# ==============================================================================
# Supabase & Database Configuration Template (KrishiLink)
# ==============================================================================

# Supabase Project Credentials
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Next.js / Frontend Client Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Database Individual Parameters
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_password

# PostgreSQL Connection Strings (URI Format)
DATABASE_URL="postgresql://postgres.your-project-ref:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-project-ref:[PASSWORD]@[HOST]:5432/postgres"

# ASP.NET Core / Entity Framework (Npgsql Format)
ConnectionStrings__DefaultConnection="Host=[HOST];Port=6543;Database=postgres;Username=postgres.your-project-ref;Password=[PASSWORD];SSL Mode=Require;Trust Server Certificate=true;"
ConnectionStrings__DirectConnection="Host=[HOST];Port=5432;Database=postgres;Username=postgres;Password=[PASSWORD];SSL Mode=Require;Trust Server Certificate=true;"
