# Copy to .env.local. Never commit real credentials.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY
SUPABASE_PUBLIC_BUCKET=listing-images
SUPABASE_PRIVATE_BUCKET=verification-documents

# Copy exact hosts from Supabase Dashboard > Connect; never guess the pooler region.
# Percent-encode special characters in URI passwords (for example @ becomes %40).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres

# Optional Npgsql-format alternatives to the URIs:
# ConnectionStrings__SessionConnection=Host=YOUR_POOLER_HOST;Port=5432;Database=postgres;Username=postgres.YOUR_PROJECT_REF;Password=YOUR_PASSWORD;SSL Mode=VerifyFull
# ConnectionStrings__MigrationConnection=Host=YOUR_POOLER_HOST;Port=5432;Database=postgres;Username=postgres.YOUR_PROJECT_REF;Password=YOUR_PASSWORD;SSL Mode=VerifyFull

App__PublicBaseUrl=https://localhost:7276
Database__ApplyMigrationsOnStartup=false
# Optional replacement CA bundle; defaults to the bundled public Supabase CA.
# Database__RootCertificate=C:\secure-config\supabase-ca.crt
# Persistent volume required in production; contains encryption/session key material.
DataProtection__KeyPath=App_Data/keys
# AI assistant. Server-only: never expose to the browser. Leave all empty to run without the assistant (the panel then
# shows its "unavailable" state). Groq is the primary provider (https://console.groq.com/keys); Google Gemini is the
# fallback (https://aistudio.google.com/apikey). _2/_3 are optional standby keys, used only if a key is rejected.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GEMINI_API_KEY=
GEMINI_API_KEY_2=
# Optional verified-email administrator bootstrap (server-controlled).
# SUPABASE_ADMIN_EMAIL=admin@example.com
