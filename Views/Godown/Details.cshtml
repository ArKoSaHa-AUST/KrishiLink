@model KrishiLink.Models.ViewModels.GodownDetailViewModel
@{
    ViewData["Title"] = Model.Name;
    ViewData["BodyClass"] = "krishi-body-gradient";
    var primaryImage = Model.ImageUrls.FirstOrDefault() ?? "";
    var bookingRequested = TempData.Peek("SuccessMessage") != null;
}

<!-- Breadcrumb Navigation -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-success text-decoration-none">Home</a></li>
        <li class="breadcrumb-item"><a asp-controller="Godown" asp-action="Index" class="text-success text-decoration-none">Godowns</a></li>
        <li class="breadcrumb-item active text-muted" aria-current="page">@Model.Name</li>
    </ol>
</nav>

<!-- Page Header & Action State Alert -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-3">
        <i class="bi bi-check-circle-fill fs-4 text-success"></i>
        <div>
            <h6 class="fw-bold mb-0 text-success-emphasis">Booking Requested ✓</h6>
            <p class="mb-1 small text-success-emphasis">@TempData["SuccessMessage"]</p>
            <a asp-controller="Bookings" asp-action="Index" class="small fw-semibold text-success">
                View Booking History <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
}

<div class="row g-4">
    <!-- LEFT COLUMN: Image Gallery & Storage Details -->
    <div class="col-12 col-lg-7 col-xl-8">
        
        <!-- Image Gallery Component -->
        <div class="card krishi-card overflow-hidden mb-4 border-0 shadow-sm">
            <div class="position-relative bg-light text-center">
                <img id="mainGodownImage" src="@primaryImage" class="img-fluid object-fit-cover w-100" style="height: 380px; transition: opacity 0.25s ease;" alt="@Model.Name" />
                <div class="position-absolute top-0 end-0 m-3">
                    @if (Model.AvailableCapacityTons > 0)
                    {
                        <span class="krishi-badge krishi-badge-available shadow-sm">
                            <i class="bi bi-check-circle-fill"></i> Available
                        </span>
                    }
                    else
                    {
                        <span class="krishi-badge krishi-badge-unavailable shadow-sm">
                            <i class="bi bi-slash-circle-fill"></i> Fully Booked
                        </span>
                    }
                </div>
            </div>

            @if (Model.ImageUrls.Count > 1)
            {
                <div class="card-body p-3 bg-white border-top">
                    <div class="d-flex gap-2 overflow-x-auto pb-1">
                        @for (int i = 0; i < Model.ImageUrls.Count; i++)
                        {
                            var imgUrl = Model.ImageUrls[i];
                            <button type="button" class="btn p-0 border rounded overflow-hidden gallery-thumb-btn @(i == 0 ? "border-success border-2" : "border-light-subtle")"
                                    onclick="switchGodownImage('@imgUrl', this)" aria-label="View godown photo @(i+1)">
                                <img src="@imgUrl" class="object-fit-cover" style="width: 76px; height: 60px;" alt="Thumbnail @(i+1)" />
                            </button>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Details Panel -->
        <div class="card krishi-card p-4 mb-4 border-0 shadow-sm">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1.5 fw-semibold">
                    @Model.StorageType
                </span>
                <span class="text-muted small d-flex align-items-center gap-1">
                    <i class="bi bi-geo-alt text-success"></i> @Model.Location
                </span>
            </div>

            <h2 class="fw-bold text-dark mb-3">@Model.Name</h2>

            <!-- Rates & Capacity Highlight Box -->
            <div class="row g-3 p-3 rounded-3 mb-4 bg-light text-dark border">
                <div class="col-6 col-sm-4">
                    <span class="text-muted small d-block">Monthly Rate</span>
                    <span class="fs-4 fw-bold text-success">@Model.PricePerTonPerMonth</span>
                </div>
                <div class="col-6 col-sm-4">
                    <span class="text-muted small d-block">Daily Rate (Est.)</span>
                    <span class="fs-5 fw-semibold text-dark">@Model.DailyRatePerTon</span>
                </div>
                <div class="col-12 col-sm-4 border-start-sm pt-2 pt-sm-0">
                    <span class="text-muted small d-block">Available Space</span>
                    <span class="fw-bold text-success fs-5">@Model.AvailableCapacityTons.ToString("N0") / @Model.TotalCapacityTons.ToString("N0") Tons</span>
                </div>
            </div>

            <!-- Description -->
            <h5 class="fw-bold text-dark mb-2">Storage Facility Description</h5>
            <p class="text-secondary leading-relaxed mb-4">@Model.Description</p>

            <!-- Facilities & Highlights -->
            <h5 class="fw-bold text-dark mb-2.5">Preservation & Security Features</h5>
            <div class="d-flex flex-wrap gap-2 mb-4">
                @foreach (var fac in Model.Facilities)
                {
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill small fw-medium d-inline-flex align-items-center gap-1.5">
                        <i class="bi bi-shield-check text-success"></i> @fac
                    </span>
                }
            </div>

            <!-- Owner Info Card -->
            <div class="p-3 rounded-3 border bg-white d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center fw-bold" style="width: 46px; height: 46px;">
                        @(Model.OwnerName.Length > 0 ? Model.OwnerName[0].ToString() : "O")
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0 text-dark">@Model.OwnerName</h6>
                        <div class="d-flex align-items-center gap-2 small text-muted">
                            <span class="text-success fw-semibold">Rating: @Model.OwnerRating.ToString("0.0")</span>
                            <span>(@Model.TotalReviews reviews)</span>
                            <span>Member since @Model.OwnerMemberSince</span>
                        </div>
                    </div>
                </div>
                <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill small">
                    <i class="bi bi-telephone text-success me-1"></i> Verified Owner
                </span>
            </div>

        </div>

    </div>

    <!-- RIGHT COLUMN: Storage Booking Form -->
    <div class="col-12 col-lg-5 col-xl-4">
        <div class="card krishi-card p-4 border-0 shadow-sm sticky-top" style="top: 85px; z-index: 10;" id="bookingFormContainer">
            <div class="d-flex align-items-center justify-content-between mb-3 pb-3 border-bottom">
                <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-calendar-check text-success"></i> Book Storage Space
                </h5>
                <span class="badge bg-success-subtle text-success fw-bold">@Model.AvailableCapacityTons Tons Free</span>
            </div>

            @if (Model.AvailableCapacityTons <= 0)
            {
                <div class="alert alert-warning border-0 small rounded-3 mb-0">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> This godown is currently fully booked. Please check other nearby storage options.
                </div>
            }
            else
            {
                <form asp-controller="Godown" asp-action="SubmitBooking" method="post" id="godownBookingForm">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Name" />
                    <input type="hidden" id="maxAvailableCapacity" value="@Model.AvailableCapacityTons" />

                    <!-- Capacity Needed Input with Live Indicator -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark small" for="requestedCapacityInput">
                            Capacity Needed (in Tons) <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <input type="number" class="form-control" id="requestedCapacityInput" asp-for="RequestedCapacityTons"
                                   min="1" max="@Model.AvailableCapacityTons" step="1" required oninput="updateRemainingCapacity(this.value)" />
                            <span class="input-group-text bg-light text-muted">Tons</span>
                        </div>
                        <div class="form-text small" id="remainingCapacityText">
                            <i class="bi bi-info-circle text-success me-1"></i>
                            <span id="remainingCapacityNumber">@((Model.AvailableCapacityTons - Model.RequestedCapacityTons).ToString("N0"))</span>/@Model.AvailableCapacityTons.ToString("N0") Tons available after this booking.
                        </div>
                        <div class="text-danger small d-none mt-1" id="capacityErrorMsg">
                            <i class="bi bi-x-circle me-1"></i> Requested capacity exceeds available space (@Model.AvailableCapacityTons Tons).
                        </div>
                    </div>

                    <!-- Date Range -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold text-dark small" for="startDateInput">Start Date <span class="text-danger">*</span></label>
                            <input type="date" class="form-control form-control-sm" id="startDateInput" asp-for="StartDate"
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold text-dark small" for="endDateInput">End Date <span class="text-danger">*</span></label>
                            <input type="date" class="form-control form-control-sm" id="endDateInput" asp-for="EndDate"
                                   min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>

                    <!-- Notes -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark small" for="bookingNotesInput">Produce Details & Notes (Optional)</label>
                        <textarea class="form-control form-control-sm" id="bookingNotesInput" asp-for="BookingNotes" rows="3" 
                                  placeholder="e.g. 5 Tons BRRI-28 Paddy bags, moisture tested, delivery next Monday"></textarea>
                    </div>

                    <!-- Action Button -->
                    <div class="d-grid pt-2">
                        @if (bookingRequested)
                        {
                            <button type="button" class="btn btn-success py-2.5 fw-bold rounded-3" disabled>
                                <i class="bi bi-check-circle-fill me-1.5"></i> Booking Requested ✓
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-krishi-primary py-2.5 fw-bold rounded-3 shadow-sm" id="submitBookingBtn">
                                <i class="bi bi-box-seam me-1.5"></i> Book Storage
                            </button>
                        }
                    </div>

                    <p class="text-muted small text-center mt-3 mb-0" style="font-size: 0.78rem;">
                        <i class="bi bi-lock-fill text-muted me-1"></i> No immediate payment required. Owner confirms reservation first.
                    </p>
                </form>
            }
        </div>
    </div>
</div>

<!-- Mobile Sticky Bottom Bar (Visible on mobile viewports only) — mirrors Equipment Detail page -->
<div class="d-lg-none position-fixed bottom-0 start-0 end-0 bg-white border-top shadow-lg p-3" style="z-index: 1040;">
    <div class="container d-flex align-items-center justify-content-between gap-2">
        <div>
            <span class="text-muted small d-block">Monthly Rate</span>
            <span class="fw-bold text-success fs-5">@Model.PricePerTonPerMonth</span>
        </div>
        @if (bookingRequested)
        {
            <button type="button" class="btn btn-secondary rounded-pill px-4 py-2.5 fw-bold" disabled>
                Booking Requested ✓
            </button>
        }
        else if (Model.AvailableCapacityTons <= 0)
        {
            <button type="button" class="btn btn-secondary rounded-pill px-4 py-2.5 fw-bold" disabled>
                Fully Booked
            </button>
        }
        else
        {
            <button type="button" class="btn btn-krishi-primary rounded-pill px-4 py-2.5 fw-bold" onclick="scrollToBookingForm()">
                Book This Godown
            </button>
        }
    </div>
</div>
<!-- Spacer so the fixed bar never covers footer content on mobile -->
<div class="d-lg-none" style="height: 84px;"></div>

@section Scripts {
    <script>
        function scrollToBookingForm() {
            document.getElementById('bookingFormContainer')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        function switchGodownImage(src, btn) {
            const mainImg = document.getElementById('mainGodownImage');
            if (mainImg) {
                mainImg.style.opacity = '0.4';
                setTimeout(() => {
                    mainImg.src = src;
                    mainImg.style.opacity = '1';
                }, 150);
            }
            document.querySelectorAll('.gallery-thumb-btn').forEach(b => {
                b.classList.remove('border-success', 'border-2');
                b.classList.add('border-light-subtle');
            });
            if (btn) {
                btn.classList.add('border-success', 'border-2');
                btn.classList.remove('border-light-subtle');
            }
        }

        function updateRemainingCapacity(val) {
            const max = Number(document.getElementById('maxAvailableCapacity')?.value || 0);
            const req = Number(val || 0);
            const remaining = max - req;
            const remainingSpan = document.getElementById('remainingCapacityNumber');
            const errorMsg = document.getElementById('capacityErrorMsg');
            const submitBtn = document.getElementById('submitBookingBtn');

            if (req > max || req <= 0) {
                if (errorMsg) errorMsg.classList.remove('d-none');
                if (submitBtn) submitBtn.disabled = true;
                if (remainingSpan) remainingSpan.innerText = '0';
            } else {
                if (errorMsg) errorMsg.classList.add('d-none');
                if (submitBtn) submitBtn.disabled = false;
                if (remainingSpan) remainingSpan.innerText = remaining.toLocaleString();
            }
        }

        // Intercept submit: show a confirmation modal with a booking summary before posting
        document.getElementById('godownBookingForm')?.addEventListener('submit', function (e) {
            e.preventDefault();
            const form = this;
            if (!form.reportValidity()) return;

            const capacity = document.getElementById('requestedCapacityInput').value;
            const start = document.getElementById('startDateInput').value;
            const end = document.getElementById('endDateInput').value;

            if (end <= start) {
                KrishiModal.confirm({
                    title: 'Invalid Dates',
                    body: 'End date must be after the start date. Please adjust the booking duration.',
                    confirmText: 'OK'
                });
                return;
            }

            KrishiModal.confirm({
                title: 'Confirm Storage Booking',
                body: `<ul class="list-unstyled mb-0 d-flex flex-column gap-2 small">
                           <li><i class="bi bi-building text-success me-2"></i><strong>Godown:</strong> @Model.Name</li>
                           <li><i class="bi bi-box-seam text-success me-2"></i><strong>Capacity:</strong> ${capacity} Tons</li>
                           <li><i class="bi bi-calendar-range text-success me-2"></i><strong>Duration:</strong> ${start} → ${end}</li>
                       </ul>`,
                confirmText: 'Confirm Booking',
                onConfirm: function () { form.submit(); }
            });
        });
    </script>
}
