@model KrishiLink.Models.ViewModels.GodownDetailViewModel
@{
    ViewData["Title"] = Model.Name;
    ViewData["BodyClass"] = "krishi-body-gradient";
    var primaryImage = Model.ImageUrls.FirstOrDefault() ?? "";
    var bookingRequested = TempData.Peek("SuccessMessage") != null;
    var ownerMemberSinceParts = Model.OwnerMemberSince?.Split(' ', 2, StringSplitOptions.RemoveEmptyEntries) ?? Array.Empty<string>();
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <style>
        .leaflet-popup-content-wrapper { border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.15); }
        .custom-godown-pin {
            background-color: #0d6efd;
            color: white;
            border-radius: 50% 50% 50% 0;
            transform: rotate(-45deg);
            width: 34px;
            height: 34px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid white;
            box-shadow: 0 2px 8px rgba(0,0,0,0.3);
        }
        .custom-godown-pin i {
            transform: rotate(45deg);
            font-size: 15px;
        }
    </style>
}

<!-- Breadcrumb Navigation -->
<nav aria-label='@L["breadcrumb"]' class="mb-3">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-success text-decoration-none">@L["Home"]</a></li>
        <li class="breadcrumb-item"><a asp-controller="Godown" asp-action="Index" class="text-success text-decoration-none">@L["Godowns"]</a></li>
        <li class="breadcrumb-item active text-muted" aria-current="page">@Model.Name</li>
    </ol>
</nav>

<!-- Page Header & Action State Alert -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-3">
        <i class="bi bi-check-circle-fill fs-4 text-success"></i>
        <div>
            <h6 class="fw-bold mb-0 text-success-emphasis">@L["Booking Requested ✓"]</h6>
            <p class="mb-1 small text-success-emphasis">@TempData["SuccessMessage"]</p>
            <a asp-controller="Bookings" asp-action="Index" class="small fw-semibold text-success">
                @L["View Booking History"] <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-triangle-fill"></i><span class="small">@TempData["ErrorMessage"]</span>
    </div>
}

<div class="row g-4">
    <!-- LEFT COLUMN: Image Gallery & Storage Details -->
    <div class="col-12 col-lg-7 col-xl-8">

        <!-- Image Gallery Component -->
        <div class="card krishi-card overflow-hidden mb-4 border-0 shadow-sm">
            <div class="position-relative bg-light text-center">
                <img id="mainGodownImage" src="@primaryImage" class="img-fluid object-fit-cover w-100" style="height: 380px; transition: opacity 0.25s ease;" alt="@Model.Name" />
                <div class="position-absolute top-0 end-0 m-3">
                    @if (Model.AvailableCapacityTons > 0)
                    {
                        <span class="krishi-badge krishi-badge-available shadow-sm">
                            <i class="bi bi-check-circle-fill"></i> @L["Available"]
                        </span>
                    }
                    else
                    {
                        <span class="krishi-badge krishi-badge-unavailable shadow-sm">
                            <i class="bi bi-slash-circle-fill"></i> @L["Fully Booked"]
                        </span>
                    }
                </div>
            </div>

            @if (Model.ImageUrls.Count > 1)
            {
                <div class="card-body p-3 bg-white border-top">
                    <div class="d-flex gap-2 overflow-x-auto pb-1">
                        @for (int i = 0; i < Model.ImageUrls.Count; i++)
                        {
                            var imgUrl = Model.ImageUrls[i];
                            <button type="button" class="btn p-0 border rounded overflow-hidden gallery-thumb-btn @(i == 0 ? "border-success border-2" : "border-light-subtle")"
                                    onclick="switchGodownImage('@imgUrl', this)" aria-label='@L["View godown photo {0}", i+1]'>
                                <img src="@imgUrl" class="object-fit-cover" style="width: 76px; height: 60px;" alt='@L["Thumbnail {0}", i+1]' />
                            </button>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Details Panel -->
        <div class="card krishi-card p-4 mb-4 border-0 shadow-sm">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1.5 fw-semibold">
                    @L[Model.StorageType]
                </span>
                <span class="text-muted small d-flex align-items-center gap-1">
                    <i class="bi bi-geo-alt text-success"></i> @L[Model.Location]
                </span>
            </div>

            <h2 class="fw-bold text-dark mb-3">@Model.Name</h2>

            <!-- Rates & Capacity Highlight Box -->
            <div class="row g-3 p-3 rounded-3 mb-4 bg-light text-dark border">
                <div class="col-6 col-sm-4">
                    <span class="text-muted small d-block">@L["Monthly Rate"]</span>
                    <span class="fs-4 fw-bold text-success">@L["Tk {0} / Ton / Month", Model.PricePerTonPerMonth.Replace("\u09f3", "").Replace(" / Ton / Month", "")]</span>
                </div>
                <div class="col-6 col-sm-4">
                    <span class="text-muted small d-block">@L["Daily Rate (Est.)"]</span>
                    <span class="fs-5 fw-semibold text-dark">@L["Tk {0} / Ton / Day", Model.DailyRatePerTon.Replace("\u09f3", "").Replace(" / Ton / Day", "")]</span>
                </div>
                <div class="col-12 col-sm-4 border-start-sm pt-2 pt-sm-0">
                    <span class="text-muted small d-block">@L["Available Space"]</span>
                    <span class="fw-bold text-success fs-5">@L["{0} / {1} Tons", Model.AvailableCapacityTons.ToString("N0"), Model.TotalCapacityTons.ToString("N0")]</span>
                </div>
            </div>

            <!-- Description -->
            <h5 class="fw-bold text-dark mb-2">@L["Storage Facility Description"]</h5>
            <p class="text-secondary leading-relaxed mb-4">@Model.Description</p>

            <!-- Facilities & Highlights -->
            <h5 class="fw-bold text-dark mb-2.5">@L["Preservation & Security Features"]</h5>
            <div class="d-flex flex-wrap gap-2 mb-4">
                @foreach (var fac in Model.Facilities)
                {
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill small fw-medium d-inline-flex align-items-center gap-1.5">
                        <i class="bi bi-shield-check text-success"></i> @L[fac]
                    </span>
                }
            </div>

            <!-- Owner Info Card -->
            <div class="p-3 rounded-3 border bg-white d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center fw-bold" style="width: 46px; height: 46px;">
                        @(Model.OwnerName.Length > 0 ? Model.OwnerName[0].ToString().ToUpperInvariant() : "O")
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-1.5">
                            @Model.OwnerName
                            @if (Model.OwnerIsVerified)
                            {
                                <i class="bi bi-patch-check-fill text-success" title="@L["Verified Owner"]"></i>
                            }
                        </h6>
                        <div class="d-flex align-items-center gap-2 small text-muted">
                            @if (Model.ReviewCount > 0)
                            {
                                <span class="text-warning fw-bold d-inline-flex align-items-center gap-1">
                                    <i class="bi bi-star-fill"></i> @Model.AverageRating.ToString("0.0")
                                </span>
                                <span>(@L["{0} reviews", Model.ReviewCount])</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border py-0.5 px-2">@L["New Listing"]</span>
                            }
                            <span>@L["Member since"] @(ownerMemberSinceParts.Length == 2 ? $"{L[ownerMemberSinceParts[0]]} {ownerMemberSinceParts[1]}" : Model.OwnerMemberSince)</span>
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    @if (!string.IsNullOrWhiteSpace(Model.OwnerRankText))
                    {
                        <a asp-controller="Leaderboard" asp-action="Index" class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2 rounded-pill small fw-bold text-decoration-none">
                            <i class="bi bi-trophy-fill text-warning me-1"></i> @Model.OwnerRankText
                        </a>
                    }
                    @if (Model.OwnerIsVerified)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill small fw-semibold shadow-xs">
                            <i class="bi bi-patch-check-fill text-success me-1"></i> @L["Verified Owner"]
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-light text-muted border px-3 py-2 rounded-pill small">
                            <i class="bi bi-shield text-muted me-1"></i> @L["Unverified"]
                        </span>
                    }
                </div>
            </div>

            @if (Model.OwnerBadges != null && Model.OwnerBadges.Any())
            {
                <div class="mt-2.5 pt-2.5 border-top d-flex align-items-center gap-2 flex-wrap">
                    <span class="text-muted small fw-medium me-1"><i class="bi bi-award"></i> @L["Badges"]:</span>
                    <partial name="_OwnerBadgeList" model="Model.OwnerBadges" />
                </div>
            }

            <!-- Storage Facility Location & Map Directions Card -->
            <div class="card p-3.5 mt-4 border rounded-4 bg-light shadow-xs">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 pb-2 border-bottom">
                    <div>
                        <h6 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                            <i class="bi bi-geo-alt-fill text-primary"></i>
                            <span>@L["Location & Map Directions"]</span>
                        </h6>
                        <div class="text-muted small d-flex align-items-center flex-wrap gap-2">
                            <span class="fw-semibold text-dark"><i class="bi bi-pin-map text-primary me-1"></i>@Model.Location</span>
                            @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                            {
                                <span class="badge bg-white text-muted border font-monospace">@Model.FormattedCoordinates</span>
                            }
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-semibold shadow-xs" onclick="copyCoordinates('@Model.Latitude.Value.ToString("F6")', '@Model.Longitude.Value.ToString("F6")')">
                                <i class="bi bi-clipboard me-1"></i> @L["Copy GPS"]
                            </button>
                            <a href="@Model.GoogleMapsUrl" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm rounded-pill px-3 fw-semibold shadow-xs">
                                <i class="bi bi-signpost-2-fill me-1"></i> @L["Get Directions"]
                            </a>
                        }
                    </div>
                </div>

                <div id="godownDetailMap" class="rounded-3 border shadow-xs bg-white" style="height: 260px; width: 100%; z-index: 1;"></div>
            </div>

        </div>

        <!-- Availability Calendar: owner blackout dates and days already at full capacity -->
        <partial name="_AvailabilityCalendar" model="Model.UnavailableDates" />

        <!-- =========================================================================
             RATINGS & REVIEWS SECTION
             ========================================================================= -->
        <div class="card krishi-card p-4 mt-4 border-0 shadow-sm" id="reviewsSection">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4 pb-3 border-bottom">
                <h4 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-star-fill text-warning"></i>
                    <span>@L["Ratings & Reviews"]</span>
                </h4>
                @if (Model.ReviewCount > 0)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1.5 fw-semibold">
                        @L["{0} Verified Storage Reviews", Model.ReviewCount]
                    </span>
                }
            </div>

            @if (Model.ReviewCount > 0 && Model.Reviews != null)
            {
                <!-- Rating Score Summary & Breakdown Card -->
                <div class="bg-light p-4 rounded-4 border mb-4">
                    <div class="row g-4 align-items-center">
                        
                        <!-- Left: Overall Score -->
                        <div class="col-12 col-md-5 text-center text-md-start border-end-md">
                            <div class="d-flex flex-column align-items-center align-items-md-start">
                                <div class="display-4 fw-black text-dark lh-1 mb-1">
                                    @Model.AverageRating.ToString("0.0")
                                </div>
                                <div class="text-warning mb-1 fs-5">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= Math.Round(Model.AverageRating))
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star text-muted opacity-50"></i>
                                        }
                                    }
                                </div>
                                <span class="text-muted small fw-medium">
                                    @L["Based on {0} verified booking reviews", Model.ReviewCount]
                                </span>
                            </div>
                        </div>

                        <!-- Right: Star Breakdown Progress Bars -->
                        <div class="col-12 col-md-7">
                            <div class="d-flex flex-column gap-1.5">
                                
                                <!-- 5 Stars -->
                                <div class="d-flex align-items-center gap-2 small">
                                    <span class="text-muted text-nowrap" style="width: 45px;">5 <i class="bi bi-star-fill text-warning" style="font-size: 0.75rem;"></i></span>
                                    <div class="progress flex-grow-1" style="height: 8px;">
                                        <div class="progress-bar bg-warning" role="progressbar" style="width: @(Model.Reviews.Breakdown.FiveStarPercent)%;" aria-valuenow="@Model.Reviews.Breakdown.FiveStarPercent" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <span class="text-muted text-end text-nowrap" style="width: 30px;">@Model.Reviews.Breakdown.FiveStarCount</span>
                                </div>

                                <!-- 4 Stars -->
                                <div class="d-flex align-items-center gap-2 small">
                                    <span class="text-muted text-nowrap" style="width: 45px;">4 <i class="bi bi-star-fill text-warning" style="font-size: 0.75rem;"></i></span>
                                    <div class="progress flex-grow-1" style="height: 8px;">
                                        <div class="progress-bar bg-warning" role="progressbar" style="width: @(Model.Reviews.Breakdown.FourStarPercent)%;" aria-valuenow="@Model.Reviews.Breakdown.FourStarPercent" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <span class="text-muted text-end text-nowrap" style="width: 30px;">@Model.Reviews.Breakdown.FourStarCount</span>
                                </div>

                                <!-- 3 Stars -->
                                <div class="d-flex align-items-center gap-2 small">
                                    <span class="text-muted text-nowrap" style="width: 45px;">3 <i class="bi bi-star-fill text-warning" style="font-size: 0.75rem;"></i></span>
                                    <div class="progress flex-grow-1" style="height: 8px;">
                                        <div class="progress-bar bg-warning" role="progressbar" style="width: @(Model.Reviews.Breakdown.ThreeStarPercent)%;" aria-valuenow="@Model.Reviews.Breakdown.ThreeStarPercent" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <span class="text-muted text-end text-nowrap" style="width: 30px;">@Model.Reviews.Breakdown.ThreeStarCount</span>
                                </div>

                                <!-- 2 Stars -->
                                <div class="d-flex align-items-center gap-2 small">
                                    <span class="text-muted text-nowrap" style="width: 45px;">2 <i class="bi bi-star-fill text-warning" style="font-size: 0.75rem;"></i></span>
                                    <div class="progress flex-grow-1" style="height: 8px;">
                                        <div class="progress-bar bg-warning" role="progressbar" style="width: @(Model.Reviews.Breakdown.TwoStarPercent)%;" aria-valuenow="@Model.Reviews.Breakdown.TwoStarPercent" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <span class="text-muted text-end text-nowrap" style="width: 30px;">@Model.Reviews.Breakdown.TwoStarCount</span>
                                </div>

                                <!-- 1 Star -->
                                <div class="d-flex align-items-center gap-2 small">
                                    <span class="text-muted text-nowrap" style="width: 45px;">1 <i class="bi bi-star-fill text-warning" style="font-size: 0.75rem;"></i></span>
                                    <div class="progress flex-grow-1" style="height: 8px;">
                                        <div class="progress-bar bg-warning" role="progressbar" style="width: @(Model.Reviews.Breakdown.OneStarPercent)%;" aria-valuenow="@Model.Reviews.Breakdown.OneStarPercent" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <span class="text-muted text-end text-nowrap" style="width: 30px;">@Model.Reviews.Breakdown.OneStarCount</span>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>

                <!-- Individual Reviews List -->
                <div class="d-flex flex-column gap-3">
                    @foreach (var review in Model.Reviews.Reviews)
                    {
                        <div class="p-3.5 rounded-3 border bg-white shadow-xs">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <div class="d-flex align-items-center gap-2.5">
                                    <div class="rounded-circle bg-success-subtle text-success border border-success-subtle d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px;">
                                        @review.UserInitial
                                    </div>
                                    <div>
                                        <h6 class="fw-bold text-dark mb-0">@review.FarmerName</h6>
                                        <div class="small text-muted d-flex align-items-center gap-2">
                                            @if (!string.IsNullOrWhiteSpace(review.FarmerLocation))
                                            {
                                                <span><i class="bi bi-geo-alt text-success"></i> @review.FarmerLocation</span>
                                            }
                                            <span class="badge bg-light text-muted border py-0.5 px-1.5" style="font-size: 0.7rem;">@L["Verified Storage"]</span>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="text-end">
                                    <div class="text-warning small mb-0.5">
                                        @for (int s = 1; s <= 5; s++)
                                        {
                                            if (s <= review.Rating)
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star text-muted opacity-50"></i>
                                            }
                                        }
                                    </div>
                                    <span class="text-muted small" style="font-size: 0.75rem;">@review.TimeAgo</span>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(review.Comment))
                            {
                                <p class="text-secondary small mb-0 mt-2 ps-1 border-start border-2 border-success-subtle ps-2.5">
                                    @review.Comment
                                </p>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Empty State -->
                <div class="text-center py-5 px-3 bg-light rounded-4 border">
                    <div class="display-6 text-muted mb-2">
                        <i class="bi bi-building-check text-success opacity-75"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-1">@L["No Reviews Yet"]</h6>
                    <p class="text-muted small mb-0" style="max-width: 420px; margin: 0 auto;">
                        @L["Be the first farmer to store agricultural produce here and leave an honest rating and review after your booking is completed!"]
                    </p>
                </div>
            }
        </div>

    </div>

    <!-- RIGHT COLUMN: Storage Booking Form -->
    <div class="col-12 col-lg-5 col-xl-4">
        <div class="card krishi-card p-4 border-0 shadow-sm sticky-top" style="top: 85px; z-index: 10;" id="bookingFormContainer">
            <div class="d-flex align-items-center justify-content-between mb-3 pb-3 border-bottom">
                <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-calendar-check text-success"></i> @L["Book Storage Space"]
                </h5>
                <span class="badge bg-success-subtle text-success fw-bold">@L["{0} Tons Free", Model.AvailableCapacityTons]</span>
            </div>

            @if (Model.AvailableCapacityTons <= 0)
            {
                <div class="alert alert-warning border-0 small rounded-3 mb-0">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @L["This godown is currently fully booked. Please check other nearby storage options."]
                </div>
            }
            else
            {
                <form asp-controller="Godown" asp-action="SubmitBooking" method="post" id="godownBookingForm">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Name" />
                    <input type="hidden" id="maxAvailableCapacity" value="@Model.AvailableCapacityTons" />

                    <!-- Capacity Needed Input with Live Indicator -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark small" for="requestedCapacityInput">
                            @L["Capacity Needed (in Tons)"] <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <input type="number" class="form-control" id="requestedCapacityInput" asp-for="RequestedCapacityTons"
                                   min="1" max="@Model.AvailableCapacityTons" step="1" required oninput="updateRemainingCapacity(this.value)" />
                            <span class="input-group-text bg-light text-muted">@L["Tons"]</span>
                        </div>
                        <div class="form-text small" id="remainingCapacityText">
                            <i class="bi bi-info-circle text-success me-1"></i>
                            <span id="remainingCapacityNumber">@((Model.AvailableCapacityTons - Model.RequestedCapacityTons).ToString("N0"))</span>/@Model.AvailableCapacityTons.ToString("N0") @L["Tons available after this booking."]
                        </div>
                        <div class="text-danger small d-none mt-1" id="capacityErrorMsg">
                            <i class="bi bi-x-circle me-1"></i> @L["Requested capacity exceeds available space ({0} Tons).", Model.AvailableCapacityTons]
                        </div>
                    </div>

                    <!-- Date Range -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold text-dark small" for="startDateInput">@L["Start Date"] <span class="text-danger">*</span></label>
                            <input type="date" class="form-control form-control-sm" id="startDateInput" asp-for="StartDate"
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold text-dark small" for="endDateInput">@L["End Date"] <span class="text-danger">*</span></label>
                            <input type="date" class="form-control form-control-sm" id="endDateInput" asp-for="EndDate"
                                   min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>

                    <!-- Estimated Cost Summary -->
                    <div id="godownCostSummaryBox" class="p-3 bg-success-subtle text-success border border-success-subtle rounded-3 mb-3 d-none">
                        <div class="d-flex justify-content-between small fw-medium">
                            <span>@L["Storage Duration:"]</span>
                            <span id="godownSummaryDuration">0 Months</span>
                        </div>
                        <div class="d-flex justify-content-between small fw-medium mt-1">
                            <span>@L["Gross Storage Fee:"]</span>
                            <span id="godownSummaryGrossFee">৳0</span>
                        </div>
                        <div id="godownSummaryDiscountRow" class="d-flex justify-content-between small fw-bold text-success mt-1 d-none">
                            <span id="godownSummaryDiscountLabel">@L["Loyalty Discount:"]</span>
                            <span id="godownSummaryDiscountAmount">-৳0</span>
                        </div>
                        <div class="d-flex justify-content-between fw-bold fs-6 mt-1.5 pt-1.5 border-top border-success-subtle">
                            <span>@L["Estimated Net Total:"]</span>
                            <span id="godownSummaryTotalFee">৳0</span>
                        </div>
                        <div class="d-flex justify-content-between small text-muted mt-1" style="font-size: 0.75rem;">
                            <span>@L["KrishiPoints Earned on Completion:"]</span>
                            <span id="godownSummaryPointsEarned" class="fw-bold text-success">+10 pts</span>
                        </div>
                    </div>

                    <!-- Loyalty Points & Promo Code Redemption -->
                    <div class="card border border-success-subtle bg-light rounded-3 mb-3 p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label small fw-bold text-dark mb-0 d-flex align-items-center gap-1.5">
                                <i class="bi bi-gift-fill text-success"></i>
                                <span>@L["KrishiPoints & Promo Code"]</span>
                            </label>
                            @if (User.Identity?.IsAuthenticated == true && Model.FarmerLoyaltyPoints > 0)
                            {
                                <span class="badge bg-success text-white rounded-pill px-2 py-0.5 small" id="godownFarmerPointsBadge">
                                    @Model.FarmerLoyaltyPoints @L["pts available"]
                                </span>
                            }
                        </div>

                        <!-- Quick Tier Select (If points available) -->
                        @if (User.Identity?.IsAuthenticated == true && Model.FarmerLoyaltyPoints >= 50 && Model.AvailableConversionTiers.Any(t => t.PointsRequired <= Model.FarmerLoyaltyPoints))
                        {
                            <div class="mb-2">
                                <label class="small text-muted mb-1 d-block" style="font-size: 0.78rem;">@L["1-Click Redeem KrishiPoints:"]</label>
                                <select class="form-select form-select-sm rounded-3" id="godownPointsTierSelect" onchange="applyGodownPointsTier(this.value)">
                                    <option value="0">@L["-- Do not use points --"]</option>
                                    @foreach (var tier in Model.AvailableConversionTiers.Where(t => t.PointsRequired <= Model.FarmerLoyaltyPoints))
                                    {
                                        <option value="@tier.PointsRequired" data-discount="@tier.DiscountTaka">
                                            @L["Use {0} pts → Save ৳{1}", tier.PointsRequired, tier.DiscountTaka.ToString("N0")]
                                        </option>
                                    }
                                </select>
                            </div>
                        }

                        <!-- Or Promo Code Input -->
                        <div class="mt-1">
                            <label class="small text-muted mb-1 d-block" style="font-size: 0.78rem;">@L["Or enter Promo Voucher code:"]</label>
                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control rounded-start-3 text-uppercase" id="godownPromoCodeInput" placeholder="@L["e.g. KL-PTS120-ABCD"]" />
                                <button type="button" class="btn btn-outline-success px-3 fw-semibold" id="godownApplyPromoBtn" onclick="applyGodownPromoCode()">@L["Apply"]</button>
                                <button type="button" class="btn btn-outline-secondary d-none" id="godownClearPromoBtn" onclick="clearGodownPromoCode()"><i class="bi bi-x"></i></button>
                            </div>
                            <div id="godownPromoFeedbackMsg" class="form-text small mt-1 d-none"></div>
                        </div>

                        <!-- Hidden form fields to submit -->
                        <input type="hidden" name="AppliedPromoCode" id="godownHiddenAppliedPromoCode" value="" />
                        <input type="hidden" name="PointsUsed" id="godownHiddenPointsUsed" value="0" />
                    </div>

                    <!-- Notes -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark small" for="bookingNotesInput">@L["Produce Details & Notes (Optional)"]</label>
                        <textarea class="form-control form-control-sm" id="bookingNotesInput" asp-for="BookingNotes" rows="3"
                                  placeholder='@L["e.g. 5 Tons BRRI-28 Paddy bags, moisture tested, delivery next Monday"]'></textarea>
                    </div>

                    <!-- Action Button -->
                    <div class="d-grid pt-2">
                        @if (bookingRequested)
                        {
                            <button type="button" class="btn btn-success py-2.5 fw-bold rounded-3" disabled>
                                <i class="bi bi-check-circle-fill me-1.5"></i> @L["Booking Requested ✓"]
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-krishi-primary py-2.5 fw-bold rounded-3 shadow-sm" id="submitBookingBtn">
                                <i class="bi bi-box-seam me-1.5"></i> @L["Book Storage"]
                            </button>
                        }
                    </div>

                    <p class="text-muted small text-center mt-3 mb-0" style="font-size: 0.78rem;">
                        <i class="bi bi-lock-fill text-muted me-1"></i> @L["No immediate payment required. Owner confirms reservation first."]
                    </p>
                </form>
            }
        </div>
    </div>
</div>

<!-- Mobile Sticky Bottom Bar (Visible on mobile viewports only) — mirrors Equipment Detail page -->
<div class="d-lg-none position-fixed bottom-0 start-0 end-0 bg-white border-top shadow-lg p-3" style="z-index: 1040;">
    <div class="container d-flex align-items-center justify-content-between gap-2">
        <div>
            <span class="text-muted small d-block">@L["Monthly Rate"]</span>
            <span class="fw-bold text-success fs-5">@L["Tk {0} / Ton / Month", Model.PricePerTonPerMonth.Replace("\u09f3", "").Replace(" / Ton / Month", "")]</span>
        </div>
        @if (bookingRequested)
        {
            <button type="button" class="btn btn-secondary rounded-pill px-4 py-2.5 fw-bold" disabled>
                @L["Booking Requested ✓"]
            </button>
        }
        else if (Model.AvailableCapacityTons <= 0)
        {
            <button type="button" class="btn btn-secondary rounded-pill px-4 py-2.5 fw-bold" disabled>
                @L["Fully Booked"]
            </button>
        }
        else
        {
            <button type="button" class="btn btn-krishi-primary rounded-pill px-4 py-2.5 fw-bold" onclick="scrollToBookingForm()">
                @L["Book This Godown"]
            </button>
        }
    </div>
</div>
<!-- Spacer so the fixed bar never covers footer content on mobile -->
<div class="d-lg-none" style="height: 84px;"></div>

@section Scripts {
    <script>
        const unavailableDates = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.UnavailableDates.Select(d => d.ToString("yyyy-MM-dd"))));

        function scrollToBookingForm() {
            document.getElementById('bookingFormContainer')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        // Calendar click: fill start date first, then end date
        function selectCalendarDate(dateStr) {
            const startInput = document.getElementById('startDateInput');
            const endInput = document.getElementById('endDateInput');
            if (!startInput.value || dateStr <= startInput.value) {
                startInput.value = dateStr;
                endInput.value = '';
            } else {
                endInput.value = dateStr;
            }
            scrollToBookingForm();
        }

        function rangeHitsUnavailableDate(start, end) {
            return unavailableDates.some(d => d >= start && d <= end);
        }

        function switchGodownImage(src, btn) {
            const mainImg = document.getElementById('mainGodownImage');
            if (mainImg) {
                mainImg.style.opacity = '0.4';
                setTimeout(() => {
                    mainImg.src = src;
                    mainImg.style.opacity = '1';
                }, 150);
            }
            document.querySelectorAll('.gallery-thumb-btn').forEach(b => {
                b.classList.remove('border-success', 'border-2');
                b.classList.add('border-light-subtle');
            });
            if (btn) {
                btn.classList.add('border-success', 'border-2');
                btn.classList.remove('border-light-subtle');
            }
        }

        const pricePerTonPerMonth = @Model.PricePerTonPerMonthAmount.ToString(System.Globalization.CultureInfo.InvariantCulture);
        let currentGodownDiscount = 0;
        let currentGodownPromo = '';
        let currentGodownPointsUsed = 0;
        let currentGodownGross = 0;

        function recalculateGodownSummary() {
            const startInput = document.getElementById('startDateInput');
            const endInput = document.getElementById('endDateInput');
            const capacityInput = document.getElementById('requestedCapacityInput');
            const costBox = document.getElementById('godownCostSummaryBox');
            const summaryDuration = document.getElementById('godownSummaryDuration');
            const summaryGrossFee = document.getElementById('godownSummaryGrossFee');
            const summaryDiscountRow = document.getElementById('godownSummaryDiscountRow');
            const summaryDiscountAmount = document.getElementById('godownSummaryDiscountAmount');
            const summaryDiscountLabel = document.getElementById('godownSummaryDiscountLabel');
            const summaryTotalFee = document.getElementById('godownSummaryTotalFee');
            const summaryPointsEarned = document.getElementById('godownSummaryPointsEarned');

            if (!startInput?.value || !endInput?.value || !capacityInput?.value) {
                if (costBox) costBox.classList.add('d-none');
                currentGodownGross = 0;
                return;
            }

            const start = new Date(startInput.value);
            const end = new Date(endInput.value);
            const capacity = parseFloat(capacityInput.value) || 0;

            if (end <= start || capacity <= 0) {
                if (costBox) costBox.classList.add('d-none');
                currentGodownGross = 0;
                return;
            }

            const diffTime = Math.abs(end - start);
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;
            const months = Math.max(1.0, diffDays / 30.0);

            const gross = Math.round(capacity * pricePerTonPerMonth * months);
            currentGodownGross = gross;

            if (summaryDuration) {
                summaryDuration.textContent = `${months.toFixed(1)} Months (${diffDays} Days)`;
            }

            if (summaryGrossFee) {
                summaryGrossFee.textContent = '৳' + gross.toLocaleString();
            }

            const netTotal = Math.max(0, gross - currentGodownDiscount);

            if (currentGodownDiscount > 0) {
                if (summaryDiscountRow) summaryDiscountRow.classList.remove('d-none');
                if (summaryDiscountAmount) summaryDiscountAmount.textContent = '-৳' + currentGodownDiscount.toLocaleString();
                if (summaryDiscountLabel) {
                    summaryDiscountLabel.textContent = currentGodownPromo
                        ? `@L["Promo Discount"] (${currentGodownPromo}):`
                        : `@L["KrishiPoints Discount"] (${currentGodownPointsUsed} pts):`;
                }
            } else {
                if (summaryDiscountRow) summaryDiscountRow.classList.add('d-none');
            }

            if (summaryTotalFee) {
                summaryTotalFee.textContent = '৳' + netTotal.toLocaleString();
            }

            if (summaryPointsEarned) {
                const pts = Math.max(10, Math.floor(netTotal / 100));
                summaryPointsEarned.textContent = `+${pts.toLocaleString()} pts`;
            }

            if (costBox) costBox.classList.remove('d-none');
        }

        function applyGodownPointsTier(pts) {
            pts = parseInt(pts) || 0;
            const selectEl = document.getElementById('godownPointsTierSelect');
            const promoInput = document.getElementById('godownPromoCodeInput');
            const promoFeedback = document.getElementById('godownPromoFeedbackMsg');
            const clearBtn = document.getElementById('godownClearPromoBtn');

            if (pts > 0) {
                if (promoInput) promoInput.value = '';
                if (clearBtn) clearBtn.classList.add('d-none');
                if (promoFeedback) promoFeedback.classList.add('d-none');
                currentGodownPromo = '';
                document.getElementById('godownHiddenAppliedPromoCode').value = '';
                document.getElementById('godownHiddenPointsUsed').value = pts;
                currentGodownPointsUsed = pts;

                const selectedOption = selectEl?.selectedOptions[0];
                const discount = parseFloat(selectedOption?.getAttribute('data-discount')) || 0;
                currentGodownDiscount = discount;
            } else {
                currentGodownPointsUsed = 0;
                document.getElementById('godownHiddenPointsUsed').value = 0;
                currentGodownDiscount = 0;
            }

            recalculateGodownSummary();
        }

        async function applyGodownPromoCode() {
            const promoInput = document.getElementById('godownPromoCodeInput');
            const code = promoInput?.value?.trim()?.toUpperCase() || '';
            const feedback = document.getElementById('godownPromoFeedbackMsg');
            const clearBtn = document.getElementById('godownClearPromoBtn');
            const tierSelect = document.getElementById('godownPointsTierSelect');

            if (!code) {
                if (feedback) {
                    feedback.textContent = '@L["Please enter a valid promo voucher code."]';
                    feedback.className = 'form-text small mt-1 text-danger';
                    feedback.classList.remove('d-none');
                }
                return;
            }

            recalculateGodownSummary();
            if (currentGodownGross <= 0) {
                if (feedback) {
                    feedback.textContent = '@L["Please select valid storage dates and capacity first."]';
                    feedback.className = 'form-text small mt-1 text-danger';
                    feedback.classList.remove('d-none');
                }
                return;
            }

            try {
                const res = await fetch('/Loyalty/ValidatePromo', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        promoCode: code,
                        pointsToRedeem: null,
                        grossAmount: currentGodownGross
                    })
                });

                const data = await res.json();
                if (data.isValid) {
                    if (tierSelect) tierSelect.value = "0";
                    currentGodownPointsUsed = data.pointsRequired || 0;
                    currentGodownDiscount = data.discountAmount || 0;
                    currentGodownPromo = data.promoCode || code;

                    document.getElementById('godownHiddenAppliedPromoCode').value = currentGodownPromo;
                    document.getElementById('godownHiddenPointsUsed').value = currentGodownPointsUsed;

                    if (feedback) {
                        feedback.textContent = `@L["Promo Applied!"] ${data.message}`;
                        feedback.className = 'form-text small mt-1 text-success fw-semibold';
                        feedback.classList.remove('d-none');
                    }
                    if (clearBtn) clearBtn.classList.remove('d-none');
                } else {
                    currentGodownDiscount = 0;
                    currentGodownPromo = '';
                    document.getElementById('godownHiddenAppliedPromoCode').value = '';
                    document.getElementById('godownHiddenPointsUsed').value = 0;

                    if (feedback) {
                        feedback.textContent = data.message || '@L["Invalid or expired promo code."]';
                        feedback.className = 'form-text small mt-1 text-danger';
                        feedback.classList.remove('d-none');
                    }
                    if (clearBtn) clearBtn.classList.add('d-none');
                }
            } catch (err) {
                if (feedback) {
                    feedback.textContent = '@L["Network error validating promo code."]';
                    feedback.className = 'form-text small mt-1 text-danger';
                    feedback.classList.remove('d-none');
                }
            }

            recalculateGodownSummary();
        }

        function clearGodownPromoCode() {
            const promoInput = document.getElementById('godownPromoCodeInput');
            const feedback = document.getElementById('godownPromoFeedbackMsg');
            const clearBtn = document.getElementById('godownClearPromoBtn');

            if (promoInput) promoInput.value = '';
            if (feedback) feedback.classList.add('d-none');
            if (clearBtn) clearBtn.classList.add('d-none');

            currentGodownDiscount = 0;
            currentGodownPromo = '';
            currentGodownPointsUsed = 0;
            document.getElementById('godownHiddenAppliedPromoCode').value = '';
            document.getElementById('godownHiddenPointsUsed').value = 0;

            recalculateGodownSummary();
        }

        function updateRemainingCapacity(val) {
            const max = Number(document.getElementById('maxAvailableCapacity')?.value || 0);
            const req = Number(val || 0);
            const remaining = max - req;
            const remainingSpan = document.getElementById('remainingCapacityNumber');
            const errorMsg = document.getElementById('capacityErrorMsg');
            const submitBtn = document.getElementById('submitBookingBtn');

            if (req > max || req <= 0) {
                if (errorMsg) errorMsg.classList.remove('d-none');
                if (submitBtn) submitBtn.disabled = true;
                if (remainingSpan) remainingSpan.innerText = '0';
            } else {
                if (errorMsg) errorMsg.classList.add('d-none');
                if (submitBtn) submitBtn.disabled = false;
                if (remainingSpan) remainingSpan.innerText = remaining.toLocaleString();
            }

            recalculateGodownSummary();
        }

        document.getElementById('startDateInput')?.addEventListener('change', recalculateGodownSummary);
        document.getElementById('endDateInput')?.addEventListener('change', recalculateGodownSummary);
        document.addEventListener('DOMContentLoaded', recalculateGodownSummary);

        // Intercept submit: show a confirmation modal with a booking summary before posting
        document.getElementById('godownBookingForm')?.addEventListener('submit', function (e) {
            e.preventDefault();
            const form = this;
            if (!form.reportValidity()) return;
            if (!@(User.Identity?.IsAuthenticated == true ? "true" : "false")) {
                window.location.href = '@Url.Action("Login", "Account", new { returnUrl = Url.Action("Details", "Godown", new { id = Model.Id }) })';
                return;
            }

            const capacity = document.getElementById('requestedCapacityInput').value;
            const start = document.getElementById('startDateInput').value;
            const end = document.getElementById('endDateInput').value;

            if (end <= start || rangeHitsUnavailableDate(start, end)) {
                KrishiModal.confirm({
                    title: '@L["Invalid Dates"]',
                    body: '@L["End Date must be after Start Date and not overlap booked dates."]',
                    confirmText: '@L["Close"]'
                });
                return;
            }

            KrishiModal.confirm({
                title: '@L["Confirm Storage Booking"]',
                body: `<ul class="list-unstyled mb-0 d-flex flex-column gap-2 small">
                           <li><i class="bi bi-building text-success me-2"></i><strong>@L["Godown"]:</strong> @Model.Name</li>
                           <li><i class="bi bi-box-seam text-success me-2"></i><strong>@L["Capacity:"]</strong> @L["{0} Tons", "${capacity}"]</li>
                           <li><i class="bi bi-calendar-range text-success me-2"></i><strong>@L["Duration:"]</strong> ${start} → ${end}</li>
                       </ul>`,
                confirmText: '@L["Confirm Booking"]',
                onConfirm: function () { form.submit(); }
            });
        });

        // -------------------------------------------------------------------------
        // LEAFLET MAP DISPLAY (GODOWN)
        // -------------------------------------------------------------------------
        function copyCoordinates(lat, lng) {
            const text = `${lat}, ${lng}`;
            navigator.clipboard.writeText(text).then(() => {
                if (window.KrishiToast) {
                    KrishiToast.show('@L["Coordinates copied to clipboard!"]', { iconClass: 'bi-clipboard-check-fill text-success' });
                }
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            const mapEl = document.getElementById('godownDetailMap');
            if (!mapEl) return;

            const lat = @(Model.Latitude.HasValue ? Model.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "25.6279");
            const lng = @(Model.Longitude.HasValue ? Model.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "88.6332");

            const map = L.map('godownDetailMap', {
                scrollWheelZoom: false
            }).setView([lat, lng], 13);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
            }).addTo(map);

            const godownIcon = L.divIcon({
                className: 'custom-leaflet-marker',
                html: `<div class="custom-godown-pin"><i class="bi bi-building"></i></div>`,
                iconSize: [34, 34],
                iconAnchor: [17, 34],
                popupAnchor: [0, -34]
            });

            const marker = L.marker([lat, lng], { icon: godownIcon }).addTo(map);
            marker.bindPopup(`
                <div class="p-1">
                    <h6 class="fw-bold text-dark mb-1">@Model.Name</h6>
                    <p class="small text-muted mb-1"><i class="bi bi-geo-alt text-primary me-1"></i>@Model.Location</p>
                    <div class="d-flex align-items-center justify-content-between gap-2 mt-2">
                        <span class="badge bg-primary-subtle text-primary fw-bold">@Model.PricePerTonPerMonth</span>
                        <a href="@Model.GoogleMapsUrl" target="_blank" class="btn btn-xs btn-outline-primary rounded-pill px-2 py-0.5 small">@L["Directions"]</a>
                    </div>
                </div>
            `);

            setTimeout(() => { map.invalidateSize(); }, 300);
        });
    </script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
}
