@model KrishiLink.Models.ViewModels.BookingHistoryViewModel
@{
    ViewData["Title"] = "Booking & Rental History";
    var hasActiveFilters = Model.StatusFilter != "all" || Model.DateFrom.HasValue || Model.DateTo.HasValue || !string.IsNullOrWhiteSpace(Model.SearchTerm);
}

<!-- Page Header & Overview -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4 pb-3 border-bottom">
    <div>
        <h2 class="fw-bold mb-1" style="color: var(--krishi-primary);">
            <i class="bi bi-calendar2-check-fill text-success me-2"></i>Booking &amp; Rental History
        </h2>
        <p class="text-muted mb-0">
            Track, review, and manage all your past and current equipment rentals and godown storage bookings.
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Equipment" asp-action="Index" class="btn btn-outline-success btn-sm rounded-pill px-3 py-2 fw-semibold">
            <i class="bi bi-gear-wide-connected me-1"></i> Rent Equipment
        </a>
        <a asp-controller="Godown" asp-action="Index" class="btn btn-krishi-primary btn-sm rounded-pill px-3 py-2 fw-semibold">
            <i class="bi bi-building me-1"></i> Book Storage
        </a>
    </div>
</div>

<!-- Tabs Navigation: All | Equipment Rentals | Godown Bookings -->
<div class="card krishi-card border-0 shadow-sm rounded-4 p-2.5 mb-4">
    <ul class="nav nav-pills krishi-nav-pills d-flex gap-1" id="bookingTypeTabs" role="tablist">
        <li class="nav-item flex-fill text-center" role="presentation">
            <a class="nav-link @(Model.ActiveTab == "all" ? "active" : "") d-flex align-items-center justify-content-center gap-2" 
               href="@Url.Action("Index", "Bookings", new { tab = "all" })">
                <i class="bi bi-collection"></i>
                <span>All Bookings</span>
                <span class="badge @(Model.ActiveTab == "all" ? "bg-white text-success" : "bg-light text-muted border") rounded-pill">@Model.TotalAllCount</span>
            </a>
        </li>
        <li class="nav-item flex-fill text-center" role="presentation">
            <a class="nav-link @(Model.ActiveTab == "equipment" ? "active" : "") d-flex align-items-center justify-content-center gap-2" 
               href="@Url.Action("Index", "Bookings", new { tab = "equipment" })">
                <i class="bi bi-truck"></i>
                <span>Equipment Rentals</span>
                <span class="badge @(Model.ActiveTab == "equipment" ? "bg-white text-success" : "bg-light text-muted border") rounded-pill">@Model.EquipmentCount</span>
            </a>
        </li>
        <li class="nav-item flex-fill text-center" role="presentation">
            <a class="nav-link @(Model.ActiveTab == "godown" ? "active" : "") d-flex align-items-center justify-content-center gap-2" 
               href="@Url.Action("Index", "Bookings", new { tab = "godown" })">
                <i class="bi bi-building"></i>
                <span>Godown Bookings</span>
                <span class="badge @(Model.ActiveTab == "godown" ? "bg-white text-success" : "bg-light text-muted border") rounded-pill">@Model.GodownCount</span>
            </a>
        </li>
    </ul>
</div>

<!-- Filter Row: Status Filter, Date Range & Search -->
<div class="card krishi-card border-0 shadow-sm rounded-4 p-3 mb-4">
    <form method="get" asp-controller="Bookings" asp-action="Index" id="bookingsFilterForm">
        <input type="hidden" name="tab" value="@Model.ActiveTab" />
        
        <div class="row g-2 align-items-center">
            
            <!-- Search Query -->
            <div class="col-12 col-md-4 col-xl-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0 text-muted ps-2.5">
                        <i class="bi bi-search text-success"></i>
                    </span>
                    <input type="text" class="form-control border-start-0 py-2" name="searchTerm" 
                           value="@Model.SearchTerm" placeholder="Search by name, code, owner, or area..." />
                    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                    {
                        <a href="@Url.Action("Index", "Bookings", new { tab = Model.ActiveTab })" 
                           class="input-group-text bg-light border-start-0 text-muted text-decoration-none" title="Clear Search">
                            <i class="bi bi-x"></i>
                        </a>
                    }
                </div>
            </div>

            <!-- Status Filter -->
            <div class="col-6 col-md-3 col-xl-3">
                <select class="form-select form-select-sm py-2" name="status" onchange="this.form.submit()">
                    <option value="all" selected="@(Model.StatusFilter == "all" ? "selected" : null)">All Statuses</option>
                    <option value="pending" selected="@(Model.StatusFilter == "pending" ? "selected" : null)">Pending Approval (@Model.PendingCount)</option>
                    <option value="accepted" selected="@(Model.StatusFilter == "accepted" ? "selected" : null)">Accepted / Active (@Model.AcceptedCount)</option>
                    <option value="completed" selected="@(Model.StatusFilter == "completed" ? "selected" : null)">Completed (@Model.CompletedCount)</option>
                    <option value="rejected" selected="@(Model.StatusFilter == "rejected" ? "selected" : null)">Rejected (@Model.RejectedCount)</option>
                </select>
            </div>

            <!-- Date Range (From & To) -->
            <div class="col-6 col-md-3 col-xl-3">
                <div class="input-group input-group-sm">
                    <input type="date" class="form-control py-2" name="dateFrom" title="From Date"
                           value="@(Model.DateFrom.HasValue ? Model.DateFrom.Value.ToString("yyyy-MM-dd") : "")" onchange="this.form.submit()" />
                    <span class="input-group-text bg-light text-muted px-1.5">to</span>
                    <input type="date" class="form-control py-2" name="dateTo" title="To Date"
                           value="@(Model.DateTo.HasValue ? Model.DateTo.Value.ToString("yyyy-MM-dd") : "")" onchange="this.form.submit()" />
                </div>
            </div>

            <!-- Actions: Submit & Reset -->
            <div class="col-12 col-md-2 col-xl-2 text-md-end d-flex gap-1 justify-content-end">
                <button type="submit" class="btn btn-krishi-primary btn-sm py-2 px-3 fw-semibold flex-grow-1 flex-md-grow-0">
                    Filter
                </button>
                @if (hasActiveFilters)
                {
                    <a href="@Url.Action("Index", "Bookings", new { tab = Model.ActiveTab })" class="btn btn-outline-secondary btn-sm py-2 px-2.5" title="Reset Filters">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                }
            </div>

        </div>
    </form>
</div>

<!-- =========================================================================
     BOOKINGS LIST / TABLE
     ========================================================================= -->
@if (Model.Bookings.Any())
{
    <div class="card krishi-card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        
        <!-- Desktop Table View (>= lg) -->
        <div class="table-responsive d-none d-lg-block">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color: var(--krishi-primary-light);">
                    <tr>
                        <th class="ps-4 py-3 text-uppercase small fw-bold text-muted" style="letter-spacing: 0.04em;">Booking Item</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted" style="letter-spacing: 0.04em;">Type</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted" style="letter-spacing: 0.04em;">Dates &amp; Duration</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted" style="letter-spacing: 0.04em;">Amount</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted" style="letter-spacing: 0.04em;">Status</th>
                        <th class="pe-4 py-3 text-end text-uppercase small fw-bold text-muted" style="letter-spacing: 0.04em;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.Bookings)
                    {
                        var collapseId = $"collapseDetail_{b.Id}";
                        <tr class="booking-row" style="cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                            
                            <!-- Item Image & Info -->
                            <td class="ps-4 py-3">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@b.ImageUrl" alt="@b.ItemName" class="rounded-3 object-fit-cover shadow-sm border" style="width: 58px; height: 50px;" />
                                    <div>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="fw-bold text-dark mb-0">@b.ItemName</span>
                                        </div>
                                        <div class="small text-muted d-flex align-items-center gap-2 mt-0.5">
                                            <span class="badge bg-light text-muted border py-0.5 px-1.5" style="font-size: 0.72rem;">@b.BookingCode</span>
                                            <span><i class="bi bi-geo-alt text-success"></i> @b.Location</span>
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <!-- Type Badge -->
                            <td class="py-3">
                                @if (b.BookingType == "Equipment")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 small fw-semibold">
                                        <i class="bi bi-truck me-1"></i> Equipment
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2.5 py-1 small fw-semibold">
                                        <i class="bi bi-building me-1"></i> Godown
                                    </span>
                                }
                            </td>

                            <!-- Dates & Duration -->
                            <td class="py-3">
                                <span class="d-block fw-semibold text-dark small">@b.DateRangeDisplay</span>
                                <span class="text-muted small">@b.QuantityDisplay (@b.TotalDays Days)</span>
                            </td>

                            <!-- Price -->
                            <td class="py-3">
                                <span class="fw-bold text-success fs-6 d-block">@b.CostDisplay</span>
                                <span class="text-muted small" style="font-size: 0.75rem;">@b.RateDescription</span>
                            </td>

                            <!-- Status Badge -->
                            <td class="py-3">
                                <partial name="_StatusBadge" model="@b.Status" />
                            </td>

                            <!-- View Details Button -->
                            <td class="pe-4 py-3 text-end">
                                <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-1">
                                    <span>Details</span>
                                    <i class="bi bi-chevron-down small"></i>
                                </button>
                            </td>

                        </tr>

                        <!-- =========================================================
                             EXPANDABLE DETAIL ROW & TIMELINE
                             ========================================================= -->
                        <tr class="p-0 border-0">
                            <td colspan="6" class="p-0 border-0">
                                <div class="collapse bg-light-subtle border-top border-bottom px-4 py-4" id="@collapseId">
                                    <div class="row g-4">
                                        
                                        <!-- Left Column: Request Details & Owner Contact -->
                                        <div class="col-12 col-md-6 border-end-md">
                                            <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                                                <i class="bi bi-file-text text-success"></i> Booking Summary &amp; Notes
                                            </h6>

                                            <div class="bg-white p-3 rounded-3 border mb-3">
                                                <div class="row g-2 small mb-2">
                                                    <div class="col-5 text-muted">Booking Reference:</div>
                                                    <div class="col-7 fw-semibold text-dark">@b.BookingCode</div>
                                                    <div class="col-5 text-muted">Requested On:</div>
                                                    <div class="col-7 text-dark">@b.RequestedAt.ToString("dd MMM yyyy, hh:mm tt")</div>
                                                    <div class="col-5 text-muted">Payment Status:</div>
                                                    <div class="col-7"><span class="badge bg-light text-dark border">@b.PaymentStatus</span></div>
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(b.FarmerNotes))
                                                {
                                                    <div class="mt-2 pt-2 border-top">
                                                        <span class="text-muted small d-block mb-1">Your Request Notes:</span>
                                                        <p class="small text-dark mb-0 fst-italic">"@b.FarmerNotes"</p>
                                                    </div>
                                                }
                                            </div>

                                            <!-- Owner Profile -->
                                            <div class="bg-white p-3 rounded-3 border d-flex justify-content-between align-items-center flex-wrap gap-2">
                                                <div class="d-flex align-items-center gap-2.5">
                                                    <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px;">
                                                        @(b.OwnerName.Length > 0 ? b.OwnerName[0].ToString() : "O")
                                                    </div>
                                                    <div>
                                                        <span class="small text-muted d-block">Facility / Asset Owner</span>
                                                        <span class="fw-bold text-dark">@b.OwnerName</span>
                                                    </div>
                                                </div>
                                                <a href="tel:@b.OwnerPhone" class="btn btn-outline-success btn-sm rounded-pill px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-1.5">
                                                    <i class="bi bi-telephone-fill"></i> @b.OwnerPhone
                                                </a>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(b.OwnerRemarks))
                                            {
                                                <div class="alert alert-success border-0 small rounded-3 mt-3 mb-0">
                                                    <strong class="text-success-emphasis d-block mb-0.5"><i class="bi bi-chat-left-dots-fill me-1"></i> Owner Remarks:</strong>
                                                    <span>@b.OwnerRemarks</span>
                                                </div>
                                            }
                                        </div>

                                        <!-- Right Column: Step-by-Step Status Timeline -->
                                        <div class="col-12 col-md-6">
                                            <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                                                <i class="bi bi-clock-history text-success"></i> Status &amp; Progress Timeline
                                            </h6>

                                            <div class="booking-timeline bg-white p-3.5 rounded-3 border">
                                                @foreach (var step in b.Timeline)
                                                {
                                                    var stepClass = step.State switch
                                                    {
                                                        "done" => "step-done",
                                                        "active" => "step-active",
                                                        "rejected" => "step-rejected",
                                                        _ => ""
                                                    };
                                                    <div class="booking-timeline-step @stepClass">
                                                        <div class="booking-timeline-node"></div>
                                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                                            <div>
                                                                <h6 class="fw-bold mb-0.5 text-dark small">@step.Title</h6>
                                                                <p class="text-muted small mb-0">@step.Description</p>
                                                            </div>
                                                            @if (!string.IsNullOrWhiteSpace(step.DateDisplay))
                                                            {
                                                                <span class="badge bg-light text-muted border small text-nowrap" style="font-size: 0.72rem;">@step.DateDisplay</span>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>

                                            <div class="mt-3 text-end">
                                                <a href="@b.ListingDetailUrl" class="btn btn-krishi-primary btn-sm rounded-pill px-3.5 py-1.5 fw-semibold">
                                                    <span>View Original Listing</span>
                                                    <i class="bi bi-arrow-right small ms-1"></i>
                                                </a>
                                            </div>

                                        </div>

                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Mobile Stacked Card View (< lg) -->
        <div class="d-lg-none p-3 d-flex flex-column gap-3">
            @foreach (var b in Model.Bookings)
            {
                var mobCollapseId = $"mobCollapseDetail_{b.Id}";
                <div class="card krishi-card border shadow-sm rounded-3 overflow-hidden p-3">
                    
                    <div class="d-flex gap-3 mb-2.5">
                        <img src="@b.ImageUrl" alt="@b.ItemName" class="rounded-3 object-fit-cover shadow-sm border flex-shrink-0" style="width: 72px; height: 60px;" />
                        <div class="flex-grow-1 min-w-0">
                            <div class="d-flex justify-content-between align-items-start gap-1">
                                <h6 class="fw-bold text-dark mb-1 text-truncate">@b.ItemName</h6>
                            </div>
                            <div class="d-flex align-items-center gap-2 small text-muted">
                                <span class="badge bg-light text-muted border">@b.BookingCode</span>
                                <span class="text-truncate"><i class="bi bi-geo-alt text-success"></i> @b.Location</span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center border-top border-bottom py-2 my-2 small">
                        <div>
                            <span class="text-muted d-block" style="font-size: 0.75rem;">Dates</span>
                            <span class="fw-semibold text-dark">@b.DateRangeDisplay</span>
                        </div>
                        <div class="text-end">
                            <span class="text-muted d-block" style="font-size: 0.75rem;">Total Rate</span>
                            <span class="fw-bold text-success">@b.CostDisplay</span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-1">
                        <partial name="_StatusBadge" model="@b.Status" />
                        <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-3 py-1.5 fw-semibold" 
                                data-bs-toggle="collapse" data-bs-target="#@mobCollapseId" aria-expanded="false">
                            <span>Details &amp; Timeline</span>
                            <i class="bi bi-chevron-down small ms-1"></i>
                        </button>
                    </div>

                    <!-- Mobile Collapse Body -->
                    <div class="collapse mt-3 pt-3 border-top" id="@mobCollapseId">
                        
                        <!-- Timeline -->
                        <h6 class="fw-bold text-dark small mb-2">Status Timeline</h6>
                        <div class="booking-timeline bg-light p-3 rounded-3 mb-3">
                            @foreach (var step in b.Timeline)
                            {
                                var stepClass = step.State switch
                                {
                                    "done" => "step-done",
                                    "active" => "step-active",
                                    "rejected" => "step-rejected",
                                    _ => ""
                                };
                                <div class="booking-timeline-step @stepClass">
                                    <div class="booking-timeline-node"></div>
                                    <h6 class="fw-bold mb-0.5 text-dark small">@step.Title</h6>
                                    <p class="text-muted small mb-0" style="font-size: 0.75rem;">@step.Description (@step.DateDisplay)</p>
                                </div>
                            }
                        </div>

                        <!-- Owner Contact -->
                        <div class="d-flex justify-content-between align-items-center p-2.5 bg-light rounded-3 mb-2">
                            <div>
                                <span class="small text-muted d-block" style="font-size: 0.72rem;">Owner</span>
                                <span class="small fw-bold text-dark">@b.OwnerName</span>
                            </div>
                            <a href="tel:@b.OwnerPhone" class="btn btn-success btn-sm rounded-pill px-2.5 py-1 text-nowrap" style="font-size: 0.75rem;">
                                <i class="bi bi-telephone"></i> Call Owner
                            </a>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(b.FarmerNotes))
                        {
                            <div class="p-2.5 bg-light rounded-3 mb-2">
                                <span class="small text-muted d-block" style="font-size: 0.72rem;">Your Note:</span>
                                <p class="small text-dark mb-0">"@b.FarmerNotes"</p>
                            </div>
                        }

                        <a href="@b.ListingDetailUrl" class="btn btn-krishi-primary btn-sm w-100 rounded-pill py-2 fw-semibold mt-2">
                            View Original Listing
                        </a>
                    </div>

                </div>
            }
        </div>

    </div>
}
else
{
    <!-- Empty State -->
    <div class="card krishi-card border-0 shadow-sm rounded-4 p-5 text-center my-4">
        <div class="mb-3">
            <div class="d-inline-flex p-3.5 rounded-circle bg-light text-muted mb-2">
                <i class="bi bi-calendar2-x text-success" style="font-size: 3rem;"></i>
            </div>
        </div>
        
        @if (Model.ActiveTab == "equipment")
        {
            <h4 class="fw-bold text-dark mb-2">No equipment rentals found</h4>
            <p class="text-secondary mb-4 mx-auto" style="max-width: 440px;">
                You haven't requested any machinery rentals yet. Explore tractors, harvesters, and tillers available in your area.
            </p>
            <div>
                <a asp-controller="Equipment" asp-action="Index" class="btn btn-krishi-primary rounded-pill px-4 py-2.5 fw-semibold shadow-sm">
                    <i class="bi bi-gear-wide-connected me-1.5"></i> Browse Equipment
                </a>
            </div>
        }
        else if (Model.ActiveTab == "godown")
        {
            <h4 class="fw-bold text-dark mb-2">No godown bookings found</h4>
            <p class="text-secondary mb-4 mx-auto" style="max-width: 440px;">
                You haven't booked any crop or grain storage facilities yet. Discover nearby warehouses and cold storage rooms.
            </p>
            <div>
                <a asp-controller="Godown" asp-action="Index" class="btn btn-krishi-primary rounded-pill px-4 py-2.5 fw-semibold shadow-sm">
                    <i class="bi bi-building me-1.5"></i> Browse Godowns
                </a>
            </div>
        }
        else
        {
            <h4 class="fw-bold text-dark mb-2">No bookings match your filters</h4>
            <p class="text-secondary mb-4 mx-auto" style="max-width: 440px;">
                Try changing your status filter, clearing the date range, or searching with different keywords.
            </p>
            <div>
                <a asp-controller="Bookings" asp-action="Index" class="btn btn-krishi-primary rounded-pill px-4 py-2.5 fw-semibold shadow-sm">
                    <i class="bi bi-arrow-counterclockwise me-1.5"></i> Clear All Filters
                </a>
            </div>
        }
    </div>
}
