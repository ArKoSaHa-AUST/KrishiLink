@model KrishiLink.Models.ViewModels.BookingHistoryViewModel
@{
    ViewData["Title"] = L["Booking & Rental History"];
    var hasActiveFilters = Model.StatusFilter != "all" || Model.DateFrom.HasValue || Model.DateTo.HasValue || !string.IsNullOrWhiteSpace(Model.SearchTerm);
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
}

<!-- Page Header & Overview -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4 pb-3 border-bottom">
    <div>
        <h2 class="fw-bold mb-1" style="color: var(--krishi-primary);">
            <i class="bi bi-calendar2-check-fill text-success me-2"></i>@L["Booking & Rental History"]
        </h2>
        <p class="text-muted mb-0">
            @L["Track, review, and manage all your past and current equipment rentals and godown storage bookings."]
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Equipment" asp-action="Index" class="btn btn-outline-success btn-sm rounded-pill px-3 py-2 fw-semibold">
            <i class="bi bi-gear-wide-connected me-1"></i> @L["Rent Equipment"]
        </a>
        <a asp-controller="Godown" asp-action="Index" class="btn btn-krishi-primary btn-sm rounded-pill px-3 py-2 fw-semibold">
            <i class="bi bi-building me-1"></i> @L["Book Storage"]
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill text-success"></i><span class="small">@TempData["SuccessMessage"]</span></div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2"><i class="bi bi-exclamation-triangle-fill"></i><span class="small">@TempData["ErrorMessage"]</span></div>
}

<!-- Tabs Navigation: All | Equipment Rentals | Godown Bookings -->
<div class="card krishi-card border-0 shadow-sm rounded-4 p-2.5 mb-4">
    <ul class="nav nav-pills krishi-nav-pills d-flex gap-1" id="bookingTypeTabs" role="tablist">
        <li class="nav-item flex-fill text-center" role="presentation">
            <a class="nav-link @(Model.ActiveTab == "all" ? "active" : "") d-flex align-items-center justify-content-center gap-2" 
               href="@Url.Action("Index", "Bookings", new { tab = "all" })">
                <i class="bi bi-collection"></i>
                <span>@L["All Bookings"]</span>
                <span class="badge @(Model.ActiveTab == "all" ? "bg-white text-success" : "bg-light text-muted border") rounded-pill">@Model.TotalAllCount</span>
            </a>
        </li>
        <li class="nav-item flex-fill text-center" role="presentation">
            <a class="nav-link @(Model.ActiveTab == "equipment" ? "active" : "") d-flex align-items-center justify-content-center gap-2" 
               href="@Url.Action("Index", "Bookings", new { tab = "equipment" })">
                <i class="bi bi-truck"></i>
                <span>@L["Equipment Rentals"]</span>
                <span class="badge @(Model.ActiveTab == "equipment" ? "bg-white text-success" : "bg-light text-muted border") rounded-pill">@Model.EquipmentCount</span>
            </a>
        </li>
        <li class="nav-item flex-fill text-center" role="presentation">
            <a class="nav-link @(Model.ActiveTab == "godown" ? "active" : "") d-flex align-items-center justify-content-center gap-2" 
               href="@Url.Action("Index", "Bookings", new { tab = "godown" })">
                <i class="bi bi-building"></i>
                <span>@L["Godown Bookings"]</span>
                <span class="badge @(Model.ActiveTab == "godown" ? "bg-white text-success" : "bg-light text-muted border") rounded-pill">@Model.GodownCount</span>
            </a>
        </li>
    </ul>
</div>

<!-- Filter Row: Status Filter, Date Range & Search -->
<div class="card krishi-card border-0 shadow-sm rounded-4 p-3 mb-4">
    <form method="get" asp-controller="Bookings" asp-action="Index" id="bookingsFilterForm">
        <input type="hidden" name="tab" value="@Model.ActiveTab" />
        
        <div class="row g-2 align-items-center">
            
            <!-- Search Query -->
            <div class="col-12 col-md-4 col-xl-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0 text-muted ps-2.5">
                        <i class="bi bi-search text-success"></i>
                    </span>
                    <input type="text" class="form-control border-start-0 py-2" name="searchTerm" 
                           value="@Model.SearchTerm" placeholder="@L["Search by name, code, owner, or area..."]" />
                    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                    {
                        <a href="@Url.Action("Index", "Bookings", new { tab = Model.ActiveTab })" 
                           class="input-group-text bg-light border-start-0 text-muted text-decoration-none" title="@L["Clear Search"]">
                            <i class="bi bi-x"></i>
                        </a>
                    }
                </div>
            </div>

            <!-- Status Filter -->
            <div class="col-6 col-md-3 col-xl-3">
                <select class="form-select form-select-sm py-2" name="status" onchange="this.form.submit()">
                    <option value="all" selected="@(Model.StatusFilter == "all" ? "selected" : null)">@L["All Statuses"]</option>
                    <option value="pending" selected="@(Model.StatusFilter == "pending" ? "selected" : null)">@L["Pending Approval ({0})", Model.PendingCount]</option>
                    <option value="accepted" selected="@(Model.StatusFilter == "accepted" ? "selected" : null)">@L["Accepted / Awaiting Payment ({0})", Model.AcceptedCount]</option>
                    <option value="paid" selected="@(Model.StatusFilter == "paid" ? "selected" : null)">@L["Paid / Confirmed ({0})", Model.PaidCount]</option>
                    <option value="completed" selected="@(Model.StatusFilter == "completed" ? "selected" : null)">@L["Completed ({0})", Model.CompletedCount]</option>
                    <option value="rejected" selected="@(Model.StatusFilter == "rejected" ? "selected" : null)">@L["Rejected ({0})", Model.RejectedCount]</option>
                    <option value="cancelled" selected="@(Model.StatusFilter == "cancelled" ? "selected" : null)">@L["Cancelled ({0})", Model.CancelledCount]</option>
                </select>
            </div>

            <!-- Date Range (From & To) -->
            <div class="col-6 col-md-3 col-xl-3">
                <div class="input-group input-group-sm">
                    <input type="date" class="form-control py-2" name="dateFrom" title="@L["From Date"]"
                           value="@(Model.DateFrom.HasValue ? Model.DateFrom.Value.ToString("yyyy-MM-dd") : "")" onchange="this.form.submit()" />
                    <span class="input-group-text bg-light text-muted px-1.5">@L["To"]</span>
                    <input type="date" class="form-control py-2" name="dateTo" title="@L["To Date"]"
                           value="@(Model.DateTo.HasValue ? Model.DateTo.Value.ToString("yyyy-MM-dd") : "")" onchange="this.form.submit()" />
                </div>
            </div>

            <!-- Actions: Submit & Reset -->
            <div class="col-12 col-md-2 col-xl-2 text-md-end d-flex gap-1 justify-content-end">
                <button type="submit" class="btn btn-krishi-primary btn-sm py-2 px-3 fw-semibold flex-grow-1 flex-md-grow-0">
                    @L["Filter"]
                </button>
                @if (hasActiveFilters)
                {
                    <a href="@Url.Action("Index", "Bookings", new { tab = Model.ActiveTab })" class="btn btn-outline-secondary btn-sm py-2 px-2.5" title="@L["Reset Filters"]">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                }
            </div>

        </div>
    </form>
</div>

<!-- =========================================================================
     BOOKINGS LIST / TABLE
     ========================================================================= -->
@if (Model.Bookings.Any())
{
    <div class="card krishi-card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        
        <!-- Desktop Table View (>= lg) -->
        <div class="table-responsive d-none d-lg-block">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color: var(--krishi-primary-light);">
                    <tr>
                        <th class="ps-4 py-3 text-uppercase small fw-bold text-muted" style="letter-spacing: 0.04em;">@L["Booking Item"]</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted" style="letter-spacing: 0.04em;">@L["Type"]</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted" style="letter-spacing: 0.04em;">@L["Dates & Duration"]</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted" style="letter-spacing: 0.04em;">@L["Amount"]</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted" style="letter-spacing: 0.04em;">@L["Status"]</th>
                        <th class="pe-4 py-3 text-end text-uppercase small fw-bold text-muted" style="letter-spacing: 0.04em;">@L["Action"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.Bookings)
                    {
                        var collapseId = $"collapseDetail_{b.BookingCode}";
                        <tr class="booking-row" style="cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                            
                            <!-- Item Image & Info -->
                            <td class="ps-4 py-3">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@b.ImageUrl" alt="@b.ItemName" class="rounded-3 object-fit-cover shadow-sm border" style="width: 58px; height: 50px;" />
                                    <div>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="fw-bold text-dark mb-0">@b.ItemName</span>
                                            @if (b.ModificationCount > 0)
                                            {
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle py-0.5 px-1.5" style="font-size: 0.72rem;" title="@b.PreviousDetails">
                                                    <i class="bi bi-pencil-square me-1"></i>@L["Changed ×{0}", b.ModificationCount]
                                                </span>
                                            }
                                        </div>
                                        <div class="small text-muted d-flex align-items-center gap-2 mt-0.5">
                                            <span class="badge bg-light text-muted border py-0.5 px-1.5" style="font-size: 0.72rem;">@b.BookingCode</span>
                                            <span><i class="bi bi-geo-alt text-success"></i> @b.Location</span>
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <!-- Type Badge -->
                            <td class="py-3">
                                @if (b.BookingType == "Equipment")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 small fw-semibold">
                                        <i class="bi bi-truck me-1"></i> @L["Equipment"]
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2.5 py-1 small fw-semibold">
                                        <i class="bi bi-building me-1"></i> @L["Godown"]
                                    </span>
                                }
                            </td>

                            <!-- Dates & Duration -->
                            <td class="py-3">
                                <span class="d-block fw-semibold text-dark small">@b.DateRangeDisplay</span>
                                <span class="text-muted small">@L[b.QuantityDisplay] (@L["{0} Days", b.TotalDays])</span>
                            </td>

                            <!-- Price -->
                            <td class="py-3">
                                <span class="fw-bold text-success fs-6 d-block">@b.CostDisplay</span>
                                <span class="text-muted small" style="font-size: 0.75rem;">@L[b.RateDescription]</span>
                            </td>

                            <!-- Status Badge -->
                            <td class="py-3">
                                <partial name="_StatusBadge" model="@b.Status" />
                            </td>

                            <!-- View Details Button -->
                            <td class="pe-4 py-3 text-end">
                                <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-1">
                                    <span>@L["Details"]</span>
                                    <i class="bi bi-chevron-down small"></i>
                                </button>
                            </td>

                        </tr>

                        <!-- =========================================================
                             EXPANDABLE DETAIL ROW & TIMELINE
                             ========================================================= -->
                        <tr class="p-0 border-0">
                            <td colspan="6" class="p-0 border-0">
                                <div class="collapse bg-light-subtle border-top border-bottom px-4 py-4" id="@collapseId">
                                    <div class="row g-4">
                                        
                                        <!-- Left Column: Request Details & Owner Contact -->
                                        <div class="col-12 col-md-6 border-end-md">
                                            <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                                                <i class="bi bi-file-text text-success"></i> @L["Booking Summary & Notes"]
                                            </h6>

                                            <div class="bg-white p-3 rounded-3 border mb-3">
                                                <div class="row g-2 small mb-2">
                                                    <div class="col-5 text-muted">@L["Booking Reference:"]</div>
                                                    <div class="col-7 fw-semibold text-dark">@b.BookingCode</div>
                                                    @if (b.ModificationCount > 0 && !string.IsNullOrWhiteSpace(b.PreviousDetails))
                                                    {
                                                        <div class="col-5 text-muted">@L["Previously:"]</div>
                                                        <div class="col-7 text-muted fst-italic">@b.PreviousDetails</div>
                                                    }
                                                    <div class="col-5 text-muted">@L["Requested On:"]</div>
                                                    <div class="col-7 text-dark">@b.RequestedAt.ToString("dd MMM yyyy, hh:mm tt")</div>
                                                    <div class="col-5 text-muted">@L["Payment Status:"]</div>
                                                    <div class="col-7">
                                                        <span class="badge @(b.Status == "Paid" || b.Status == "Completed" ? "bg-success-subtle text-success-emphasis border border-success-subtle" : "bg-light text-dark border")">@L[b.PaymentStatus]</span>
                                                        @if (b.PaymentReference is not null)
                                                        {
                                                            <code class="small d-block mt-1">@b.PaymentReference</code>
                                                        }
                                                    </div>
                                                </div>
                                            @if (!string.IsNullOrWhiteSpace(b.FarmerNotes))
                                                {
                                                    <div class="mt-2 pt-2 border-top">
                                                        <span class="text-muted small d-block mb-1">@L["Your Request Notes:"]</span>
                                                        <p class="small text-dark mb-0 fst-italic">"@b.FarmerNotes"</p>
                                                    </div>
                                                }

                                                @if (b.HasReview)
                                                {
                                                    <div class="mt-2 pt-2 border-top">
                                                        <div class="d-flex align-items-center gap-1.5 text-warning small fw-bold mb-1">
                                                            <i class="bi bi-star-fill"></i>
                                                            <span>★ @(b.ReviewRating ?? 0)/5 @L["Your Review:"]</span>
                                                        </div>
                                                        @if (!string.IsNullOrWhiteSpace(b.ReviewComment))
                                                        {
                                                            <p class="small text-secondary mb-0 fst-italic">"@b.ReviewComment"</p>
                                                        }
                                                    </div>
                                                }
                                            </div>

                                            <!-- Owner Profile -->
                                            <div class="bg-white p-3 rounded-3 border d-flex justify-content-between align-items-center flex-wrap gap-2">
                                                <div class="d-flex align-items-center gap-2.5">
                                                    <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px;">
                                                        @(b.OwnerName.Length > 0 ? b.OwnerName[0].ToString().ToUpperInvariant() : "O")
                                                    </div>
                                                    <div>
                                                        <span class="small text-muted d-block">@L["Facility / Asset Owner"]</span>
                                                        <span class="fw-bold text-dark">@b.OwnerName</span>
                                                    </div>
                                                </div>
                                                <a href="tel:@b.OwnerPhone" class="btn btn-outline-success btn-sm rounded-pill px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-1.5">
                                                    <i class="bi bi-telephone-fill"></i> @b.OwnerPhone
                                                </a>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(b.OwnerRemarks))
                                            {
                                                <div class="alert alert-success border-0 small rounded-3 mt-3 mb-0">
                                                    <strong class="text-success-emphasis d-block mb-0.5"><i class="bi bi-chat-left-dots-fill me-1"></i> @L["Owner Remarks:"]</strong>
                                                    <span>@b.OwnerRemarks</span>
                                                </div>
                                            }
                                        </div>

                                        <!-- Right Column: Step-by-Step Status Timeline -->
                                        <div class="col-12 col-md-6">
                                            <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                                                <i class="bi bi-clock-history text-success"></i> @L["Status & Progress Timeline"]
                                            </h6>

                                            <div class="booking-timeline bg-white p-3.5 rounded-3 border">
                                                @foreach (var step in b.Timeline)
                                                {
                                                    var stepClass = step.State switch
                                                    {
                                                        "done" => "step-done",
                                                        "active" => "step-active",
                                                        "rejected" => "step-rejected",
                                                        _ => ""
                                                    };
                                                    <div class="booking-timeline-step @stepClass">
                                                        <div class="booking-timeline-node"></div>
                                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                                            <div>
                                                                <h6 class="fw-bold mb-0.5 text-dark small">@L[step.Title]</h6>
                                                                <p class="text-muted small mb-0">@L[step.Description]</p>
                                                            </div>
                                                            @if (!string.IsNullOrWhiteSpace(step.DateDisplay))
                                                            {
                                                                <span class="badge bg-light text-muted border small text-nowrap" style="font-size: 0.72rem;">@step.DateDisplay</span>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>

                                            <div class="mt-3 d-flex justify-content-end align-items-center gap-2 flex-wrap">
                                                @if (b.Status == "Completed")
                                                {
                                                    if (b.HasReview)
                                                    {
                                                        <div id="reviewActionContainer_@(b.BookingType)_@(b.Id)" class="d-inline-flex align-items-center gap-1.5 px-3 py-1.5 rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle small fw-bold">
                                                            <i class="bi bi-star-fill text-warning"></i>
                                                            <span>★ @(b.ReviewRating ?? 0)/5 @L["Reviewed"]</span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div id="reviewActionContainer_@(b.BookingType)_@(b.Id)">
                                                            <button type="button" class="btn btn-warning btn-sm rounded-pill px-3.5 py-1.5 fw-bold text-dark shadow-sm d-inline-flex align-items-center gap-1.5"
                                                                    onclick="openReviewModal('@b.BookingType', @b.Id, '@b.ItemName.Replace("'", "\\'")', '@b.BookingCode', '@b.OwnerName.Replace("'", "\\'")', '@b.ImageUrl')">
                                                                <i class="bi bi-star-fill text-dark"></i>
                                                                <span>@L["Rate & Review"]</span>
                                                            </button>
                                                        </div>
                                                    }
                                                }

                                                <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-3.5 py-1.5 fw-semibold d-inline-flex align-items-center gap-1.5 shadow-xs" onclick="openBookingQrModal('@b.BookingType', @b.Id)">
                                                    <i class="bi bi-qr-code"></i>
                                                    <span>@L["Show QR Code"]</span>
                                                </button>
                                                <a asp-action="Confirmation" asp-route-type="@b.BookingType" asp-route-id="@b.Id" class="btn btn-outline-secondary btn-sm rounded-pill px-3.5 py-1.5 fw-semibold d-inline-flex align-items-center gap-1.5">
                                                    <i class="bi bi-ticket-perforated-fill text-success"></i>
                                                    <span>@L["View Pass & Voucher"]</span>
                                                </a>
                                                @if (b.CanModify)
                                                {
                                                    <button type="button" class="btn btn-outline-warning btn-sm rounded-pill px-3.5 py-1.5 fw-semibold d-inline-flex align-items-center gap-1.5"
                                                            onclick="openModifyModal('@b.BookingType', @b.Id, '@b.StartDate.ToString("yyyy-MM-dd")', '@b.EndDate.ToString("yyyy-MM-dd")', @b.Units, @b.StorageTons, @b.MaxUnits, @b.MinDays, '@b.ItemName.Replace("'", "\\'")')">
                                                        <i class="bi bi-pencil-square"></i>
                                                        <span>@L["Change dates"]</span>
                                                    </button>
                                                }
                                                else if (b.Status == "Paid")
                                                {
                                                    <span data-bs-toggle="tooltip" data-bs-placement="top" title="@L["Paid bookings cannot be modified (escrow payment is locked). Cancel and refund instead."]">
                                                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3.5 py-1.5 fw-semibold d-inline-flex align-items-center gap-1.5 opacity-50" disabled>
                                                            <i class="bi bi-pencil-square"></i>
                                                            <span>@L["Change dates"]</span>
                                                        </button>
                                                    </span>
                                                }
                                                @if (b.CanPay)
                                                {
                                                    <a href="@b.PayUrl" class="btn btn-krishi-primary btn-sm rounded-pill px-3.5 py-1.5 fw-bold shadow-sm">
                                                        <i class="bi bi-credit-card-fill me-1"></i>@L["Pay now {0}", b.CostDisplay]
                                                    </a>
                                                }
                                                @if (b.CanCancel)
                                                {
                                                    <form asp-action="Cancel" method="post" onsubmit="return confirm('@(b.Status == "Paid" ? L["Cancel this booking? Your payment will be refunded and the dates released."] : L["Cancel this booking? The dates will be released to other farmers."])');">
                                                        <input type="hidden" name="type" value="@b.BookingType" />
                                                        <input type="hidden" name="id" value="@b.Id" />
                                                        <input type="hidden" name="returnUrl" value="@currentUrl" />
                                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3.5 py-1.5 fw-semibold">
                                                            <i class="bi bi-x-circle me-1"></i>@(b.Status == "Paid" ? L["Cancel & Refund"] : L["Cancel Booking"])
                                                        </button>
                                                    </form>
                                                }
                                                <a href="@b.ListingDetailUrl" class="btn @(b.CanPay ? "btn-outline-success" : "btn-krishi-primary") btn-sm rounded-pill px-3.5 py-1.5 fw-semibold">
                                                    <span>@L["View Listing"]</span>
                                                    <i class="bi bi-arrow-right small ms-1"></i>
                                                </a>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Mobile Stacked Card View (< lg) -->
        <div class="d-lg-none p-3 d-flex flex-column gap-3">
            @foreach (var b in Model.Bookings)
            {
                var mobCollapseId = $"mobCollapseDetail_{b.BookingCode}";
                <div class="card krishi-card border shadow-sm rounded-3 overflow-hidden p-3">
                    
                    <div class="d-flex gap-3 mb-2.5">
                        <img src="@b.ImageUrl" alt="@b.ItemName" class="rounded-3 object-fit-cover shadow-sm border flex-shrink-0" style="width: 72px; height: 60px;" />
                        <div class="flex-grow-1 min-w-0">
                            <div class="d-flex justify-content-between align-items-start gap-1">
                                <h6 class="fw-bold text-dark mb-1 text-truncate">@b.ItemName</h6>
                                @if (b.ModificationCount > 0)
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle py-0.5 px-1.5" style="font-size: 0.7rem;" title="@b.PreviousDetails">
                                        @L["Changed ×{0}", b.ModificationCount]
                                    </span>
                                }
                            </div>
                            <div class="d-flex align-items-center gap-2 small text-muted">
                                <span class="badge bg-light text-muted border">@b.BookingCode</span>
                                <span class="text-truncate"><i class="bi bi-geo-alt text-success"></i> @b.Location</span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center border-top border-bottom py-2 my-2 small">
                        <div>
                            <span class="text-muted d-block" style="font-size: 0.75rem;">@L["Dates"]</span>
                            <span class="fw-semibold text-dark">@b.DateRangeDisplay</span>
                        </div>
                        <div class="text-end">
                            <span class="text-muted d-block" style="font-size: 0.75rem;">@L["Total Rate"]</span>
                            <span class="fw-bold text-success">@b.CostDisplay</span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-1">
                        <partial name="_StatusBadge" model="@b.Status" />
                        <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-3 py-1.5 fw-semibold" 
                                data-bs-toggle="collapse" data-bs-target="#@mobCollapseId" aria-expanded="false">
                            <span>@L["Details & Timeline"]</span>
                            <i class="bi bi-chevron-down small ms-1"></i>
                        </button>
                    </div>

                    <!-- Mobile Collapse Body -->
                    <div class="collapse mt-3 pt-3 border-top" id="@mobCollapseId">
                        
                        <!-- Timeline -->
                        <h6 class="fw-bold text-dark small mb-2">@L["Status Timeline"]</h6>
                        <div class="booking-timeline bg-light p-3 rounded-3 mb-3">
                            @foreach (var step in b.Timeline)
                            {
                                var stepClass = step.State switch
                                {
                                    "done" => "step-done",
                                    "active" => "step-active",
                                    "rejected" => "step-rejected",
                                    _ => ""
                                };
                                <div class="booking-timeline-step @stepClass">
                                    <div class="booking-timeline-node"></div>
                                    <h6 class="fw-bold mb-0.5 text-dark small">@L[step.Title]</h6>
                                    <p class="text-muted small mb-0" style="font-size: 0.75rem;">@L[step.Description] (@step.DateDisplay)</p>
                                </div>
                            }
                        </div>

                        <!-- Owner Contact -->
                        <div class="d-flex justify-content-between align-items-center p-2.5 bg-light rounded-3 mb-2">
                            <div>
                                <span class="small text-muted d-block" style="font-size: 0.72rem;">@L["Owner"]</span>
                                <span class="small fw-bold text-dark">@b.OwnerName</span>
                            </div>
                            <a href="tel:@b.OwnerPhone" class="btn btn-success btn-sm rounded-pill px-2.5 py-1 text-nowrap" style="font-size: 0.75rem;">
                                <i class="bi bi-telephone"></i> @L["Call Owner"]
                            </a>
                        </div>

                        @if (b.ModificationCount > 0 && !string.IsNullOrWhiteSpace(b.PreviousDetails))
                        {
                            <div class="p-2.5 bg-light rounded-3 mb-2 small">
                                <span class="text-muted d-block" style="font-size: 0.72rem;">@L["Previously:"]</span>
                                <span class="text-secondary fst-italic">@b.PreviousDetails</span>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(b.FarmerNotes))
                        {
                            <div class="p-2.5 bg-light rounded-3 mb-2">
                                <span class="small text-muted d-block" style="font-size: 0.72rem;">@L["Your Note:"]</span>
                                <p class="small text-dark mb-0">"@b.FarmerNotes"</p>
                            </div>
                        }

                        @if (b.HasReview)
                        {
                            <div class="p-2.5 bg-warning-subtle border border-warning-subtle rounded-3 mb-2">
                                <div class="d-flex align-items-center gap-1.5 text-warning-emphasis small fw-bold mb-1">
                                    <i class="bi bi-star-fill text-warning"></i>
                                    <span>★ @(b.ReviewRating ?? 0)/5 @L["Your Review:"]</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(b.ReviewComment))
                                {
                                    <p class="small text-dark mb-0 fst-italic">"@b.ReviewComment"</p>
                                }
                            </div>
                        }

                        @if (b.Status == "Completed" && !b.HasReview)
                        {
                            <button type="button" class="btn btn-warning btn-sm w-100 rounded-pill py-2 fw-bold text-dark shadow-sm mb-2 d-flex align-items-center justify-content-center gap-1.5"
                                    onclick="openReviewModal('@b.BookingType', @b.Id, '@b.ItemName.Replace("'", "\\'")', '@b.BookingCode', '@b.OwnerName.Replace("'", "\\'")', '@b.ImageUrl')">
                                <i class="bi bi-star-fill text-dark"></i>
                                <span>@L["Rate & Review This Booking"]</span>
                            </button>
                        }

                        <div class="d-grid gap-2 mt-2">
                            @if (b.CanPay)
                            {
                                <a href="@b.PayUrl" class="btn btn-krishi-primary btn-sm rounded-pill py-2 fw-bold shadow-sm">
                                    <i class="bi bi-credit-card-fill me-1"></i>@L["Pay now {0}", b.CostDisplay]
                                </a>
                            }
                            <button type="button" class="btn btn-outline-success btn-sm rounded-pill py-2 fw-semibold d-flex align-items-center justify-content-center gap-1.5" onclick="openBookingQrModal('@b.BookingType', @b.Id)">
                                <i class="bi bi-qr-code"></i>
                                <span>@L["Show QR Code"]</span>
                            </button>
                            <a asp-action="Confirmation" asp-route-type="@b.BookingType" asp-route-id="@b.Id" class="btn btn-outline-secondary btn-sm rounded-pill py-2 fw-semibold d-flex align-items-center justify-content-center gap-1.5">
                                <i class="bi bi-ticket-perforated-fill text-success"></i>
                                <span>@L["View Full Voucher Pass"]</span>
                            </a>
                            @if (b.CanModify)
                            {
                                <button type="button" class="btn btn-outline-warning btn-sm rounded-pill py-2 fw-semibold d-flex align-items-center justify-content-center gap-1.5"
                                        onclick="openModifyModal('@b.BookingType', @b.Id, '@b.StartDate.ToString("yyyy-MM-dd")', '@b.EndDate.ToString("yyyy-MM-dd")', @b.Units, @b.StorageTons, @b.MaxUnits, @b.MinDays, '@b.ItemName.Replace("'", "\\'")')">
                                    <i class="bi bi-pencil-square"></i>
                                    <span>@L["Change dates"]</span>
                                </button>
                            }
                            else if (b.Status == "Paid")
                            {
                                <span class="d-block" data-bs-toggle="tooltip" data-bs-placement="top" title="@L["Paid bookings cannot be modified (escrow payment is locked). Cancel and refund instead."]">
                                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill py-2 fw-semibold d-flex align-items-center justify-content-center gap-1.5 w-100 opacity-50" disabled>
                                        <i class="bi bi-pencil-square"></i>
                                        <span>@L["Change dates"]</span>
                                    </button>
                                </span>
                            }
                            <a href="@b.ListingDetailUrl" class="btn btn-krishi-primary btn-sm rounded-pill py-2 fw-semibold">
                                @L["View Listing"]
                            </a>
                        </div>
                        @if (b.CanCancel)
                        {
                            <form asp-action="Cancel" method="post" class="mt-2" onsubmit="return confirm('@(b.Status == "Paid" ? L["Cancel this booking? Your payment will be refunded and the dates released."] : L["Cancel this booking? The dates will be released to other farmers."])');">
                                <input type="hidden" name="type" value="@b.BookingType" />
                                <input type="hidden" name="id" value="@b.Id" />
                                <input type="hidden" name="returnUrl" value="@currentUrl" />
                                <button type="submit" class="btn btn-outline-danger btn-sm w-100 rounded-pill py-2 fw-semibold"><i class="bi bi-x-circle me-1"></i>@(b.Status == "Paid" ? L["Cancel & Refund"] : L["Cancel Booking"])</button>
                            </form>
                        }
                    </div>

                </div>
            }
        </div>

    </div>
}
else
{
    <!-- Empty State -->
    <div class="card krishi-card border-0 shadow-sm rounded-4 p-5 text-center my-4">
        <div class="mb-3">
            <div class="d-inline-flex p-3.5 rounded-circle bg-light text-muted mb-2">
                <i class="bi bi-calendar2-x text-success" style="font-size: 3rem;"></i>
            </div>
        </div>
        
        @if (Model.ActiveTab == "equipment")
        {
            <h4 class="fw-bold text-dark mb-2">@L["No equipment rentals found"]</h4>
            <p class="text-secondary mb-4 mx-auto" style="max-width: 440px;">
                @L["You haven't requested any machinery rentals yet. Explore tractors, harvesters, and tillers available in your area."]
            </p>
            <div>
                <a asp-controller="Equipment" asp-action="Index" class="btn btn-krishi-primary rounded-pill px-4 py-2.5 fw-semibold shadow-sm">
                    <i class="bi bi-gear-wide-connected me-1.5"></i> @L["Browse Equipment"]
                </a>
            </div>
        }
        else if (Model.ActiveTab == "godown")
        {
            <h4 class="fw-bold text-dark mb-2">@L["No godown bookings found"]</h4>
            <p class="text-secondary mb-4 mx-auto" style="max-width: 440px;">
                @L["You haven't booked any crop or grain storage facilities yet. Discover nearby warehouses and cold storage rooms."]
            </p>
            <div>
                <a asp-controller="Godown" asp-action="Index" class="btn btn-krishi-primary rounded-pill px-4 py-2.5 fw-semibold shadow-sm">
                    <i class="bi bi-building me-1.5"></i> @L["Browse Godowns"]
                </a>
            </div>
        }
        else
        {
            <h4 class="fw-bold text-dark mb-2">@L["No bookings match your filters"]</h4>
            <p class="text-secondary mb-4 mx-auto" style="max-width: 440px;">
                @L["Try changing your status filter, clearing the date range, or searching with different keywords."]
            </p>
            <div>
                <a asp-controller="Bookings" asp-action="Index" class="btn btn-krishi-primary rounded-pill px-4 py-2.5 fw-semibold shadow-sm">
                    <i class="bi bi-arrow-counterclockwise me-1.5"></i> @L["Clear All Filters"]
                </a>
            </div>
        }
    </div>
}

<!-- =========================================================================
     QUICK QR CODE MODAL FOR MOBILE / DESKTOP
     ========================================================================= -->
<div class="modal fade" id="quickQrModal" tabindex="-1" aria-labelledby="quickQrModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
        <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
            <div class="modal-header bg-success text-white py-3 border-0">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-qr-code-scan fs-5"></i>
                    <h6 class="modal-title fw-bold mb-0" id="quickQrModalLabel">@L["Booking QR Code Pass"]</h6>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center p-4">
                <div id="modalQrLoading" class="py-4">
                    <div class="spinner-border text-success" role="status"></div>
                    <p class="text-muted small mt-2 mb-0">@L["Generating QR Pass..."]</p>
                </div>
                <div id="modalQrContent" class="d-none">
                    <div id="modalQrSvg" class="p-3 bg-light rounded-4 border d-inline-block mb-3 shadow-xs" style="max-width: 220px; max-height: 220px;"></div>
                    <h5 class="fw-bold text-dark mb-1" id="modalQrItemName"></h5>
                    <p class="font-monospace fw-bold text-success mb-1" id="modalQrCode"></p>
                    <p class="text-muted small mb-3" id="modalQrDates"></p>
                    <div class="alert alert-light border small text-start mb-3 p-2.5 rounded-3">
                        <i class="bi bi-info-circle-fill text-success me-1"></i>
                        <span>@L["Present this QR code to the owner upon pickup or delivery to quickly verify your identity." ]</span>
                    </div>
                    <div class="d-flex gap-2 justify-content-center">
                        <a id="modalQrVoucherLink" href="#" class="btn btn-success btn-sm rounded-pill px-3.5 py-1.5 fw-semibold">
                            <i class="bi bi-ticket-perforated me-1"></i> @L["Open Full Voucher"]
                        </a>
                        <a id="modalQrDownloadLink" href="#" download="" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-1.5 fw-semibold">
                            <i class="bi bi-download me-1"></i> @L["Download"]
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="_ReviewModal" />

<!-- =========================================================================
     MODIFY BOOKING MODAL
     ========================================================================= -->
<div class="modal fade" id="modifyBookingModal" tabindex="-1" aria-labelledby="modifyBookingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 460px;">
        <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
            <form asp-action="Modify" method="post" id="modifyBookingForm">
                <input type="hidden" name="type" id="modifyType" />
                <input type="hidden" name="id" id="modifyId" />
                <input type="hidden" name="returnUrl" value="@currentUrl" />

                <div class="modal-header bg-warning-subtle text-warning-emphasis py-3 border-0">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-pencil-square fs-5"></i>
                        <h6 class="modal-title fw-bold mb-0" id="modifyBookingModalLabel">@L["Change Booking Dates & Details"]</h6>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4">
                    <div class="alert alert-info border-0 small rounded-3 mb-3 p-2.5">
                        <i class="bi bi-info-circle-fill me-1"></i>
                        <span>@L["You can change dates and quantity up to 3 times. If previously accepted, the booking returns to pending for owner re-approval."]</span>
                    </div>

                    <h6 class="fw-bold text-dark mb-3" id="modifyItemTitle"></h6>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label for="modifyStartDate" class="form-label small fw-semibold text-muted mb-1">@L["Start Date"]</label>
                            <input type="date" class="form-control form-control-sm py-2" id="modifyStartDate" name="startDate" required
                                   min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-6">
                            <label for="modifyEndDate" class="form-label small fw-semibold text-muted mb-1">@L["End Date"]</label>
                            <input type="date" class="form-control form-control-sm py-2" id="modifyEndDate" name="endDate" required
                                   min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />
                        </div>
                    </div>

                    <div id="modifyUnitsContainer" class="mb-3">
                        <label for="modifyUnits" class="form-label small fw-semibold text-muted mb-1">
                            @L["Number of Units"] <span id="modifyMaxUnitsHint" class="text-muted fw-normal"></span>
                        </label>
                        <input type="number" class="form-control form-control-sm py-2" id="modifyUnits" name="units" min="1" />
                    </div>

                    <div id="modifyTonsContainer" class="mb-3 d-none">
                        <label for="modifyTons" class="form-label small fw-semibold text-muted mb-1">@L["Storage Capacity (Tons)"]</label>
                        <input type="number" step="0.1" class="form-control form-control-sm py-2" id="modifyTons" name="tons" min="0.1" />
                    </div>

                    <div id="modifyErrorAlert" class="alert alert-danger border-0 small rounded-3 d-none p-2 mb-0"></div>
                </div>

                <div class="modal-footer bg-light border-0 py-2.5 px-4 justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-1.5" data-bs-dismiss="modal">@L["Cancel"]</button>
                    <button type="submit" class="btn btn-warning btn-sm rounded-pill px-3.5 py-1.5 fw-bold text-dark">
                        <i class="bi bi-check-circle me-1"></i>@L["Save Changes"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function openBookingQrModal(type, id) {
            const modalEl = document.getElementById('quickQrModal');
            if (!modalEl) return;
            const modal = new bootstrap.Modal(modalEl);
            modal.show();

            const loading = document.getElementById('modalQrLoading');
            const content = document.getElementById('modalQrContent');
            loading.classList.remove('d-none');
            content.classList.add('d-none');

            try {
                const res = await fetch(`/Bookings/GetQrData?type=${encodeURIComponent(type)}&id=${id}`);
                if (!res.ok) throw new Error('Failed to load QR');
                const data = await res.json();

                document.getElementById('modalQrSvg').innerHTML = data.qrSvg;
                document.getElementById('modalQrItemName').textContent = data.itemName;
                document.getElementById('modalQrCode').textContent = data.bookingCode;
                document.getElementById('modalQrDates').textContent = `${data.dates} • ${data.amount}`;
                
                const voucherLink = document.getElementById('modalQrVoucherLink');
                voucherLink.href = `/Bookings/Confirmation?type=${encodeURIComponent(data.bookingType)}&id=${id}`;

                const downloadLink = document.getElementById('modalQrDownloadLink');
                downloadLink.href = data.qrBase64;
                downloadLink.download = `KrishiLink_QR_${data.bookingCode}.png`;

                loading.classList.add('d-none');
                content.classList.remove('d-none');
            } catch (err) {
                console.error(err);
                loading.innerHTML = `<p class="text-danger small mb-0">@L["Failed to load QR code. Please open full voucher."]`;
            }
        }

        function openModifyModal(type, id, start, end, units, tons, maxUnits, minDays, itemName) {
            const modalEl = document.getElementById('modifyBookingModal');
            if (!modalEl) return;

            document.getElementById('modifyType').value = type;
            document.getElementById('modifyId').value = id;
            document.getElementById('modifyStartDate').value = start;
            document.getElementById('modifyEndDate').value = end;
            document.getElementById('modifyItemTitle').textContent = itemName;

            const unitsCont = document.getElementById('modifyUnitsContainer');
            const tonsCont = document.getElementById('modifyTonsContainer');
            const unitsInput = document.getElementById('modifyUnits');
            const tonsInput = document.getElementById('modifyTons');

            if (type.toLowerCase() === 'equipment') {
                unitsCont.classList.remove('d-none');
                tonsCont.classList.add('d-none');
                unitsInput.value = units || 1;
                unitsInput.max = maxUnits || 50;
                unitsInput.required = true;
                tonsInput.required = false;
                document.getElementById('modifyMaxUnitsHint').textContent = maxUnits ? `(Max: ${maxUnits})` : '';
            } else {
                unitsCont.classList.add('d-none');
                tonsCont.classList.remove('d-none');
                tonsInput.value = tons || 1;
                tonsInput.required = true;
                unitsInput.required = false;
            }

            const modal = new bootstrap.Modal(modalEl);
            modal.show();
        }

        document.addEventListener('DOMContentLoaded', function () {
            // Initialize tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (el) { return new bootstrap.Tooltip(el); });

            const urlParams = new URLSearchParams(window.location.search);
            const reviewParam = urlParams.get('review');
            if (reviewParam) {
                let parts = reviewParam.split(':');
                let type = parts.length > 1 ? parts[0] : '@Model.ActiveTab';
                let id = parts.length > 1 ? parts[1] : parts[0];

                const container = document.getElementById(`reviewActionContainer_${type}_${id}`) ||
                                  document.getElementById(`reviewActionContainer_${type.charAt(0).toUpperCase() + type.slice(1)}_${id}`);
                if (container) {
                    const btn = container.querySelector('button');
                    if (btn) {
                        btn.click();
                    }
                }
            }
        });
    </script>
}


