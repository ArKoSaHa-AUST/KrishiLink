@model KrishiLink.Models.ViewModels.PaginatedNotificationsViewModel
@inject Microsoft.Extensions.Hosting.IHostEnvironment Env
@using System.Globalization
@using KrishiLink.BLL.Helpers
@{
    ViewData["Title"] = L["Notifications"].Value;
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
    var bn = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn";

    string TranslateNotificationText(string? text)
    {
        if (!bn || string.IsNullOrWhiteSpace(text)) return text ?? string.Empty;
        var s = text;

        // Payout un-interpolated template placeholders or fallback patterns
        s = System.Text.RegularExpressions.Regex.Replace(s,
            @"Your payout of ৳?\{0:N0\} via \{1\} \(\{2\}\) has been settled successfully\.?",
            "আপনার পেআউট সফলভাবে নিষ্পত্তি হয়েছে।",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        s = System.Text.RegularExpressions.Regex.Replace(s,
            @"Your payout request of ৳?\{0:N0\} via \{1\} is being processed\.?",
            "আপনার পেআউটের অনুরোধটি প্রক্রিয়াধীন রয়েছে।",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        s = System.Text.RegularExpressions.Regex.Replace(s,
            @"Your payout of ৳?\{0\} via \{1\} \(\{2\}\) failed: \{3\}\.?",
            "আপনার পেআউট ব্যর্থ হয়েছে।",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        // Populated payout messages
        s = System.Text.RegularExpressions.Regex.Replace(s,
            @"Your payout of (?:৳|Tk\.?|BDT\s*)?([0-9,.]+)\s+via\s+(.+?)\s+\((.+?)\)\s+has been settled successfully\.?",
            m => $"{m.Groups[2].Value} ({m.Groups[3].Value})-এর মাধ্যমে আপনার ৳{m.Groups[1].Value} পেআউট সফলভাবে নিষ্পত্তি হয়েছে।",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        s = System.Text.RegularExpressions.Regex.Replace(s,
            @"Your payout request of (?:৳|Tk\.?|BDT\s*)?([0-9,.]+)\s+via\s+(.+?)\s+is being processed\.?",
            m => $"{m.Groups[2].Value}-এর মাধ্যমে আপনার ৳{m.Groups[1].Value} পেআউটের অনুরোধটি প্রক্রিয়াধীন রয়েছে।",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        s = System.Text.RegularExpressions.Regex.Replace(s,
            @"Your payout of (?:৳|Tk\.?|BDT\s*)?([0-9,.]+)\s+via\s+(.+?)\s+\((.+?)\)\s+failed:\s*(.+?)\.?\s*(?:The bookings are back in your pending balance\.?)?",
            m => $"{m.Groups[2].Value} ({m.Groups[3].Value})-এর মাধ্যমে আপনার ৳{m.Groups[1].Value} পেআউট ব্যর্থ হয়েছে: {m.Groups[4].Value}। বুকিংগুলো আপনার অপেক্ষমাণ ব্যালেন্সে ফিরে এসেছে।",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        var map = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["Payout Completed"] = "পেআউট সম্পন্ন হয়েছে",
            ["Payout Requested"] = "পেআউটের অনুরোধ করা হয়েছে",
            ["Payout Failed"] = "পেআউট ব্যর্থ হয়েছে",
            ["Rental Request Accepted"] = "ভাড়ার অনুরোধ গৃহীত হয়েছে",
            ["Rental Request Declined"] = "ভাড়ার অনুরোধ প্রত্যাখ্যাত হয়েছে",
            ["Rental Request Received"] = "নতুন ভাড়ার অনুরোধ এসেছে",
            ["Rental Request Cancelled"] = "ভাড়ার অনুরোধ বাতিল হয়েছে",
            ["Equipment Booking Confirmed"] = "যন্ত্রপাতি বুকিং নিশ্চিত হয়েছে",
            ["Godown Booking Confirmed"] = "গুদাম বুকিং নিশ্চিত হয়েছে",
            ["Booking Confirmed"] = "বুকিং নিশ্চিত হয়েছে",
            ["Booking Completed"] = "বুকিং সম্পন্ন হয়েছে",
            ["Booking Cancelled"] = "বুকিং বাতিল হয়েছে",
            ["Booking Update"] = "বুকিং আপডেট",
            ["Payment Received"] = "পেমেন্ট গ্রহণ করা হয়েছে",
            ["Payment Successful"] = "পেমেন্ট সফল হয়েছে",
            ["Payment confirmed"] = "পেমেন্ট নিশ্চিত করা হয়েছে",
            ["New Review Received"] = "নতুন রিভিউ পেয়েছেন",
            ["Review Submitted"] = "রিভিউ জমা দেওয়া হয়েছে",
            ["Pest Alert"] = "পোকামাকড় ও রোগবালাই সতর্কতা",
            ["Weather Advisory"] = "আবহাওয়া পরামর্শ",
            ["Weather Suggestion"] = "আবহাওয়া ভিত্তিক পরামর্শ",
            ["Weather & Crop Advisory"] = "আবহাওয়া ও ফসল পরামর্শ",
            ["Electric Farm Tractor"] = "ইলেকট্রিক ফার্ম ট্র্যাক্টর",
            ["Combine Harvester"] = "কম্বাইন হারভেস্টার",
            ["Power Tiller"] = "পাওয়ার টিলার",
            ["Tractor"] = "ট্র্যাক্টর",
            ["Power Sprayer"] = "পাওয়ার স্প্রেয়ার",
            ["Rice Transplanter"] = "রাইস ট্রান্সপ্লান্টার",
            ["Thresher"] = "মাড়াই কল (থ্রেশার)",
            ["Grain Dryer"] = "গ্রেইন ড্রায়ার",
            ["Rice Blast (Leaf & Neck Blast)"] = "রাইস ব্লাস্ট (পাতা ও শীষ ব্লাস্ট)",
            ["Rice Blast"] = "রাইস ব্লাস্ট",
            ["Bacterial Leaf Blight (BLB)"] = "ব্যাকটেরিয়াল পাতা পোড়া (বিএলবি)",
            ["Bacterial Leaf Blight"] = "ব্যাকটেরিয়াল পাতা পোড়া",
            ["Brown Plant Hopper (BPH)"] = "বাদামি গাছফড়িং (বিপিএইচ)",
            ["Brown Plant Hopper"] = "বাদামি গাছফড়িং",
            ["Potato Late Blight"] = "আলুর নাবি ধসা (লেট ব্লাইট)",
            ["Mustard Aphid Infestation"] = "সরিষার জাবপোকা আক্রমণ",
            ["Mustard Aphid"] = "সরিষার জাবপোকা",
            ["Chili Anthracnose / Dieback"] = "মরিচের অ্যানথ্রাকনোজ / ডাইব্যাক",
            ["Wheat Rust (Leaf & Stripe Rust)"] = "গমের মরিচা রোগ",
            ["Wheat Rust"] = "গমের মরিচা রোগ",
            ["Eggplant Fruit & Shoot Borer (FSB)"] = "বেগুনের ডগা ও ফল ছিদ্রকারী পোকা",
            ["Corn / Maize Fall Armyworm"] = "ভুট্টার ফল আর্মিওয়ার্ম",
            ["Tomato Early Blight"] = "টমেটোর আগাম ধসা (আর্লি ব্লাইট)",
            ["Onion Purple Blotch"] = "পেঁয়াজের পার্পল ব্লচ (বেগুনি দাগ রোগ)",
            ["Jute Stem Rot"] = "পাটের কাণ্ড পচা রোগ",
            ["Harvest Plan"] = "ফসল কাটার পরিকল্পনা",
            ["Just now"] = "এইমাত্র",
            ["Yesterday"] = "গতকাল"
        };

        foreach (var kvp in map)
        {
            if (s.Contains(kvp.Key, StringComparison.OrdinalIgnoreCase))
            {
                s = s.Replace(kvp.Key, kvp.Value);
            }
        }

        foreach (var dist in BangladeshGeo.AllDistricts)
        {
            if (s.Contains(dist, StringComparison.OrdinalIgnoreCase))
            {
                s = s.Replace(dist, L[dist].Value);
            }
        }

        var monthMap = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["Jan"] = "জানু", ["Feb"] = "ফেব্রু", ["Mar"] = "মার্চ", ["Apr"] = "এপ্রিল",
            ["May"] = "মে", ["Jun"] = "জুন", ["Jul"] = "জুলাই", ["Aug"] = "আগস্ট",
            ["Sep"] = "সেপ", ["Oct"] = "অক্টো", ["Nov"] = "নভে", ["Dec"] = "ডিসে",
            ["January"] = "জানুয়ারি", ["February"] = "ফেব্রুয়ারি", ["March"] = "মার্চ",
            ["April"] = "এপ্রিল", ["June"] = "জুন", ["July"] = "জুলাই",
            ["August"] = "আগস্ট", ["September"] = "সেপ্টেম্বর", ["October"] = "অক্টোবর",
            ["November"] = "নভেম্বর", ["December"] = "ডিসেম্বর"
        };

        foreach (var kvp in monthMap)
        {
            s = System.Text.RegularExpressions.Regex.Replace(s, $@"\b{kvp.Key}\b", kvp.Value, System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        }

        // Relative time translations
        s = System.Text.RegularExpressions.Regex.Replace(s, @"(\d+)\s*mins?\s*ago", "$1 মিনিট আগে", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        s = System.Text.RegularExpressions.Regex.Replace(s, @"(\d+)\s*hours?\s*ago", "$1 ঘণ্টা আগে", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        s = System.Text.RegularExpressions.Regex.Replace(s, @"(\d+)\s*days?\s*ago", "$1 দিন আগে", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        s = System.Text.RegularExpressions.Regex.Replace(s, @"(\d+)\s*secs?\s*ago", "$1 সেকেন্ড আগে", System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        // Convert ASCII numbers to Bangla digits
        s = string.Concat(s.Select(c => c >= '0' && c <= '9' ? (char)('০' + (c - '0')) : c));

        return s;
    }
}

<!-- Page Header & Overview -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4 pb-3 border-bottom">
    <div>
        <h2 class="fw-bold mb-1" style="color: var(--krishi-primary);">
            <i class="bi bi-bell-fill text-success me-2"></i>@L["Notifications"]
        </h2>
        <p class="text-muted mb-0">
            @L["Stay updated with your rental requests, booking decisions, reviews, and platform activity."]
        </p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (Env.IsDevelopment())
        {
            <form asp-controller="Notifications" asp-action="RunReminders" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-warning btn-sm rounded-pill px-3 py-2 fw-semibold">
                    <i class="bi bi-play-circle me-1"></i> @L["[Dev] Run reminders now"]
                </button>
            </form>
        }
        @if (Model.UnreadCount > 0)
        {
            <form asp-controller="Notifications" asp-action="MarkAllAsRead" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@currentUrl" />
                <button type="submit" class="btn btn-outline-success btn-sm rounded-pill px-3 py-2 fw-semibold">
                    <i class="bi bi-check2-all me-1"></i> @L["Mark all read"]
                </button>
            </form>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2">
        <i class="bi bi-check-circle-fill text-success"></i>
        <span class="small">@TempData["SuccessMessage"]</span>
    </div>
}

<!-- Tabs Navigation: All | Unread -->
<div class="card krishi-card border-0 shadow-sm rounded-4 p-2.5 mb-4">
    <ul class="nav nav-pills krishi-nav-pills d-flex gap-1" role="tablist">
        <li class="nav-item flex-fill text-center" role="presentation">
            <a class="nav-link @(!Model.UnreadOnly ? "active" : "") d-flex align-items-center justify-content-center gap-2" 
               href="@Url.Action("Index", "Notifications", new { unreadOnly = false })">
                <i class="bi bi-bell"></i>
                <span>@L["All Notifications"]</span>
                <span class="badge @(!Model.UnreadOnly ? "bg-white text-success" : "bg-light text-muted border") rounded-pill">@Model.TotalCount</span>
            </a>
        </li>
        <li class="nav-item flex-fill text-center" role="presentation">
            <a class="nav-link @(Model.UnreadOnly ? "active" : "") d-flex align-items-center justify-content-center gap-2" 
               href="@Url.Action("Index", "Notifications", new { unreadOnly = true })">
                <i class="bi bi-envelope-open"></i>
                <span>@L["Unread Only"]</span>
                <span class="badge @(Model.UnreadOnly ? "bg-white text-success" : (Model.UnreadCount > 0 ? "bg-danger text-white" : "bg-light text-muted border")) rounded-pill">@Model.UnreadCount</span>
            </a>
        </li>
    </ul>
</div>

<!-- Notifications List -->
@if (Model.Items.Count == 0)
{
    <div class="card krishi-card border-0 shadow-sm rounded-4 p-5 text-center my-4">
        <div class="py-4">
            <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                <i class="bi bi-bell-slash text-muted" style="font-size: 2.5rem;"></i>
            </div>
            <h5 class="fw-bold text-dark mb-1">
                @(Model.UnreadOnly ? L["No unread notifications"] : L["No notifications yet"])
            </h5>
            <p class="text-muted small mb-3">
                @(Model.UnreadOnly ? L["You're all caught up! There are no unread notifications at the moment."] : L["When you receive booking updates, rental requests, or reviews, they will appear here."])
            </p>
            @if (Model.UnreadOnly && Model.TotalCount > 0)
            {
                <a asp-action="Index" asp-route-unreadOnly="false" class="btn btn-outline-success btn-sm rounded-pill px-4">
                    @L["View All Notifications"]
                </a>
            }
        </div>
    </div>
}
else
{
    <div class="list-group gap-2 mb-4">
        @foreach (var item in Model.Items)
        {
            <div class="card border-0 shadow-sm rounded-3 p-3 transition-all @(!item.IsRead ? "border-start border-4 border-success bg-white shadow-sm" : "bg-light bg-opacity-50")"
                 style="@(!item.IsRead ? "border-left-color: var(--krishi-primary) !important; background-color: #f8faf8 !important;" : "")">
                <div class="d-flex align-items-start gap-3">
                    <!-- Icon / Type Indicator -->
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width: 44px; height: 44px; background-color: var(--bs-@item.BadgeColor-bg-subtle, #e8f5e9);">
                        <i class="@item.IconClass fs-5 text-@item.BadgeColor"></i>
                    </div>

                    <!-- Notification Body -->
                    <div class="flex-grow-1 min-w-0">
                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-1 mb-1">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <h6 class="fw-bold mb-0 text-dark @(!item.IsRead ? "text-success fw-bolder" : "")">
                                    @TranslateNotificationText(item.Title)
                                </h6>
                                <span class="badge bg-@item.BadgeColor bg-opacity-10 text-@item.BadgeColor border border-@item.BadgeColor border-opacity-25 rounded-pill px-2 py-0.5" style="font-size: 0.7rem;">
                                    @L[item.Type]
                                </span>
                                @if (!item.IsRead)
                                {
                                    <span class="badge bg-success rounded-pill px-2" style="font-size: 0.65rem;">@L["NEW"]</span>
                                }
                            </div>
                            <small class="text-muted text-nowrap" title="@item.CreatedAt.ToString("f")">
                                <i class="bi bi-clock me-1"></i>@TranslateNotificationText(item.TimeAgo)
                            </small>
                        </div>

                        <p class="mb-2 text-secondary text-break" style="font-size: 0.925rem; line-height: 1.45;">
                            @TranslateNotificationText(item.Message)
                        </p>

                        <!-- Action Buttons -->
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 pt-1 border-top border-light">
                            <div>
                                @if (!string.IsNullOrWhiteSpace(item.LinkUrl))
                                {
                                    <a asp-action="Open" asp-route-id="@item.Id" class="btn btn-sm btn-link text-decoration-none p-0 fw-semibold text-success d-inline-flex align-items-center gap-1">
                                        <span>@L["View Details"]</span>
                                        <i class="bi bi-arrow-right small"></i>
                                    </a>
                                }
                            </div>

                            <div class="d-flex align-items-center gap-2">
                                @if (!item.IsRead)
                                {
                                    <form asp-action="MarkAsRead" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="returnUrl" value="@currentUrl" />
                                        <button type="submit" class="btn btn-sm btn-light border rounded-pill px-2.5 py-1 text-muted small hover-success" title="@L["Mark as read"]">
                                            <i class="bi bi-check2 text-success me-1"></i> @L["Mark read"]
                                        </button>
                                    </form>
                                }

                                <form asp-action="Delete" method="post" class="d-inline" data-onsubmit="return confirm('@L["Delete this notification?"]');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="returnUrl" value="@currentUrl" />
                                    <button type="submit" class="btn btn-sm btn-light border rounded-circle p-1 text-muted text-hover-danger" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;" title="@L["Delete notification"]">
                                        <i class="bi bi-trash small"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination Controls -->
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Notifications pagination" class="d-flex justify-content-center mt-4">
            <ul class="pagination pagination-sm">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link rounded-pill px-3 me-1" href="@Url.Action("Index", new { unreadOnly = Model.UnreadOnly, page = Model.CurrentPage - 1 })">
                        <i class="bi bi-chevron-left me-1"></i> @L["Previous"]
                    </a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                        <a class="page-link rounded-circle mx-0.5 text-center" style="width: 32px; height: 32px; line-height: 18px;" href="@Url.Action("Index", new { unreadOnly = Model.UnreadOnly, page = p })">
                            @p
                        </a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link rounded-pill px-3 ms-1" href="@Url.Action("Index", new { unreadOnly = Model.UnreadOnly, page = Model.CurrentPage + 1 })">
                        @L["Next"] <i class="bi bi-chevron-right ms-1"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
}
