@model KrishiLink.Models.ViewModels.GodownOwnerDashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Godown Owner Dashboard";
    ViewData["BodyClass"] = "krishi-body-gradient";
    var occupiedPercent = Model.TotalCapacityTons > 0 ? (int)Math.Round(Model.OccupiedCapacityTons / Model.TotalCapacityTons * 100) : 0;
    var summaryBarClass = occupiedPercent >= 95 ? "bg-danger" : occupiedPercent >= 70 ? "bg-warning" : "bg-success";
    var godownsJson = JsonSerializer.Serialize(Model.Godowns.ToDictionary(
        g => g.Id,
        g => new { total = g.TotalCapacityTons, available = g.AvailableCapacityTons }));
}

<!-- Dashboard Welcome Header -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-4 pb-3 border-bottom" style="border-color: var(--krishi-border-color) !important;">
    <div>
        <h2 class="fw-bold mb-1" style="color: var(--krishi-primary);">Godown Owner Dashboard</h2>
        <p class="mb-0" style="color: var(--krishi-text-muted);">
            Track capacity utilization and respond to incoming storage booking requests.
        </p>
    </div>
    <a asp-controller="GodownOwner" asp-action="Requests" class="btn btn-krishi-outline rounded-pill px-3 py-2 fw-semibold flex-shrink-0">
        <i class="bi bi-inbox me-1"></i> Booking Requests
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2">
        <i class="bi bi-check-circle-fill text-success"></i>
        <span class="small">@TempData["SuccessMessage"]</span>
    </div>
}

<!-- Summary Cards Row (horizontal scroll strip on mobile) -->
<div class="d-flex flex-nowrap overflow-x-auto flex-md-wrap gap-3 pb-2 mb-4">
    <a href="#myGodowns" class="text-decoration-none flex-shrink-0 flex-md-grow-1 krishi-summary-card">
        <div class="card krishi-card border-0 shadow-sm p-3 d-flex flex-row align-items-center gap-3 h-100">
            <div class="rounded-3 d-flex align-items-center justify-content-center krishi-summary-icon" style="background-color: var(--krishi-primary-light);">
                <i class="bi bi-building fs-4" style="color: var(--krishi-primary);"></i>
            </div>
            <div>
                <span class="fs-3 fw-bold d-block lh-1 krishi-summary-value">@Model.TotalGodowns</span>
                <span class="small krishi-summary-label">Total Godowns</span>
            </div>
        </div>
    </a>
    <a href="#myGodowns" class="text-decoration-none flex-shrink-0 flex-md-grow-1 krishi-summary-card">
        <div class="card krishi-card border-0 shadow-sm p-3 d-flex flex-row align-items-center gap-3 h-100">
            <div class="rounded-3 d-flex align-items-center justify-content-center krishi-summary-icon" style="background-color: var(--krishi-primary-subtle);">
                <i class="bi bi-box-seam fs-4" style="color: var(--krishi-primary);"></i>
            </div>
            <div class="flex-grow-1">
                <span class="fs-3 fw-bold d-block lh-1 krishi-summary-value">
                    <span id="summaryOccupied">@Model.OccupiedCapacityTons.ToString("N0")</span>
                    <span class="fs-6 fw-normal" style="color: var(--krishi-text-muted);">/ @Model.TotalCapacityTons.ToString("N0") Tons</span>
                </span>
                <span class="small krishi-summary-label">Occupied Capacity (<span id="summaryOccupiedPct">@occupiedPercent</span>%)</span>
                <div class="progress mt-1" role="progressbar" aria-label="Overall capacity utilization"
                     aria-valuenow="@occupiedPercent" aria-valuemin="0" aria-valuemax="100" style="height: 4px;">
                    <div class="progress-bar @summaryBarClass" id="summaryOccupiedBar" style="width: @occupiedPercent%;"></div>
                </div>
            </div>
        </div>
    </a>
    <a href="#pendingRequests" class="text-decoration-none flex-shrink-0 flex-md-grow-1 krishi-summary-card">
        <div class="card krishi-card border-0 shadow-sm p-3 d-flex flex-row align-items-center gap-3 h-100">
            <div class="rounded-3 d-flex align-items-center justify-content-center krishi-summary-icon" style="background-color: var(--krishi-status-pending-bg);">
                <i class="bi bi-hourglass-split fs-4" style="color: var(--krishi-status-pending-text);"></i>
            </div>
            <div>
                <span class="fs-3 fw-bold d-block lh-1 krishi-summary-value" id="pendingCount" aria-live="polite">@Model.PendingRequests</span>
                <span class="small krishi-summary-label">Pending Booking Requests</span>
            </div>
        </div>
    </a>
</div>

<!-- Pending Booking Requests Widget (inline Accept/Reject, mirrors Equipment Owner Dashboard) -->
<div class="mb-5" id="pendingRequests">
    <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: var(--krishi-radius-lg); border-left: 4px solid var(--krishi-primary) !important;">
        <div class="p-3 px-4 d-flex align-items-center justify-content-between" style="background-color: var(--krishi-primary-light);">
            <h5 class="fw-bold mb-0 d-flex align-items-center gap-2" style="color: var(--krishi-primary);">
                <i class="bi bi-bell-fill"></i> Pending Booking Requests
                <span class="badge rounded-pill bg-white shadow-sm" id="pendingBadge" style="color: var(--krishi-primary);">@Model.PendingRequests</span>
            </h5>
            <a asp-controller="GodownOwner" asp-action="Requests" class="small fw-semibold text-success text-decoration-none d-none d-sm-block">
                View All <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div id="pendingRequestsList">
            @foreach (var req in Model.PendingRequestItems)
            {
                <partial name="_BookingRequestRow" model="req" />
            }
        </div>

        <div class="p-4 text-center @(Model.PendingRequestItems.Any() ? "d-none" : "")" id="noPendingState">
            <i class="bi bi-check2-circle fs-2 text-success d-block mb-1"></i>
            <span style="color: var(--krishi-text-muted);">All caught up — no pending booking requests right now.</span>
        </div>
    </div>
</div>

<!-- My Godowns Preview: capacity visualization is the visual anchor -->
<div class="mb-5" id="myGodowns">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h5 class="fw-bold mb-0" style="color: var(--krishi-text-primary);">
            My Godowns
            <span class="badge rounded-pill ms-1" style="background-color: var(--krishi-primary-light); color: var(--krishi-primary); font-size: 0.78rem;">@Model.TotalGodowns</span>
        </h5>
        <a asp-controller="GodownOwner" asp-action="Create" class="btn btn-krishi-primary rounded-pill px-3 py-2 fw-bold shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Add New Godown
        </a>
    </div>

    @if (!Model.Godowns.Any())
    {
        <div class="card border-0 shadow-sm text-center p-5" style="border-radius: var(--krishi-radius-lg);">
            <i class="bi bi-building fs-1 text-success d-block mb-2"></i>
            <h5 class="fw-bold" style="color: var(--krishi-text-primary);">No godowns listed yet</h5>
            <p class="mb-3" style="color: var(--krishi-text-muted);">List your first warehouse or cold storage and start earning from unused capacity.</p>
            <div>
                <a asp-controller="GodownOwner" asp-action="Create" class="btn btn-krishi-primary rounded-pill px-4 py-2 fw-bold">
                    <i class="bi bi-plus-lg me-1"></i> List Your First Godown
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3 g-lg-4">
            @foreach (var g in Model.Godowns)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <a asp-controller="GodownOwner" asp-action="Edit" asp-route-id="@g.Id" class="text-decoration-none">
                        <div class="card krishi-card border-0 shadow-sm h-100 p-3 godown-card @(g.AvailableCapacityTons <= 0 ? "godown-card-full" : "")" data-godown-id="@g.Id">
                            <div class="d-flex align-items-start justify-content-between gap-2 mb-1">
                                <div>
                                    <span class="small text-uppercase fw-semibold" style="color: var(--krishi-text-muted); letter-spacing: 0.04em;">@g.StorageType</span>
                                    <h6 class="fw-bold mb-0" style="color: var(--krishi-text-primary);">@g.Name</h6>
                                </div>
                                <span class="krishi-badge g-status-badge @(g.Status == "Active" ? "krishi-badge-available" : g.Status == "Full" ? "krishi-badge-unavailable" : "krishi-badge-completed")">@g.Status</span>
                            </div>

                            <!-- Capacity utilization: the card's visual anchor -->
                            <div class="mt-3">
                                <partial name="_CapacityBar" model="g" />
                            </div>

                            <span class="small fw-semibold mt-3 text-success">
                                <i class="bi bi-pencil me-1"></i>Edit Listing <i class="bi bi-arrow-right"></i>
                            </span>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>

<form id="antiForgeryForm">@Html.AntiForgeryToken()</form>

@section Scripts {
    <script>
        const RESPOND_URL = '@Url.Action("RespondRequest", "GodownOwner")';
        // Live capacity state per godown, seeded from the server
        const GODOWNS = @Html.Raw(godownsJson);
        const fmt = n => Number(n).toLocaleString();

        function refreshPendingUI() {
            const remaining = document.querySelectorAll('.pending-request-row:not(.d-none)').length;
            KrishiCount.animate(document.getElementById('pendingCount'), remaining);
            document.getElementById('pendingBadge').textContent = remaining;
            document.getElementById('noPendingState').classList.toggle('d-none', remaining > 0);
        }

        function barClassFor(pct) {
            return pct >= 95 ? 'bg-danger' : pct >= 70 ? 'bg-warning' : 'bg-success';
        }

        // Re-renders a godown card's capacity bar, badge, and availability line from GODOWNS
        function updateGodownCard(id) {
            const g = GODOWNS[id];
            const card = document.querySelector(`.godown-card[data-godown-id="${id}"]`);
            if (!g || !card) return;
            const occupied = g.total - g.available;
            const pct = g.total > 0 ? Math.round(occupied / g.total * 100) : 0;

            card.querySelector('.occupied-line').textContent = `${fmt(occupied)} / ${fmt(g.total)} Tons occupied`;
            card.querySelector('.util-percent').textContent = pct + '%';
            const bar = card.querySelector('.progress-bar');
            bar.style.width = pct + '%';
            bar.className = 'progress-bar ' + barClassFor(pct);
            bar.parentElement.setAttribute('aria-valuenow', pct);
            card.querySelector('.available-line').innerHTML = g.available > 0
                ? `<i class="bi bi-box-seam text-success me-1"></i>${fmt(g.available)} Tons still available`
                : `<i class="bi bi-slash-circle text-danger me-1"></i>Fully booked — no new capacity`;

            const badge = card.querySelector('.g-status-badge');
            badge.textContent = g.available > 0 ? 'Active' : 'Full';
            badge.className = 'krishi-badge g-status-badge ' + (g.available > 0 ? 'krishi-badge-available' : 'krishi-badge-unavailable');
            card.classList.toggle('godown-card-full', g.available <= 0);
        }

        function updateSummaryBar() {
            let occupied = 0, total = 0;
            Object.values(GODOWNS).forEach(g => { occupied += g.total - g.available; total += g.total; });
            const pct = total > 0 ? Math.round(occupied / total * 100) : 0;
            document.getElementById('summaryOccupied').textContent = fmt(occupied);
            document.getElementById('summaryOccupiedPct').textContent = pct;
            const bar = document.getElementById('summaryOccupiedBar');
            bar.style.width = pct + '%';
            bar.className = 'progress-bar ' + barClassFor(pct);
            bar.parentElement.setAttribute('aria-valuenow', pct);
        }

        // Per-row fits/exceeds indicator against live availability
        function refreshFitIndicators() {
            document.querySelectorAll('.pending-request-row').forEach(row => {
                const g = GODOWNS[row.dataset.godownId];
                const cap = Number(row.dataset.capacity);
                const el = row.querySelector('.fit-indicator');
                if (!g || !el) return;
                if (cap <= g.available) {
                    el.style.color = 'var(--krishi-status-accepted-text)';
                    el.innerHTML = `<i class="bi bi-check-circle me-1"></i>${fmt(cap)} / ${fmt(g.available)} Tons free — fits available space`;
                } else {
                    el.style.color = 'var(--krishi-status-rejected-text)';
                    el.innerHTML = `<i class="bi bi-exclamation-triangle-fill me-1"></i>Exceeds available space (only ${fmt(g.available)} Tons free)`;
                }
            });
        }

        // Accept immediately updates capacity everywhere; Undo/failure reverses it
        function applyCapacityChange(godownId, deltaOccupiedTons) {
            const g = GODOWNS[godownId];
            if (!g) return;
            g.available -= deltaOccupiedTons;
            updateGodownCard(godownId);
            updateSummaryBar();
            refreshFitIndicators();
        }

        function applyDecision(id, decision, btn, reason, skipGuard) {
            const row = btn.closest('.pending-request-row');
            const accepted = decision === 'accept';
            const godownId = row.dataset.godownId;
            const cap = Number(row.dataset.capacity);
            const g = GODOWNS[godownId];

            // Capacity guard: accepting more than the godown has free needs explicit confirmation
            if (accepted && !skipGuard && g && cap > g.available) {
                KrishiModal.confirm({
                    title: 'Exceeds Available Capacity',
                    body: `This booking needs <strong>${fmt(cap)} Tons</strong>, but only <strong>${fmt(g.available)} Tons</strong> are free in this godown. Accept anyway?`,
                    confirmText: 'Accept Anyway',
                    confirmClass: 'btn-danger',
                    iconClass: 'bi-exclamation-triangle-fill text-danger',
                    onConfirm: () => applyDecision(id, decision, btn, reason, true)
                });
                return;
            }

            KrishiRequests.optimisticDecision({
                url: RESPOND_URL, id, decision, reason, row,
                acceptedMsg: 'Booking request accepted ✓',
                rejectedMsg: 'Booking request rejected',
                onApply: () => { if (accepted) applyCapacityChange(godownId, cap); },
                onRowHidden: refreshPendingUI,
                onRevert: () => { if (accepted) applyCapacityChange(godownId, -cap); refreshPendingUI(); }
            });
        }

        function promptReject(id, btn) {
            const farmer = btn.closest('.pending-request-row').dataset.farmerName;
            KrishiRequests.promptReject(farmer,
                reason => applyDecision(id, 'reject', btn, reason),
                { title: 'Reject Booking Request', placeholder: 'e.g. Requested capacity is not available for those dates (optional)' });
        }

        // Notify when new booking requests arrive
        KrishiRequests.watchPendingCount('@Url.Action("PendingCount", "GodownOwner")', @Model.PendingRequests, delta => {
            const countEl = document.getElementById('pendingCount');
            KrishiCount.animate(countEl, Number(countEl.textContent) + delta);
            const badge = document.getElementById('pendingBadge');
            badge.textContent = Number(badge.textContent) + delta;
            KrishiToast.show(`${delta} new booking request${delta > 1 ? 's' : ''} received`, { iconClass: 'bi-bell-fill text-success' });
        });

        refreshFitIndicators();
    </script>
}
