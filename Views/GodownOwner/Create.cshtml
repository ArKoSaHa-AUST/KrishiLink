@model KrishiLink.Models.ViewModels.GodownListingViewModel
@{
    ViewData["Title"] = L[Model.FormTitle];
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <style>
        .leaflet-popup-content-wrapper { border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.15); }
        .krishi-map-card { position: relative; border-radius: 16px; overflow: hidden; }
        .custom-godown-pin {
            background-color: #0d6efd;
            color: white;
            border-radius: 50% 50% 50% 0;
            transform: rotate(-45deg);
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid white;
            box-shadow: 0 2px 6px rgba(0,0,0,0.3);
        }
        .custom-godown-pin i {
            transform: rotate(45deg);
            font-size: 14px;
        }
    </style>
}

<!-- Breadcrumb Navigation -->
<nav aria-label="@L["breadcrumb"]" class="mb-3">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-success text-decoration-none">@L["Home"]</a></li>
        <li class="breadcrumb-item"><a asp-controller="GodownOwner" asp-action="Index" class="text-success text-decoration-none">@L["Godown Dashboard"]</a></li>
        <li class="breadcrumb-item active text-muted" aria-current="page">@L[Model.FormTitle]</li>
    </ol>
</nav>

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-4 pb-2 border-bottom">
    <div>
        <h2 class="fw-bold mb-1" style="color: var(--krishi-primary);">
            <i class="bi bi-building text-success me-2"></i>@L[Model.FormTitle]
        </h2>
        <p class="text-muted mb-0">
            @(Model.IsEditMode 
                ? L["Update your storage facility details, capacity, pricing, and amenities."]
                : L["List your warehouse or cold storage facility to connect with farmers needing storage space."])
        </p>
    </div>
    <a asp-controller="GodownOwner" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-1.5 fw-semibold">
        <i class="bi bi-arrow-left me-1"></i> @L["Back to Dashboard"]
    </a>
</div>

<!-- Main Form Container -->
<div class="row justify-content-center">
    <div class="col-12 col-xl-10">
        
        <form asp-controller="GodownOwner" asp-action="Save" method="post" id="godownListingForm" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" id="godownId" />
            <input type="hidden" asp-for="PrimaryImageKey" id="primaryImageKeyInput" />
            <input type="hidden" asp-for="Latitude" id="godownLatitude" />
            <input type="hidden" asp-for="Longitude" id="godownLongitude" />

            <div class="card krishi-card border-0 shadow-sm rounded-4 p-4 p-md-5 mb-4 bg-white">
                
                <div class="row g-4">
                    
                    <!-- Section 1: Basic Facility Details -->
                    <div class="col-12">
                        <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                            <span class="badge bg-success-subtle text-success rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                <i class="bi bi-info-circle-fill"></i>
                            </span>
                            <h5 class="fw-bold text-dark mb-0">@L["1. Facility Details"]</h5>
                        </div>
                    </div>

                    <!-- Godown / Facility Name -->
                    <div class="col-12 col-md-8">
                        <label asp-for="Name" class="form-label fw-semibold text-dark small">
                            @L["Godown / Facility Title"] <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Name" class="form-control py-2.5 rounded-3" id="godownNameInput" placeholder="@L["e.g. Green Grain Cold Storage Facility"]" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                        <div class="form-text small text-muted">@L["Specify the facility name and storage specialty for higher search visibility."]</div>
                    </div>

                    <!-- Storage Category Dropdown -->
                    <div class="col-12 col-md-4">
                        <label asp-for="Category" class="form-label fw-semibold text-dark small">
                            @L["Storage Type / Category"] <span class="text-danger">*</span>
                        </label>
                        <select asp-for="Category" class="form-select py-2.5 rounded-3" id="godownCategorySelect" required>
                            <option value="Cold Storage">@L["❄️ Cold Storage (Vegetables & Fruits)"]</option>
                            <option value="Grain Warehouse">@L["🌾 Grain Warehouse (Paddy & Wheat)"]</option>
                            <option value="Multi-Chamber Cold Storage">@L["🧊 Multi-Chamber Storage (Multi-Temp)"]</option>
                            <option value="Seed Vault">@L["🌱 Certified Seed Vault"]</option>
                            <option value="Silo Facility">@L["🏢 Modern Silo Facility"]</option>
                            <option value="Dry Godown">@L["📦 Dry Goods & Jute Warehouse"]</option>
                        </select>
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>

                    <!-- Location Input -->
                    <div class="col-12 col-md-6">
                        <label asp-for="Location" class="form-label fw-semibold text-dark small">
                            @L["Facility Location (District / Upazila)"] <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-success border-end-0 rounded-start-3">
                                <i class="bi bi-geo-alt-fill"></i>
                            </span>
                            <input asp-for="Location" class="form-control border-start-0 py-2.5 rounded-end-3" id="godownLocationInput" placeholder="@L["e.g. Dinajpur Sadar, Dinajpur"]" required />
                        </div>
                        <span asp-validation-for="Location" class="text-danger small"></span>
                        <div class="form-text small text-muted">@L["District or Upazila name where the storage facility is located."]</div>
                    </div>

                    <!-- Availability Status Toggle -->
                    <div class="col-12 col-md-6 d-flex align-items-center">
                        <div class="p-3 bg-light rounded-3 border w-100 mt-md-1">
                            <div class="form-check form-switch d-flex align-items-center justify-content-between p-0 m-0">
                                <label class="form-check-label fw-semibold text-dark small mb-0" for="isAvailableSwitch">
                                    <i class="bi bi-toggle-on text-success me-1.5"></i> @L["Mark Listing as Active & Bookable"]
                                </label>
                                <input class="form-check-input ms-0" type="checkbox" role="switch" id="isAvailableSwitch" asp-for="IsAvailable" style="cursor: pointer;" />
                            </div>
                        </div>
                    </div>

                    <!-- Interactive Map Pin Picker -->
                    <div class="col-12">
                        <div class="p-3.5 bg-light rounded-4 border">
                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-2 pb-2 border-bottom">
                                <div>
                                    <label class="form-label fw-bold text-dark mb-0 small d-flex align-items-center gap-1.5">
                                        <i class="bi bi-pin-map-fill text-primary"></i>
                                        <span>@L["Map Pin Location (Drop Pin for Storage Facility)"]</span>
                                    </label>
                                    <div class="small text-muted">@L["Click anywhere on the map or drag the marker to pinpoint your warehouse location for farmers."]</div>
                                </div>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold shadow-xs" id="btnDetectGPS" title="@L["Detect My Current GPS Location"]">
                                        <i class="bi bi-crosshair me-1"></i> @L["Use Current GPS"]
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold shadow-xs" id="btnRecenterDistrict" title="@L["Center on District"]">
                                        <i class="bi bi-arrow-clockwise me-1"></i> @L["Center on District"]
                                    </button>
                                    <span class="badge bg-primary text-white px-3 py-1.5 rounded-pill font-monospace small shadow-xs" id="coordBadge">
                                        <i class="bi bi-geo-alt-fill me-1"></i> <span id="coordBadgeText">@(Model.Latitude.HasValue && Model.Longitude.HasValue ? $"{Model.Latitude.Value:F4}° N, {Model.Longitude.Value:F4}° E" : "25.6279° N, 88.6332° E")</span>
                                    </span>
                                </div>
                            </div>
                            
                            <div id="godownLocationPickerMap" class="rounded-3 shadow-xs border bg-white" style="height: 320px; width: 100%; z-index: 1;"></div>
                        </div>
                    </div>

                    <!-- Section 2: Storage Capacity -->
                    <div class="col-12 pt-2">
                        <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                            <span class="badge bg-success-subtle text-success rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                <i class="bi bi-boxes"></i>
                            </span>
                            <h5 class="fw-bold text-dark mb-0">@L["2. Storage Capacity Specifications"]</h5>
                        </div>
                    </div>

                    <!-- Total Capacity -->
                    <div class="col-12 col-md-4">
                        <label asp-for="TotalCapacity" class="form-label fw-semibold text-dark small">
                            @L["Total Storage Capacity"] <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <input type="number" asp-for="TotalCapacity" class="form-control py-2.5 rounded-start-3" id="totalCapacityInput" min="0.1" step="0.5" placeholder="200" required />
                            <span class="input-group-text bg-light text-muted fw-semibold rounded-end-3" id="capacityUnitDisplay">@Model.CapacityUnit</span>
                        </div>
                        <span asp-validation-for="TotalCapacity" class="text-danger small"></span>
                    </div>

                    <!-- Capacity Unit Selector -->
                    <div class="col-12 col-md-4">
                        <label asp-for="CapacityUnit" class="form-label fw-semibold text-dark small">
                            @L["Measurement Unit"] <span class="text-danger">*</span>
                        </label>
                        <select asp-for="CapacityUnit" class="form-select py-2.5 rounded-3" id="capacityUnitSelect" required>
                            <option value="Tons">@L["Metric Tons (MT)"]</option>
                            <option value="Maunds">@L["Maunds (মন) - 40 kg"]</option>
                            <option value="Bags">@L["Bags (50 kg standard)"]</option>
                            <option value="Quintals">@L["Quintals (100 kg)"]</option>
                        </select>
                        <span asp-validation-for="CapacityUnit" class="text-danger small"></span>
                    </div>

                    <!-- Available Capacity -->
                    <div class="col-12 col-md-4">
                        <label asp-for="AvailableCapacity" class="form-label fw-semibold text-dark small">
                            @L["Currently Available Space"] <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <input type="number" asp-for="AvailableCapacity" class="form-control py-2.5 rounded-start-3" id="availableCapacityInput" min="0" step="0.5" placeholder="200" required />
                            <span class="input-group-text bg-light text-muted fw-semibold rounded-end-3" id="availableUnitDisplay">@Model.CapacityUnit</span>
                        </div>
                        <span asp-validation-for="AvailableCapacity" class="text-danger small"></span>
                    </div>

                    <!-- Description Textarea -->
                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold text-dark small">
                            @L["Description & Facility Highlights"] <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="Description" class="form-control rounded-3" id="godownDescInput" rows="4" 
                                  placeholder="@L["Detail the ventilation, cooling range, pallet support, security guards, pest control schedules, road access, and loading equipment..."]" required></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                        <div class="form-text small text-muted">@L["Provide detailed storage conditions so farmers know their crops remain fresh and secure."]</div>
                    </div>

                    <!-- Section 3: Rental Rates & Pricing Structure -->
                    <div class="col-12 pt-2">
                        <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                            <span class="badge bg-success-subtle text-success rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                <i class="bi bi-tag-fill"></i>
                            </span>
                            <h5 class="fw-bold text-dark mb-0">@L["3. Storage Rental Rates & Pricing"]</h5>
                        </div>
                    </div>

                    <!-- Price Amount -->
                    <div class="col-12 col-md-6">
                        <label asp-for="PriceAmount" class="form-label fw-semibold text-dark small">
                            @L["Storage Rental Rate (BDT ৳)"] <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-success fw-bold">৳</span>
                            <input type="number" asp-for="PriceAmount" class="form-control py-2.5" id="priceAmountInput" min="1" step="10" placeholder="450" required />
                            <span class="input-group-text bg-light text-muted" id="priceUnitSuffix">@L["/ Ton / Month"]</span>
                        </div>
                        <span asp-validation-for="PriceAmount" class="text-danger small"></span>
                        <div class="form-text small text-muted" id="calculatedEquivalentRate">@L["Standard rate charged per ton per month."]</div>
                    </div>

                    <!-- Pricing Period Toggle -->
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold text-dark small">
                            @L["Billing Frequency / Period"] <span class="text-danger">*</span>
                        </label>
                        <div class="d-flex gap-2">
                            <div class="form-check form-check-inline p-2.5 border rounded-3 flex-grow-1 text-center bg-light">
                                <input class="form-check-input" type="radio" asp-for="PricePeriod" id="periodMonth" value="Month" checked />
                                <label class="form-check-label fw-semibold small text-dark user-select-none" for="periodMonth">
                                    <i class="bi bi-calendar3 me-1 text-success"></i> @L["Monthly (/ Month)"]
                                </label>
                            </div>
                            <div class="form-check form-check-inline p-2.5 border rounded-3 flex-grow-1 text-center bg-light">
                                <input class="form-check-input" type="radio" asp-for="PricePeriod" id="periodDay" value="Day" />
                                <label class="form-check-label fw-semibold small text-dark user-select-none" for="periodDay">
                                    <i class="bi bi-sun me-1 text-success"></i> @L["Daily (/ Day)"]
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Section 4: Facility Features & Amenities -->
                    <div class="col-12 pt-2">
                        <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                            <span class="badge bg-success-subtle text-success rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                <i class="bi bi-shield-check"></i>
                            </span>
                            <h5 class="fw-bold text-dark mb-0">@L["4. Facility Amenities & Conditions"]</h5>
                        </div>
                        <p class="text-muted small mb-3">@L["Select all preservation facilities and security standards provided at this godown:"]</p>

                        <div class="row g-2">
                            @{
                                var standardFacilities = new[]
                                {
                                    new { Name = "Climate Control (2-8°C)", Icon = "bi-snow", Label = "❄️ Climate Control (2-8°C)" },
                                    new { Name = "24/7 Security & CCTV", Icon = "bi-camera-video", Label = "🛡️ 24/7 Security & CCTV" },
                                    new { Name = "Power Backup Generator", Icon = "bi-lightning-charge", Label = "⚡ Power Backup Generator" },
                                    new { Name = "Pest & Rodent Control", Icon = "bi-bug", Label = "🐜 Pest & Rodent Fumigation" },
                                    new { Name = "Moisture Testing Lab", Icon = "bi-droplet", Label = "🧪 Moisture Testing Lab" },
                                    new { Name = "Loading & Unloading Ramp", Icon = "bi-truck", Label = "🚚 Loading / Unloading Ramp" },
                                    new { Name = "Pallet Racking System", Icon = "bi-grid-3x3", Label = "📦 Pallet Racking System" },
                                    new { Name = "Fire Safety & Insurance", Icon = "bi-fire", Label = "🧯 Fire Safety & Insurance" }
                                };
                            }
                            @foreach (var fac in standardFacilities)
                            {
                                var isChecked = Model.SelectedFacilities != null && Model.SelectedFacilities.Contains(fac.Name);
                                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                                    <div class="form-check amenity-pill-check p-2 border rounded-3 h-100 bg-light d-flex align-items-center gap-2">
                                        <input class="form-check-input ms-1" type="checkbox" name="SelectedFacilities" value="@fac.Name" id="fac_@fac.Name.Replace(" ", "_")" @(isChecked ? "checked" : "") />
                                        <label class="form-check-label small fw-medium text-dark user-select-none mb-0" for="fac_@fac.Name.Replace(" ", "_")">
                                            @L[fac.Label]
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Section 5: Interactive Drag-and-Drop Image Uploader -->
                    <div class="col-12 pt-2">
                        <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-success-subtle text-success rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                    <i class="bi bi-images"></i>
                                </span>
                                <h5 class="fw-bold text-dark mb-0">@L["5. Facility Photos"] <span class="text-danger">*</span></h5>
                            </div>
                            <span class="text-muted small">@L["At least 1 photo required (Max 5 MB each: PNG, JPG, WebP)"]</span>
                        </div>

                        <!-- Dropzone Component -->
                        <div class="krishi-upload-dropzone mb-3" id="dropzoneArea" onclick="document.getElementById('godownImageFileInput').click()">
                            <input type="file" id="godownImageFileInput" name="imageFiles" multiple accept="image/png, image/jpeg, image/webp" class="d-none" onchange="handleFileSelect(this.files)" />
                            <div class="mb-2">
                                <i class="bi bi-cloud-arrow-up text-success" style="font-size: 2.5rem;"></i>
                            </div>
                            <h6 class="fw-bold text-dark mb-1">@L["Drag & drop godown facility photos here, or"] <span class="text-success text-decoration-underline">@L["browse files"]</span></h6>
                            <p class="text-muted small mb-0">@L["Clear photos build farmer trust. Click any photo below to set it as the Primary preview."]</p>
                        </div>

                        <!-- Server-Side & Client-Side Validation Alerts -->
                        <span asp-validation-for="ImageFiles" class="text-danger small d-block mb-2"></span>
                        <div class="alert alert-danger d-none py-2 px-3 small rounded-3 mb-3" id="imageValidationAlert">
                            <i class="bi bi-exclamation-triangle-fill me-1.5"></i> <span id="imageValidationAlertText">@L["Please upload at least one photo of the storage facility before saving."]</span>
                        </div>

                        <!-- Live Preview Cards Container -->
                        <div class="d-flex flex-wrap gap-3" id="imagePreviewsContainer">
                            <!-- Existing Images (if edit mode) -->
                            @for (int i = 0; i < Model.ExistingImageUrls.Count; i++)
                            {
                                var imgUrl = Model.ExistingImageUrls[i];
                                var isPrimary = (string.IsNullOrEmpty(Model.PrimaryImageKey) && i == 0) || string.Equals(Model.PrimaryImageKey, imgUrl, StringComparison.OrdinalIgnoreCase);
                                <div class="krishi-image-preview-card existing-image-card @(isPrimary ? "is-primary" : "")" id="existingCard_@i" data-key="@imgUrl" onclick="setPrimaryImage('@imgUrl', this)">
                                    <img src="@imgUrl" alt="@L["Godown photo"]" class="w-100 h-100 object-fit-cover rounded-3" />
                                    <input type="hidden" name="ExistingImageUrls" value="@imgUrl" />
                                    <span class="krishi-primary-badge @(isPrimary ? "" : "d-none")">
                                        <i class="bi bi-star-fill"></i> @L["Primary"]
                                    </span>
                                    <button type="button" class="krishi-set-primary-btn @(isPrimary ? "d-none" : "")" onclick="event.stopPropagation(); setPrimaryImage('@imgUrl', this.parentElement)">
                                        <i class="bi bi-star me-1"></i>@L["Set as Primary"]
                                    </button>
                                    <button type="button" class="krishi-preview-remove-btn" onclick="event.stopPropagation(); removeExistingImage(@i, '@imgUrl')" title="@L["Remove photo"]">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>

                </div>

                <!-- Form Action Buttons -->
                <div class="d-flex flex-column flex-sm-row justify-content-end align-items-center gap-3 pt-4 mt-4 border-top">
                    <a asp-controller="GodownOwner" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2.5 fw-semibold w-100 w-sm-auto order-2 order-sm-1">
                        @L["Cancel"]
                    </a>
                    <button type="submit" class="btn btn-krishi-primary rounded-pill px-5 py-2.5 fw-bold shadow-sm w-100 w-sm-auto order-1 order-sm-2" id="submitGodownBtn">
                        <span class="btn-spinner spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                        <i class="bi bi-check2-circle me-1.5 btn-icon"></i>
                        <span class="btn-text">@L[Model.SubmitButtonText]</span>
                    </button>
                </div>

            </div>

        </form>

    </div>
</div>

<style>
.amenity-pill-check {
    transition: all 0.2s ease;
    cursor: pointer;
}
.amenity-pill-check:hover {
    border-color: var(--krishi-primary) !important;
    background-color: var(--krishi-primary-light) !important;
}
.amenity-pill-check input:checked ~ label {
    color: var(--krishi-primary) !important;
    font-weight: 600 !important;
}
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Track newly selected File objects in memory
        let selectedNewFiles = [];
        const maxFileSize = 5 * 1024 * 1024; // 5 MB
        const allowedExtensions = ['.jpg', '.jpeg', '.png', '.webp'];

        // 1. Capacity Unit Live Synchronization
        $('#capacityUnitSelect').on('change', function () {
            const unit = $(this).val();
            $('#capacityUnitDisplay').text(unit);
            $('#availableUnitDisplay').text(unit);
            updatePricingSuffix();
        });

        // 2. Pricing Frequency & Suffix Recalculator
        function updatePricingSuffix() {
            const unit = $('#capacityUnitSelect').val() || 'Ton';
            const isMonthly = $('#periodMonth').is(':checked');
            const suffix = isMonthly ? `/ ${unit} / Month` : `/ ${unit} / Day`;
            $('#priceUnitSuffix').text(suffix);

            const amount = parseFloat($('#priceAmountInput').val()) || 0;
            if (amount > 0) {
                if (isMonthly) {
                    const dailyEquiv = (amount / 30).toFixed(1);
                    $('#calculatedEquivalentRate').text(`Approx. ৳${dailyEquiv} / ${unit} / day equivalent.`);
                } else {
                    const monthlyEquiv = (amount * 30).toFixed(0);
                    $('#calculatedEquivalentRate').text(`Approx. ৳${monthlyEquiv} / ${unit} / month equivalent.`);
                }
            }
        }

        $('input[name="PricePeriod"]').on('change', updatePricingSuffix);
        $('#priceAmountInput').on('input', updatePricingSuffix);

        // 3. Drag-and-Drop Image Uploader
        const dropzone = document.getElementById('dropzoneArea');

        if (dropzone) {
            ['dragenter', 'dragover'].forEach(eventName => {
                dropzone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzone.classList.add('dragover');
                }, false);
            });

            ['dragleave', 'drop'].forEach(eventName => {
                dropzone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzone.classList.remove('dragover');
                }, false);
            });

            dropzone.addEventListener('drop', (e) => {
                const dt = e.dataTransfer;
                if (dt && dt.files && dt.files.length > 0) {
                    handleFileSelect(dt.files);
                }
            }, false);
        }

        function handleFileSelect(files) {
            const alertBox = document.getElementById('imageValidationAlert');
            if (alertBox) alertBox.classList.add('d-none');

            Array.from(files).forEach((file) => {
                const ext = '.' + file.name.split('.').pop().toLowerCase();

                if (!allowedExtensions.includes(ext) || !file.type.startsWith('image/')) {
                    if (window.KrishiToast) {
                        KrishiToast.show(`File '${file.name}' is not a supported image format. Use JPG, PNG, or WebP.`, { iconClass: 'bi-exclamation-triangle-fill text-warning' });
                    }
                    return;
                }

                if (file.size > maxFileSize) {
                    const sizeMb = (file.size / (1024 * 1024)).toFixed(1);
                    if (window.KrishiToast) {
                        KrishiToast.show(`File '${file.name}' exceeds the 5 MB limit (${sizeMb} MB).`, { iconClass: 'bi-exclamation-triangle-fill text-warning' });
                    }
                    return;
                }

                selectedNewFiles.push(file);
            });

            renderNewPreviewCards();
        }

        function renderNewPreviewCards() {
            // Remove existing new-image cards
            document.querySelectorAll('.new-image-card').forEach(el => el.remove());

            const container = document.getElementById('imagePreviewsContainer');
            const primaryKeyInput = document.getElementById('primaryImageKeyInput');
            let currentPrimary = primaryKeyInput.value;

            selectedNewFiles.forEach((file, index) => {
                const key = 'new_' + index;
                const isPrimary = currentPrimary === key;

                const card = document.createElement('div');
                card.className = `krishi-image-preview-card new-image-card ${isPrimary ? 'is-primary' : ''}`;
                card.id = 'previewCard_' + index;
                card.dataset.key = key;
                card.onclick = function () { setPrimaryImage(key, card); };

                const img = document.createElement('img');
                img.className = 'w-100 h-100 object-fit-cover rounded-3';
                img.alt = file.name;

                const reader = new FileReader();
                reader.onload = function (e) {
                    img.src = e.target.result;
                };
                reader.readAsDataURL(file);

                card.appendChild(img);

                const badge = document.createElement('span');
                badge.className = `krishi-primary-badge ${isPrimary ? '' : 'd-none'}`;
                badge.innerHTML = `<i class="bi bi-star-fill"></i> @L["Primary"]`;
                card.appendChild(badge);

                const setPrimaryBtn = document.createElement('button');
                setPrimaryBtn.type = 'button';
                setPrimaryBtn.className = `krishi-set-primary-btn ${isPrimary ? 'd-none' : ''}`;
                setPrimaryBtn.innerHTML = `<i class="bi bi-star me-1"></i>@L["Set as Primary"]`;
                setPrimaryBtn.onclick = function (ev) {
                    ev.stopPropagation();
                    setPrimaryImage(key, card);
                };
                card.appendChild(setPrimaryBtn);

                const removeBtn = document.createElement('button');
                removeBtn.type = 'button';
                removeBtn.className = 'krishi-preview-remove-btn';
                removeBtn.title = '@L["Remove photo"]';
                removeBtn.innerHTML = '<i class="bi bi-x"></i>';
                removeBtn.onclick = function (ev) {
                    ev.stopPropagation();
                    removeNewImage(index);
                };
                card.appendChild(removeBtn);

                container.appendChild(card);
            });

            ensurePrimarySelected();
            syncFileInput();
        }

        function setPrimaryImage(key, cardElement) {
            document.getElementById('primaryImageKeyInput').value = key;

            document.querySelectorAll('.krishi-image-preview-card').forEach(card => {
                card.classList.remove('is-primary');
                const badge = card.querySelector('.krishi-primary-badge');
                if (badge) badge.classList.add('d-none');
                const btn = card.querySelector('.krishi-set-primary-btn');
                if (btn) btn.classList.remove('d-none');
            });

            if (cardElement) {
                cardElement.classList.add('is-primary');
                const badge = cardElement.querySelector('.krishi-primary-badge');
                if (badge) badge.classList.remove('d-none');
                const btn = cardElement.querySelector('.krishi-set-primary-btn');
                if (btn) btn.classList.add('d-none');
            }
        }

        function removeNewImage(index) {
            const removedKey = 'new_' + index;
            selectedNewFiles.splice(index, 1);

            const primaryKeyInput = document.getElementById('primaryImageKeyInput');
            if (primaryKeyInput.value === removedKey) {
                primaryKeyInput.value = '';
            }

            renderNewPreviewCards();
        }

        function removeExistingImage(index, url) {
            const card = document.getElementById('existingCard_' + index);
            if (card) card.remove();

            const primaryKeyInput = document.getElementById('primaryImageKeyInput');
            if (primaryKeyInput.value === url) {
                primaryKeyInput.value = '';
            }

            ensurePrimarySelected();
        }

        function ensurePrimarySelected() {
            const primaryKeyInput = document.getElementById('primaryImageKeyInput');
            const allCards = Array.from(document.querySelectorAll('.krishi-image-preview-card'));

            if (allCards.length === 0) {
                primaryKeyInput.value = '';
                return;
            }

            const currentSelectedCard = allCards.find(c => c.dataset.key === primaryKeyInput.value);

            if (!currentSelectedCard) {
                // Default to first available card
                const firstCard = allCards[0];
                const firstKey = firstCard.dataset.key;
                setPrimaryImage(firstKey, firstCard);
            }
        }

        function syncFileInput() {
            const fileInput = document.getElementById('godownImageFileInput');
            if (!fileInput) return;

            try {
                const dt = new DataTransfer();
                selectedNewFiles.forEach(file => dt.items.add(file));
                fileInput.files = dt.files;
            } catch (err) {
                console.warn('DataTransfer not fully supported on this browser', err);
            }
        }

        // 4. Form Submit Validation & Loading Spinner State
        $('#godownListingForm').on('submit', function (e) {
            syncFileInput();

            const form = $(this);
            const totalCapacity = parseFloat($('#totalCapacityInput').val()) || 0;
            const availableCapacity = parseFloat($('#availableCapacityInput').val()) || 0;
            const priceAmount = parseFloat($('#priceAmountInput').val()) || 0;
            const existingCount = $('.existing-image-card').length;
            const newCount = selectedNewFiles.length;
            const alertBox = $('#imageValidationAlert');

            // Validate capacity
            if (totalCapacity <= 0) {
                e.preventDefault();
                KrishiToast.show('@L["Total storage capacity must be a positive number."]', { iconClass: 'bi-exclamation-triangle-fill text-warning' });
                $('#totalCapacityInput').focus();
                return false;
            }

            if (availableCapacity < 0 || availableCapacity > totalCapacity) {
                e.preventDefault();
                KrishiToast.show('@L["Available capacity cannot exceed total capacity."]', { iconClass: 'bi-exclamation-triangle-fill text-warning' });
                $('#availableCapacityInput').focus();
                return false;
            }

            // Validate price
            if (priceAmount <= 0) {
                e.preventDefault();
                KrishiToast.show('@L["Rental price must be greater than 0."]', { iconClass: 'bi-exclamation-triangle-fill text-warning' });
                $('#priceAmountInput').focus();
                return false;
            }

            // Validate images (at least 1 photo)
            if (existingCount + newCount === 0) {
                e.preventDefault();
                alertBox.removeClass('d-none');
                alertBox[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
                return false;
            }

            if (form.valid()) {
                const submitBtn = $('#submitGodownBtn');
                const spinner = submitBtn.find('.btn-spinner');
                const icon = submitBtn.find('.btn-icon');
                const text = submitBtn.find('.btn-text');

                spinner.removeClass('d-none');
                icon.addClass('d-none');
                text.text('@(Model.IsEditMode ? L["Updating Storage Facility..."] : L["Saving Storage Facility..."])');
                submitBtn.prop('disabled', true);

                return true;
            }
        });

        // Initialize primary selection state on page load
        document.addEventListener('DOMContentLoaded', () => {
            ensurePrimarySelected();
            initGodownLocationPickerMap();
        });

        // -------------------------------------------------------------------------
        // LEAFLET MAP LOCATION PICKER (GODOWN)
        // -------------------------------------------------------------------------
        const districtCentroids = {
            "Dhaka": [23.8103, 90.4125], "Gazipur": [24.0023, 90.4264], "Kishoreganj": [24.4449, 90.7766], "Manikganj": [23.8617, 90.0003],
            "Munshiganj": [23.5422, 90.5305], "Narayanganj": [23.6238, 90.5000], "Narsingdi": [23.9193, 90.7176], "Tangail": [24.2513, 89.9167],
            "Faridpur": [23.6071, 89.8429], "Gopalganj": [23.0051, 89.8266], "Madaripur": [23.1641, 90.1897], "Rajbari": [23.7574, 89.6445],
            "Shariatpur": [23.2423, 90.4348], "Bogra": [24.8465, 89.3777], "Bogura": [24.8465, 89.3777], "Joypurhat": [25.0968, 89.0227],
            "Naogaon": [24.8103, 88.9416], "Natore": [24.4206, 88.9322], "Nawabganj": [24.5965, 88.2775], "Chapai Nawabganj": [24.5965, 88.2775],
            "Pabna": [24.0064, 89.2372], "Rajshahi": [24.3636, 88.6241], "Sirajganj": [24.4534, 89.7008], "Dinajpur": [25.6279, 88.6332],
            "Gaibandha": [25.3288, 89.5406], "Kurigram": [25.8054, 89.6362], "Lalmonirhat": [25.9923, 89.2847], "Nilphamari": [25.9318, 88.8560],
            "Panchagarh": [26.3411, 88.5542], "Rangpur": [25.7439, 89.2752], "Thakurgaon": [26.0337, 88.4617], "Chittagong": [22.3569, 91.7832],
            "Chattogram": [22.3569, 91.7832], "Bandarban": [22.1953, 92.2184], "Brahmanbaria": [23.9571, 91.1119], "Chandpur": [23.2333, 90.6667],
            "Comilla": [23.4607, 91.1809], "Cumilla": [23.4607, 91.1809], "Cox's Bazar": [21.4272, 92.0058], "Feni": [23.0186, 91.3966],
            "Khagrachhari": [23.1193, 91.9847], "Lakshmipur": [22.9425, 90.8412], "Noakhali": [22.8696, 91.0993], "Rangamati": [22.7324, 92.2985],
            "Khulna": [22.8456, 89.5403], "Bagerhat": [22.6516, 89.7859], "Chuadanga": [23.6402, 88.8418], "Jessore": [23.1664, 89.2081],
            "Jashore": [23.1664, 89.2081], "Jhenaidah": [23.5448, 89.1539], "Kushtia": [23.9013, 89.1205], "Magura": [23.4873, 89.4198],
            "Meherpur": [23.7622, 88.6318], "Narail": [23.1725, 89.5127], "Satkhira": [22.7185, 89.0705], "Barisal": [22.7010, 90.3535],
            "Barishal": [22.7010, 90.3535], "Barguna": [22.0953, 90.0768], "Bhola": [22.6859, 90.6481], "Jhalokati": [22.6406, 90.1987],
            "Patuakhali": [22.3596, 90.3298], "Pirojpur": [22.5841, 89.9720], "Sylhet": [24.8949, 91.8687], "Habiganj": [24.3749, 91.4155],
            "Moulvibazar": [24.4829, 91.7774], "Sunamganj": [25.0658, 91.3950], "Mymensingh": [24.7471, 90.4203], "Jamalpur": [24.9375, 89.9378],
            "Netrokona": [24.8709, 90.7279], "Sherpur": [25.0205, 90.0153]
        };

        let pickerMap = null;
        let pickerMarker = null;

        function findDistrictCoords(locationText) {
            if (!locationText) return districtCentroids["Dinajpur"];
            const clean = locationText.trim();
            for (const key in districtCentroids) {
                if (clean.toLowerCase().includes(key.toLowerCase())) {
                    return districtCentroids[key];
                }
            }
            return districtCentroids["Dinajpur"];
        }

        function updateGodownCoordinates(lat, lng) {
            document.getElementById('godownLatitude').value = lat.toFixed(6);
            document.getElementById('godownLongitude').value = lng.toFixed(6);
            
            const badgeText = document.getElementById('coordBadgeText');
            if (badgeText) {
                badgeText.textContent = `${Math.abs(lat).toFixed(4)}° ${lat >= 0 ? 'N' : 'S'}, ${Math.abs(lng).toFixed(4)}° ${lng >= 0 ? 'E' : 'W'}`;
            }
        }

        function initGodownLocationPickerMap() {
            const mapEl = document.getElementById('godownLocationPickerMap');
            if (!mapEl) return;

            const latInput = document.getElementById('godownLatitude');
            const lngInput = document.getElementById('godownLongitude');
            const locInput = document.getElementById('godownLocationInput');

            let initialLat = parseFloat(latInput.value);
            let initialLng = parseFloat(lngInput.value);

            if (isNaN(initialLat) || isNaN(initialLng)) {
                const defaultCoords = findDistrictCoords(locInput?.value);
                initialLat = defaultCoords[0];
                initialLng = defaultCoords[1];
                updateGodownCoordinates(initialLat, initialLng);
            }

            pickerMap = L.map('godownLocationPickerMap', {
                scrollWheelZoom: true
            }).setView([initialLat, initialLng], 12);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
            }).addTo(pickerMap);

            // Custom blue warehouse marker icon
            const godownIcon = L.divIcon({
                className: 'custom-leaflet-marker',
                html: `<div class="custom-godown-pin"><i class="bi bi-building"></i></div>`,
                iconSize: [32, 32],
                iconAnchor: [16, 32],
                popupAnchor: [0, -32]
            });

            pickerMarker = L.marker([initialLat, initialLng], {
                draggable: true,
                icon: godownIcon
            }).addTo(pickerMap);

            pickerMarker.bindPopup(`<strong>@L["Storage Facility Location"]</strong><br><small class="text-muted">@L["Drag marker or click map to adjust."]</small>`).openPopup();

            pickerMarker.on('dragend', function (e) {
                const pos = e.target.getLatLng();
                updateGodownCoordinates(pos.lat, pos.lng);
            });

            pickerMap.on('click', function (e) {
                pickerMarker.setLatLng(e.latlng);
                updateGodownCoordinates(e.latlng.lat, e.latlng.lng);
            });

            // "Use Current GPS" button
            document.getElementById('btnDetectGPS')?.addEventListener('click', () => {
                if ('geolocation' in navigator) {
                    if (window.KrishiToast) {
                        KrishiToast.show('@L["Detecting your current location..."]', { iconClass: 'bi-crosshair text-primary' });
                    }
                    navigator.geolocation.getCurrentPosition((pos) => {
                        const lat = pos.coords.latitude;
                        const lng = pos.coords.longitude;
                        pickerMap.setView([lat, lng], 15);
                        pickerMarker.setLatLng([lat, lng]);
                        updateGodownCoordinates(lat, lng);
                        if (window.KrishiToast) {
                            KrishiToast.show('@L["Location updated to your GPS position!"]', { iconClass: 'bi-check-circle-fill text-success' });
                        }
                    }, (err) => {
                        if (window.KrishiToast) {
                            KrishiToast.show('@L["Unable to retrieve GPS location. Please drop a pin on the map."]', { iconClass: 'bi-exclamation-triangle-fill text-warning' });
                        }
                    }, { enableHighAccuracy: true, timeout: 8000 });
                }
            });

            // "Center on District" button
            document.getElementById('btnRecenterDistrict')?.addEventListener('click', () => {
                const coords = findDistrictCoords(locInput?.value);
                pickerMap.setView(coords, 12);
                pickerMarker.setLatLng(coords);
                updateGodownCoordinates(coords[0], coords[1]);
                if (window.KrishiToast) {
                    KrishiToast.show('@L["Map centered on district."]', { iconClass: 'bi-geo-alt-fill text-info' });
                }
            });

            // On location input change, center on district if user hasn't explicitly set pinpoint
            locInput?.addEventListener('blur', () => {
                if (locInput.value && !GodownHasCustomPin()) {
                    const coords = findDistrictCoords(locInput.value);
                    pickerMap.setView(coords, 12);
                    pickerMarker.setLatLng(coords);
                    updateGodownCoordinates(coords[0], coords[1]);
                }
            });

            function GodownHasCustomPin() {
                const lat = parseFloat(document.getElementById('godownLatitude').value);
                return !isNaN(lat) && lat !== 0;
            }

            // Invalidate size in case of tab or card layout resizing
            setTimeout(() => { pickerMap.invalidateSize(); }, 300);
        }
    </script>
