@model KrishiLink.Models.ViewModels.GodownBookingRequestsViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Godown Booking Requests";
    ViewData["BodyClass"] = "krishi-body-gradient";
    ViewData["Expandable"] = true;
    var tabs = new[] { "Pending", "Accepted", "Paid", "Rejected", "Completed", "Cancelled" };
    var godownsJson = JsonSerializer.Serialize(Model.Godowns.ToDictionary(
        g => g.Id,
        g => new { name = g.Name, total = g.TotalCapacityTons, available = g.AvailableCapacityTons }));
}

<!-- Page Header -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-4 pb-3 border-bottom" style="border-color: var(--krishi-border-color) !important;">
    <div>
        <h2 class="fw-bold mb-1" style="color: var(--krishi-primary);">@L["Booking Requests"]</h2>
        <p class="mb-0" style="color: var(--krishi-text-muted);">
            @L["Review incoming storage booking requests against remaining capacity and accept or reject them."]
        </p>
    </div>
    <a asp-controller="GodownOwner" asp-action="Index" class="btn btn-krishi-outline rounded-pill px-3 py-2 fw-semibold flex-shrink-0">
        <i class="bi bi-speedometer2 me-1"></i> @L["Dashboard"]
    </a>
</div>

<!-- Live capacity overview: remaining space per godown + aggregate pending demand -->
<div class="d-flex flex-wrap align-items-center gap-2 mb-3" id="capacityChips" aria-live="polite">
    @foreach (var g in Model.Godowns)
    {
        <span class="badge bg-white border rounded-pill px-3 py-2 fw-medium d-inline-flex align-items-center gap-1"
              style="color: var(--krishi-text-primary);" data-godown-id="@g.Id">
            <i class="bi bi-building text-success"></i> @g.Name:
            <strong class="chip-available">@g.AvailableCapacityTons.ToString("N0")</strong>/@g.TotalCapacityTons.ToString("N0") @L["Tons free"]
        </span>
    }
    <span class="badge rounded-pill px-3 py-2 fw-semibold" id="pendingAggregate"
          style="background-color: var(--krishi-primary-light); color: var(--krishi-primary);"></span>
</div>

<!-- Filter Tabs + Godown Filter + Sort + Search -->
<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
    <ul class="nav nav-pills krishi-nav-pills gap-2 flex-nowrap overflow-x-auto pb-1" id="requestTabs" role="tablist">
        @foreach (var tab in tabs)
        {
            var count = Model.Requests.Count(r => r.Status == tab);
            <li class="nav-item flex-shrink-0" role="presentation">
                <button class="nav-link rounded-pill px-3 fw-semibold @(tab == "Pending" ? "active" : "")"
                        id="tab-@tab" data-bs-toggle="pill" data-bs-target="#pane-@tab" type="button" role="tab">
                    @L[tab] <span class="badge rounded-pill bg-white text-success shadow-sm ms-1 tab-count" id="count-@tab">@count</span>
                </button>
            </li>
        }
    </ul>
    <div class="d-flex flex-wrap gap-2">
        <select class="form-select form-select-sm" id="godownFilter" aria-label="Filter by godown" style="max-width: 220px;">
            <option value="">@L["All godowns"]</option>
            @foreach (var g in Model.Godowns)
            {
                <option value="@g.Id">@g.Name</option>
            }
        </select>
        <select class="form-select form-select-sm" id="pendingSort" aria-label="Sort pending requests" style="max-width: 180px;">
            <option value="newest">@L["Newest First"]</option>
            <option value="capacity">@L["Largest capacity"]</option>
        </select>
        <div class="input-group input-group-sm" style="max-width: 240px;">
            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-success"></i></span>
            <input type="search" class="form-control border-start-0" id="requestSearch"
                   placeholder="@L["Search farmer or godown…"]" aria-label="@L["Search booking requests"]" />
        </div>
    </div>
</div>

<!-- Tab Panes -->
<div class="tab-content" id="requestTabPanes">
    @foreach (var tab in tabs)
    {
        var items = Model.Requests.Where(r => r.Status == tab).ToList();
        var emptyText = tab == "Pending" ? L["No pending requests right now"].Value : L["No {0} requests yet", L[tab].Value.ToLowerInvariant()].Value;
        <div class="tab-pane fade @(tab == "Pending" ? "show active" : "")" id="pane-@tab" role="tabpanel">
            <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: var(--krishi-radius-lg);">
                <div class="request-list" id="list-@tab">
                    @foreach (var req in items)
                    {
                        <partial name="_BookingRequestRow" model="req" />
                    }
                </div>

                <!-- Per-tab empty / no-match state -->
                <div class="p-5 text-center empty-state @(items.Any() ? "d-none" : "")" id="empty-@tab" data-default-text="@emptyText">
                    <i class="bi bi-inbox fs-2 text-success d-block mb-1"></i>
                    <span style="color: var(--krishi-text-muted);">@emptyText</span>
                </div>
            </div>
        </div>
    }
</div>

<form id="antiForgeryForm">@Html.AntiForgeryToken()</form>

<!-- Intake Modal (Record / Edit) -->
<div class="modal fade" id="intakeModal" tabindex="-1" aria-labelledby="intakeModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: var(--krishi-radius-lg, 16px);">
            <div class="modal-header border-bottom px-4 py-3" style="background-color: var(--krishi-primary-light);">
                <h5 class="modal-title fw-bold" id="intakeModalTitle" style="color: var(--krishi-primary);">
                    <i class="bi bi-box-seam me-2"></i>@L["Record Produce Intake"]
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="intakeForm" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="lotId" id="intakeLotId" value="" />
                <input type="hidden" name="GodownBookingId" id="intakeGodownBookingId" value="" />
                <input type="hidden" name="returnUrl" id="intakeReturnUrl" value="" />

                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label for="intakeDateInput" class="form-label small fw-bold text-dark">
                                @L["Intake Date"] <span class="text-danger">*</span>
                            </label>
                            <input type="date" class="form-control rounded-3" id="intakeDateInput" name="IntakeDate"
                                   value="@DateTime.Today.ToString("yyyy-MM-dd")" max="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="intakeCropInput" class="form-label small fw-bold text-dark">
                                @L["Crop Name"] <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control rounded-3" id="intakeCropInput" name="Crop"
                                   placeholder="@L["e.g. Potato, Rice, Wheat..."]" maxlength="80" required />
                        </div>

                        <div class="col-12 col-md-6">
                            <label for="intakeVarietyInput" class="form-label small fw-bold text-dark">
                                @L["Variety"] <span class="text-muted">@L["(Optional)"]</span>
                            </label>
                            <input type="text" class="form-control rounded-3" id="intakeVarietyInput" name="Variety"
                                   placeholder="@L["e.g. Diamond, Cardinal, Miniket..."]" maxlength="80" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="intakeGradeSelect" class="form-label small fw-bold text-dark">
                                @L["Quality Grade"] <span class="text-danger">*</span>
                            </label>
                            <select class="form-select rounded-3" id="intakeGradeSelect" name="Grade" required>
                                <option value="Ungraded">@L["Ungraded"]</option>
                                <option value="A">@L["Grade A (Premium)"]</option>
                                <option value="B">@L["Grade B (Standard)"]</option>
                                <option value="C">@L["Grade C (Fair)"]</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-6">
                            <label for="intakeBagsInput" class="form-label small fw-bold text-dark">
                                @L["Number of Bags / Crates"] <span class="text-danger">*</span>
                            </label>
                            <input type="number" class="form-control rounded-3" id="intakeBagsInput" name="Bags"
                                   min="1" max="100000" placeholder="e.g. 200" required />
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="intakeBagWeightInput" class="form-label small fw-bold text-dark">
                                @L["Avg. Bag Weight (kg)"] <span class="text-danger">*</span>
                            </label>
                            <input type="number" class="form-control rounded-3" id="intakeBagWeightInput" name="BagWeightKg"
                                   step="0.1" min="0.1" max="1000" placeholder="e.g. 50" required />
                        </div>

                        <div class="col-12 col-md-6">
                            <label for="intakeNetWeightInput" class="form-label small fw-bold text-dark">
                                @L["Net Weight (kg)"] <span class="text-danger">*</span>
                            </label>
                            <input type="number" class="form-control rounded-3" id="intakeNetWeightInput" name="NetWeightKg"
                                   step="0.01" min="0.01" max="1000000" placeholder="e.g. 10000" required />
                            <div class="form-text small text-muted">@L["Auto-calculated (Bags × Bag Weight) or override from weighbridge ticket."]</div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="intakeMoistureInput" class="form-label small fw-bold text-dark">
                                @L["Moisture %"] <span class="text-muted">@L["(Optional)"]</span>
                            </label>
                            <input type="number" class="form-control rounded-3" id="intakeMoistureInput" name="MoisturePercent"
                                   step="0.1" min="0" max="100" placeholder="e.g. 12.5" />
                        </div>

                        <div class="col-12">
                            <label for="intakeRemarksInput" class="form-label small fw-bold text-dark">
                                @L["Remarks / Storage Location Notes"] <span class="text-muted">@L["(Optional)"]</span>
                            </label>
                            <textarea class="form-control rounded-3" id="intakeRemarksInput" name="Remarks" rows="2"
                                      placeholder="@L["e.g. Stacked in Chamber B, Row 3; inspected on arrival..."]" maxlength="500"></textarea>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light px-4 py-3 border-top">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 fw-semibold" data-bs-dismiss="modal">
                        @L["Cancel"]
                    </button>
                    <button type="submit" class="btn btn-krishi-primary rounded-pill px-4 fw-semibold" id="intakeSubmitBtn">
                        <i class="bi bi-file-earmark-check me-1"></i><span id="intakeSubmitText">@L["Save & Issue Receipt"]</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Release Modal -->
<div class="modal fade" id="releaseModal" tabindex="-1" aria-labelledby="releaseModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: var(--krishi-radius-lg, 16px);">
            <div class="modal-header border-bottom px-4 py-3 bg-light">
                <h5 class="modal-title fw-bold text-primary" id="releaseModalTitle">
                    <i class="bi bi-box-arrow-right me-2"></i>@L["Release Stored Goods"]
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="GodownOwner" asp-action="ReleaseIntake" method="post" id="releaseForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="lotId" id="releaseLotId" value="" />
                <input type="hidden" name="returnUrl" id="releaseReturnUrl" value="" />

                <div class="modal-body p-4">
                    <div class="alert alert-warning d-flex align-items-center gap-2 small mb-3">
                        <i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0 text-warning"></i>
                        <div>@L["Releasing goods marks this lot as finalized and cannot be undone. The warehouse receipt will reflect a permanent RELEASED status."]</div>
                    </div>

                    <div class="mb-3">
                        <label for="releaseToInput" class="form-label small fw-bold text-dark">
                            @L["Released To (Name / Phone / ID)"] <span class="text-danger">*</span>
                        </label>
                        <input type="text" class="form-control rounded-3" id="releaseToInput" name="releasedTo"
                               placeholder="@L["e.g. Farmer Name or Authorized Representative..."]" maxlength="120" required />
                    </div>

                    <div class="mb-2">
                        <label for="releaseRemarksInput" class="form-label small fw-bold text-dark">
                            @L["Release Remarks"] <span class="text-muted">@L["(Optional)"]</span>
                        </label>
                        <textarea class="form-control rounded-3" id="releaseRemarksInput" name="remarks" rows="2"
                                  placeholder="@L["e.g. Gate pass #, truck reg #, ID verified..."]" maxlength="500"></textarea>
                    </div>
                </div>

                <div class="modal-footer bg-light px-4 py-3 border-top">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 fw-semibold" data-bs-dismiss="modal">
                        @L["Cancel"]
                    </button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold">
                        <i class="bi bi-check2-circle me-1"></i>@L["Confirm Release"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Live capacity state per godown, seeded from the server
        const GODOWNS = @Html.Raw(godownsJson);
        const fmt = n => Number(n).toLocaleString();

        // Header fit lines, expanded detail availability, capacity chips, and aggregate
        function refreshCapacityUI() {
            document.querySelectorAll('.request-row').forEach(row => {
                const g = GODOWNS[row.dataset.godownId];
                const cap = Number(row.dataset.capacity);
                if (!g) return;
                const fit = row.querySelector('.fit-indicator');
                if (fit) {
                    if (cap <= g.available) {
                        fit.style.color = 'var(--krishi-status-accepted-text)';
                        fit.innerHTML = `<i class="bi bi-check-circle me-1"></i>${fmt(cap)} / ${fmt(g.available)} @L["Tons free — fits available space"]`;
                    } else {
                        fit.style.color = 'var(--krishi-status-rejected-text)';
                        fit.innerHTML = `<i class="bi bi-exclamation-triangle-fill me-1"></i>` + '@L["Exceeds available space (only {0} Tons free)"]'.replace('{0}', fmt(g.available));
                    }
                }
                const detail = row.querySelector('.detail-availability');
                if (detail) detail.textContent = '@L["{0} of {1} Tons currently available in this godown"]'.replace('{0}', fmt(g.available)).replace('{1}', fmt(g.total));
            });

            document.querySelectorAll('#capacityChips [data-godown-id]').forEach(chip => {
                const g = GODOWNS[chip.dataset.godownId];
                if (g) chip.querySelector('.chip-available').textContent = fmt(g.available);
            });

            let pendingTons = 0;
            document.querySelectorAll('#list-Pending .request-row').forEach(r => pendingTons += Number(r.dataset.capacity || 0));
            const freeTons = Object.values(GODOWNS).reduce((s, g) => s + g.available, 0);
            document.getElementById('pendingAggregate').textContent =
                '@L["Pending requests total {0} Tons vs. {1} Tons free"]'.replace('{0}', fmt(pendingTons)).replace('{1}', fmt(freeTons));
        }

        function applyCapacityChange(godownId, deltaOccupiedTons) {
            const g = GODOWNS[godownId];
            if (!g) return;
            g.available -= deltaOccupiedTons;
            refreshCapacityUI();
        }

        KrishiRequestsPage.init({
            respondUrl: '@Url.Action("RespondRequest", "GodownOwner")',
            pendingCountUrl: '@Url.Action("PendingCount", "GodownOwner")',
            initialPendingCount: @Model.Requests.Count(r => r.Status == "Pending"),
            filterSelectId: 'godownFilter',
            sortSelectId: 'pendingSort',
            messages: {
                acceptTitle: '@L["Accept Booking Request"]',
                acceptNoun: '@L["storage booking request"]',
                rejectTitle: '@L["Reject Booking Request"]',
                rejectPlaceholder: '@L["e.g. Requested capacity is not available for those dates (optional)"]',
                acceptedMsg: '@L["Booking accepted — the farmer has been notified ✓"]',
                rejectedMsg: '@L["Booking rejected — the farmer has been notified"]',
                completedMsg: '@L["Booking marked as completed — capacity freed ✓"]',
                completeTitle: '@L["Mark Booking Completed"]',
                newRequestMsg: '@L["new booking request"]',
                autoRejectReason: '@L["Automatically declined: the owner accepted another booking for overlapping dates."]'
            },
            // Over-capacity requests are refused by the server — offer a one-click reject instead
            acceptGuard: function (row, api) {
                const g = GODOWNS[row.dataset.godownId];
                const cap = Number(row.dataset.capacity);
                if (!g || cap <= g.available) return api.confirm();
                KrishiModal.confirm({
                    title: '@L["Exceeds Available Capacity"]',
                    body: '@L["This booking needs <strong>{0} Tons</strong>, but only <strong>{1} Tons</strong> are free in this godown, so it cannot be accepted. Reject it and let the farmer know?"]'.replace('{0}', fmt(cap)).replace('{1}', fmt(g.available)),
                    confirmText: '@L["Reject Request"]',
                    confirmClass: 'btn-danger',
                    iconClass: 'bi-exclamation-triangle-fill text-danger',
                    onConfirm: () => api.reject('@L["Requested capacity is not available for those dates."]')
                });
            },
            // Accepted bookings occupy capacity; completed bookings free it again
            onApplied: function (row, decision) {
                const cap = Number(row.dataset.capacity);
                if (decision === 'accept') applyCapacityChange(row.dataset.godownId, cap);
                if (decision === 'complete') applyCapacityChange(row.dataset.godownId, -cap);
            },
            onReverted: function (row, decision) {
                const cap = Number(row.dataset.capacity);
                if (decision === 'accept') applyCapacityChange(row.dataset.godownId, -cap);
                if (decision === 'complete') applyCapacityChange(row.dataset.godownId, cap);
            },
            afterListChange: refreshCapacityUI
        });

        // Intake & Release Modal Helpers
        function openIntakeModal(bookingId, farmerName) {
            document.getElementById('intakeModalTitle').innerHTML = '<i class="bi bi-box-seam me-2"></i>' + '@L["Record Produce Intake"]';
            document.getElementById('intakeSubmitText').textContent = '@L["Save & Issue Receipt"]';
            const form = document.getElementById('intakeForm');
            form.action = '@Url.Action("RecordIntake", "GodownOwner")';
            form.reset();
            document.getElementById('intakeLotId').value = '';
            document.getElementById('intakeGodownBookingId').value = bookingId;
            document.getElementById('intakeReturnUrl').value = window.location.pathname + window.location.search + '#request-' + bookingId;
            document.getElementById('intakeDateInput').value = new Date().toISOString().split('T')[0];
            document.getElementById('intakeGradeSelect').value = 'Ungraded';
            bootstrap.Modal.getOrCreateInstance(document.getElementById('intakeModal')).show();
        }

        function openEditIntakeModal(lotId, bookingId, intakeDate, crop, variety, bags, bagWeightKg, netWeightKg, moisture, grade, remarks) {
            document.getElementById('intakeModalTitle').innerHTML = '<i class="bi bi-pencil-square me-2"></i>' + '@L["Edit Intake Lot"]';
            document.getElementById('intakeSubmitText').textContent = '@L["Update Lot"]';
            const form = document.getElementById('intakeForm');
            form.action = '@Url.Action("UpdateIntake", "GodownOwner")';
            document.getElementById('intakeLotId').value = lotId;
            document.getElementById('intakeGodownBookingId').value = bookingId;
            document.getElementById('intakeReturnUrl').value = window.location.pathname + window.location.search + '#request-' + bookingId;
            document.getElementById('intakeDateInput').value = intakeDate;
            document.getElementById('intakeCropInput').value = crop;
            document.getElementById('intakeVarietyInput').value = variety || '';
            document.getElementById('intakeBagsInput').value = bags;
            document.getElementById('intakeBagWeightInput').value = bagWeightKg;
            document.getElementById('intakeNetWeightInput').value = netWeightKg;
            document.getElementById('intakeMoistureInput').value = moisture || '';
            document.getElementById('intakeGradeSelect').value = grade || 'Ungraded';
            document.getElementById('intakeRemarksInput').value = remarks || '';
            bootstrap.Modal.getOrCreateInstance(document.getElementById('intakeModal')).show();
        }

        function openReleaseModal(lotId, farmerName) {
            document.getElementById('releaseLotId').value = lotId;
            document.getElementById('releaseToInput').value = farmerName || '';
            document.getElementById('releaseRemarksInput').value = '';
            document.getElementById('releaseReturnUrl').value = window.location.pathname + window.location.search;
            bootstrap.Modal.getOrCreateInstance(document.getElementById('releaseModal')).show();
        }

        document.addEventListener('DOMContentLoaded', function () {
            const bagsInput = document.getElementById('intakeBagsInput');
            const bagWeightInput = document.getElementById('intakeBagWeightInput');
            const netWeightInput = document.getElementById('intakeNetWeightInput');

            function calcNetWeight() {
                const b = parseFloat(bagsInput?.value) || 0;
                const w = parseFloat(bagWeightInput?.value) || 0;
                if (b > 0 && w > 0 && netWeightInput) {
                    netWeightInput.value = (b * w).toFixed(2);
                }
            }

            bagsInput?.addEventListener('input', calcNetWeight);
            bagWeightInput?.addEventListener('input', calcNetWeight);
        });
    </script>
}
