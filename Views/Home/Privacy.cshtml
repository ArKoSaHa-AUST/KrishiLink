@{
    ViewData["Title"] = L["Privacy Policy"].Value;
}
<h1>@ViewData["Title"]</h1>

<p>@L["Use this page to detail your site's privacy policy."]</p>

<section class="mt-4" aria-labelledby="privacy-assistant">
    <h2 class="h5 fw-bold" id="privacy-assistant">@L["AI assistant (Krishi Shohayok)"]</h2>
    <p>@L["When you use the in-app assistant, your messages and the assistant's replies are stored with your account so the conversation continues across visits, and so we can explain why the assistant suggested a booking."]</p>
    <p>@L["To answer, your message and public listing, crop-calendar and weather data are sent to our AI providers: Groq, and Google Gemini as a backup when Groq is unavailable. We never send your name, phone number, e-mail, NID or payment details from your account."]</p>
    <p>@L["Conversations are archived after 90 days without activity and permanently deleted after 180 days."]</p>
    <p class="mb-0">@L["The assistant never books, pays or cancels anything on its own. It can only prepare a request form that you review and confirm yourself."]</p>
</section>
