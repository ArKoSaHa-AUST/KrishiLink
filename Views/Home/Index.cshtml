@using KrishiLink.Models.ViewModels
@{
    ViewData["Title"] = "UI Foundation Test";
    
    var sampleEquipment = new CardViewModel
    {
        Name = "Mahindra 575 DI Tractor",
        Category = "Heavy Machinery",
        Location = "Bogra Sadar, Bogra",
        Price = "৳1,500 / Day",
        Status = "Available",
        DetailUrl = "#"
    };

    var sampleGodown = new CardViewModel
    {
        Name = "Green Grain Cold Storage",
        Category = "Cold Storage Facility",
        Location = "Dinajpur Sadar",
        Price = "৳500 / Ton / Month",
        Status = "Pending",
        DetailUrl = "#"
    };

    var sampleUnavailable = new CardViewModel
    {
        Name = "Harvester Combined Model X",
        Category = "Harvesting",
        Location = "Rangpur",
        Price = "৳3,000 / Day",
        Status = "Unavailable",
        DetailUrl = "#"
    };
}

<div class="py-3">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-success mb-1">KrishiLink Shared UI Foundation</h2>
            <p class="text-muted mb-0">Testing design tokens, green/white palette, partial views, and JS modal components.</p>
        </div>
        <button type="button" class="btn btn-krishi-primary px-3 py-2 fw-semibold" onclick="KrishiModal.confirm({ title: 'Foundation Test Modal', body: 'This is a test call for the reusable confirmation modal.', confirmText: 'Proceed', cancelText: 'Close', onConfirm: function() { alert('Confirmed!'); } })">
            <i class="bi bi-window-plus me-1"></i> Test Modal Trigger
        </button>
    </div>

    <!-- Status Badges Demonstration -->
    <div class="card krishi-card mb-4 p-3">
        <h6 class="fw-bold text-dark mb-3"><i class="bi bi-tag-fill text-success me-2"></i>Status Badges Component Test (`_StatusBadge.cshtml`)</h6>
        <div class="d-flex flex-wrap gap-3 align-items-center">
            <partial name="_StatusBadge" model='"Pending"' />
            <partial name="_StatusBadge" model='"Accepted"' />
            <partial name="_StatusBadge" model='"Available"' />
            <partial name="_StatusBadge" model='"Completed"' />
            <partial name="_StatusBadge" model='"Rejected"' />
            <partial name="_StatusBadge" model='"Unavailable"' />
        </div>
    </div>

    <!-- Equipment/Godown Cards Demonstration -->
    <div class="mb-4">
        <h6 class="fw-bold text-dark mb-3"><i class="bi bi-grid-3x3-gap-fill text-success me-2"></i>Reusable Cards Test (`_EquipmentCard.cshtml`)</h6>
        <div class="row g-4">
            <div class="col-12 col-md-6 col-lg-4">
                <partial name="_EquipmentCard" model="sampleEquipment" />
            </div>
            <div class="col-12 col-md-6 col-lg-4">
                <partial name="_EquipmentCard" model="sampleGodown" />
            </div>
            <div class="col-12 col-md-6 col-lg-4">
                <partial name="_EquipmentCard" model="sampleUnavailable" />
            </div>
        </div>
    </div>
</div>
