@model KrishiLink.Models.ViewModels.CommunityFeedViewModel

@if (Model.Posts != null && Model.Posts.Any())
{
    foreach (var post in Model.Posts)
    {
        <partial name="_PostCardPartial" model="post" />
    }

    <!-- Pagination Controls (if more than 1 page) -->
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Community Feed Pagination" class="my-5">
            <ul class="pagination justify-content-center gap-1">
                <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link rounded-pill px-3.5 py-2 shadow-sm" href="@Url.Action("Index", new { category = Model.CurrentCategory, district = Model.CurrentDistrict, urgency = Model.CurrentUrgency, sort = Model.CurrentSort, page = Model.PageNumber - 1 })" aria-label="Previous">
                        <span aria-hidden="true">&laquo; পূর্ববর্তী</span>
                    </a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 40px; height: 40px;" href="@Url.Action("Index", new { category = Model.CurrentCategory, district = Model.CurrentDistrict, urgency = Model.CurrentUrgency, sort = Model.CurrentSort, page = i })">@i</a>
                    </li>
                }
                <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link rounded-pill px-3.5 py-2 shadow-sm" href="@Url.Action("Index", new { category = Model.CurrentCategory, district = Model.CurrentDistrict, urgency = Model.CurrentUrgency, sort = Model.CurrentSort, page = Model.PageNumber + 1 })" aria-label="Next">
                        <span aria-hidden="true">পরবর্তী &raquo;</span>
                    </a>
                </li>
            </ul>
        </nav>
    }
}
else
{
    <div class="card community-card p-5 text-center my-4 bg-white">
        <div class="mb-3.5">
            <div class="avatar-circle-lg bg-light text-muted rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                <i class="bi bi-chat-square-dots fs-1" aria-hidden="true"></i>
            </div>
        </div>
        <h4 class="fw-bold text-dark mb-2">কোনো পোস্ট পাওয়া যায়নি</h4>
        <p class="text-muted mb-4" style="font-size: 1rem; max-width: 480px; margin: 0 auto;">এই ক্যাটাগরি বা এলাকায় এখনও কোনো পোস্ট বা সমস্যা প্রকাশ করা হয়নি। আপনার কোনো জিজ্ঞাসা থাকলে নির্দ্বিধায় পোস্ট করুন।</p>
        <div>
            <button type="button" class="btn btn-success px-4 py-2.5 rounded-pill shadow-sm fw-semibold d-inline-flex align-items-center" data-bs-toggle="modal" data-bs-target="#createPostModal" style="font-size: 1rem;">
                <i class="bi bi-plus-circle me-2" aria-hidden="true"></i>
                <span>প্রথম পোস্টটি তৈরি করুন</span>
            </button>
        </div>
    </div>
}
