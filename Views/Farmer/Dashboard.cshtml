@model KrishiLink.Models.ViewModels.FarmerDashboardViewModel
@{
    ViewData["Title"] = L["Farmer Dashboard"].Value;
}

<!-- Dashboard Welcome Header -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-4 pb-3 border-bottom" style="border-color: var(--krishi-border-color) !important;">
    <div>
        <h2 class="fw-bold mb-1" style="color: var(--krishi-primary);">
            @L["Welcome back, {0}", Model.FarmerName]
        </h2>
        <p class="mb-0" style="color: var(--krishi-text-muted);">
            @L["Here's your farming overview for today. Manage bookings, explore equipment, and get crop advice."]
        </p>
    </div>
    <div class="d-flex gap-2 align-items-center flex-wrap">
        <a asp-controller="HarvestPlan" asp-action="Index" class="btn btn-outline-success rounded-pill px-3 py-2 d-flex align-items-center gap-2 fw-semibold flex-shrink-0">
            <i class="bi bi-diagram-3"></i>
            <span>@L["Harvest Plans"]</span>
            @if (Model.DraftHarvestPlansCount > 0)
            {
                <span class="badge bg-success rounded-pill">@Model.DraftHarvestPlansCount</span>
            }
        </a>
        <a asp-controller="Bookings" asp-action="Index" class="btn btn-krishi-outline rounded-pill px-3 py-2 d-flex align-items-center gap-2 fw-semibold flex-shrink-0">
            <span>@L["All Bookings"]</span>
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2">
        <i class="bi bi-check-circle-fill text-success"></i>
        <span class="small">@TempData["SuccessMessage"]</span>
    </div>
}
<partial name="_OnboardingBanner" />

@if (Model.NextSubmittedHarvestPlan != null || Model.DraftHarvestPlansCount > 0)
{
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white p-3.5 border-start border-4 border-success">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle p-2.5 bg-success-subtle text-success fs-4 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px;">
                    <i class="bi bi-diagram-3"></i>
                </div>
                <div>
                    @if (Model.NextSubmittedHarvestPlan != null)
                    {
                        <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill px-2.5 py-0.5 small fw-semibold">
                                @L["Active Plan"]: @Model.NextSubmittedHarvestPlan.Name
                            </span>
                            <span class="text-muted small">@Model.NextSubmittedHarvestPlan.ItemCount @L["items"]</span>
                        </div>
                        <div class="small text-muted">
                            <i class="bi bi-calendar-event me-1"></i>@Model.NextSubmittedHarvestPlan.TargetDateRange
                        </div>
                    }
                    else
                    {
                        <h6 class="fw-bold mb-1 text-dark">@L["You have {0} draft harvest plan(s)", Model.DraftHarvestPlansCount]</h6>
                        <p class="mb-0 text-muted small">@L["Coordinate and submit your bundled equipment and godown storage requests."]</p>
                    }
                </div>
            </div>
            <a asp-controller="HarvestPlan" asp-action="Index" class="btn btn-sm btn-success rounded-pill px-3 py-1.5 fw-semibold text-nowrap">
                @L["Manage Harvest Plans"] <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
}

@if (Model.WeatherSuggestion != null)
{
    var isBangla = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn";
    var ws = Model.WeatherSuggestion;
    var isUrgent = ws.OverallRiskLevel == "Urgent";
    var isHigh = ws.OverallRiskLevel == "High";
    var bgGradient = isUrgent
        ? "linear-gradient(135deg, #fff1f2 0%, #ffe4e6 100%)"
        : isHigh
            ? "linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%)"
            : "linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%)";
    var borderLeftColor = isUrgent ? "#e11d48" : isHigh ? "#f59e0b" : "#16a34a";
    var headerBadgeBg = isUrgent ? "bg-danger" : isHigh ? "bg-warning text-dark" : "bg-success";

    <!-- PROACTIVE WEATHER-TRIGGERED SMART SUGGESTIONS BANNER -->
    <div class="card border-0 shadow-sm mb-4 rounded-4 overflow-hidden position-relative" style="background: @bgGradient; border-left: 6px solid @borderLeftColor !important;">
        <div class="card-body p-4">
            
            <!-- Header Bar -->
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="badge @headerBadgeBg text-white px-3 py-1.5 rounded-pill fw-bold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                        <i class="bi bi-broadcast me-1"></i>@L["Proactive Weather Nudge"]
                    </span>
                    <span class="badge bg-white text-dark border px-2.5 py-1 rounded-pill small fw-semibold">
                        <i class="bi bi-geo-alt text-success me-1"></i>@ws.District (@ws.Division)
                    </span>
                    <span class="badge bg-white text-success border px-2.5 py-1 rounded-pill small fw-semibold">
                        <i class="bi bi-flower2 me-1"></i>@(isBangla ? ws.BanglaCrop : ws.FarmerCrop) · @(isBangla ? ws.BanglaCropStage : ws.CropStage)
                    </span>
                    @if (ws.RainAlert)
                    {
                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle px-2.5 py-1 rounded-pill small fw-bold animate__animated animate__pulse animate__infinite">
                            <i class="bi bi-cloud-rain-heavy-fill me-1"></i>@L["Rain Risk: {0}% in next 3-5 days", ws.MaxRainChance.ToString("0")]
                        </span>
                    }
                </div>

                <a asp-controller="Advisory" asp-action="Suggestions" class="text-decoration-none small fw-bold text-success d-inline-flex align-items-center gap-1">
                    <span>@L["Explore All Advisory Nudges"]</span>
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            <!-- Banner Message -->
            <div class="row align-items-center gy-3 mb-3">
                <div class="col-12 col-lg-8">
                    <h5 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                        <span>@(isBangla ? ws.BanglaBannerTitle : ws.BannerTitle)</span>
                    </h5>
                    <p class="text-secondary small mb-0" style="line-height: 1.6;">
                        @(isBangla ? ws.BanglaBannerMessage : ws.BannerMessage)
                    </p>
                </div>

                <!-- Mini 5-day Weather Forecast Strip -->
                @if (ws.Weather.FiveDayForecast != null && ws.Weather.FiveDayForecast.Any())
                {
                    <div class="col-12 col-lg-4">
                        <div class="bg-white bg-opacity-80 p-2.5 rounded-3 border d-flex justify-content-between align-items-center text-center shadow-2xs">
                            @foreach (var day in ws.Weather.FiveDayForecast.Take(4))
                            {
                                <div class="px-1.5 border-end last-border-0" style="min-width: 55px;">
                                    <span class="d-block text-muted" style="font-size: 0.68rem;">@(isBangla ? day.BanglaDayName : day.DayName)</span>
                                    <i class="bi @day.ConditionIcon fs-6 @(day.RainChance >= 45 ? "text-danger" : "text-warning") my-0.5 d-block"></i>
                                    <span class="d-block fw-bold text-dark" style="font-size: 0.75rem;">@day.MaxTemp.ToString("0")°</span>
                                    <span class="d-block text-muted" style="font-size: 0.65rem;">@day.RainChance.ToString("0")% 🌧️</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Actionable Suggestion Cards Grid -->
            @if (ws.Suggestions.Any())
            {
                <div class="row g-3 pt-2 border-top border-dark border-opacity-10">
                    @foreach (var nudge in ws.Suggestions)
                    {
                        <div class="col-12 @(ws.Suggestions.Count > 1 ? "col-md-6" : "")">
                            <div class="bg-white p-3 rounded-3 border shadow-xs h-100 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex align-items-center justify-content-between gap-2 mb-1.5">
                                        <span class="badge bg-@nudge.BadgeClass-subtle text-@nudge.BadgeClass border border-@nudge.BadgeClass-subtle rounded-pill px-2.5 py-0.5 small fw-bold">
                                            <i class="bi @nudge.IconClass me-1"></i>@(isBangla ? nudge.BanglaBadgeText : nudge.BadgeText)
                                        </span>
                                        @if (nudge.IsCritical)
                                        {
                                            <span class="badge bg-danger text-white rounded-pill px-2 py-0.5" style="font-size: 0.68rem;">
                                                @L["High Priority"]
                                            </span>
                                        }
                                    </div>
                                    <h6 class="fw-bold text-dark mb-1">
                                        @(isBangla ? nudge.BanglaTitle : nudge.Title)
                                    </h6>
                                    <p class="text-muted small mb-3" style="line-height: 1.5;">
                                        @(isBangla ? nudge.BanglaMessage : nudge.Message)
                                    </p>
                                </div>

                                <a href="@nudge.ActionUrl" class="btn btn-sm btn-@nudge.BadgeClass rounded-pill px-3 py-2 fw-semibold d-inline-flex align-items-center justify-content-center gap-1.5 shadow-xs w-100">
                                    <span>@(isBangla ? nudge.BanglaActionText : nudge.ActionText)</span>
                                    <i class="bi @nudge.ActionIcon"></i>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (!ws.HasProfileCrop || !ws.HasProfileDistrict)
            {
                <div class="mt-3 pt-2 border-top small text-muted d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <span>
                        <i class="bi bi-info-circle text-primary me-1"></i>
                        @L["Want more personalized nudges? Update your primary crop and district in your profile."]
                    </span>
                    <a asp-controller="Account" asp-action="Profile" class="btn btn-sm btn-outline-secondary rounded-pill py-0.5 px-2.5 text-nowrap">
                        @L["Edit Profile"]
                    </a>
                </div>
            }

        </div>
    </div>
}
else if (Model.WeatherAlert != null)
{
    <!-- Live Weather & Disease Advisory Banner (Fallback) -->
    <div class="card border-0 shadow-sm mb-4 rounded-4 overflow-hidden" style="background-color: #fffbeb; border-left: 5px solid #f59e0b !important;">
        <div class="card-body p-3.5 d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-start gap-3">
                <div class="d-flex align-items-center justify-content-center rounded-circle bg-warning bg-opacity-20 text-warning-emphasis flex-shrink-0" style="width: 44px; height: 44px;">
                    <i class="bi @Model.WeatherAlert.IconClass fs-5"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                        <span class="badge bg-warning text-dark font-monospace small px-2 py-0.5">@Model.WeatherAlert.BadgeText</span>
                        <h6 class="fw-bold mb-0 text-dark">@Model.WeatherAlert.Title</h6>
                    </div>
                    <p class="mb-0 small text-secondary" style="max-width: 750px; line-height: 1.5;">@Model.WeatherAlert.Message</p>
                </div>
            </div>
            <a asp-controller="Advisory" asp-action="Alerts" class="btn btn-sm btn-outline-dark rounded-pill px-3 py-1.5 fw-semibold text-nowrap">
                <i class="bi bi-shield-shaded me-1"></i>@L["View Full Outbreak Alerts"]
            </a>
        </div>
    </div>
}

@if (Model.CropCalendarAdvisory != null)
{
    var adv = Model.CropCalendarAdvisory;
    var isBn = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bn";
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4 position-relative"
         style="background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); border: 1px solid #e2e8f0 !important; border-left: 6px solid #0284c7 !important;">
        <div class="card-body p-3.5 p-md-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-3">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="badge bg-info text-dark rounded-pill px-3 py-1 small fw-bold text-uppercase" style="letter-spacing: 0.5px;">
                        <i class="bi bi-calendar3-event me-1"></i>@L["Monthly Crop Advisory"]
                    </span>
                    <span class="badge bg-white text-dark border px-2.5 py-1 rounded-pill small fw-semibold">
                        <i class="bi bi-clock-history text-info me-1"></i>@(isBn ? adv.BanglaMonthName : adv.MonthName)
                    </span>
                    <span class="badge bg-white text-dark border px-2.5 py-1 rounded-pill small fw-semibold">
                        <i class="bi bi-flower2 text-success me-1"></i>@(isBn ? adv.BanglaCropName : adv.CropName)
                    </span>
                    <span class="badge bg-@adv.PhaseBadgeColor text-white px-2.5 py-1 rounded-pill small fw-bold">
                        @(isBn ? adv.CurrentPhaseBangla : adv.CurrentPhase)
                    </span>
                    @if (!adv.IsSuitableDistrict)
                    {
                        <span class="badge bg-warning bg-opacity-25 text-dark border border-warning-subtle px-2 py-0.5 rounded-pill small">
                            <i class="bi bi-geo-alt me-1"></i>@L["Non-primary zone for {0}", adv.District]
                        </span>
                    }
                </div>

                <a asp-controller="Advisory" asp-action="Calendar" class="text-decoration-none small fw-bold text-primary d-inline-flex align-items-center gap-1">
                    <span>@L["Full Crop Calendar"]</span>
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            <div class="mb-3">
                <h6 class="fw-bold text-dark mb-1">
                    <i class="bi bi-info-circle text-info me-1"></i>
                    @L["What to do this month for your crop"]
                </h6>
                <p class="text-secondary small mb-0" style="line-height: 1.6;">
                    @(isBn ? adv.AdvisorySummaryBangla : adv.AdvisorySummary)
                </p>
            </div>

            @if (!string.IsNullOrWhiteSpace(adv.KeyTips))
            {
                <div class="p-2.5 rounded-3 bg-white border small mb-3 text-secondary d-flex align-items-start gap-2">
                    <i class="bi bi-lightbulb-fill text-warning fs-6 mt-0.5 flex-shrink-0"></i>
                    <div>
                        <strong class="text-dark">@L["Agronomic Advice:"]</strong> @adv.KeyTips
                    </div>
                </div>
            }

            <div class="d-flex flex-wrap gap-2 small">
                @if (!string.IsNullOrWhiteSpace(adv.OptimalTemperature))
                {
                    <span class="badge bg-white text-muted border px-2.5 py-1 rounded-pill">
                        <i class="bi bi-thermometer-half text-danger me-1"></i>@adv.OptimalTemperature
                    </span>
                }
                @if (!string.IsNullOrWhiteSpace(adv.PopularVarieties))
                {
                    <span class="badge bg-white text-muted border px-2.5 py-1 rounded-pill">
                        <i class="bi bi-stars text-warning me-1"></i>@adv.PopularVarieties
                    </span>
                }
                @if (!string.IsNullOrWhiteSpace(adv.WaterRequirement))
                {
                    <span class="badge bg-white text-muted border px-2.5 py-1 rounded-pill">
                        <i class="bi bi-droplet-half text-primary me-1"></i>@adv.WaterRequirement
                    </span>
                }
            </div>
        </div>
    </div>
}

<!-- KrishiPoints Loyalty Summary Card -->
@if (Model.LoyaltyWidget != null)
{
    var lw = Model.LoyaltyWidget;
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4 position-relative"
         style="background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border: 1px solid #bbf7d0 !important;">
        <div class="card-body p-3.5 p-md-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center flex-shrink-0 shadow-xs" style="width: 52px; height: 52px; font-size: 1.5rem;">
                        <span>@lw.TierIcon</span>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="badge bg-success text-white rounded-pill px-2.5 py-1 small fw-bold">
                                @L["KrishiPoints Rewards"]
                            </span>
                            <span class="badge bg-white text-success border px-2 py-0.5 rounded-pill small fw-semibold">
                                @L[lw.TierName] (@lw.DiscountMultiplier.ToString("0.0")x @L["Discount Power"])
                            </span>
                            @if (lw.ActiveVouchersCount > 0)
                            {
                                <span class="badge bg-warning text-dark border px-2 py-0.5 rounded-pill small fw-bold">
                                    <i class="bi bi-ticket-perforated-fill me-1"></i>@L["{0} Active Vouchers", lw.ActiveVouchersCount]
                                </span>
                            }
                        </div>
                        <div class="d-flex align-items-baseline gap-2 mt-1">
                            <h4 class="fw-black text-success mb-0">@lw.CurrentPoints.ToString("N0") <span class="fs-6 fw-bold text-dark">@L["KrishiPoints"]</span></h4>
                            @if (!string.IsNullOrEmpty(lw.NextTierName))
                            {
                                <span class="small text-muted">· @L["{0} pts to {1}", lw.PointsToNextTier, L[lw.NextTierName]]</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2 flex-shrink-0 w-100 w-md-auto justify-content-end">
                    <a asp-controller="Loyalty" asp-action="Index" class="btn btn-success rounded-pill px-4 py-2 fw-semibold shadow-xs d-flex align-items-center gap-2">
                        <i class="bi bi-gift-fill"></i>
                        <span>@L["Loyalty Hub & Redeem"]</span>
                    </a>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(lw.NextTierName) && lw.ProgressToNextTierPercent > 0)
            {
                <div class="mt-3 pt-2 border-top border-success-subtle">
                    <div class="d-flex justify-content-between align-items-center small mb-1 text-muted">
                        <span>@L["Tier Progress"]</span>
                        <span class="fw-bold text-success">@lw.ProgressToNextTierPercent%</span>
                    </div>
                    <div class="progress" style="height: 6px; border-radius: 3px; background-color: #bbf7d0;">
                        <div class="progress-bar bg-success" role="progressbar" style="width: @lw.ProgressToNextTierPercent%;" aria-valuenow="@lw.ProgressToNextTierPercent" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<!-- Quick Action Cards (Row of 3) -->
<div class="row g-3 g-lg-4 mb-5">
    <!-- Find Equipment -->
    <div class="col-12 col-md-4">
        <a asp-controller="Equipment" asp-action="Index" class="text-decoration-none">
            <div class="card border-0 shadow-sm h-100 text-center p-4 krishi-action-card" style="border-radius: var(--krishi-radius-lg); background-color: var(--krishi-surface); border: 1px solid var(--krishi-border-color) !important;">
                <h5 class="fw-bold mb-2 text-success">@L["Find Equipment"]</h5>
                <p class="small mb-0" style="color: var(--krishi-text-muted);">@L["Browse tractors, tillers, harvesters & more for rent near you."]</p>
            </div>
        </a>
    </div>
    <!-- Find Storage -->
    <div class="col-12 col-md-4">
        <a asp-controller="Godown" asp-action="Index" class="text-decoration-none">
            <div class="card border-0 shadow-sm h-100 text-center p-4 krishi-action-card" style="border-radius: var(--krishi-radius-lg); background-color: var(--krishi-surface); border: 1px solid var(--krishi-border-color) !important;">
                <h5 class="fw-bold mb-2 text-success">@L["Find Storage"]</h5>
                <p class="small mb-0" style="color: var(--krishi-text-muted);">@L["Secure cold-storage and warehouses for your harvest across Bangladesh."]</p>
            </div>
        </a>
    </div>
    <!-- Get Crop Advice -->
    <div class="col-12 col-md-4">
        <a asp-controller="Advisory" asp-action="Index" class="text-decoration-none">
            <div class="card border-0 shadow-sm h-100 text-center p-4 krishi-action-card" style="border-radius: var(--krishi-radius-lg); background-color: var(--krishi-surface); border: 1px solid var(--krishi-border-color) !important;">
                <h5 class="fw-bold mb-2 text-success">@L["Get Crop Advice"]</h5>
                <p class="small mb-0" style="color: var(--krishi-text-muted);">@L["Personalized crop recommendations based on your soil, climate & region."]</p>
            </div>
        </a>
    </div>
</div>

<!-- Active Bookings Summary -->
<div class="mb-5">
    <div class="d-flex align-items-center gap-2 mb-3">
        <h5 class="fw-bold mb-0" style="color: var(--krishi-text-primary);">@L["Active Bookings"]</h5>
        <span class="badge rounded-pill ms-1" style="background-color: var(--krishi-primary-light); color: var(--krishi-primary); font-size: 0.78rem;">
            @Model.ActiveBookings.Count
        </span>
    </div>

    @if (Model.ActiveBookings.Any())
    {
        <!-- Desktop: responsive table -->
        <div class="card border-0 shadow-sm" style="border-radius: var(--krishi-radius-md); border: 1px solid var(--krishi-border-color) !important; overflow: hidden;">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr style="background-color: var(--krishi-primary-light);">
                            <th class="fw-semibold small text-uppercase ps-3 py-2.5" style="color: var(--krishi-text-muted); letter-spacing: 0.04em;">@L["Item"]</th>
                            <th class="fw-semibold small text-uppercase py-2.5 d-none d-md-table-cell" style="color: var(--krishi-text-muted); letter-spacing: 0.04em;">@L["Type"]</th>
                            <th class="fw-semibold small text-uppercase py-2.5 d-none d-lg-table-cell" style="color: var(--krishi-text-muted); letter-spacing: 0.04em;">@L["Location"]</th>
                            <th class="fw-semibold small text-uppercase py-2.5 d-none d-md-table-cell" style="color: var(--krishi-text-muted); letter-spacing: 0.04em;">@L["Dates"]</th>
                            <th class="fw-semibold small text-uppercase py-2.5" style="color: var(--krishi-text-muted); letter-spacing: 0.04em;">@L["Status"]</th>
                            <th class="fw-semibold small text-uppercase py-2.5 pe-3 text-end" style="color: var(--krishi-text-muted); letter-spacing: 0.04em;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in Model.ActiveBookings)
                        {
                            <tr>
                                <td class="ps-3 py-3">
                                    <div>
                                        <span class="fw-semibold d-block" style="color: var(--krishi-text-primary);">@booking.ItemName</span>
                                        <span class="small d-md-none" style="color: var(--krishi-text-muted);">@L[booking.BookingType] · @booking.DateRange</span>
                                    </div>
                                </td>
                                <td class="d-none d-md-table-cell py-3">
                                    <span class="badge rounded-pill px-2 py-1 small fw-medium"
                                          style="background-color: @(booking.BookingType == "Godown" ? "var(--krishi-status-pending-bg)" : "var(--krishi-primary-light)"); color: @(booking.BookingType == "Godown" ? "var(--krishi-status-pending-text)" : "var(--krishi-primary)");">
                                        @L[booking.BookingType]
                                    </span>
                                </td>
                                <td class="d-none d-lg-table-cell py-3">
                                    <span class="small" style="color: var(--krishi-text-muted);">
                                        @booking.Location
                                    </span>
                                </td>
                                <td class="d-none d-md-table-cell py-3">
                                    <span class="small" style="color: var(--krishi-text-muted);">@booking.DateRange</span>
                                </td>
                                <td class="py-3">
                                    <partial name="_StatusBadge" model="@booking.Status" />
                                </td>
                                <td class="py-3 pe-3 text-end">
                                    <a href="@(booking.DetailUrl ?? "#")" class="btn btn-sm btn-krishi-outline rounded-pill px-3 py-1" title='@L["View booking details"]' aria-label='@L["View details for {0}", booking.ItemName]'>
                                        @L["Details"]
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <!-- Empty state -->
        <div class="card border-0 shadow-sm text-center py-5 px-4" style="border-radius: var(--krishi-radius-md); border: 1px solid var(--krishi-border-color) !important; background-color: var(--krishi-surface);">
            <h6 class="fw-bold mb-2" style="color: var(--krishi-text-primary);">@L["No active bookings yet"]</h6>
            <p class="mb-3" style="color: var(--krishi-text-muted);">@L["Start by finding equipment or storage to rent for your farm."]</p>
            <div class="d-flex justify-content-center gap-2 flex-wrap">
                <a asp-controller="Equipment" asp-action="Index" class="btn btn-krishi-primary rounded-pill px-4 py-2 fw-semibold">
                    @L["Find Equipment"]
                </a>
                <a asp-controller="Godown" asp-action="Index" class="btn btn-krishi-outline rounded-pill px-4 py-2 fw-semibold">
                    @L["Find Storage"]
                </a>
            </div>
        </div>
    }
</div>

<!-- Two-Column — Crop Recommendation + Recent Activity -->
<div class="row g-4 mb-4">
    <!-- Recommended Crops Widget -->
    <div class="col-12 col-lg-5">
        <div class="d-flex align-items-center gap-2 mb-3">
            <h5 class="fw-bold mb-0" style="color: var(--krishi-text-primary);">@L["Crop Recommendation"]</h5>
        </div>

        @if (Model.SavedRecommendation != null)
        {
            <div class="card border-0 shadow-sm h-100" style="border-radius: var(--krishi-radius-md); border: 1px solid var(--krishi-border-color) !important; background-color: var(--krishi-surface);">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex align-items-start gap-3 mb-3">
                        <div>
                            <h6 class="fw-bold mb-1" style="color: var(--krishi-text-primary);">@Model.SavedRecommendation.CropName</h6>
                            <span class="badge rounded-pill px-2 py-1 small fw-medium" style="background-color: var(--krishi-primary-light); color: var(--krishi-primary);">
                                @L[Model.SavedRecommendation.Season]
                            </span>
                        </div>
                    </div>
                    <p class="small mb-3 flex-grow-1" style="color: var(--krishi-text-muted); line-height: 1.7;">
                        @Model.SavedRecommendation.Summary
                    </p>
                    <a href="@(Model.SavedRecommendation.GuideUrl ?? "#")" class="btn btn-krishi-primary rounded-pill px-4 py-2 fw-semibold d-flex align-items-center justify-content-center gap-1 mt-auto">
                        <span>@L["View Full Guide"]</span>
                    </a>
                </div>
            </div>
        }
        else
        {
            <!-- Empty state: no recommendation -->
            <div class="card border-0 shadow-sm h-100 text-center" style="border-radius: var(--krishi-radius-md); border: 1px solid var(--krishi-border-color) !important; background-color: var(--krishi-surface);">
                <div class="card-body p-4 d-flex flex-column align-items-center justify-content-center">
                    <h6 class="fw-bold mb-2" style="color: var(--krishi-text-primary);">@L["No recommendations yet"]</h6>
                    <p class="small mb-3" style="color: var(--krishi-text-muted);">@L["Get personalized crop advice based on your region and soil type."]</p>
                    <a asp-controller="Advisory" asp-action="Index" class="btn btn-krishi-primary rounded-pill px-4 py-2 fw-semibold">
                        @L["Get Crop Advice"]
                    </a>
                </div>
            </div>
        }
    </div>

    <!-- Recent Activity Feed -->
    <div class="col-12 col-lg-7">
        <div class="d-flex align-items-center gap-2 mb-3">
            <h5 class="fw-bold mb-0" style="color: var(--krishi-text-primary);">@L["Recent Activity"]</h5>
        </div>

        @if (Model.RecentActivity.Any())
        {
            <div class="card border-0 shadow-sm" style="border-radius: var(--krishi-radius-md); border: 1px solid var(--krishi-border-color) !important; background-color: var(--krishi-surface);">
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush" style="border-radius: var(--krishi-radius-md);">
                        @foreach (var activity in Model.RecentActivity)
                        {
                            <li class="list-group-item border-0 px-4 py-3 d-flex align-items-start gap-3" style="border-bottom: 1px solid var(--krishi-border-color) !important;">
                                <div class="flex-grow-1">
                                    <p class="mb-1 small fw-medium" style="color: var(--krishi-text-primary); line-height: 1.5;">
                                        @activity.Description
                                    </p>
                                    <span class="small" style="color: var(--krishi-text-muted);">
                                        @activity.TimeAgo
                                    </span>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
        else
        {
            <!-- Empty state: no activity -->
            <div class="card border-0 shadow-sm text-center py-5 px-4" style="border-radius: var(--krishi-radius-md); border: 1px solid var(--krishi-border-color) !important; background-color: var(--krishi-surface);">
                <h6 class="fw-bold mb-2" style="color: var(--krishi-text-primary);">@L["No recent activity"]</h6>
                <p class="small mb-0" style="color: var(--krishi-text-muted);">@L["Your recent actions like booking requests and advisory lookups will appear here."]</p>
            </div>
        }
    </div>
</div>

<style>
    .krishi-action-card {
        transition: transform 0.22s ease, box-shadow 0.22s ease;
        cursor: pointer;
    }
    .krishi-action-card:hover {
        transform: translateY(-4px) scale(1.015);
        box-shadow: var(--krishi-shadow-md) !important;
    }
    .table-hover tbody tr {
        transition: background-color 0.15s ease;
    }
    .table-hover tbody tr:hover {
        background-color: var(--krishi-primary-light) !important;
    }
    .list-group-item {
        transition: background-color 0.15s ease;
    }
    .list-group-item:hover {
        background-color: var(--krishi-primary-light) !important;
    }
</style>
