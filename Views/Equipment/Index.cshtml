@model KrishiLink.Models.ViewModels.EquipmentBrowseViewModel
@{
    ViewData["Title"] = L["Browse & Rent Equipment"];
    var activeFiltersCount = 0;
    if (!string.IsNullOrWhiteSpace(Model.SearchTerm)) activeFiltersCount++;
    if (Model.SelectedCategories.Any()) activeFiltersCount += Model.SelectedCategories.Count;
    if (!string.IsNullOrWhiteSpace(Model.Location)) activeFiltersCount++;
    if (Model.SelectedMaxPrice.HasValue && Model.SelectedMaxPrice.Value < Model.MaxPrice) activeFiltersCount++;
    if (Model.StartDate.HasValue || Model.EndDate.HasValue || Model.AvailabilityDate.HasValue) activeFiltersCount++;
    var localizedCategoriesJson = System.Text.Json.JsonSerializer.Serialize(Model.AvailableCategories.ToDictionary(c => c, c => L[c].Value));
    var localizedLocationsJson = System.Text.Json.JsonSerializer.Serialize(Model.AvailableLocations.ToDictionary(loc => loc, loc => L[loc].Value));
}

<!-- Page Header & Hero Banner -->
<div class="krishi-browse-header rounded-4 p-4 p-md-5 mb-4 text-white position-relative overflow-hidden shadow-sm" style="background: linear-gradient(135deg, #1b4332 0%, #2d6a4f 60%, #40916c 100%);">
    <div class="row align-items-center position-relative" style="z-index: 2;">
        <div class="col-lg-8">
            <span class="badge bg-light text-success fw-bold px-3 py-1.5 rounded-pill mb-2 mb-md-3">
                <i class="bi bi-gear-wide-connected me-1"></i> @L["Agricultural Equipment Marketplace"]
            </span>
            <h1 class="display-6 fw-bold mb-2 text-white">@L["Find & Rent Agricultural Machinery"]</h1>
            <p class="lead text-white-50 mb-0 fs-6">
                @L["Discover modern tractors, combine harvesters, power tillers, and sprayers from verified nearby owners at affordable daily or hourly rates."]
            </p>
        </div>
        <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
            <div class="d-inline-flex flex-column align-items-lg-end bg-white bg-opacity-10 border border-white border-opacity-25 rounded-3 p-3 text-white text-start">
                <span class="small text-white-50">@L["Verified Machinery"]</span>
                <span class="fs-4 fw-bold" id="heroListingCount">@L["{0} Available Items", Model.EquipmentList.Count]</span>
                <span class="small text-white-50"><i class="bi bi-shield-check text-warning me-1"></i>@L["Live availability"]</span>
            </div>
        </div>
    </div>
    <!-- Decorative background icon -->
    <div class="position-absolute end-0 bottom-0 opacity-10" style="transform: translate(20%, 20%); pointer-events: none;">
        <i class="bi bi-truck" style="font-size: 20rem; color: #fff;"></i>
    </div>
</div>

<!-- Mobile Sticky Filter Bar (< lg) -->
<div class="d-lg-none mb-3">
    <div class="d-flex gap-2">
        <button class="btn btn-krishi-primary flex-grow-1 d-flex justify-content-between align-items-center py-2.5 px-3 rounded-3 shadow-sm" 
                type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileFilterBottomSheet" aria-controls="mobileFilterBottomSheet">
            <span class="d-flex align-items-center gap-2 fw-semibold">
                <i class="bi bi-sliders2"></i> @L["Filter Equipment"]
            </span>
            <span class="badge bg-white text-success rounded-pill px-2.5 py-1" id="mobileFilterBadge">
                @(activeFiltersCount > 0 ? L["{0} active", activeFiltersCount] : L["Filters"])
            </span>
        </button>
        <button type="button" class="btn btn-outline-secondary rounded-3 px-3" onclick="resetAllFilters()" title="@L["Reset Filters"]">
            <i class="bi bi-arrow-counterclockwise"></i>
        </button>
    </div>
</div>

<div class="row g-4">
    
    <!-- ==========================================
         DESKTOP LEFT SIDEBAR: FILTERS (>= lg)
         ========================================== -->
    <div class="col-12 col-lg-4 col-xl-3 d-none d-lg-block">
        <div class="card krishi-card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 85px; z-index: 10;">
            
            <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-sliders text-success fs-5"></i>
                    <h5 class="fw-bold mb-0 text-dark">@L["Filters"]</h5>
                </div>
                <div class="d-flex align-items-center gap-1.5">
                    <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-2.5 py-1 d-flex align-items-center gap-1 fw-semibold" onclick="openSaveSearchModal('Equipment')" title="@L["Save this search"]">
                        <i class="bi bi-bookmark-plus"></i>
                        <span class="small">@L["Save"]</span>
                    </button>
                    <button type="button" class="btn btn-link btn-sm text-danger text-decoration-none p-0 fw-semibold clear-filters-btn @(activeFiltersCount > 0 ? "" : "d-none")" onclick="resetAllFilters()">
                        <i class="bi bi-x-circle me-1"></i>@L["Clear Filters"]
                    </button>
                </div>
            </div>

            <!-- 1. Equipment Type / Category Filter -->
            <div class="mb-4">
                <label class="form-label fw-bold text-dark small text-uppercase tracking-wider mb-2.5 d-flex justify-content-between align-items-center">
                    <span>@L["Equipment Type"]</span>
                    <span class="badge bg-light text-muted border">@Model.AvailableCategories.Count</span>
                </label>
                <div class="d-flex flex-column gap-2" style="max-height: 220px; overflow-y: auto;">
                    @foreach (var category in Model.AvailableCategories)
                    {
                        var isChecked = Model.SelectedCategories.Contains(category);
                        <div class="form-check custom-checkbox">
                            <input class="form-check-input filter-input desktop-cat-filter" type="checkbox" name="selectedCategories" 
                                   value="@category" id="desk_cat_@category.Replace(" ", "_").Replace("/", "_")" @(isChecked ? "checked" : "") onchange="onFilterChanged()" />
                            <label class="form-check-label text-secondary small user-select-none d-flex justify-content-between" for="desk_cat_@category.Replace(" ", "_").Replace("/", "_")">
                                <span>@L[category]</span>
                            </label>
                        </div>
                    }
                </div>
            </div>

            <!-- 2. Location / District Filter -->
            <div class="mb-4">
                <label class="form-label fw-bold text-dark small text-uppercase tracking-wider mb-2" for="desktopLocationSelect">
                    @L["Location / District"]
                </label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted">
                        <i class="bi bi-geo-alt-fill text-success"></i>
                    </span>
                    <select class="form-select border-start-0 filter-input" id="desktopLocationSelect" onchange="syncLocation(this.value); onFilterChanged(1);">
                        <option value="">@L["All Locations (Bangladesh)"]</option>
                        @foreach (var loc in Model.AvailableLocations)
                        {
                            <option value="@loc" selected="@((Model.District == loc || Model.Location == loc) ? "selected" : null)">@L[loc]</option>
                        }
                    </select>
                </div>
            </div>

            <!-- 3. Price Range (Daily Rate) -->
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label class="form-label fw-bold text-dark small text-uppercase tracking-wider mb-0" for="desktopPriceSlider">
                        @L["Daily Rate (৳)"]
                    </label>
                    <span class="badge bg-success-subtle text-success fw-bold px-2 py-1 desktop-price-display">
                        ৳@((Model.SelectedMinPrice ?? Model.MinPrice).ToString("N0")) – ৳@((Model.SelectedMaxPrice ?? Model.MaxPrice).ToString("N0"))
                    </span>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="small text-muted mb-1" for="desktopMinPriceInput">@L["Min ৳"]</label>
                        <input type="number" class="form-control form-control-sm filter-input" id="desktopMinPriceInput"
                               min="@Model.MinPrice" max="@Model.MaxPrice" step="100" 
                               value="@(Model.SelectedMinPrice ?? Model.MinPrice)" 
                               onchange="syncPriceInputs(); onFilterChanged(1);" />
                    </div>
                    <div class="col-6">
                        <label class="small text-muted mb-1" for="desktopMaxPriceInput">@L["Max ৳"]</label>
                        <input type="number" class="form-control form-control-sm filter-input" id="desktopMaxPriceInput"
                               min="@Model.MinPrice" max="@Model.MaxPrice" step="100" 
                               value="@(Model.SelectedMaxPrice ?? Model.MaxPrice)" 
                               onchange="syncPriceInputs(); onFilterChanged(1);" />
                    </div>
                </div>
                <input type="range" class="form-range filter-input" id="desktopPriceSlider"
                       min="@Model.MinPrice" max="@Model.MaxPrice" step="100" 
                       value="@(Model.SelectedMaxPrice ?? Model.MaxPrice)" 
                       oninput="syncSliderToMaxInput(this.value)"
                       onchange="onFilterChanged(1)" />
                <div class="d-flex justify-content-between small text-muted">
                    <span>৳@Model.MinPrice.ToString("N0")</span>
                    <span>৳@Model.MaxPrice.ToString("N0")</span>
                </div>
            </div>

            <!-- 4. Availability Date Range Picker -->
            <div class="mb-4">
                <label class="form-label fw-bold text-dark small text-uppercase tracking-wider mb-2">
                    @L["Required Dates"]
                </label>
                <div class="row g-2">
                    <div class="col-6">
                        <label class="small text-muted mb-1" for="desktopStartDateInput">@L["From"]</label>
                        <input type="date" class="form-control form-control-sm border-start-0 filter-input" id="desktopStartDateInput"
                               value="@(Model.StartDate.HasValue ? Model.StartDate.Value.ToString("yyyy-MM-dd") : (Model.AvailabilityDate.HasValue ? Model.AvailabilityDate.Value.ToString("yyyy-MM-dd") : ""))"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" onchange="syncDates(); onFilterChanged(1);" />
                    </div>
                    <div class="col-6">
                        <label class="small text-muted mb-1" for="desktopEndDateInput">@L["To"]</label>
                        <input type="date" class="form-control form-control-sm border-start-0 filter-input" id="desktopEndDateInput"
                               value="@(Model.EndDate.HasValue ? Model.EndDate.Value.ToString("yyyy-MM-dd") : "")"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" onchange="syncDates(); onFilterChanged(1);" />
                    </div>
                </div>
            </div>

            <!-- 5. Units Needed Filter -->
            <div class="mb-4">
                <label class="form-label fw-bold text-dark small text-uppercase tracking-wider mb-2" for="desktopUnitsInput">
                    @L["Units Needed"]
                </label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-boxes"></i></span>
                    <input type="number" class="form-control form-control-sm filter-input" id="desktopUnitsInput"
                           min="1" max="50" value="@(Model.Units > 1 ? Model.Units : 1)" onchange="syncUnits(this.value); onFilterChanged(1);" />
                </div>
            </div>

            <!-- Clear Filters Link -->
            <div class="pt-2">
                <button type="button" class="btn btn-outline-secondary w-100 btn-sm py-2 rounded-3" onclick="resetAllFilters()">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> @L["Clear Filters"]
                </button>
            </div>

        </div>
    </div>

    <!-- ==========================================
         RIGHT SECTION: SEARCH BAR & RESULTS GRID
         ========================================== -->
    <div class="col-12 col-lg-8 col-xl-9">
        
        <!-- Top Controls: Search Bar & Sort Dropdown -->
        <div class="card krishi-card border-0 shadow-sm rounded-4 p-3 mb-4">
            <div class="row g-2 align-items-center">
                
                <!-- Search Input with Debounce & Clear Icon -->
                <div class="col-12 col-md-7 col-xl-8">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted ps-3">
                            <i class="bi bi-search text-success"></i>
                        </span>
                        <input type="text" class="form-control border-start-0 py-2" id="mainSearchInput" 
                               value="@Model.SearchTerm" placeholder="@L["Search machinery name, type, owner, or area..."]"
                               oninput="onSearchInput(this.value)" />
                        <button class="btn btn-outline-light border text-muted d-none" type="button" id="clearSearchBtn" onclick="clearSearch()">
                            <i class="bi bi-x-lg small"></i>
                        </button>
                    </div>
                </div>

                <!-- Sort Dropdown -->
                <div class="col-12 col-md-5 col-xl-4">
                    <div class="d-flex align-items-center justify-content-md-end gap-2">
                        <label class="small text-muted text-nowrap fw-semibold d-none d-sm-inline" for="mainSortSelect">
                            <i class="bi bi-arrow-down-up me-1"></i>@L["Sort:"]
                        </label>
                        <select class="form-select form-select-sm py-2" id="mainSortSelect" onchange="onFilterChanged(1)">
                            <option value="newest" selected="@(Model.SortBy == "newest" ? "selected" : null)">@L["Newest First"]</option>
                            <option value="rating_desc" selected="@(Model.SortBy == "rating_desc" ? "selected" : null)">@L["Highest Rated"]</option>
                            <option value="price_asc" selected="@(Model.SortBy == "price_asc" ? "selected" : null)">@L["Price: Low to High"]</option>
                            <option value="price_desc" selected="@(Model.SortBy == "price_desc" ? "selected" : null)">@L["Price: High to Low"]</option>
                            <option value="location" selected="@(Model.SortBy == "location" || Model.SortBy == "distance" ? "selected" : null)">@L["Location (A-Z)"]</option>
                        </select>
                    </div>
                </div>

            </div>
        </div>

        <!-- Results Summary & Active Filter Tags Bar -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 px-1">
            <span class="text-secondary small fw-medium" id="resultsCountSummary">
                @L["Showing"] <strong class="text-dark" id="resultsCountNumber">@Model.TotalCount</strong> @L["equipment available for rent"]
            </span>

            <div class="d-flex flex-wrap align-items-center gap-1.5" id="activeFilterTagsContainer">
                <!-- Injected via JavaScript -->
            </div>
        </div>

        <!-- ==========================================
             SKELETON LOADING PLACEHOLDERS
             ========================================== -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4 d-none" id="skeletonLoadingContainer">
            @for (int i = 0; i < 6; i++)
            {
                <div class="col">
                    <div class="krishi-skeleton-card h-100 p-0 shadow-sm border-0 rounded-4">
                        <div class="krishi-shimmer krishi-skeleton-img"></div>
                        <div class="p-3.5">
                            <div class="krishi-shimmer krishi-skeleton-line-title"></div>
                            <div class="krishi-shimmer krishi-skeleton-line w-75"></div>
                            <div class="krishi-shimmer krishi-skeleton-line w-50 mb-4"></div>
                            <div class="krishi-shimmer krishi-skeleton-btn"></div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- ==========================================
             EQUIPMENT RESULTS GRID
             ========================================== -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4" id="equipmentResultsGrid">
            @foreach (var item in Model.EquipmentList)
            {
                <div class="col equipment-card-col">
                    <div class="card krishi-card h-100 border-0 shadow-sm rounded-4 overflow-hidden d-flex flex-column transition-hover" 
                         style="cursor: pointer;" onclick="location.href='@Url.Action("Details", "Equipment", new { id = item.Id })'">
                        
                        <!-- Equipment Image & Badges -->
                        <div class="krishi-equipment-img-box">
                            <img src="@item.ImageUrl" alt="@item.Name" loading="lazy" />
                            
                            <!-- Category Pill & Quantity Badge -->
                            <div class="position-absolute top-0 start-0 m-2.5 d-flex flex-column gap-1 align-items-start">
                                <span class="badge bg-white text-dark shadow-sm rounded-pill px-2.5 py-1 small fw-semibold opacity-95">
                                    @L[item.Category]
                                </span>
                                @if (item.Quantity > 1)
                                {
                                    <span class="badge bg-primary text-white shadow-sm rounded-pill px-2.5 py-1 small fw-semibold">
                                        <i class="bi bi-boxes me-1"></i>@item.Quantity @L["Units"]
                                    </span>
                                }
                            </div>

                            <!-- Availability Badge & Heart Button -->
                            <div class="position-absolute top-0 end-0 m-2.5 d-flex align-items-center gap-1.5">
                                @if (item.IsAvailable)
                                {
                                    <span class="krishi-badge krishi-badge-available shadow-sm">
                                        <i class="bi bi-check-circle-fill"></i> @L["Available"]
                                    </span>
                                }
                                else
                                {
                                    <span class="krishi-badge krishi-badge-unavailable shadow-sm">
                                        <i class="bi bi-clock-fill"></i> @L["Booked"]
                                    </span>
                                }
                                <button type="button" 
                                        class="btn btn-light btn-sm rounded-circle shadow-sm favorite-btn @(item.IsFavorite ? "active text-danger" : "")" 
                                        style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; z-index: 2;"
                                        data-type="Equipment" 
                                        data-id="@item.Id" 
                                        onclick="event.stopPropagation(); KrishiFavorites.toggle(this);" 
                                        title="@(item.IsFavorite ? L["Remove from favorites"] : L["Add to favorites"])">
                                    <i class="bi @(item.IsFavorite ? "bi-heart-fill text-danger" : "bi-heart")"></i>
                                </button>
                            </div>

                            <!-- Distance Badge -->
                            @if (item.DistanceKm > 0)
                            {
                                <div class="position-absolute bottom-0 start-0 m-2">
                                    <span class="badge bg-dark bg-opacity-75 text-white rounded-pill px-2.5 py-1 small" style="font-size: 0.75rem;">
                                        <i class="bi bi-compass me-1"></i>@L["{0} km away", item.DistanceKm.ToString("0.0")]
                                    </span>
                                </div>
                            }
                        </div>

                        <!-- Card Body -->
                        <div class="card-body d-flex flex-column p-3.5">
                            
                            <!-- Title -->
                            <h5 class="card-title fw-bold text-dark mb-1 text-truncate" title="@item.Name">
                                @item.Name
                            </h5>

                            <!-- Location & Owner -->
                            <div class="small text-muted mb-2">
                                <div class="d-flex align-items-center gap-1 text-truncate mb-1">
                                    <i class="bi bi-geo-alt text-success"></i>
                                    <span class="text-truncate">
                                        @if (!string.IsNullOrWhiteSpace(item.District))
                                        {
                                            <strong>@L[item.District]</strong>@(!string.IsNullOrWhiteSpace(item.Location) && !item.Location.Equals(item.District, StringComparison.OrdinalIgnoreCase) ? $" · {item.Location}" : "")
                                        }
                                        else
                                        {
                                            @L[item.Location]
                                        }
                                    </span>
                                </div>
                                <div class="d-flex align-items-center justify-content-between">
                                    <span class="text-truncate">
                                        <i class="bi bi-person text-muted me-1"></i>@item.OwnerName
                                        @if (item.OwnerIsVerified)
                                        {
                                            <span class="text-success ms-1" title="@L["Verified Owner"]"><i class="bi bi-patch-check-fill"></i></span>
                                        }
                                    </span>
                                    @if (item.ReviewCount > 0)
                                    {
                                        var ratingTooltip = item.OwnerReviewCount > 0
                                            ? $"{item.Rating:0.0} ({item.ReviewCount} reviews) · {L["Owner"]}: {item.OwnerRating:0.0} ({item.OwnerReviewCount})"
                                            : $"{item.Rating:0.0} ({item.ReviewCount} reviews)";
                                        <span class="text-warning fw-semibold" title="@ratingTooltip"><i class="bi bi-star-fill me-1"></i>@item.Rating.ToString("0.0") (@item.ReviewCount)</span>
                                    }
                                </div>
                            </div>

                            <!-- Last Serviced Trust Chip -->
                            @if (!string.IsNullOrEmpty(item.LastServicedText))
                            {
                                <div class="mb-2.5">
                                    <span class="badge bg-success-subtle text-success border border-success-subtle font-monospace small py-1 px-2" style="font-size: 0.72rem;">
                                        <i class="bi bi-wrench-adjustable me-1"></i>@L[item.LastServicedText]
                                    </span>
                                </div>
                            }

                            <!-- Pricing & Action Button -->
                            <div class="pt-3 border-top mt-auto">
                                <div class="d-flex justify-content-between align-items-baseline mb-3">
                                    <div>
                                        <span class="text-muted small d-block">@L["Daily Rate"]</span>
                                        <span class="fw-bold text-success fs-5">@(item.HasRateRules ? L["from "] : "")৳@item.DailyRate.ToString("N0")</span>
                                        <span class="text-muted small">@L["/ Day"]</span>
                                    </div>
                                    @if (item.HourlyRate.HasValue)
                                    {
                                        <div class="text-end">
                                            <span class="text-muted small d-block">@L["Hourly"]</span>
                                            <span class="fw-semibold text-dark">৳@item.HourlyRate.Value.ToString("N0")</span>
                                            <span class="text-muted small">@L["/ hr"]</span>
                                        </div>
                                    }
                                </div>

                                <a asp-controller="Equipment" asp-action="Details" asp-route-id="@item.Id" 
                                   class="btn btn-krishi-primary w-100 fw-semibold rounded-3 py-2 d-flex align-items-center justify-content-center gap-1.5 shadow-sm"
                                   onclick="event.stopPropagation();">
                                    <span>@L["View Details"]</span>
                                    <i class="bi bi-arrow-right small"></i>
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- ==========================================
             SERVER-SIDE PAGINATION CONTROLS
             ========================================== -->
        <div id="equipmentPaginationContainer" class="mt-4 @(Model.TotalPages > 1 ? "" : "d-none")">
            <nav aria-label="Equipment pagination" class="d-flex justify-content-center">
                <ul class="pagination pagination-sm" id="equipmentPaginationList">
                    @if (Model.TotalPages > 1)
                    {
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link rounded-pill px-3 me-1" href="javascript:void(0)" onclick="goToPage(@(Model.Page - 1))">
                                <i class="bi bi-chevron-left me-1"></i> @L["Previous"]
                            </a>
                        </li>
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.Page ? "active" : "")">
                                <a class="page-link rounded-circle mx-0.5 text-center" style="width: 32px; height: 32px; line-height: 18px;" href="javascript:void(0)" onclick="goToPage(@p)">
                                    @p
                                </a>
                            </li>
                        }
                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link rounded-pill px-3 ms-1" href="javascript:void(0)" onclick="goToPage(@(Model.Page + 1))">
                                @L["Next"] <i class="bi bi-chevron-right ms-1"></i>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        </div>

        <!-- ==========================================
             EMPTY STATE (no listings on the platform vs. nothing matching the filters)
             ========================================== -->
        @{
            var hasFilters = !string.IsNullOrWhiteSpace(Model.SearchTerm) || Model.SelectedCategories.Any()
                || !string.IsNullOrWhiteSpace(Model.District ?? Model.Location) || Model.AvailabilityDate.HasValue
                || (Model.SelectedMinPrice.HasValue && Model.SelectedMinPrice > Model.MinPrice)
                || (Model.SelectedMaxPrice.HasValue && Model.SelectedMaxPrice < Model.MaxPrice);
            // Live filtering can reveal this container later, so only claim "nothing listed" when the platform really is empty
            var platformEmpty = !hasFilters && !Model.EquipmentList.Any();
        }
        <div class="card krishi-card border-0 shadow-sm rounded-4 p-5 text-center my-4 @(Model.EquipmentList.Any() ? "d-none" : "")" id="emptyStateContainer">
            <div class="mb-3">
                <div class="d-inline-flex p-3.5 rounded-circle bg-light text-muted mb-2">
                    <i class="bi @(platformEmpty ? "bi-tools" : "bi-search") text-success" style="font-size: 3rem;"></i>
                </div>
            </div>
            @if (!platformEmpty)
            {
                <h4 class="fw-bold text-dark mb-2">@L["No equipment matches your filters"]</h4>
                <p class="text-secondary mb-4 mx-auto" style="max-width: 460px;">
                    @L["No equipment matches your filters — try widening your search criteria, adjusting the price slider, or selecting a different location."]
                </p>
                <div>
                    <a asp-controller="Equipment" asp-action="Index" class="btn btn-krishi-primary rounded-pill px-4 py-2.5 fw-semibold shadow-sm">
                        <i class="bi bi-arrow-counterclockwise me-1.5"></i> @L["Clear Filters"]
                    </a>
                </div>
            }
            else
            {
                <h4 class="fw-bold text-dark mb-2">@L["No equipment listed yet"]</h4>
                <p class="text-secondary mb-4 mx-auto" style="max-width: 460px;">
                    @L["Equipment owners haven't added any machinery yet. Own a tractor, tiller or harvester? Be the first to list it and start earning."]
                </p>
                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    @if (User.IsInRole("EquipmentOwner"))
                    {
                        <a asp-controller="EquipmentOwner" asp-action="Create" class="btn btn-krishi-primary rounded-pill px-4 py-2.5 fw-semibold shadow-sm"><i class="bi bi-plus-lg me-1.5"></i> @L["List Your First Equipment"]</a>
                    }
                    else if (!(User.Identity?.IsAuthenticated ?? false))
                    {
                        <a asp-controller="Account" asp-action="Register" asp-route-role="EquipmentOwner" class="btn btn-krishi-primary rounded-pill px-4 py-2.5 fw-semibold shadow-sm"><i class="bi bi-truck me-1.5"></i> @L["Register as Equipment Owner"]</a>
                    }
                    <a asp-controller="Godown" asp-action="Index" class="btn btn-krishi-outline rounded-pill px-4 py-2.5 fw-semibold"><i class="bi bi-building me-1.5"></i> @L["Browse Storage Instead"]</a>
                </div>
            }
        </div>

    </div>
</div>

<!-- ==========================================
     MOBILE BOTTOM SHEET FOR FILTERS (< lg)
     ========================================== -->
<div class="offcanvas offcanvas-bottom krishi-bottom-sheet d-lg-none" tabindex="-1" id="mobileFilterBottomSheet" aria-labelledby="mobileFilterBottomSheetLabel">
    <div class="offcanvas-header pb-2 pt-3 px-4 d-flex flex-column align-items-stretch">
        <div class="krishi-sheet-handle"></div>
        <div class="d-flex justify-content-between align-items-center w-100">
            <h5 class="offcanvas-title fw-bold text-dark d-flex align-items-center gap-2" id="mobileFilterBottomSheetLabel">
                <i class="bi bi-sliders2 text-success"></i> @L["Filter Machinery"]
            </h5>
            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="@L["Close"]"></button>
        </div>
    </div>
    <div class="offcanvas-body px-4 py-3" style="overflow-y: auto;">
        
        <!-- Mobile: Equipment Type -->
        <div class="mb-4">
            <label class="form-label fw-bold text-dark small text-uppercase tracking-wider mb-2">@L["Equipment Type"]</label>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var category in Model.AvailableCategories)
                {
                    var isChecked = Model.SelectedCategories.Contains(category);
                    <div class="form-check custom-checkbox w-100">
                        <input class="form-check-input mobile-cat-filter" type="checkbox" 
                               value="@category" id="mob_cat_@category.Replace(" ", "_").Replace("/", "_")" @(isChecked ? "checked" : "") onchange="syncMobileToDesktopCategory(); onFilterChanged(1);" />
                        <label class="form-check-label text-secondary small" for="mob_cat_@category.Replace(" ", "_").Replace("/", "_")">
                            @L[category]
                        </label>
                    </div>
                }
            </div>
        </div>

        <!-- Mobile: Location -->
        <div class="mb-4">
            <label class="form-label fw-bold text-dark small text-uppercase tracking-wider mb-2" for="mobileLocationSelect">@L["Location / District"]</label>
            <select class="form-select" id="mobileLocationSelect" onchange="syncLocation(this.value); onFilterChanged(1);">
                <option value="">@L["All Locations (Bangladesh)"]</option>
                @foreach (var loc in Model.AvailableLocations)
                {
                    <option value="@loc" selected="@((Model.District == loc || Model.Location == loc) ? "selected" : null)">@L[loc]</option>
                }
            </select>
        </div>

        <!-- Mobile: Price Range Inputs -->
        <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <label class="form-label fw-bold text-dark small text-uppercase tracking-wider mb-0" for="mobilePriceSlider">@L["Daily Rate (৳)"]</label>
                <span class="badge bg-success-subtle text-success fw-bold px-2 py-1 mobile-price-display">
                    ৳@((Model.SelectedMinPrice ?? Model.MinPrice).ToString("N0")) – ৳@((Model.SelectedMaxPrice ?? Model.MaxPrice).ToString("N0"))
                </span>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-6">
                    <label class="small text-muted mb-1" for="mobileMinPriceInput">@L["Min ৳"]</label>
                    <input type="number" class="form-control form-control-sm" id="mobileMinPriceInput"
                           min="@Model.MinPrice" max="@Model.MaxPrice" step="100" 
                           value="@(Model.SelectedMinPrice ?? Model.MinPrice)" 
                           onchange="syncPriceInputsFromMobile(); onFilterChanged(1);" />
                </div>
                <div class="col-6">
                    <label class="small text-muted mb-1" for="mobileMaxPriceInput">@L["Max ৳"]</label>
                    <input type="number" class="form-control form-control-sm" id="mobileMaxPriceInput"
                           min="@Model.MinPrice" max="@Model.MaxPrice" step="100" 
                           value="@(Model.SelectedMaxPrice ?? Model.MaxPrice)" 
                           onchange="syncPriceInputsFromMobile(); onFilterChanged(1);" />
                </div>
            </div>
            <input type="range" class="form-range" id="mobilePriceSlider"
                   min="@Model.MinPrice" max="@Model.MaxPrice" step="100" 
                   value="@(Model.SelectedMaxPrice ?? Model.MaxPrice)" 
                   oninput="syncSliderToMaxInput(this.value)"
                   onchange="onFilterChanged(1)" />
        </div>

        <!-- Mobile: Availability Date Range -->
        <div class="mb-4">
            <label class="form-label fw-bold text-dark small text-uppercase tracking-wider mb-2">@L["Required Dates"]</label>
            <div class="row g-2">
                <div class="col-6">
                    <label class="small text-muted mb-1" for="mobileStartDateInput">@L["From"]</label>
                    <input type="date" class="form-control form-control-sm" id="mobileStartDateInput"
                           value="@(Model.StartDate.HasValue ? Model.StartDate.Value.ToString("yyyy-MM-dd") : (Model.AvailabilityDate.HasValue ? Model.AvailabilityDate.Value.ToString("yyyy-MM-dd") : ""))" 
                           min="@DateTime.Today.ToString("yyyy-MM-dd")" onchange="syncMobileDates(); onFilterChanged(1);" />
                </div>
                <div class="col-6">
                    <label class="small text-muted mb-1" for="mobileEndDateInput">@L["To"]</label>
                    <input type="date" class="form-control form-control-sm" id="mobileEndDateInput"
                           value="@(Model.EndDate.HasValue ? Model.EndDate.Value.ToString("yyyy-MM-dd") : "")" 
                           min="@DateTime.Today.ToString("yyyy-MM-dd")" onchange="syncMobileDates(); onFilterChanged(1);" />
                </div>
            </div>
        </div>

        <!-- Mobile: Units Needed -->
        <div class="mb-4">
            <label class="form-label fw-bold text-dark small text-uppercase tracking-wider mb-2" for="mobileUnitsInput">
                @L["Units Needed"]
            </label>
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-light text-muted"><i class="bi bi-boxes"></i></span>
                <input type="number" class="form-control form-control-sm" id="mobileUnitsInput"
                       min="1" max="50" value="@(Model.Units > 1 ? Model.Units : 1)" onchange="syncUnits(this.value); onFilterChanged(1);" />
            </div>
        </div>

        <!-- Bottom Sheet Actions -->
        <div class="d-grid gap-2 pt-2 pb-3">
            <button type="button" class="btn btn-krishi-primary py-2.5 fw-bold rounded-pill" data-bs-dismiss="offcanvas">
                @L["View Results ("]<span id="mobileSheetResultCount">@Model.TotalCount</span>)
            </button>
            <button type="button" class="btn btn-outline-danger btn-sm py-2 rounded-pill" onclick="resetAllFilters()">
                @L["Clear Filters"]
            </button>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        let searchDebounceTimer = null;
        let currentPage = @Model.Page;
        const DEFAULT_MAX_PRICE = @Model.MaxPrice;
        const DEFAULT_MIN_PRICE = @Model.MinPrice;
        const localizedCategories = @Html.Raw(localizedCategoriesJson);
        const localizedLocations = @Html.Raw(localizedLocationsJson);

        function syncPriceInputs() {
            const minVal = Number(document.getElementById('desktopMinPriceInput')?.value || DEFAULT_MIN_PRICE);
            const maxVal = Number(document.getElementById('desktopMaxPriceInput')?.value || DEFAULT_MAX_PRICE);
            
            const mobMin = document.getElementById('mobileMinPriceInput');
            const mobMax = document.getElementById('mobileMaxPriceInput');
            if (mobMin) mobMin.value = minVal;
            if (mobMax) mobMax.value = maxVal;

            const deskSlider = document.getElementById('desktopPriceSlider');
            const mobSlider = document.getElementById('mobilePriceSlider');
            if (deskSlider) deskSlider.value = maxVal;
            if (mobSlider) mobSlider.value = maxVal;

            updatePriceDisplay(minVal, maxVal);
        }

        function syncPriceInputsFromMobile() {
            const minVal = Number(document.getElementById('mobileMinPriceInput')?.value || DEFAULT_MIN_PRICE);
            const maxVal = Number(document.getElementById('mobileMaxPriceInput')?.value || DEFAULT_MAX_PRICE);
            
            const deskMin = document.getElementById('desktopMinPriceInput');
            const deskMax = document.getElementById('desktopMaxPriceInput');
            if (deskMin) deskMin.value = minVal;
            if (deskMax) deskMax.value = maxVal;

            const deskSlider = document.getElementById('desktopPriceSlider');
            const mobSlider = document.getElementById('mobilePriceSlider');
            if (deskSlider) deskSlider.value = maxVal;
            if (mobSlider) mobSlider.value = maxVal;

            updatePriceDisplay(minVal, maxVal);
        }

        function syncSliderToMaxInput(val) {
            const deskMax = document.getElementById('desktopMaxPriceInput');
            const mobMax = document.getElementById('mobileMaxPriceInput');
            if (deskMax) deskMax.value = val;
            if (mobMax) mobMax.value = val;

            const minVal = Number(document.getElementById('desktopMinPriceInput')?.value || DEFAULT_MIN_PRICE);
            updatePriceDisplay(minVal, Number(val));
        }

        function updatePriceDisplay(minVal, maxVal) {
            const formatted = '৳' + minVal.toLocaleString() + ' – ৳' + maxVal.toLocaleString();
            document.querySelectorAll('.desktop-price-display, .mobile-price-display').forEach(el => el.innerText = formatted);
        }

        function syncLocation(val) {
            const deskLoc = document.getElementById('desktopLocationSelect');
            const mobLoc = document.getElementById('mobileLocationSelect');
            if (deskLoc && deskLoc.value !== val) deskLoc.value = val;
            if (mobLoc && mobLoc.value !== val) mobLoc.value = val;
        }

        function syncDates() {
            const sDesk = document.getElementById('desktopStartDateInput')?.value || '';
            const eDesk = document.getElementById('desktopEndDateInput')?.value || '';
            const sMob = document.getElementById('mobileStartDateInput');
            const eMob = document.getElementById('mobileEndDateInput');
            if (sMob) sMob.value = sDesk;
            if (eMob) eMob.value = eDesk;
        }

        function syncMobileDates() {
            const sMob = document.getElementById('mobileStartDateInput')?.value || '';
            const eMob = document.getElementById('mobileEndDateInput')?.value || '';
            const sDesk = document.getElementById('desktopStartDateInput');
            const eDesk = document.getElementById('desktopEndDateInput');
            if (sDesk) sDesk.value = sMob;
            if (eDesk) eDesk.value = eMob;
        }

        function syncUnits(val) {
            const u = Math.max(1, parseInt(val) || 1);
            const desk = document.getElementById('desktopUnitsInput');
            const mob = document.getElementById('mobileUnitsInput');
            if (desk && desk.value != u) desk.value = u;
            if (mob && mob.value != u) mob.value = u;
        }

        function syncMobileToDesktopCategory() {
            const mobileChecked = Array.from(document.querySelectorAll('.mobile-cat-filter:checked')).map(cb => cb.value);
            document.querySelectorAll('.desktop-cat-filter').forEach(cb => {
                cb.checked = mobileChecked.includes(cb.value);
            });
        }

        function syncDesktopToMobileCategory() {
            const desktopChecked = Array.from(document.querySelectorAll('.desktop-cat-filter:checked')).map(cb => cb.value);
            document.querySelectorAll('.mobile-cat-filter').forEach(cb => {
                cb.checked = desktopChecked.includes(cb.value);
            });
        }

        function onSearchInput(val) {
            const clearBtn = document.getElementById('clearSearchBtn');
            if (clearBtn) {
                if (val && val.trim().length > 0) clearBtn.classList.remove('d-none');
                else clearBtn.classList.add('d-none');
            }
            clearTimeout(searchDebounceTimer);
            searchDebounceTimer = setTimeout(() => {
                onFilterChanged(1);
            }, 250);
        }

        function clearSearch() {
            const searchInput = document.getElementById('mainSearchInput');
            if (searchInput) {
                searchInput.value = '';
                onSearchInput('');
            }
        }

        function resetAllFilters() {
            const searchInput = document.getElementById('mainSearchInput');
            if (searchInput) searchInput.value = '';
            const clearBtn = document.getElementById('clearSearchBtn');
            if (clearBtn) clearBtn.classList.add('d-none');

            document.querySelectorAll('.desktop-cat-filter, .mobile-cat-filter').forEach(cb => cb.checked = false);
            syncLocation('');

            const deskMin = document.getElementById('desktopMinPriceInput');
            const deskMax = document.getElementById('desktopMaxPriceInput');
            if (deskMin) deskMin.value = DEFAULT_MIN_PRICE;
            if (deskMax) deskMax.value = DEFAULT_MAX_PRICE;
            syncPriceInputs();

            const sDesk = document.getElementById('desktopStartDateInput');
            const eDesk = document.getElementById('desktopEndDateInput');
            if (sDesk) sDesk.value = '';
            if (eDesk) eDesk.value = '';
            syncDates();

            const deskUnits = document.getElementById('desktopUnitsInput');
            const mobUnits = document.getElementById('mobileUnitsInput');
            if (deskUnits) deskUnits.value = '1';
            if (mobUnits) mobUnits.value = '1';

            const sortSelect = document.getElementById('mainSortSelect');
            if (sortSelect) sortSelect.value = 'newest';

            onFilterChanged(1);
        }

        function goToPage(page) {
            if (page < 1) return;
            currentPage = page;
            onFilterChanged(page);
            window.scrollTo({ top: 120, behavior: 'smooth' });
        }

        // Live Filter Dispatcher via Fetch API with Skeleton Transitions
        async function onFilterChanged(page) {
            if (typeof page === 'number') {
                currentPage = page;
            } else {
                currentPage = 1;
            }

            syncDesktopToMobileCategory();

            const searchTerm = document.getElementById('mainSearchInput')?.value || '';
            const selectedCategories = Array.from(document.querySelectorAll('.desktop-cat-filter:checked')).map(cb => cb.value);
            const location = document.getElementById('desktopLocationSelect')?.value || '';
            const minPrice = Number(document.getElementById('desktopMinPriceInput')?.value || DEFAULT_MIN_PRICE);
            const maxPrice = Number(document.getElementById('desktopMaxPriceInput')?.value || DEFAULT_MAX_PRICE);
            const startDate = document.getElementById('desktopStartDateInput')?.value || '';
            const endDate = document.getElementById('desktopEndDateInput')?.value || '';
            const units = parseInt(document.getElementById('desktopUnitsInput')?.value || '1') || 1;
            const sortBy = document.getElementById('mainSortSelect')?.value || 'newest';

            const grid = document.getElementById('equipmentResultsGrid');
            const skeleton = document.getElementById('skeletonLoadingContainer');
            const emptyState = document.getElementById('emptyStateContainer');
            const paginationContainer = document.getElementById('equipmentPaginationContainer');
            
            if (skeleton) skeleton.classList.remove('d-none');
            if (grid) grid.classList.add('d-none');
            if (emptyState) emptyState.classList.add('d-none');

            const params = new URLSearchParams();
            if (searchTerm.trim()) params.append('searchTerm', searchTerm.trim());
            selectedCategories.forEach(cat => params.append('selectedCategories', cat));
            if (location) params.append('district', location);
            if (minPrice > DEFAULT_MIN_PRICE) params.append('selectedMinPrice', minPrice);
            if (maxPrice < DEFAULT_MAX_PRICE) params.append('selectedMaxPrice', maxPrice);
            if (startDate) params.append('startDate', startDate);
            if (endDate) params.append('endDate', endDate);
            if (units > 1) params.append('units', units);
            if (sortBy && sortBy !== 'newest') params.append('sortBy', sortBy);
            if (currentPage > 1) params.append('page', currentPage);

            const newUrl = window.location.pathname + (params.toString() ? '?' + params.toString() : '');
            window.history.replaceState({}, '', newUrl);

            try {
                const response = await fetch('/Equipment/FilterData?' + params.toString(), {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                if (!response.ok) throw new Error('Network error fetching filtered equipment');

                const data = await response.json();
                renderResults(data);
                renderPagination(data);
            } catch (err) {
                console.error('Filter fetch failed:', err);
                if (grid) grid.classList.remove('d-none');
            } finally {
                if (skeleton) skeleton.classList.add('d-none');
            }
        }

        function renderResults(data) {
            const grid = document.getElementById('equipmentResultsGrid');
            const emptyState = document.getElementById('emptyStateContainer');
            const countNum = document.getElementById('resultsCountNumber');
            const heroCount = document.getElementById('heroListingCount');
            const mobileCount = document.getElementById('mobileSheetResultCount');
            const mobileFilterBadge = document.getElementById('mobileFilterBadge');

            const count = data.totalCount || 0;
            if (countNum) countNum.innerText = count;
            if (heroCount) heroCount.innerText = '@L["{0} Available Items", "__COUNT__"]'.replace('__COUNT__', count);
            if (mobileCount) mobileCount.innerText = '@L["{0} items", "__COUNT__"]'.replace('__COUNT__', count);

            const searchTerm = document.getElementById('mainSearchInput')?.value || '';
            const selectedCategories = Array.from(document.querySelectorAll('.desktop-cat-filter:checked')).map(cb => cb.value);
            const location = document.getElementById('desktopLocationSelect')?.value || '';
            const minPrice = Number(document.getElementById('desktopMinPriceInput')?.value || DEFAULT_MIN_PRICE);
            const maxPrice = Number(document.getElementById('desktopMaxPriceInput')?.value || DEFAULT_MAX_PRICE);
            const startDate = document.getElementById('desktopStartDateInput')?.value || '';
            const endDate = document.getElementById('desktopEndDateInput')?.value || '';
            const units = parseInt(document.getElementById('desktopUnitsInput')?.value || '1') || 1;

            let activeCount = 0;
            if (searchTerm.trim()) activeCount++;
            activeCount += selectedCategories.length;
            if (location) activeCount++;
            if (minPrice > DEFAULT_MIN_PRICE) activeCount++;
            if (maxPrice < DEFAULT_MAX_PRICE) activeCount++;
            if (startDate || endDate) activeCount++;
            if (units > 1) activeCount++;

            if (mobileFilterBadge) {
                mobileFilterBadge.innerText = activeCount > 0 ? '@L["{0} active", "__COUNT__"]'.replace('__COUNT__', activeCount) : '@L["Filters"]';
            }

            document.querySelectorAll('.clear-filters-btn').forEach(btn => {
                if (activeCount > 0) btn.classList.remove('d-none');
                else btn.classList.add('d-none');
            });

            renderActiveTags(searchTerm, selectedCategories, location, minPrice, maxPrice, startDate, endDate, units);

            if (count === 0) {
                if (grid) {
                    grid.innerHTML = '';
                    grid.classList.add('d-none');
                }
                if (emptyState) emptyState.classList.remove('d-none');
                return;
            }

            if (emptyState) emptyState.classList.add('d-none');
            if (grid) {
                grid.classList.remove('d-none');
                grid.innerHTML = data.items.map(item => {
                    const locDisplay = item.district 
                        ? `<strong>${localizedLocations[item.district] || item.district}</strong>${item.location && item.location !== item.district ? ' · ' + item.location : ''}`
                        : (localizedLocations[item.location] || item.location);

                    const ratingTooltip = item.ownerReviewCount > 0
                        ? `${item.rating.toFixed(1)} (${item.reviewCount} reviews) · @L["Owner"]: ${item.ownerRating.toFixed(1)} (${item.ownerReviewCount})`
                        : `${item.rating.toFixed(1)} (${item.reviewCount} reviews)`;

                    return `
                    <div class="col equipment-card-col">
                        <div class="card krishi-card h-100 border-0 shadow-sm rounded-4 overflow-hidden d-flex flex-column transition-hover" 
                             style="cursor: pointer;" onclick="location.href='${item.detailsUrl}'">
                            
                            <!-- Equipment Image & Badges -->
                            <div class="krishi-equipment-img-box">
                                <img src="${item.imageUrl}" alt="${item.name}" loading="lazy" />
                                
                                <!-- Category Pill & Quantity Badge -->
                                <div class="position-absolute top-0 start-0 m-2.5 d-flex flex-column gap-1 align-items-start">
                                    <span class="badge bg-white text-dark shadow-sm rounded-pill px-2.5 py-1 small fw-semibold opacity-95">
                                        ${localizedCategories[item.category] || item.category}
                                    </span>
                                    ${item.quantity > 1 ? `
                                        <span class="badge bg-primary text-white shadow-sm rounded-pill px-2.5 py-1 small fw-semibold">
                                            <i class="bi bi-boxes me-1"></i>${item.quantity} @L["Units"]
                                        </span>
                                    ` : ''}
                                </div>

                                <div class="position-absolute top-0 end-0 m-2.5 d-flex align-items-center gap-1.5">
                                    ${item.isAvailable 
                                        ? `<span class="krishi-badge krishi-badge-available shadow-sm"><i class="bi bi-check-circle-fill"></i> @L["Available"]</span>`
                                        : `<span class="krishi-badge krishi-badge-unavailable shadow-sm"><i class="bi bi-clock-fill"></i> @L["Booked"]</span>`
                                    }
                                    <button type="button" 
                                            class="btn btn-light btn-sm rounded-circle shadow-sm favorite-btn ${item.isFavorite ? 'active text-danger' : ''}" 
                                            style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; z-index: 2;"
                                            data-type="Equipment" 
                                            data-id="${item.id}" 
                                            onclick="event.stopPropagation(); KrishiFavorites.toggle(this);" 
                                            title="${item.isFavorite ? '@L["Remove from favorites"]' : '@L["Add to favorites"]'}">
                                        <i class="bi ${item.isFavorite ? 'bi-heart-fill text-danger' : 'bi-heart'}"></i>
                                    </button>
                                </div>

                                ${item.distanceKm > 0 ? `<div class="position-absolute bottom-0 start-0 m-2">
                                    <span class="badge bg-dark bg-opacity-75 text-white rounded-pill px-2.5 py-1 small" style="font-size: 0.75rem;">
                                        <i class="bi bi-compass me-1"></i>${'@L["{0} km away", "__DISTANCE__"]'.replace('__DISTANCE__', Number(item.distanceKm).toFixed(1))}
                                    </span>
                                </div>` : ''}
                            </div>

                            <!-- Card Body -->
                            <div class="card-body d-flex flex-column p-3.5">
                                <h5 class="card-title fw-bold text-dark mb-1 text-truncate" title="${item.name}">
                                    ${item.name}
                                </h5>

                                <div class="small text-muted mb-2">
                                    <div class="d-flex align-items-center gap-1 text-truncate mb-1">
                                        <i class="bi bi-geo-alt text-success"></i>
                                        <span class="text-truncate">${locDisplay}</span>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between">
                                        <span class="text-truncate"><i class="bi bi-person text-muted me-1"></i>${item.ownerName}${item.ownerIsVerified ? ` <span class="text-success ms-1" title="@L["Verified Owner"]"><i class="bi bi-patch-check-fill"></i></span>` : ''}</span>
                                        ${item.reviewCount > 0 ? `<span class="text-warning fw-semibold" title="${ratingTooltip}"><i class="bi bi-star-fill me-1"></i>${item.rating.toFixed(1)} (${item.reviewCount})</span>` : ''}
                                    </div>
                                </div>

                                ${item.lastServicedText ? `
                                    <div class="mb-2.5">
                                        <span class="badge bg-success-subtle text-success border border-success-subtle font-monospace small py-1 px-2" style="font-size: 0.72rem;">
                                            <i class="bi bi-wrench-adjustable me-1"></i>${item.lastServicedText}
                                        </span>
                                    </div>
                                ` : ''}

                                <div class="pt-3 border-top mt-auto">
                                    <div class="d-flex justify-content-between align-items-baseline mb-3">
                                        <div>
                                            <span class="text-muted small d-block">@L["Daily Rate"]</span>
                                            <span class="fw-bold text-success fs-5">${item.hasRateRules ? '@L["from "]' : ''}${item.dailyRateFormatted}</span>
                                            <span class="text-muted small">@L["/ Day"]</span>
                                        </div>
                                        ${item.hourlyRateFormatted ? `
                                            <div class="text-end">
                                                <span class="text-muted small d-block">@L["Hourly"]</span>
                                                <span class="fw-semibold text-dark">${item.hourlyRateFormatted}</span>
                                                <span class="text-muted small">@L["/ hr"]</span>
                                            </div>
                                        ` : ''}
                                    </div>

                                    <a href="${item.detailsUrl}" 
                                       class="btn btn-krishi-primary w-100 fw-semibold rounded-3 py-2 d-flex align-items-center justify-content-center gap-1.5 shadow-sm"
                                       onclick="event.stopPropagation();">
                                        <span>@L["View Details"]</span>
                                        <i class="bi bi-arrow-right small"></i>
                                    </a>
                                </div>
                            </div>

                        </div>
                    </div>
                `}).join('');
            }
        }

        function renderPagination(data) {
            const container = document.getElementById('equipmentPaginationContainer');
            const list = document.getElementById('equipmentPaginationList');
            if (!container || !list) return;

            if (data.totalPages <= 1) {
                container.classList.add('d-none');
                list.innerHTML = '';
                return;
            }

            container.classList.remove('d-none');
            let html = `
                <li class="page-item ${!data.hasPreviousPage ? 'disabled' : ''}">
                    <a class="page-link rounded-pill px-3 me-1" href="javascript:void(0)" onclick="goToPage(${data.page - 1})">
                        <i class="bi bi-chevron-left me-1"></i> @L["Previous"]
                    </a>
                </li>
            `;

            for (let p = 1; p <= data.totalPages; p++) {
                html += `
                    <li class="page-item ${p === data.page ? 'active' : ''}">
                        <a class="page-link rounded-circle mx-0.5 text-center" style="width: 32px; height: 32px; line-height: 18px;" href="javascript:void(0)" onclick="goToPage(${p})">
                            ${p}
                        </a>
                    </li>
                `;
            }

            html += `
                <li class="page-item ${!data.hasNextPage ? 'disabled' : ''}">
                    <a class="page-link rounded-pill px-3 ms-1" href="javascript:void(0)" onclick="goToPage(${data.page + 1})">
                        @L["Next"] <i class="bi bi-chevron-right ms-1"></i>
                    </a>
                </li>
            `;

            list.innerHTML = html;
        }

        function renderActiveTags(search, categories, location, minPrice, maxPrice, startDate, endDate, units = 1) {
            const container = document.getElementById('activeFilterTagsContainer');
            if (!container) return;

            let html = '';
            if (search && search.trim()) {
                html += `<span class="badge bg-light text-dark border px-2.5 py-1.5 rounded-pill small d-inline-flex align-items-center gap-1">
                    @L["Search:"] "${search.trim()}" <i class="bi bi-x-circle-fill text-muted ms-1" style="cursor:pointer;" onclick="clearSearch()"></i>
                </span>`;
            }
            if (categories && categories.length > 0) {
                categories.forEach(cat => {
                    html += `<span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5 rounded-pill small">
                        ${localizedCategories[cat] || cat}
                    </span>`;
                });
            }
            if (location) {
                html += `<span class="badge bg-light text-dark border px-2.5 py-1.5 rounded-pill small">
                    <i class="bi bi-geo-alt me-1"></i>${localizedLocations[location] || location}
                </span>`;
            }
            if (minPrice > DEFAULT_MIN_PRICE || maxPrice < DEFAULT_MAX_PRICE) {
                html += `<span class="badge bg-light text-dark border px-2.5 py-1.5 rounded-pill small">
                    ৳${minPrice.toLocaleString()} – ৳${maxPrice.toLocaleString()} @L["/ Day"]
                </span>`;
            }
            if (startDate || endDate) {
                const dateText = startDate && endDate ? `${startDate} ~ ${endDate}` : (startDate || endDate);
                html += `<span class="badge bg-light text-dark border px-2.5 py-1.5 rounded-pill small">
                    <i class="bi bi-calendar3 me-1"></i>${dateText}
                </span>`;
            }
            if (units > 1) {
                html += `<span class="badge bg-light text-dark border px-2.5 py-1.5 rounded-pill small">
                    <i class="bi bi-boxes me-1"></i>${units} @L["Units"]
                </span>`;
            }
            container.innerHTML = html;
        }

        // Open Save Search Modal
        function openSaveSearchModal(type) {
            const searchTerm = document.getElementById('mainSearchInput')?.value.trim() || '';
            const selectedCats = Array.from(document.querySelectorAll('.desktop-cat-filter:checked')).map(cb => cb.value);
            const cat = selectedCats.length > 0 ? selectedCats[0] : '';
            const district = document.getElementById('desktopLocationSelect')?.value || '';
            const maxPriceVal = document.getElementById('desktopMaxPriceInput')?.value;
            const maxPrice = (maxPriceVal && Number(maxPriceVal) < DEFAULT_MAX_PRICE) ? maxPriceVal : '';
            const startDate = document.getElementById('desktopStartDateInput')?.value || '';
            const endDate = document.getElementById('desktopEndDateInput')?.value || '';

            document.getElementById('ssModalListingType').value = type;
            document.getElementById('ssModalSearchTerm').value = searchTerm;
            document.getElementById('ssModalCategory').value = cat;
            document.getElementById('ssModalDistrict').value = district;
            document.getElementById('ssModalMaxRate').value = maxPrice;
            document.getElementById('ssModalFrom').value = startDate;
            document.getElementById('ssModalTo').value = endDate;
            document.getElementById('ssModalReturnUrl').value = window.location.pathname + window.location.search;

            const parts = [];
            if (cat) parts.push(cat);
            else if (searchTerm) parts.push(searchTerm);
            else parts.push('Machinery');

            if (district) parts.push('in ' + district);
            if (startDate && endDate) parts.push(`(${startDate} to ${endDate})`);
            else if (startDate) parts.push(`(from ${startDate})`);

            document.getElementById('ssModalName').value = parts.join(' ').substring(0, 80);

            const summaryParts = [];
            if (searchTerm) summaryParts.push(`Keyword: "${searchTerm}"`);
            if (cat) summaryParts.push(`Type: ${cat}`);
            if (district) summaryParts.push(`Location: ${district}`);
            if (maxPrice) summaryParts.push(`Max: ৳${Number(maxPrice).toLocaleString()}/day`);
            if (startDate || endDate) summaryParts.push(`Dates: ${startDate || 'Any'} ~ ${endDate || 'Any'}`);
            document.getElementById('ssModalSummaryText').textContent = summaryParts.length > 0 ? summaryParts.join(' · ') : '@L["All machinery in Bangladesh"]';

            const modalEl = document.getElementById('saveSearchModal');
            if (modalEl) {
                bootstrap.Modal.getOrCreateInstance(modalEl).show();
            }
        }

        // Initialize on load
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById('mainSearchInput');
            if (searchInput && searchInput.value.trim().length > 0) {
                const clearBtn = document.getElementById('clearSearchBtn');
                if (clearBtn) clearBtn.classList.remove('d-none');
            }
            renderActiveTags(
                document.getElementById('mainSearchInput')?.value || '',
                Array.from(document.querySelectorAll('.desktop-cat-filter:checked')).map(cb => cb.value),
                document.getElementById('desktopLocationSelect')?.value || '',
                Number(document.getElementById('desktopMinPriceInput')?.value || DEFAULT_MIN_PRICE),
                Number(document.getElementById('desktopMaxPriceInput')?.value || DEFAULT_MAX_PRICE),
                document.getElementById('desktopStartDateInput')?.value || '',
                document.getElementById('desktopEndDateInput')?.value || '',
                parseInt(document.getElementById('desktopUnitsInput')?.value || '1') || 1
            );
        });
    </script>

    <!-- Save Search Modal -->
    <div class="modal fade" id="saveSearchModal" tabindex="-1" aria-labelledby="saveSearchModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-4 overflow-hidden">
                <form asp-controller="SavedSearches" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header bg-success text-white border-0 px-4 py-3">
                        <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="saveSearchModalLabel">
                            <i class="bi bi-bookmark-plus"></i>
                            <span>@L["Save This Search"]</span>
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <input type="hidden" name="ListingType" id="ssModalListingType" value="Equipment" />
                        <input type="hidden" name="SearchTerm" id="ssModalSearchTerm" />
                        <input type="hidden" name="Category" id="ssModalCategory" />
                        <input type="hidden" name="District" id="ssModalDistrict" />
                        <input type="hidden" name="MaxRate" id="ssModalMaxRate" />
                        <input type="hidden" name="MinCapacityTons" id="ssModalMinCapacity" />
                        <input type="hidden" name="From" id="ssModalFrom" />
                        <input type="hidden" name="To" id="ssModalTo" />
                        <input type="hidden" name="ReturnUrl" id="ssModalReturnUrl" />

                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark small" for="ssModalName">@L["Search Name"]</label>
                            <input type="text" class="form-control rounded-3" id="ssModalName" name="Name" maxlength="80" required
                                   placeholder="@L["e.g. Combine harvester in Bogura"]" />
                        </div>

                        <div class="p-3 bg-light rounded-3 border small mb-3">
                            <div class="fw-bold text-dark mb-1">@L["Current Search Criteria:"]</div>
                            <div id="ssModalSummaryText" class="text-secondary"></div>
                        </div>

                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" role="switch" id="ssModalAlerts" name="AlertsEnabled" value="true" checked />
                            <label class="form-check-label text-dark fw-semibold small" for="ssModalAlerts">
                                @L["Notify me when new matching machinery becomes available"]
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer border-0 bg-light px-4 py-3">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">@L["Cancel"]</button>
                        <button type="submit" class="btn btn-krishi-primary rounded-pill px-4 fw-semibold shadow-sm">
                            <i class="bi bi-check2 me-1"></i>@L["Save Search"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
