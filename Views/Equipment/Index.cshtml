@model KrishiLink.Models.ViewModels.EquipmentBrowseViewModel
@{
    ViewData["Title"] = "Browse & Rent Equipment";
    var activeFiltersCount = 0;
    if (!string.IsNullOrWhiteSpace(Model.SearchTerm)) activeFiltersCount++;
    if (Model.SelectedCategories.Any()) activeFiltersCount += Model.SelectedCategories.Count;
    if (!string.IsNullOrWhiteSpace(Model.Location)) activeFiltersCount++;
    if (Model.SelectedMaxPrice.HasValue && Model.SelectedMaxPrice.Value < Model.MaxPrice) activeFiltersCount++;
    if (Model.AvailabilityDate.HasValue) activeFiltersCount++;
}

<!-- Page Header & Hero Banner -->
<div class="krishi-browse-header rounded-4 p-4 p-md-5 mb-4 text-white position-relative overflow-hidden shadow-sm" style="background: linear-gradient(135deg, #1b4332 0%, #2d6a4f 60%, #40916c 100%);">
    <div class="row align-items-center position-relative" style="z-index: 2;">
        <div class="col-lg-8">
            <span class="badge bg-light text-success fw-bold px-3 py-1.5 rounded-pill mb-2 mb-md-3">
                <i class="bi bi-gear-wide-connected me-1"></i> Agricultural Equipment Marketplace
            </span>
            <h1 class="display-6 fw-bold mb-2 text-white">Find & Rent Agricultural Machinery</h1>
            <p class="lead text-white-50 mb-0 fs-6">
                Discover modern tractors, combine harvesters, power tillers, and sprayers from verified nearby owners at affordable daily or hourly rates.
            </p>
        </div>
        <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
            <div class="d-inline-flex flex-column align-items-lg-end bg-white bg-opacity-10 border border-white border-opacity-25 rounded-3 p-3 text-white text-start">
                <span class="small text-white-50">Available Machinery</span>
                <span class="fs-4 fw-bold">@Model.EquipmentList.Count Verified Items</span>
                <span class="small text-white-50"><i class="bi bi-shield-check text-warning me-1"></i>Owner-verified listings</span>
            </div>
        </div>
    </div>
    <!-- Decorative background circle -->
    <div class="position-absolute end-0 bottom-0 opacity-10" style="transform: translate(20%, 20%);">
        <i class="bi bi-truck" style="font-size: 20rem; color: #fff;"></i>
    </div>
</div>

<!-- Main Content Area: Sidebar + Grid -->
<form method="get" asp-controller="Equipment" asp-action="Index" id="equipmentFilterForm">
    <div class="row g-4">
        
        <!-- ==========================================
             LEFT SIDEBAR: FILTERS
             ========================================== -->
        <div class="col-12 col-lg-4 col-xl-3">
            
            <!-- Mobile Filter Toggle Button -->
            <div class="d-lg-none mb-3">
                <button class="btn btn-outline-success w-100 d-flex justify-content-between align-items-center py-2.5 rounded-3 shadow-sm bg-white" 
                        type="button" data-bs-toggle="collapse" data-bs-target="#filterSidebarCollapse" 
                        aria-expanded="false" aria-controls="filterSidebarCollapse">
                    <span class="d-flex align-items-center gap-2 fw-semibold text-dark">
                        <i class="bi bi-sliders2 text-success"></i> Filter Equipment
                        @if (activeFiltersCount > 0)
                        {
                            <span class="badge bg-success rounded-pill">@activeFiltersCount active</span>
                        }
                    </span>
                    <i class="bi bi-chevron-down text-muted"></i>
                </button>
            </div>

            <!-- Filter Container (Collapsible on Mobile, Fixed Sidebar on Desktop) -->
            <div class="collapse d-lg-block" id="filterSidebarCollapse">
                <div class="card krishi-card border-0 shadow-sm rounded-4 p-3 p-xl-4 sticky-top" style="top: 80px; z-index: 10;">
                    
                    <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-sliders text-success fs-5"></i>
                            <h5 class="fw-bold mb-0 text-dark">Filters</h5>
                        </div>
                        @if (activeFiltersCount > 0)
                        {
                            <a asp-controller="Equipment" asp-action="Index" class="btn btn-link btn-sm text-danger text-decoration-none p-0 fw-semibold">
                                <i class="bi bi-x-circle me-1"></i>Clear All
                            </a>
                        }
                    </div>

                    <!-- 1. Equipment Type / Category Filter -->
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark small text-uppercase tracking-wider mb-2.5 d-flex justify-content-between align-items-center">
                            <span>Equipment Type</span>
                            <span class="badge bg-light text-muted border">@Model.AvailableCategories.Count</span>
                        </label>
                        <div class="d-flex flex-column gap-2" style="max-height: 220px; overflow-y: auto;">
                            @foreach (var category in Model.AvailableCategories)
                            {
                                var isChecked = Model.SelectedCategories.Contains(category);
                                <div class="form-check custom-checkbox">
                                    <input class="form-check-input filter-trigger" type="checkbox" name="selectedCategories" 
                                           value="@category" id="cat_@category.Replace(" ", "_").Replace("/", "_")" @(isChecked ? "checked" : "") />
                                    <label class="form-check-label text-secondary small user-select-none d-flex justify-content-between" for="cat_@category.Replace(" ", "_").Replace("/", "_")">
                                        <span>@category</span>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- 2. Location Filter -->
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark small text-uppercase tracking-wider mb-2" for="locationSelect">
                            Location / District
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-geo-alt-fill text-success"></i>
                            </span>
                            <select class="form-select border-start-0 filter-trigger" id="locationSelect" name="location">
                                <option value="">All Locations (Bangladesh)</option>
                                @foreach (var loc in Model.AvailableLocations)
                                {
                                    <option value="@loc" selected="@(Model.Location == loc ? "selected" : null)">@loc</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- 3. Price Range Slider (Daily Rate) -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label fw-bold text-dark small text-uppercase tracking-wider mb-0" for="priceRangeSlider">
                                Max Daily Rate
                            </label>
                            <span class="badge bg-success-subtle text-success fw-bold px-2 py-1" id="priceDisplay">
                                ৳@((Model.SelectedMaxPrice ?? Model.MaxPrice).ToString("N0")) / day
                            </span>
                        </div>
                        <input type="range" class="form-range" id="priceRangeSlider" name="selectedMaxPrice"
                               min="@Model.MinPrice" max="@Model.MaxPrice" step="100" 
                               value="@(Model.SelectedMaxPrice ?? Model.MaxPrice)" 
                               oninput="document.getElementById('priceDisplay').innerText = '৳' + Number(this.value).toLocaleString() + ' / day'"
                               onchange="this.form.submit()" />
                        <div class="d-flex justify-content-between small text-muted">
                            <span>৳@Model.MinPrice.ToString("N0")</span>
                            <span>৳@Model.MaxPrice.ToString("N0")</span>
                        </div>
                    </div>

                    <!-- 4. Availability Date Picker -->
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark small text-uppercase tracking-wider mb-2" for="availDateInput">
                            Required Date
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-calendar3 text-success"></i>
                            </span>
                            <input type="date" class="form-control border-start-0 filter-trigger" id="availDateInput" name="availabilityDate"
                                   value="@(Model.AvailabilityDate.HasValue ? Model.AvailabilityDate.Value.ToString("yyyy-MM-dd") : "")" 
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>

                    <!-- Filter Actions -->
                    <div class="d-grid gap-2 pt-2">
                        <button type="submit" class="btn btn-krishi-primary fw-semibold py-2">
                            <i class="bi bi-search me-1.5"></i> Apply Filters
                        </button>
                        @if (activeFiltersCount > 0)
                        {
                            <a asp-controller="Equipment" asp-action="Index" class="btn btn-outline-secondary btn-sm py-1.5 rounded-3">
                                Reset All
                            </a>
                        }
                    </div>

                </div>
            </div>
        </div>

        <!-- ==========================================
             RIGHT SECTION: SEARCH BAR & RESULTS GRID
             ========================================== -->
        <div class="col-12 col-lg-8 col-xl-9">
            
            <!-- Top Controls: Search Bar & Sort Dropdown -->
            <div class="card krishi-card border-0 shadow-sm rounded-4 p-3 mb-4">
                <div class="row g-2 align-items-center">
                    
                    <!-- Search Input -->
                    <div class="col-12 col-md-7 col-xl-8">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted ps-3">
                                <i class="bi bi-search text-success"></i>
                            </span>
                            <input type="text" class="form-control border-start-0 py-2" name="searchTerm" 
                                   value="@Model.SearchTerm" placeholder="Search by machinery name, type, owner, or area..." />
                            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                            {
                                <a asp-controller="Equipment" asp-action="Index" class="input-group-text bg-light border-start-0 text-muted text-decoration-none">
                                    <i class="bi bi-x"></i>
                                </a>
                            }
                            <button class="btn btn-krishi-primary px-3" type="submit">Search</button>
                        </div>
                    </div>

                    <!-- Sort Dropdown -->
                    <div class="col-12 col-md-5 col-xl-4">
                        <div class="d-flex align-items-center justify-content-md-end gap-2">
                            <label class="small text-muted text-nowrap fw-semibold d-none d-sm-inline" for="sortSelect">
                                <i class="bi bi-arrow-down-up me-1"></i>Sort:
                            </label>
                            <select class="form-select form-select-sm py-2 filter-trigger" id="sortSelect" name="sortBy" style="max-width: 200px;">
                                <option value="newest" selected="@(Model.SortBy == "newest" ? "selected" : null)">Newest First</option>
                                <option value="price_asc" selected="@(Model.SortBy == "price_asc" ? "selected" : null)">Price: Low to High</option>
                                <option value="price_desc" selected="@(Model.SortBy == "price_desc" ? "selected" : null)">Price: High to Low</option>
                                <option value="distance" selected="@(Model.SortBy == "distance" ? "selected" : null)">Distance: Nearest</option>
                            </select>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Results Summary & Active Filter Tags -->
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 px-1">
                <span class="text-secondary small fw-medium">
                    Showing <strong class="text-dark">@Model.EquipmentList.Count</strong> equipment available for rent
                </span>

                @if (activeFiltersCount > 0)
                {
                    <div class="d-flex flex-wrap align-items-center gap-1.5">
                        @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                        {
                            <span class="badge bg-light text-dark border px-2.5 py-1.5 rounded-pill small d-inline-flex align-items-center gap-1">
                                Search: "@Model.SearchTerm"
                            </span>
                        }
                        @foreach (var cat in Model.SelectedCategories)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5 rounded-pill small">
                                @cat
                            </span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Location))
                        {
                            <span class="badge bg-light text-dark border px-2.5 py-1.5 rounded-pill small">
                                <i class="bi bi-geo-alt me-1"></i>@Model.Location
                            </span>
                        }
                        @if (Model.SelectedMaxPrice.HasValue && Model.SelectedMaxPrice.Value < Model.MaxPrice)
                        {
                            <span class="badge bg-light text-dark border px-2.5 py-1.5 rounded-pill small">
                                ≤ ৳@Model.SelectedMaxPrice.Value.ToString("N0") / day
                            </span>
                        }
                    </div>
                }
            </div>

            <!-- ==========================================
                 RESULTS GRID
                 ========================================== -->
            @if (Model.EquipmentList.Any())
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4" id="equipmentResultsGrid">
                    @foreach (var item in Model.EquipmentList)
                    {
                        <div class="col">
                            <div class="card krishi-card h-100 border-0 shadow-sm rounded-4 overflow-hidden d-flex flex-column transition-hover">
                                
                                <!-- Equipment Image & Status Badge -->
                                <div class="position-relative bg-light text-center overflow-hidden" style="height: 190px;">
                                    <img src="@item.ImageUrl" class="card-img-top object-fit-cover w-100 h-100" alt="@item.Name" loading="lazy" />
                                    
                                    <!-- Category Pill -->
                                    <div class="position-absolute top-0 start-0 m-2.5">
                                        <span class="badge bg-white text-dark shadow-sm rounded-pill px-2.5 py-1 small fw-semibold opacity-95">
                                            @item.Category
                                        </span>
                                    </div>

                                    <!-- Status / Availability Badge -->
                                    <div class="position-absolute top-0 end-0 m-2.5">
                                        @if (item.IsAvailable)
                                        {
                                            <span class="badge bg-success shadow-sm rounded-pill px-2.5 py-1 small fw-semibold">
                                                <i class="bi bi-check-circle-fill me-1"></i>Available
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary shadow-sm rounded-pill px-2.5 py-1 small fw-semibold">
                                                <i class="bi bi-clock-fill me-1"></i>Booked
                                            </span>
                                        }
                                    </div>

                                    <!-- Distance Badge -->
                                    <div class="position-absolute bottom-0 start-0 m-2">
                                        <span class="badge bg-dark bg-opacity-75 text-white rounded-pill px-2 py-0.5 small" style="font-size: 0.75rem;">
                                            <i class="bi bi-compass me-1"></i>@item.DistanceKm.ToString("0.0") km away
                                        </span>
                                    </div>
                                </div>

                                <!-- Card Body -->
                                <div class="card-body d-flex flex-column p-3.5">
                                    
                                    <!-- Title -->
                                    <h5 class="card-title fw-bold text-dark mb-1 text-truncate" title="@item.Name">
                                        @item.Name
                                    </h5>

                                    <!-- Location & Owner -->
                                    <div class="small text-muted mb-3">
                                        <div class="d-flex align-items-center gap-1 text-truncate mb-1">
                                            <i class="bi bi-geo-alt text-success"></i>
                                            <span class="text-truncate">@item.Location</span>
                                        </div>
                                        <div class="d-flex align-items-center justify-content-between">
                                            <span class="text-truncate"><i class="bi bi-person text-muted me-1"></i>@item.OwnerName</span>
                                            <span class="text-warning fw-semibold"><i class="bi bi-star-fill me-1"></i>@item.Rating.ToString("0.0") (@item.ReviewCount)</span>
                                        </div>
                                    </div>

                                    <!-- Pricing & Action Button -->
                                    <div class="pt-3 border-top mt-auto">
                                        <div class="d-flex justify-content-between align-items-baseline mb-3">
                                            <div>
                                                <span class="text-muted small d-block">Rental Rate</span>
                                                <span class="fw-bold text-success fs-5">৳@item.DailyRate.ToString("N0")</span>
                                                <span class="text-muted small">/ day</span>
                                            </div>
                                            @if (item.HourlyRate.HasValue)
                                            {
                                                <div class="text-end">
                                                    <span class="text-muted small d-block">Hourly</span>
                                                    <span class="fw-semibold text-dark">৳@item.HourlyRate.Value.ToString("N0")</span>
                                                    <span class="text-muted small">/ hr</span>
                                                </div>
                                            }
                                        </div>

                                        <a asp-controller="Equipment" asp-action="Details" asp-route-id="@item.Id" 
                                           class="btn btn-krishi-primary w-100 fw-semibold rounded-3 py-2 d-flex align-items-center justify-content-center gap-1.5 shadow-sm">
                                            <span>View Details & Request</span>
                                            <i class="bi bi-arrow-right small"></i>
                                        </a>
                                    </div>

                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Empty State -->
                <div class="card krishi-card border-0 shadow-sm rounded-4 p-5 text-center my-4">
                    <div class="mb-3">
                        <div class="d-inline-flex p-3 rounded-circle bg-light text-muted mb-2">
                            <i class="bi bi-search text-success" style="font-size: 3rem;"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">No equipment matches your filters</h4>
                    <p class="text-secondary mb-4 mx-auto" style="max-width: 460px;">
                        Try widening your search criteria, clearing the category filters, or selecting a different location.
                    </p>
                    <div>
                        <a asp-controller="Equipment" asp-action="Index" class="btn btn-krishi-primary rounded-pill px-4 py-2 fw-semibold">
                            <i class="bi bi-arrow-counterclockwise me-1.5"></i> Clear All Filters
                        </a>
                    </div>
                </div>
            }

        </div>
    </div>
</form>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Auto submit on select change for sort and location dropdowns
            const filterTriggers = document.querySelectorAll(".filter-trigger");
            filterTriggers.forEach(function (element) {
                element.addEventListener("change", function () {
                    document.getElementById("equipmentFilterForm").submit();
                });
            });
        });
    </script>
}
