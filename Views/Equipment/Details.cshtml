@model KrishiLink.Models.ViewModels.EquipmentDetailViewModel
@{
    ViewData["Title"] = Model.Name;
    var primaryImage = Model.ImageUrls.FirstOrDefault() ?? "";
    var bookedDatesJson = System.Text.Json.JsonSerializer.Serialize(Model.BookedDates.Select(d => d.ToString("yyyy-MM-dd")).ToList());
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <style>
        .leaflet-popup-content-wrapper { border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.15); }
        .custom-map-pin {
            background-color: #198754;
            color: white;
            border-radius: 50% 50% 50% 0;
            transform: rotate(-45deg);
            width: 34px;
            height: 34px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid white;
            box-shadow: 0 2px 8px rgba(0,0,0,0.3);
        }
        .custom-map-pin i {
            transform: rotate(45deg);
            font-size: 15px;
        }
    </style>
}

<!-- Breadcrumb Navigation -->
<nav aria-label="@L["breadcrumb"]" class="mb-3">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-success text-decoration-none">@L["Home"]</a></li>
        <li class="breadcrumb-item"><a asp-controller="Equipment" asp-action="Index" class="text-success text-decoration-none">@L["Equipment"]</a></li>
        <li class="breadcrumb-item active text-muted" aria-current="page">@Model.Name</li>
    </ol>
</nav>

<!-- Page Header & Action State Alert -->
<div id="requestSuccessAlert" class="alert alert-success border-0 shadow-sm rounded-3 mb-4 @(Model.IsRequestSubmitted ? "d-flex" : "d-none") align-items-center gap-3">
    <div>
        <h6 class="fw-bold mb-1 text-success-emphasis">@L["Rental Request Submitted Successfully!"]</h6>
        <p class="mb-0 small text-success-emphasis">@L["Your request has been sent to"] <strong>@Model.OwnerName</strong>@L[". You will receive a notification as soon as the request is accepted."]</p>
    </div>
</div>
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-triangle-fill"></i><span class="small">@TempData["ErrorMessage"]</span>
    </div>
}

<div class="row g-4">
    <!-- LEFT COLUMN: Image Gallery, Equipment Details & Availability Calendar -->
    <div class="col-12 col-lg-7 col-xl-8">
        
        <!-- Image Gallery Component -->
        <div class="card krishi-card overflow-hidden mb-4 border-0 shadow-sm">
            <div class="position-relative bg-light text-center">
                <img id="mainGalleryImage" src="@primaryImage" class="img-fluid object-fit-cover w-100" style="height: 380px; transition: opacity 0.25s ease;" alt="@Model.Name" />
                <div class="position-absolute top-0 end-0 m-3">
                    <partial name="_StatusBadge" model="@Model.Status" />
                </div>
            </div>

            @if (Model.ImageUrls.Count > 1)
            {
                <div class="card-body p-3 bg-white border-top">
                    <div class="d-flex gap-2 overflow-x-auto pb-1">
                        @for (int i = 0; i < Model.ImageUrls.Count; i++)
                        {
                            var imgUrl = Model.ImageUrls[i];
                            <button type="button" class="btn p-0 border rounded overflow-hidden gallery-thumb-btn @(i == 0 ? "border-success border-2" : "border-light-subtle")"
                                    onclick="switchMainImage('@imgUrl', this)" aria-label="@L["View equipment photo {0}", i+1]">
                                <img src="@imgUrl" class="object-fit-cover" style="width: 76px; height: 60px;" alt="@L["Thumbnail {0}", i+1]" />
                            </button>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Details Panel -->
        <div class="card krishi-card p-4 mb-4 border-0 shadow-sm">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1.5 fw-semibold">
                        @L[Model.Category]
                    </span>
                    @if (Model.LastServicedDaysAgo.HasValue)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-1.5 shadow-xs" title="@L["Verified Maintenance Log Available"]">
                            <i class="bi bi-wrench-adjustable text-success"></i>
                            @if (Model.LastServicedDaysAgo.Value == 0)
                            {
                                @L["Last serviced: Today"]
                            }
                            else if (Model.LastServicedDaysAgo.Value == 1)
                            {
                                @L["Last serviced: Yesterday"]
                            }
                            else
                            {
                                @L["Last serviced: {0} days ago", Model.LastServicedDaysAgo.Value]
                            }
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-light text-muted border rounded-pill px-2.5 py-1.5 small">
                            <i class="bi bi-info-circle me-1"></i>@L["No recent service logged"]
                        </span>
                    }
                </div>
                <span class="text-muted small d-flex align-items-center gap-1">
                    @L[Model.Location]
                </span>
            </div>

            <h2 class="fw-bold text-dark mb-3">@Model.Name</h2>

            <!-- Rates Highlight Box -->
            <div class="row g-3 p-3 rounded-3 mb-4 bg-light text-dark border">
                <div class="col-6 col-sm-4">
                    <span class="text-muted small d-block">@L["Daily Rental Rate"]</span>
                    <span class="fs-4 fw-bold text-success">@Model.DailyRate</span>
                </div>
                <div class="col-6 col-sm-4">
                    <span class="text-muted small d-block">@L["Hourly Rate"]</span>
                    <span class="fs-5 fw-semibold text-dark">@(string.IsNullOrEmpty(Model.HourlyRate) ? "—" : Model.HourlyRate)</span>
                </div>
                <div class="col-12 col-sm-4 border-start-sm pt-2 pt-sm-0">
                    <span class="text-muted small d-block">@L["Min. Duration"]</span>
                    <span class="fw-semibold text-dark">@L["1 Day / 2 Hours"]</span>
                </div>
            </div>

            <!-- Description -->
            <h5 class="fw-bold text-dark mb-2">@L["Equipment Description"]</h5>
            <p class="text-secondary leading-relaxed mb-4">@Model.Description</p>

            <!-- Owner Info Card -->
            <div class="p-3 rounded-3 border bg-white d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center fw-bold" style="width: 44px; height: 44px;">
                        @(Model.OwnerName.Length > 0 ? Model.OwnerName[0].ToString().ToUpperInvariant() : "O")
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-1.5">
                            @Model.OwnerName
                            @if (Model.OwnerIsVerified)
                            {
                                <i class="bi bi-patch-check-fill text-success" title="@L["Verified Owner"]"></i>
                            }
                        </h6>
                        <div class="d-flex align-items-center gap-2 small text-muted">
                            @if (Model.ReviewCount > 0)
                            {
                                <span class="text-warning fw-bold d-inline-flex align-items-center gap-1">
                                    <i class="bi bi-star-fill"></i> @Model.AverageRating.ToString("0.0")
                                </span>
                                <span>(@L["{0} reviews", Model.ReviewCount])</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border py-0.5 px-2">@L["New Listing"]</span>
                            }
                            <span>@L["Member since {0}", Model.OwnerMemberSince]</span>
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    @if (!string.IsNullOrWhiteSpace(Model.OwnerRankText))
                    {
                        <a asp-controller="Leaderboard" asp-action="Index" class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2 rounded-pill small fw-bold text-decoration-none">
                            <i class="bi bi-trophy-fill text-warning me-1"></i> @Model.OwnerRankText
                        </a>
                    }
                    @if (Model.OwnerIsVerified)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill small fw-semibold shadow-xs">
                            <i class="bi bi-patch-check-fill text-success me-1"></i> @L["Verified Owner"]
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-light text-muted border px-3 py-2 rounded-pill small">
                            <i class="bi bi-shield text-muted me-1"></i> @L["Unverified"]
                        </span>
                    }
                </div>
            </div>

            @if (Model.OwnerBadges != null && Model.OwnerBadges.Any())
            {
                <div class="mt-2.5 pt-2.5 border-top d-flex align-items-center gap-2 flex-wrap">
                    <span class="text-muted small fw-medium me-1"><i class="bi bi-award"></i> @L["Badges"]:</span>
                    <partial name="_OwnerBadgeList" model="Model.OwnerBadges" />
                </div>
            }

            <!-- Machinery Location & Map Directions Card -->
            <div class="card p-3.5 mt-4 border rounded-4 bg-light shadow-xs">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 pb-2 border-bottom">
                    <div>
                        <h6 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                            <i class="bi bi-geo-alt-fill text-success"></i>
                            <span>@L["Location & Map Directions"]</span>
                        </h6>
                        <div class="text-muted small d-flex align-items-center flex-wrap gap-2">
                            <span class="fw-semibold text-dark"><i class="bi bi-pin-map text-success me-1"></i>@Model.Location</span>
                            @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                            {
                                <span class="badge bg-white text-muted border font-monospace">@Model.FormattedCoordinates</span>
                            }
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-semibold shadow-xs" onclick="copyCoordinates('@Model.Latitude.Value.ToString("F6")', '@Model.Longitude.Value.ToString("F6")')">
                                <i class="bi bi-clipboard me-1"></i> @L["Copy GPS"]
                            </button>
                            <a href="@Model.GoogleMapsUrl" target="_blank" rel="noopener noreferrer" class="btn btn-success btn-sm rounded-pill px-3 fw-semibold shadow-xs">
                                <i class="bi bi-signpost-2-fill me-1"></i> @L["Get Directions"]
                            </a>
                        }
                    </div>
                </div>

                <div id="equipmentDetailMap" class="rounded-3 border shadow-xs bg-white" style="height: 260px; width: 100%; z-index: 1;"></div>
            </div>
        </div>

        <!-- Availability Calendar Component -->
        <partial name="_AvailabilityCalendar" model="Model.BookedDates" />

        <!-- =========================================================================
             EQUIPMENT HEALTH & MAINTENANCE HISTORY SECTION
             ========================================================================= -->
        <div class="card krishi-card p-4 mt-4 border-0 shadow-sm" id="healthSection">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 pb-3 border-bottom">
                <h4 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-wrench-adjustable text-success"></i>
                    <span>@L["Machinery Health & Maintenance History"]</span>
                </h4>
                @if (Model.LastServicedDaysAgo.HasValue)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1.5 fw-semibold shadow-xs">
                        <i class="bi bi-patch-check-fill me-1"></i>
                        @if (Model.LastServicedDaysAgo.Value == 0)
                        {
                            @L["Serviced Today (Prime Condition)"]
                        }
                        else if (Model.LastServicedDaysAgo.Value == 1)
                        {
                            @L["Serviced Yesterday (Prime Condition)"]
                        }
                        else
                        {
                            @L["Last Serviced {0} Days Ago", Model.LastServicedDaysAgo.Value]
                        }
                    </span>
                }
            </div>

            @if (Model.MaintenanceHistory.Any())
            {
                <!-- Trust summary alert -->
                <div class="bg-light p-3.5 rounded-4 border mb-3 d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                            <i class="bi bi-shield-check fs-5"></i>
                        </div>
                        <div>
                            <span class="fw-bold text-dark d-block">@L["Verified Owner Maintenance Log"]</span>
                            <span class="small text-muted">@L["Owner records routine maintenance and inspections on KrishiLink to ensure optimal fieldwork reliability."]</span>
                        </div>
                    </div>
                    <span class="badge bg-white text-dark border font-monospace px-3 py-2 rounded-pill small">
                        @L["{0} Service Events Logged", Model.MaintenanceHistory.Count]
                    </span>
                </div>

                <!-- Timeline / Service List -->
                <div class="d-flex flex-column gap-2.5">
                    @foreach (var log in Model.MaintenanceHistory)
                    {
                        <div class="p-3.5 rounded-3 border bg-white shadow-xs">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-1.5">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 fw-semibold">
                                        @L[log.ServiceType]
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(log.ServicedBy))
                                    {
                                        <span class="text-muted small"><i class="bi bi-tools text-muted me-1"></i>@log.ServicedBy</span>
                                    }
                                </div>
                                <div class="text-end text-nowrap">
                                    <span class="fw-bold text-dark small">@log.ServiceDateFormatted</span>
                                    <span class="badge bg-light text-muted border ms-1" style="font-size: 0.72rem;">@L[log.DaysAgoText]</span>
                                </div>
                            </div>
                            <p class="text-secondary small mb-0 mt-2 ps-1 border-start border-2 border-success-subtle ps-2.5">
                                @log.Description
                            </p>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Empty State -->
                <div class="text-center py-4 px-3 bg-light rounded-4 border">
                    <i class="bi bi-journal-x text-muted fs-3 d-block mb-1"></i>
                    <h6 class="fw-bold text-dark mb-1">@L["No Maintenance Logs Available"]</h6>
                    <p class="text-muted small mb-0 mx-auto" style="max-width: 420px;">
                        @L["The owner has not logged specific servicing history for this equipment yet. You may contact the owner for machinery condition details."]
                    </p>
                </div>
            }
        </div>

        <!-- =========================================================================
             RATINGS & REVIEWS SECTION
             ========================================================================= -->
        <div class="card krishi-card p-4 mt-4 border-0 shadow-sm" id="reviewsSection">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4 pb-3 border-bottom">
                <h4 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-star-fill text-warning"></i>
                    <span>@L["Ratings & Reviews"]</span>
                </h4>
                @if (Model.ReviewCount > 0)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1.5 fw-semibold">
                        @L["{0} Verified Farmer Reviews", Model.ReviewCount]
                    </span>
                }
            </div>

            @if (Model.ReviewCount > 0 && Model.Reviews != null)
            {
                <!-- Rating Score Summary & Breakdown Card -->
                <div class="bg-light p-4 rounded-4 border mb-4">
                    <div class="row g-4 align-items-center">
                        
                        <!-- Left: Overall Score -->
                        <div class="col-12 col-md-5 text-center text-md-start border-end-md">
                            <div class="d-flex flex-column align-items-center align-items-md-start">
                                <div class="display-4 fw-black text-dark lh-1 mb-1">
                                    @Model.AverageRating.ToString("0.0")
                                </div>
                                <div class="text-warning mb-1 fs-5">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= Math.Round(Model.AverageRating))
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star text-muted opacity-50"></i>
                                        }
                                    }
                                </div>
                                <span class="text-muted small fw-medium">
                                    @L["Based on {0} verified booking reviews", Model.ReviewCount]
                                </span>
                            </div>
                        </div>

                        <!-- Right: Star Breakdown Progress Bars -->
                        <div class="col-12 col-md-7">
                            <div class="d-flex flex-column gap-1.5">
                                
                                <!-- 5 Stars -->
                                <div class="d-flex align-items-center gap-2 small">
                                    <span class="text-muted text-nowrap" style="width: 45px;">5 <i class="bi bi-star-fill text-warning" style="font-size: 0.75rem;"></i></span>
                                    <div class="progress flex-grow-1" style="height: 8px;">
                                        <div class="progress-bar bg-warning" role="progressbar" style="width: @(Model.Reviews.Breakdown.FiveStarPercent)%;" aria-valuenow="@Model.Reviews.Breakdown.FiveStarPercent" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <span class="text-muted text-end text-nowrap" style="width: 30px;">@Model.Reviews.Breakdown.FiveStarCount</span>
                                </div>

                                <!-- 4 Stars -->
                                <div class="d-flex align-items-center gap-2 small">
                                    <span class="text-muted text-nowrap" style="width: 45px;">4 <i class="bi bi-star-fill text-warning" style="font-size: 0.75rem;"></i></span>
                                    <div class="progress flex-grow-1" style="height: 8px;">
                                        <div class="progress-bar bg-warning" role="progressbar" style="width: @(Model.Reviews.Breakdown.FourStarPercent)%;" aria-valuenow="@Model.Reviews.Breakdown.FourStarPercent" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <span class="text-muted text-end text-nowrap" style="width: 30px;">@Model.Reviews.Breakdown.FourStarCount</span>
                                </div>

                                <!-- 3 Stars -->
                                <div class="d-flex align-items-center gap-2 small">
                                    <span class="text-muted text-nowrap" style="width: 45px;">3 <i class="bi bi-star-fill text-warning" style="font-size: 0.75rem;"></i></span>
                                    <div class="progress flex-grow-1" style="height: 8px;">
                                        <div class="progress-bar bg-warning" role="progressbar" style="width: @(Model.Reviews.Breakdown.ThreeStarPercent)%;" aria-valuenow="@Model.Reviews.Breakdown.ThreeStarPercent" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <span class="text-muted text-end text-nowrap" style="width: 30px;">@Model.Reviews.Breakdown.ThreeStarCount</span>
                                </div>

                                <!-- 2 Stars -->
                                <div class="d-flex align-items-center gap-2 small">
                                    <span class="text-muted text-nowrap" style="width: 45px;">2 <i class="bi bi-star-fill text-warning" style="font-size: 0.75rem;"></i></span>
                                    <div class="progress flex-grow-1" style="height: 8px;">
                                        <div class="progress-bar bg-warning" role="progressbar" style="width: @(Model.Reviews.Breakdown.TwoStarPercent)%;" aria-valuenow="@Model.Reviews.Breakdown.TwoStarPercent" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <span class="text-muted text-end text-nowrap" style="width: 30px;">@Model.Reviews.Breakdown.TwoStarCount</span>
                                </div>

                                <!-- 1 Star -->
                                <div class="d-flex align-items-center gap-2 small">
                                    <span class="text-muted text-nowrap" style="width: 45px;">1 <i class="bi bi-star-fill text-warning" style="font-size: 0.75rem;"></i></span>
                                    <div class="progress flex-grow-1" style="height: 8px;">
                                        <div class="progress-bar bg-warning" role="progressbar" style="width: @(Model.Reviews.Breakdown.OneStarPercent)%;" aria-valuenow="@Model.Reviews.Breakdown.OneStarPercent" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <span class="text-muted text-end text-nowrap" style="width: 30px;">@Model.Reviews.Breakdown.OneStarCount</span>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>

                <!-- Individual Reviews List -->
                <div class="d-flex flex-column gap-3">
                    @foreach (var review in Model.Reviews.Reviews)
                    {
                        <div class="p-3.5 rounded-3 border bg-white shadow-xs">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <div class="d-flex align-items-center gap-2.5">
                                    <div class="rounded-circle bg-success-subtle text-success border border-success-subtle d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px;">
                                        @review.UserInitial
                                    </div>
                                    <div>
                                        <h6 class="fw-bold text-dark mb-0">@review.FarmerName</h6>
                                        <div class="small text-muted d-flex align-items-center gap-2">
                                            @if (!string.IsNullOrWhiteSpace(review.FarmerLocation))
                                            {
                                                <span><i class="bi bi-geo-alt text-success"></i> @review.FarmerLocation</span>
                                            }
                                            <span class="badge bg-light text-muted border py-0.5 px-1.5" style="font-size: 0.7rem;">@L["Verified Rental"]</span>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="text-end">
                                    <div class="text-warning small mb-0.5">
                                        @for (int s = 1; s <= 5; s++)
                                        {
                                            if (s <= review.Rating)
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star text-muted opacity-50"></i>
                                            }
                                        }
                                    </div>
                                    <span class="text-muted small" style="font-size: 0.75rem;">@review.TimeAgo</span>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(review.Comment))
                            {
                                <p class="text-secondary small mb-0 mt-2 ps-1 border-start border-2 border-success-subtle ps-2.5">
                                    @review.Comment
                                </p>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Empty State -->
                <div class="text-center py-5 px-3 bg-light rounded-4 border">
                    <div class="display-6 text-muted mb-2">
                        <i class="bi bi-chat-square-heart text-success opacity-75"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-1">@L["No Reviews Yet"]</h6>
                    <p class="text-muted small mb-0" style="max-width: 420px; margin: 0 auto;">
                        @L["Be the first farmer to rent this equipment and leave an honest rating and review after your booking is completed!"]
                    </p>
                </div>
            }
        </div>
    </div>

    <!-- RIGHT COLUMN: Sticky Rental Request Form (Desktop) -->
    <div class="col-12 col-lg-5 col-xl-4">
        <div class="sticky-top" style="top: 90px; z-index: 1000;" id="requestFormContainer">
            <div class="card krishi-card border-0 shadow p-4" style="border-radius: var(--krishi-radius-lg);">
                <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom">
                    <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                        @L["Rental Request Form"]
                    </h5>
                    <span class="fs-5 fw-bold text-success">@Model.DailyRate</span>
                </div>

                <form id="rentalRequestForm" asp-controller="Equipment" asp-action="SubmitRequest" method="post" onsubmit="handleFormSubmit(event)">
                    <input type="hidden" asp-for="Id" />
                    <!-- Start Date -->
                    <div class="mb-3">
                        <label for="startDateInput" class="form-label small fw-bold text-dark">
                            @L["Start Date"] <span class="text-danger">*</span>
                        </label>
                        <input type="date" class="form-control form-control-lg rounded-3" id="startDateInput" name="StartDate" required
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" onchange="validateDates()" />
                    </div>

                    <!-- End Date -->
                    <div class="mb-3">
                        <label for="endDateInput" class="form-label small fw-bold text-dark">
                            @L["End Date"] <span class="text-danger">*</span>
                        </label>
                        <input type="date" class="form-control form-control-lg rounded-3" id="endDateInput" name="EndDate" required
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" onchange="validateDates()" />
                        <div id="dateValidationError" class="form-text text-danger d-none mt-1">
                            @L["End Date must be after Start Date and not overlap booked dates."]
                        </div>
                    </div>

                    <!-- Estimated Cost Summary -->
                    <div id="costSummaryBox" class="p-3 bg-success-subtle text-success border border-success-subtle rounded-3 mb-3 d-none">
                        <div class="d-flex justify-content-between small fw-medium">
                            <span>@L["Total Rental Duration:"]</span>
                            <span id="summaryDaysCount">@L["0 Days"]</span>
                        </div>
                        <div class="d-flex justify-content-between small fw-medium mt-1">
                            <span>@L["Gross Rental Fee:"]</span>
                            <span id="summaryGrossFee">৳0</span>
                        </div>
                        <div id="summaryDiscountRow" class="d-flex justify-content-between small fw-bold text-success mt-1 d-none">
                            <span id="summaryDiscountLabel">@L["Loyalty Discount:"]</span>
                            <span id="summaryDiscountAmount">-৳0</span>
                        </div>
                        <div class="d-flex justify-content-between fw-bold fs-6 mt-1.5 pt-1.5 border-top border-success-subtle">
                            <span>@L["Estimated Net Total:"]</span>
                            <span id="summaryTotalFee">@L["Tk {0}", 0]</span>
                        </div>
                        <div class="d-flex justify-content-between small text-muted mt-1" style="font-size: 0.75rem;">
                            <span>@L["KrishiPoints Earned on Completion:"]</span>
                            <span id="summaryPointsEarned" class="fw-bold text-success">+10 pts</span>
                        </div>
                    </div>

                    <!-- Loyalty Points & Promo Code Redemption -->
                    <div class="card border border-success-subtle bg-light rounded-3 mb-3 p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label small fw-bold text-dark mb-0 d-flex align-items-center gap-1.5">
                                <i class="bi bi-gift-fill text-success"></i>
                                <span>@L["KrishiPoints & Promo Code"]</span>
                            </label>
                            @if (User.Identity?.IsAuthenticated == true && Model.FarmerLoyaltyPoints > 0)
                            {
                                <span class="badge bg-success text-white rounded-pill px-2 py-0.5 small" id="farmerPointsBadge">
                                    @Model.FarmerLoyaltyPoints @L["pts available"]
                                </span>
                            }
                        </div>

                        <!-- Quick Tier Select (If points available) -->
                        @if (User.Identity?.IsAuthenticated == true && Model.FarmerLoyaltyPoints >= 50 && Model.AvailableConversionTiers.Any(t => t.PointsRequired <= Model.FarmerLoyaltyPoints))
                        {
                            <div class="mb-2">
                                <label class="small text-muted mb-1 d-block" style="font-size: 0.78rem;">@L["1-Click Redeem KrishiPoints:"]</label>
                                <select class="form-select form-select-sm rounded-3" id="pointsTierSelect" onchange="applyPointsTier(this.value)">
                                    <option value="0">@L["-- Do not use points --"]</option>
                                    @foreach (var tier in Model.AvailableConversionTiers.Where(t => t.PointsRequired <= Model.FarmerLoyaltyPoints))
                                    {
                                        <option value="@tier.PointsRequired" data-discount="@tier.DiscountTaka">
                                            @L["Use {0} pts → Save ৳{1}", tier.PointsRequired, tier.DiscountTaka.ToString("N0")]
                                        </option>
                                    }
                                </select>
                            </div>
                        }

                        <!-- Or Promo Code Input -->
                        <div class="mt-1">
                            <label class="small text-muted mb-1 d-block" style="font-size: 0.78rem;">@L["Or enter Promo Voucher code:"]</label>
                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control rounded-start-3 text-uppercase" id="promoCodeInput" placeholder="@L["e.g. KL-PTS120-ABCD"]" />
                                <button type="button" class="btn btn-outline-success px-3 fw-semibold" id="applyPromoBtn" onclick="applyPromoCode()">@L["Apply"]</button>
                                <button type="button" class="btn btn-outline-secondary d-none" id="clearPromoBtn" onclick="clearPromoCode()"><i class="bi bi-x"></i></button>
                            </div>
                            <div id="promoFeedbackMsg" class="form-text small mt-1 d-none"></div>
                        </div>

                        <!-- Hidden form fields to submit -->
                        <input type="hidden" name="AppliedPromoCode" id="hiddenAppliedPromoCode" value="" />
                        <input type="hidden" name="PointsUsed" id="hiddenPointsUsed" value="0" />
                    </div>

                    <!-- Optional Note -->
                    <div class="mb-4">
                        <label for="noteInput" class="form-label small fw-bold text-dark">
                            @L["Note to Owner"] <span class="text-muted">@L["(Optional)"]</span>
                        </label>
                        <textarea class="form-control rounded-3" id="noteInput" name="Note" rows="3" placeholder="@L["e.g. Need operator, location details, or specific crop field details..."]"></textarea>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" id="submitRequestBtn" class="btn btn-krishi-primary w-100 py-3 rounded-pill fw-bold d-flex align-items-center justify-content-center gap-2 shadow-sm fs-6">
                        <span id="btnText">@L["Send Rental Request"]</span>
                    </button>
                </form>

                <p class="text-muted small text-center mb-0 mt-3">
                    @L["No immediate payment required. Owner will confirm availability."]
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Mobile Sticky Bottom Bar (Visible on mobile viewports only) -->
<div class="d-lg-none position-fixed bottom-0 start-0 end-0 bg-white border-top shadow-lg p-3" style="z-index: 1040;">
    <div class="container d-flex align-items-center justify-content-between gap-2">
        <div>
            <span class="text-muted small d-block">@L["Daily Rate"]</span>
            <span class="fw-bold text-success fs-5">@Model.DailyRate</span>
        </div>
        <button type="button" id="mobileRequestBtn" class="btn btn-krishi-primary rounded-pill px-4 py-2.5 fw-bold" onclick="scrollToRequestForm()">
            @L["Request Equipment"]
        </button>
    </div>
</div>

@section Scripts {
    <script>
        const bookedDates = @Html.Raw(bookedDatesJson);
        const dailyRate = @Model.DailyRateAmount.ToString(System.Globalization.CultureInfo.InvariantCulture);
        const isAuthenticated = @(User.Identity?.IsAuthenticated == true ? "true" : "false");
        const loginUrl = '@Url.Action("Login", "Account", new { returnUrl = Url.Action("Details", "Equipment", new { id = Model.Id }) })';

        function switchMainImage(imgUrl, btnElement) {
            const mainImg = document.getElementById('mainGalleryImage');
            if (mainImg) {
                mainImg.style.opacity = '0.3';
                setTimeout(() => {
                    mainImg.src = imgUrl;
                    mainImg.style.opacity = '1';
                }, 150);
            }
            document.querySelectorAll('.gallery-thumb-btn').forEach(b => {
                b.classList.remove('border-success', 'border-2');
                b.classList.add('border-light-subtle');
            });
            if (btnElement) {
                btnElement.classList.remove('border-light-subtle');
                btnElement.classList.add('border-success', 'border-2');
            }
        }

        function selectCalendarDate(dateStr) {
            const startInput = document.getElementById('startDateInput');
            const endInput = document.getElementById('endDateInput');
            if (startInput && !startInput.value) {
                startInput.value = dateStr;
            } else if (endInput && !endInput.value) {
                endInput.value = dateStr;
            } else {
                startInput.value = dateStr;
                endInput.value = '';
            }
            validateDates();
            scrollToRequestForm();
        }

        let currentAppliedDiscount = 0;
        let currentAppliedPromo = '';
        let currentPointsUsed = 0;
        let currentDaysCount = 0;
        let currentGrossFee = 0;

        function applyPointsTier(pts) {
            pts = parseInt(pts) || 0;
            const selectEl = document.getElementById('pointsTierSelect');
            const promoInput = document.getElementById('promoCodeInput');
            const promoFeedback = document.getElementById('promoFeedbackMsg');
            const clearBtn = document.getElementById('clearPromoBtn');

            if (pts > 0) {
                // Clear promo text input if point tier is selected
                if (promoInput) promoInput.value = '';
                if (clearBtn) clearBtn.classList.add('d-none');
                if (promoFeedback) promoFeedback.classList.add('d-none');
                currentAppliedPromo = '';
                document.getElementById('hiddenAppliedPromoCode').value = '';
                document.getElementById('hiddenPointsUsed').value = pts;
                currentPointsUsed = pts;

                const selectedOption = selectEl?.selectedOptions[0];
                const discount = parseFloat(selectedOption?.getAttribute('data-discount')) || 0;
                currentAppliedDiscount = discount;
            } else {
                currentPointsUsed = 0;
                document.getElementById('hiddenPointsUsed').value = 0;
                currentAppliedDiscount = 0;
            }

            recalculateSummary();
        }

        async function applyPromoCode() {
            const promoInput = document.getElementById('promoCodeInput');
            const code = promoInput?.value?.trim()?.toUpperCase() || '';
            const feedback = document.getElementById('promoFeedbackMsg');
            const clearBtn = document.getElementById('clearPromoBtn');
            const tierSelect = document.getElementById('pointsTierSelect');

            if (!code) {
                if (feedback) {
                    feedback.textContent = '@L["Please enter a valid promo voucher code."]';
                    feedback.className = 'form-text small mt-1 text-danger';
                    feedback.classList.remove('d-none');
                }
                return;
            }

            if (!validateDates() || currentGrossFee <= 0) {
                if (feedback) {
                    feedback.textContent = '@L["Please select valid rental dates first."]';
                    feedback.className = 'form-text small mt-1 text-danger';
                    feedback.classList.remove('d-none');
                }
                return;
            }

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                const res = await fetch('/Loyalty/ValidatePromo', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        promoCode: code,
                        pointsToRedeem: null,
                        grossAmount: currentGrossFee
                    })
                });

                const data = await res.json();
                if (data.isValid) {
                    if (tierSelect) tierSelect.value = "0";
                    currentPointsUsed = data.pointsRequired || 0;
                    currentAppliedDiscount = data.discountAmount || 0;
                    currentAppliedPromo = data.promoCode || code;

                    document.getElementById('hiddenAppliedPromoCode').value = currentAppliedPromo;
                    document.getElementById('hiddenPointsUsed').value = currentPointsUsed;

                    if (feedback) {
                        feedback.textContent = `@L["Promo Applied!"] ${data.message}`;
                        feedback.className = 'form-text small mt-1 text-success fw-semibold';
                        feedback.classList.remove('d-none');
                    }
                    if (clearBtn) clearBtn.classList.remove('d-none');
                } else {
                    currentAppliedDiscount = 0;
                    currentAppliedPromo = '';
                    document.getElementById('hiddenAppliedPromoCode').value = '';
                    document.getElementById('hiddenPointsUsed').value = 0;

                    if (feedback) {
                        feedback.textContent = data.message || '@L["Invalid or expired promo code."]';
                        feedback.className = 'form-text small mt-1 text-danger';
                        feedback.classList.remove('d-none');
                    }
                    if (clearBtn) clearBtn.classList.add('d-none');
                }
            } catch (err) {
                if (feedback) {
                    feedback.textContent = '@L["Network error validating promo code."]';
                    feedback.className = 'form-text small mt-1 text-danger';
                    feedback.classList.remove('d-none');
                }
            }

            recalculateSummary();
        }

        function clearPromoCode() {
            const promoInput = document.getElementById('promoCodeInput');
            const feedback = document.getElementById('promoFeedbackMsg');
            const clearBtn = document.getElementById('clearPromoBtn');

            if (promoInput) promoInput.value = '';
            if (feedback) feedback.classList.add('d-none');
            if (clearBtn) clearBtn.classList.add('d-none');

            currentAppliedDiscount = 0;
            currentAppliedPromo = '';
            currentPointsUsed = 0;
            document.getElementById('hiddenAppliedPromoCode').value = '';
            document.getElementById('hiddenPointsUsed').value = 0;

            recalculateSummary();
        }

        function recalculateSummary() {
            const costBox = document.getElementById('costSummaryBox');
            const summaryDaysCount = document.getElementById('summaryDaysCount');
            const summaryGrossFee = document.getElementById('summaryGrossFee');
            const summaryDiscountRow = document.getElementById('summaryDiscountRow');
            const summaryDiscountAmount = document.getElementById('summaryDiscountAmount');
            const summaryDiscountLabel = document.getElementById('summaryDiscountLabel');
            const summaryTotalFee = document.getElementById('summaryTotalFee');
            const summaryPointsEarned = document.getElementById('summaryPointsEarned');

            if (currentDaysCount <= 0 || currentGrossFee <= 0) {
                if (costBox) costBox.classList.add('d-none');
                return;
            }

            if (summaryDaysCount) {
                summaryDaysCount.textContent = currentDaysCount > 1
                    ? '@L["{0} Days", "__COUNT__"]'.replace('__COUNT__', currentDaysCount)
                    : '@L["{0} Day", "__COUNT__"]'.replace('__COUNT__', currentDaysCount);
            }

            if (summaryGrossFee) {
                summaryGrossFee.textContent = '৳' + currentGrossFee.toLocaleString();
            }

            const netTotal = Math.max(0, currentGrossFee - currentAppliedDiscount);

            if (currentAppliedDiscount > 0) {
                if (summaryDiscountRow) summaryDiscountRow.classList.remove('d-none');
                if (summaryDiscountAmount) summaryDiscountAmount.textContent = '-৳' + currentAppliedDiscount.toLocaleString();
                if (summaryDiscountLabel) {
                    summaryDiscountLabel.textContent = currentAppliedPromo
                        ? `@L["Promo Discount"] (${currentAppliedPromo}):`
                        : `@L["KrishiPoints Discount"] (${currentPointsUsed} pts):`;
                }
            } else {
                if (summaryDiscountRow) summaryDiscountRow.classList.add('d-none');
            }

            if (summaryTotalFee) {
                summaryTotalFee.textContent = '৳' + netTotal.toLocaleString();
            }

            if (summaryPointsEarned) {
                const pts = Math.max(10, Math.floor(netTotal / 100));
                summaryPointsEarned.textContent = `+${pts.toLocaleString()} pts`;
            }

            if (costBox) costBox.classList.remove('d-none');
        }

        function validateDates() {
            const startInput = document.getElementById('startDateInput');
            const endInput = document.getElementById('endDateInput');
            const errorDiv = document.getElementById('dateValidationError');
            const costBox = document.getElementById('costSummaryBox');
            const submitBtn = document.getElementById('submitRequestBtn');

            if (!startInput.value || !endInput.value) {
                errorDiv.classList.add('d-none');
                costBox.classList.add('d-none');
                currentDaysCount = 0;
                currentGrossFee = 0;
                return true;
            }

            const startDate = new Date(startInput.value);
            const endDate = new Date(endInput.value);

            if (endDate < startDate) {
                errorDiv.textContent = '@L["End Date must be on or after Start Date."]';
                errorDiv.classList.remove('d-none');
                costBox.classList.add('d-none');
                submitBtn.disabled = true;
                currentDaysCount = 0;
                currentGrossFee = 0;
                return false;
            }

            let curr = new Date(startDate);
            let hasOverlap = false;
            let daysCount = 0;

            while (curr <= endDate) {
                const dateStr = curr.toISOString().split('T')[0];
                if (bookedDates.includes(dateStr)) {
                    hasOverlap = true;
                    break;
                }
                daysCount++;
                curr.setDate(curr.getDate() + 1);
            }

            if (hasOverlap) {
                errorDiv.textContent = '@L["Selected date range overlaps with an already booked date."]';
                errorDiv.classList.remove('d-none');
                costBox.classList.add('d-none');
                submitBtn.disabled = true;
                currentDaysCount = 0;
                currentGrossFee = 0;
                return false;
            }

            errorDiv.classList.add('d-none');
            submitBtn.disabled = false;

            currentDaysCount = daysCount;
            currentGrossFee = daysCount * dailyRate;

            recalculateSummary();

            return true;
        }

        function scrollToRequestForm() {
            const container = document.getElementById('requestFormContainer');
            if (container) {
                container.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }

        function handleFormSubmit(e) {
            e.preventDefault();
            if (!validateDates()) return;
            if (!isAuthenticated) { window.location.href = loginUrl; return; }

            const startVal = document.getElementById('startDateInput').value;
            const endVal = document.getElementById('endDateInput').value;

            window.KrishiModal.confirm({
                title: '@L["Confirm Rental Request"]',
                body: `@L["Are you sure you want to send a rental request for"] <strong>@Model.Name</strong> @L["From"] <strong>${startVal}</strong> @L["To"] <strong>${endVal}</strong>?`,
                confirmText: '@L["Send Request"]',
                cancelText: '@L["Cancel"]',
                confirmClass: 'btn-krishi-primary',
                onConfirm: function () {
                    const submitBtn = document.getElementById('submitRequestBtn');
                    const btnText = document.getElementById('btnText');
                    if (submitBtn) submitBtn.disabled = true;
                    if (btnText) btnText.textContent = '@L["Sending..."]';
                    document.getElementById('rentalRequestForm').submit();
                }
            });
        }

        // -------------------------------------------------------------------------
        // LEAFLET MAP DISPLAY
        // -------------------------------------------------------------------------
        function copyCoordinates(lat, lng) {
            const text = `${lat}, ${lng}`;
            navigator.clipboard.writeText(text).then(() => {
                if (window.KrishiToast) {
                    KrishiToast.show('@L["Coordinates copied to clipboard!"]', { iconClass: 'bi-clipboard-check-fill text-success' });
                }
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            const mapEl = document.getElementById('equipmentDetailMap');
            if (!mapEl) return;

            const lat = @(Model.Latitude.HasValue ? Model.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "24.8465");
            const lng = @(Model.Longitude.HasValue ? Model.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "89.3777");

            const map = L.map('equipmentDetailMap', {
                scrollWheelZoom: false
            }).setView([lat, lng], 13);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
            }).addTo(map);

            const tractorIcon = L.divIcon({
                className: 'custom-leaflet-marker',
                html: `<div class="custom-map-pin"><i class="bi bi-gear-wide-connected"></i></div>`,
                iconSize: [34, 34],
                iconAnchor: [17, 34],
                popupAnchor: [0, -34]
            });

            const marker = L.marker([lat, lng], { icon: tractorIcon }).addTo(map);
            marker.bindPopup(`
                <div class="p-1">
                    <h6 class="fw-bold text-dark mb-1">@Model.Name</h6>
                    <p class="small text-muted mb-1"><i class="bi bi-geo-alt text-success me-1"></i>@Model.Location</p>
                    <div class="d-flex align-items-center justify-content-between gap-2 mt-2">
                        <span class="badge bg-success-subtle text-success fw-bold">@Model.DailyRate</span>
                        <a href="@Model.GoogleMapsUrl" target="_blank" class="btn btn-xs btn-outline-success rounded-pill px-2 py-0.5 small">@L["Directions"]</a>
                    </div>
                </div>
            `);

            setTimeout(() => { map.invalidateSize(); }, 300);
        });
    </script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
}
