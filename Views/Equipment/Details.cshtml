@model KrishiLink.Models.ViewModels.EquipmentDetailViewModel
@{
    ViewData["Title"] = Model.Name;
    var primaryImage = Model.ImageUrls.FirstOrDefault() ?? "";
    var bookedDatesJson = System.Text.Json.JsonSerializer.Serialize(Model.BookedDates.Select(d => d.ToString("yyyy-MM-dd")).ToList());
}

<!-- Breadcrumb Navigation -->
<nav aria-label="@L["breadcrumb"]" class="mb-3">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-success text-decoration-none">@L["Home"]</a></li>
        <li class="breadcrumb-item"><a asp-controller="Equipment" asp-action="Index" class="text-success text-decoration-none">@L["Equipment"]</a></li>
        <li class="breadcrumb-item active text-muted" aria-current="page">@Model.Name</li>
    </ol>
</nav>

<!-- Page Header & Action State Alert -->
<div id="requestSuccessAlert" class="alert alert-success border-0 shadow-sm rounded-3 mb-4 d-none align-items-center gap-3">
    <div>
        <h6 class="fw-bold mb-1 text-success-emphasis">@L["Rental Request Submitted Successfully!"]</h6>
        <p class="mb-0 small text-success-emphasis">@L["Your request has been sent to"] <strong>@Model.OwnerName</strong>@L[". You will receive a notification as soon as the request is accepted."]</p>
    </div>
</div>

<div class="row g-4">
    <!-- LEFT COLUMN: Image Gallery, Equipment Details & Availability Calendar -->
    <div class="col-12 col-lg-7 col-xl-8">
        
        <!-- Image Gallery Component -->
        <div class="card krishi-card overflow-hidden mb-4 border-0 shadow-sm">
            <div class="position-relative bg-light text-center">
                <img id="mainGalleryImage" src="@primaryImage" class="img-fluid object-fit-cover w-100" style="height: 380px; transition: opacity 0.25s ease;" alt="@Model.Name" />
                <div class="position-absolute top-0 end-0 m-3">
                    <partial name="_StatusBadge" model="@Model.Status" />
                </div>
            </div>

            @if (Model.ImageUrls.Count > 1)
            {
                <div class="card-body p-3 bg-white border-top">
                    <div class="d-flex gap-2 overflow-x-auto pb-1">
                        @for (int i = 0; i < Model.ImageUrls.Count; i++)
                        {
                            var imgUrl = Model.ImageUrls[i];
                            <button type="button" class="btn p-0 border rounded overflow-hidden gallery-thumb-btn @(i == 0 ? "border-success border-2" : "border-light-subtle")"
                                    onclick="switchMainImage('@imgUrl', this)" aria-label="@L["View equipment photo {0}", i+1]">
                                <img src="@imgUrl" class="object-fit-cover" style="width: 76px; height: 60px;" alt="@L["Thumbnail {0}", i+1]" />
                            </button>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Details Panel -->
        <div class="card krishi-card p-4 mb-4 border-0 shadow-sm">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1.5 fw-semibold">
                    @L[Model.Category]
                </span>
                <span class="text-muted small d-flex align-items-center gap-1">
                    @L[Model.Location]
                </span>
            </div>

            <h2 class="fw-bold text-dark mb-3">@Model.Name</h2>

            <!-- Rates Highlight Box -->
            <div class="row g-3 p-3 rounded-3 mb-4 bg-light text-dark border">
                <div class="col-6 col-sm-4">
                    <span class="text-muted small d-block">@L["Daily Rental Rate"]</span>
                    <span class="fs-4 fw-bold text-success">@Model.DailyRate</span>
                </div>
                <div class="col-6 col-sm-4">
                    <span class="text-muted small d-block">@L["Hourly Rate"]</span>
                    <span class="fs-5 fw-semibold text-dark">@Model.HourlyRate</span>
                </div>
                <div class="col-12 col-sm-4 border-start-sm pt-2 pt-sm-0">
                    <span class="text-muted small d-block">@L["Min. Duration"]</span>
                    <span class="fw-semibold text-dark">@L["1 Day / 2 Hours"]</span>
                </div>
            </div>

            <!-- Description -->
            <h5 class="fw-bold text-dark mb-2">@L["Equipment Description"]</h5>
            <p class="text-secondary leading-relaxed mb-4">@Model.Description</p>

            <!-- Owner Info Card -->
            <div class="p-3 rounded-3 border bg-white d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div>
                        <h6 class="fw-bold mb-0 text-dark">@Model.OwnerName</h6>
                        <div class="d-flex align-items-center gap-2 small text-muted">
                            <span class="text-success fw-semibold">@L["Rating:"] @Model.OwnerRating</span>
                            <span>(@L["{0} reviews", Model.TotalReviews])</span>
                            <span>@L["Member since {0}", Model.OwnerMemberSince]</span>
                        </div>
                    </div>
                </div>
                <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill small">
                    @L["Verified Owner"]
                </span>
            </div>
        </div>

        <!-- Availability Calendar Component -->
        <div class="card krishi-card p-4 mb-4 border-0 shadow-sm">
            <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                    @L["Current Availability Calendar"]
                </h5>
                <!-- Legend -->
                <div class="d-flex gap-3 small">
                    <span class="d-flex align-items-center gap-1">
                        <span class="d-inline-block rounded-circle bg-success" style="width: 10px; height: 10px;"></span>
                        @L["Available"]
                    </span>
                    <span class="d-flex align-items-center gap-1">
                        <span class="d-inline-block rounded-circle bg-secondary" style="width: 10px; height: 10px;"></span>
                        @L["Booked / Blocked"]
                    </span>
                </div>
            </div>

            <p class="text-muted small mb-3">@L["Dates marked in gray are already booked or reserved by other farmers."]</p>

            <!-- Calendar Month Visual Grid -->
            <div class="bg-light p-3 rounded-3 border">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="fw-bold text-dark">@L[DateTime.Today.ToString("MMMM")] @DateTime.Today.ToString("yyyy")</span>
                    <span class="badge bg-white text-secondary border small">@L["Current Month"]</span>
                </div>

                <div class="row row-cols-7 g-1 text-center small fw-semibold text-muted mb-2">
                    <div class="col">@L["Sun"]</div>
                    <div class="col">@L["Mon"]</div>
                    <div class="col">@L["Tue"]</div>
                    <div class="col">@L["Wed"]</div>
                    <div class="col">@L["Thu"]</div>
                    <div class="col">@L["Fri"]</div>
                    <div class="col">@L["Sat"]</div>
                </div>

                <div class="row row-cols-7 g-1 text-center small" id="calendarDaysGrid">
                    @{
                        var firstDayOfMonth = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
                        var daysInMonth = DateTime.DaysInMonth(DateTime.Today.Year, DateTime.Today.Month);
                        int startOffset = (int)firstDayOfMonth.DayOfWeek;

                        for (int b = 0; b < startOffset; b++)
                        {
                            <div class="col p-2 text-muted opacity-25"></div>
                        }

                        for (int day = 1; day <= daysInMonth; day++)
                        {
                            var currentDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, day);
                            bool isBooked = Model.BookedDates.Any(bd => bd.Date == currentDate.Date);
                            bool isPast = currentDate < DateTime.Today;

                            if (isBooked || isPast)
                            {
                                <div class="col p-2 rounded bg-secondary-subtle text-secondary text-decoration-line-through fw-medium" title="@(isPast ? L["Past Date"] : L["Already Booked"])">
                                    @day
                                </div>
                            }
                            else
                            {
                                <div class="col p-2 rounded bg-white border border-success-subtle text-success fw-bold calendar-day-available" onclick="selectCalendarDate('@currentDate.ToString("yyyy-MM-dd")')" title="@L["Available for booking"]">
                                    @day
                                </div>
                            }
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- RIGHT COLUMN: Sticky Rental Request Form (Desktop) -->
    <div class="col-12 col-lg-5 col-xl-4">
        <div class="sticky-top" style="top: 90px; z-index: 1000;" id="requestFormContainer">
            <div class="card krishi-card border-0 shadow p-4" style="border-radius: var(--krishi-radius-lg);">
                <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom">
                    <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                        @L["Rental Request Form"]
                    </h5>
                    <span class="fs-5 fw-bold text-success">@Model.DailyRate</span>
                </div>

                <form id="rentalRequestForm" onsubmit="handleFormSubmit(event)">
                    <!-- Start Date -->
                    <div class="mb-3">
                        <label for="startDateInput" class="form-label small fw-bold text-dark">
                            @L["Start Date"] <span class="text-danger">*</span>
                        </label>
                        <input type="date" class="form-control form-control-lg rounded-3" id="startDateInput" required
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" onchange="validateDates()" />
                    </div>

                    <!-- End Date -->
                    <div class="mb-3">
                        <label for="endDateInput" class="form-label small fw-bold text-dark">
                            @L["End Date"] <span class="text-danger">*</span>
                        </label>
                        <input type="date" class="form-control form-control-lg rounded-3" id="endDateInput" required
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" onchange="validateDates()" />
                        <div id="dateValidationError" class="form-text text-danger d-none mt-1">
                            @L["End Date must be after Start Date and not overlap booked dates."]
                        </div>
                    </div>

                    <!-- Estimated Cost Summary -->
                    <div id="costSummaryBox" class="p-3 bg-success-subtle text-success border border-success-subtle rounded-3 mb-3 d-none">
                        <div class="d-flex justify-content-between small fw-medium">
                            <span>@L["Total Rental Duration:"]</span>
                            <span id="summaryDaysCount">@L["0 Days"]</span>
                        </div>
                        <div class="d-flex justify-content-between fw-bold fs-6 mt-1">
                            <span>@L["Estimated Rental Fee:"]</span>
                            <span id="summaryTotalFee">@L["Tk {0}", 0]</span>
                        </div>
                    </div>

                    <!-- Optional Note -->
                    <div class="mb-4">
                        <label for="noteInput" class="form-label small fw-bold text-dark">
                            @L["Note to Owner"] <span class="text-muted">@L["(Optional)"]</span>
                        </label>
                        <textarea class="form-control rounded-3" id="noteInput" rows="3" placeholder="@L["e.g. Need operator, location details, or specific crop field details..."]"></textarea>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" id="submitRequestBtn" class="btn btn-krishi-primary w-100 py-3 rounded-pill fw-bold d-flex align-items-center justify-content-center gap-2 shadow-sm fs-6">
                        <span id="btnText">@L["Send Rental Request"]</span>
                    </button>
                </form>

                <p class="text-muted small text-center mb-0 mt-3">
                    @L["No immediate payment required. Owner will confirm availability."]
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Mobile Sticky Bottom Bar (Visible on mobile viewports only) -->
<div class="d-lg-none position-fixed bottom-0 start-0 end-0 bg-white border-top shadow-lg p-3" style="z-index: 1040;">
    <div class="container d-flex align-items-center justify-content-between gap-2">
        <div>
            <span class="text-muted small d-block">@L["Daily Rate"]</span>
            <span class="fw-bold text-success fs-5">@Model.DailyRate</span>
        </div>
        <button type="button" id="mobileRequestBtn" class="btn btn-krishi-primary rounded-pill px-4 py-2.5 fw-bold" onclick="scrollToRequestForm()">
            @L["Request Equipment"]
        </button>
    </div>
</div>

@section Scripts {
    <script>
        const bookedDates = @Html.Raw(bookedDatesJson);

        function switchMainImage(imgUrl, btnElement) {
            const mainImg = document.getElementById('mainGalleryImage');
            if (mainImg) {
                mainImg.style.opacity = '0.3';
                setTimeout(() => {
                    mainImg.src = imgUrl;
                    mainImg.style.opacity = '1';
                }, 150);
            }
            document.querySelectorAll('.gallery-thumb-btn').forEach(b => {
                b.classList.remove('border-success', 'border-2');
                b.classList.add('border-light-subtle');
            });
            if (btnElement) {
                btnElement.classList.remove('border-light-subtle');
                btnElement.classList.add('border-success', 'border-2');
            }
        }

        function selectCalendarDate(dateStr) {
            const startInput = document.getElementById('startDateInput');
            const endInput = document.getElementById('endDateInput');
            if (startInput && !startInput.value) {
                startInput.value = dateStr;
            } else if (endInput && !endInput.value) {
                endInput.value = dateStr;
            } else {
                startInput.value = dateStr;
                endInput.value = '';
            }
            validateDates();
            scrollToRequestForm();
        }

        function validateDates() {
            const startInput = document.getElementById('startDateInput');
            const endInput = document.getElementById('endDateInput');
            const errorDiv = document.getElementById('dateValidationError');
            const costBox = document.getElementById('costSummaryBox');
            const submitBtn = document.getElementById('submitRequestBtn');

            if (!startInput.value || !endInput.value) {
                errorDiv.classList.add('d-none');
                costBox.classList.add('d-none');
                return true;
            }

            const startDate = new Date(startInput.value);
            const endDate = new Date(endInput.value);

            if (endDate < startDate) {
                errorDiv.textContent = '@L["End Date must be on or after Start Date."]';
                errorDiv.classList.remove('d-none');
                costBox.classList.add('d-none');
                submitBtn.disabled = true;
                return false;
            }

            let curr = new Date(startDate);
            let hasOverlap = false;
            let daysCount = 0;

            while (curr <= endDate) {
                const dateStr = curr.toISOString().split('T')[0];
                if (bookedDates.includes(dateStr)) {
                    hasOverlap = true;
                    break;
                }
                daysCount++;
                curr.setDate(curr.getDate() + 1);
            }

            if (hasOverlap) {
                errorDiv.textContent = '@L["Selected date range overlaps with an already booked date."]';
                errorDiv.classList.remove('d-none');
                costBox.classList.add('d-none');
                submitBtn.disabled = true;
                return false;
            }

            errorDiv.classList.add('d-none');
            submitBtn.disabled = false;

            const summaryDaysCount = document.getElementById('summaryDaysCount');
            const summaryTotalFee = document.getElementById('summaryTotalFee');
            if (summaryDaysCount && summaryTotalFee) {
                summaryDaysCount.textContent = daysCount > 1
                    ? '@L["{0} Days", "__COUNT__"]'.replace('__COUNT__', daysCount)
                    : '@L["{0} Day", "__COUNT__"]'.replace('__COUNT__', daysCount);
                summaryTotalFee.textContent = '@L["Tk {0}", "__AMOUNT__"]'.replace('__AMOUNT__', (daysCount * 1500).toLocaleString());
                costBox.classList.remove('d-none');
            }

            return true;
        }

        function scrollToRequestForm() {
            const container = document.getElementById('requestFormContainer');
            if (container) {
                container.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }

        function handleFormSubmit(e) {
            e.preventDefault();
            if (!validateDates()) return;

            const startVal = document.getElementById('startDateInput').value;
            const endVal = document.getElementById('endDateInput').value;

            window.KrishiModal.confirm({
                title: '@L["Confirm Rental Request"]',
                body: `@L["Are you sure you want to send a rental request for"] <strong>@Model.Name</strong> @L["From"] <strong>${startVal}</strong> @L["To"] <strong>${endVal}</strong>?`,
                confirmText: '@L["Send Request"]',
                cancelText: '@L["Cancel"]',
                confirmClass: 'btn-krishi-primary',
                onConfirm: function () {
                    const submitBtn = document.getElementById('submitRequestBtn');
                    const btnText = document.getElementById('btnText');
                    const mobileBtn = document.getElementById('mobileRequestBtn');

                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.classList.remove('btn-krishi-primary');
                        submitBtn.classList.add('btn-secondary');
                    }
                    if (btnText) btnText.textContent = '@L["Request Submitted"]';
                    if (mobileBtn) {
                        mobileBtn.disabled = true;
                        mobileBtn.textContent = '@L["Request Submitted"]';
                        mobileBtn.classList.remove('btn-krishi-primary');
                        mobileBtn.classList.add('btn-secondary');
                    }

                    const alertDiv = document.getElementById('requestSuccessAlert');
                    if (alertDiv) {
                        alertDiv.classList.remove('d-none');
                        alertDiv.classList.add('d-flex');
                        alertDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                }
            });
        }
    </script>
}
