@model KrishiLink.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
}
<div class="container py-5" style="max-width: 540px;">
    <h1 class="h3">Reset your password</h1>
    <partial name="_AuthMessages" />
    <p>Use the recovery code emailed to you. Resetting your password signs out all existing sessions.</p>
    <div asp-validation-summary="All" class="text-danger"></div>
    <form asp-action="ResetPassword" method="post">
        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" type="email" autocomplete="email" class="form-control" required />
        </div>
        <div class="mb-3">
            <label asp-for="Code" class="form-label"></label>
            <input asp-for="Code" autocomplete="one-time-code" inputmode="numeric" class="form-control" required />
        </div>
        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label"></label>
            <input asp-for="NewPassword" autocomplete="new-password" class="form-control" required />
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" class="form-control" required />
        </div>
        <button class="btn btn-success" type="submit">Reset password</button>
    </form>
    <p class="mt-3"><a asp-action="ForgotPassword">Request a new code</a> · <a asp-action="Login">Back to login</a></p>
</div>
