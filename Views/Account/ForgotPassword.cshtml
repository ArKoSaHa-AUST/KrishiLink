@model KrishiLink.Models.ViewModels.EmailAddressViewModel
@{
    ViewData["Title"] = "Forgot password";
}
<div class="container py-5" style="max-width: 540px;">
    <h1 class="h3">Recover your account</h1>
    <partial name="_AuthMessages" />
    <p>Enter your verified email address to receive a one-time password recovery code.</p>
    <div asp-validation-summary="All" class="text-danger"></div>
    <form asp-action="ForgotPassword" method="post">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" type="email" autocomplete="email" class="form-control mb-3" required />
        <button class="btn btn-success" type="submit">Send recovery code</button>
    </form>
    <p class="mt-3"><a asp-action="ResetPassword">Already have a code?</a> · <a asp-action="Login">Back to login</a></p>
</div>
