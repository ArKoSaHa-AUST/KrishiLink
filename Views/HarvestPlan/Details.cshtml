@model KrishiLink.Models.ViewModels.HarvestPlanDetailsViewModel
@{
    ViewData["Title"] = $"{Model.Name} - {L["Harvest Plan"]}";
    var successMsg = TempData["Success"] as string ?? TempData["SuccessMessage"] as string;
    var errorMsg = TempData["Error"] as string ?? TempData["ErrorMessage"] as string;

    var statusBadgeClass = Model.Status switch
    {
        KrishiLink.Models.Entities.HarvestPlanStatus.Draft => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
        KrishiLink.Models.Entities.HarvestPlanStatus.Submitted => "bg-info-subtle text-info-emphasis border border-info-subtle",
        _ => "bg-secondary-subtle text-secondary border border-secondary-subtle"
    };
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">@L["Home"]</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">@L["Harvest Plans"]</a></li>
            <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                    <h2 class="fw-bold mb-0 text-dark">@Model.Name</h2>
                    <span class="badge @statusBadgeClass rounded-pill px-3 py-1.5 fw-semibold text-uppercase" style="font-size: 0.8rem;">
                        @Model.Status
                    </span>
                    @if (!string.IsNullOrWhiteSpace(Model.Crop))
                    {
                        <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle rounded-pill px-3 py-1.5 fw-semibold">
                            <i class="bi bi-flower1 me-1"></i>@Model.Crop
                        </span>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Note))
                {
                    <p class="text-muted mb-2">@Model.Note</p>
                }
                <div class="text-muted small d-flex gap-3 flex-wrap">
                    <span><i class="bi bi-calendar-event me-1"></i>@L["Target Window"]: <strong class="text-dark">@Model.TargetDateRange</strong></span>
                    <span><i class="bi bi-clock me-1"></i>@L["Created"]: @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</span>
                    @if (Model.SubmittedOn.HasValue)
                    {
                        <span><i class="bi bi-send-check me-1"></i>@L["Submitted"]: @Model.SubmittedOn.Value.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</span>
                    }
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap align-items-center">
                @if (Model.CanEdit)
                {
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 py-2 fw-semibold btn-sm" data-bs-toggle="modal" data-bs-target="#editPlanModal">
                        <i class="bi bi-pencil me-1"></i> @L["Edit Details"]
                    </button>
                }
                @if (Model.CanClone)
                {
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 py-2 fw-semibold btn-sm" data-bs-toggle="modal" data-bs-target="#clonePlanModal">
                        <i class="bi bi-copy me-1"></i> @L["Clone Plan"]
                    </button>
                }
                @if (Model.CanDelete)
                {
                    <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('@L["Are you sure you want to delete this harvest plan?"]');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="planId" value="@Model.Id" />
                        <button type="submit" class="btn btn-outline-danger rounded-pill px-3 py-2 fw-semibold btn-sm">
                            <i class="bi bi-trash3 me-1"></i> @L["Delete"]
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>

    <!-- Alerts -->
    @if (!string.IsNullOrWhiteSpace(successMsg))
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-check-circle-fill text-success fs-5"></i>
            <div>@successMsg</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(errorMsg))
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
            <div>@errorMsg</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Conflict Alert Banner -->
    @if (Model.HasConflicts && Model.Status == KrishiLink.Models.Entities.HarvestPlanStatus.Draft)
    {
        <div class="alert alert-warning border-0 shadow-sm rounded-4 p-3 mb-4 d-flex align-items-center gap-3">
            <div class="rounded-circle p-2 bg-warning text-dark d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            </div>
            <div>
                <h6 class="fw-bold mb-1 text-dark">@L["Availability Conflict Detected"]</h6>
                <div class="small text-muted">
                    @L["One or more items in this harvest plan are currently unavailable for the requested dates or quantities. Please adjust dates or unit counts before submitting."]
                </div>
            </div>
        </div>
    }

    <!-- Submitted Status Widget -->
    @if (Model.Status == KrishiLink.Models.Entities.HarvestPlanStatus.Submitted || Model.Status == KrishiLink.Models.Entities.HarvestPlanStatus.Closed)
    {
        <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-light">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="fw-bold small text-uppercase text-muted">@L["Linked Booking Requests Status"]</span>
                <a asp-controller="Bookings" asp-action="Index" class="small text-success text-decoration-none fw-semibold">
                    @L["View in Bookings"] <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            <div class="row g-2 text-center">
                <div class="col">
                    <div class="p-2 bg-white rounded-3 border">
                        <div class="small text-muted">@L["Pending"]</div>
                        <div class="fw-bold fs-5 text-warning">@Model.PendingCount</div>
                    </div>
                </div>
                <div class="col">
                    <div class="p-2 bg-white rounded-3 border">
                        <div class="small text-muted">@L["Accepted"]</div>
                        <div class="fw-bold fs-5 text-success">@Model.AcceptedCount</div>
                    </div>
                </div>
                <div class="col">
                    <div class="p-2 bg-white rounded-3 border">
                        <div class="small text-muted">@L["Paid"]</div>
                        <div class="fw-bold fs-5 text-primary">@Model.PaidCount</div>
                    </div>
                </div>
                <div class="col">
                    <div class="p-2 bg-white rounded-3 border">
                        <div class="small text-muted">@L["Completed"]</div>
                        <div class="fw-bold fs-5 text-secondary">@Model.CompletedCount</div>
                    </div>
                </div>
                <div class="col">
                    <div class="p-2 bg-white rounded-3 border">
                        <div class="small text-muted">@L["Rejected/Cancelled"]</div>
                        <div class="fw-bold fs-5 text-danger">@(Model.RejectedCount + Model.CancelledCount)</div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Main Content Layout: Items List (Left) + Summary & Submission (Right) -->
    <div class="row g-4">
        <!-- Items List -->
        <div class="col-12 col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-box-seam text-success me-2"></i>@L["Plan Items"] (@Model.Items.Count / 10)
                </h5>
                @if (Model.CanEdit && Model.Items.Count < 10)
                {
                    <div class="dropdown">
                        <button class="btn btn-outline-success btn-sm rounded-pill px-3 dropdown-toggle fw-semibold" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-plus me-1"></i>@L["Add More Items"]
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3">
                            <li><a class="dropdown-item" asp-controller="Equipment" asp-action="Index"><i class="bi bi-gear-wide-connected me-2 text-success"></i>@L["Browse Equipment"]</a></li>
                            <li><a class="dropdown-item" asp-controller="Godown" asp-action="Index"><i class="bi bi-building me-2 text-primary"></i>@L["Browse Godown Storage"]</a></li>
                        </ul>
                    </div>
                }
            </div>

            @if (!Model.Items.Any())
            {
                <div class="card border-0 shadow-sm rounded-4 text-center py-5 px-3">
                    <div class="my-2">
                        <i class="bi bi-cart-x text-muted fs-1 mb-2 d-block"></i>
                        <h6 class="fw-bold text-dark mb-1">@L["This harvest plan is empty"]</h6>
                        <p class="text-muted small mb-4">@L["Add equipment rentals and godown storage listings to this plan to coordinate your harvest."]</p>
                        <div class="d-flex justify-content-center gap-2">
                            <a asp-controller="Equipment" asp-action="Index" class="btn btn-sm btn-success rounded-pill px-3 fw-semibold">
                                <i class="bi bi-gear-wide-connected me-1"></i>@L["Browse Equipment"]
                            </a>
                            <a asp-controller="Godown" asp-action="Index" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-semibold">
                                <i class="bi bi-building me-1"></i>@L["Browse Storage"]
                            </a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var item in Model.Items)
                    {
                        var isEquipment = item.ItemType == KrishiLink.Models.Entities.HarvestPlanItemType.Equipment;
                        var cardBorderClass = !item.IsAvailable ? "border-danger border-2" : "border-0";

                        <div class="card @cardBorderClass shadow-sm rounded-4 p-3 bg-white">
                            <div class="d-flex flex-column flex-sm-row gap-3">
                                <!-- Image Thumbnail -->
                                <div class="position-relative flex-shrink-0" style="width: 110px; height: 110px;">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Title" class="w-100 h-100 object-fit-cover rounded-3" />
                                    }
                                    else
                                    {
                                        <div class="w-100 h-100 bg-light rounded-3 d-flex align-items-center justify-content-center text-muted fs-1">
                                            <i class="bi @(isEquipment ? "bi-gear" : "bi-building")"></i>
                                        </div>
                                    }
                                    <span class="position-absolute top-0 start-0 m-1.5 badge @(isEquipment ? "bg-success" : "bg-primary") rounded-pill px-2 py-1" style="font-size: 0.65rem;">
                                        @(isEquipment ? L["Equipment"] : L["Godown"])
                                    </span>
                                </div>

                                <!-- Details -->
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap mb-1">
                                        <div>
                                            <h6 class="fw-bold mb-0">
                                                <a href="@item.ListingDetailUrl" target="_blank" class="text-decoration-none text-dark">
                                                    @item.Title <i class="bi bi-box-arrow-up-right small text-muted"></i>
                                                </a>
                                            </h6>
                                            <div class="text-muted small">
                                                <span><i class="bi bi-tag me-1"></i>@item.CategoryOrType</span>
                                                @if (!string.IsNullOrWhiteSpace(item.Location))
                                                {
                                                    <span class="ms-2"><i class="bi bi-geo-alt me-1"></i>@item.Location</span>
                                                }
                                            </div>
                                        </div>

                                        <!-- Availability status badge -->
                                        @if (item.IsAvailable)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1">
                                                <i class="bi bi-check-circle me-1"></i>@L["Available"]
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1">
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i>@L["Conflict"]
                                            </span>
                                        }
                                    </div>

                                    <!-- Conflict Detail Message -->
                                    @if (!item.IsAvailable && !string.IsNullOrWhiteSpace(item.AvailabilityMessage))
                                    {
                                        <div class="alert alert-danger py-1.5 px-2.5 small rounded-2 mb-2 d-flex align-items-center gap-1.5">
                                            <i class="bi bi-info-circle-fill"></i>
                                            <span>@item.AvailabilityMessage</span>
                                        </div>
                                    }

                                    <!-- Timing & Quantity Specs -->
                                    <div class="row g-2 small my-1">
                                        <div class="col-sm-6">
                                            <span class="text-muted">@L["Dates"]:</span>
                                            <strong class="text-dark">@item.DateRangeDisplay</strong>
                                            <span class="text-muted">(@item.DurationDisplay)</span>
                                        </div>
                                        <div class="col-sm-6">
                                            <span class="text-muted">@L["Quantity"]:</span>
                                            <strong class="text-dark">@item.QuantityDisplay</strong>
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(item.Note))
                                    {
                                        <div class="small text-muted fst-italic mb-2">
                                            <i class="bi bi-chat-left-quote me-1"></i>"@item.Note"
                                        </div>
                                    }

                                    <!-- Bottom Row: Price & Actions -->
                                    <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-2 flex-wrap gap-2">
                                        <div>
                                            <span class="text-muted small">@L["Estimated"]:</span>
                                            <span class="fw-bold fs-6 text-success ms-1">@item.GrossDisplay</span>
                                        </div>

                                        <!-- Actions depending on Draft / Submitted -->
                                        <div class="d-flex gap-1.5 align-items-center">
                                            @if (Model.CanEdit)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1"
                                                        data-bs-toggle="modal" data-bs-target="#editItemModal-@item.Id">
                                                    <i class="bi bi-pencil me-1"></i>@L["Edit"]
                                                </button>
                                                <form asp-action="RemoveItem" method="post" class="d-inline" onsubmit="return confirm('@L["Remove this item from the harvest plan?"]');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="itemId" value="@item.Id" />
                                                    <input type="hidden" name="planId" value="@Model.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2.5 py-1" title="@L["Remove Item"]">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                </form>
                                            }
                                            else if (item.BookingId.HasValue)
                                            {
                                                <span class="badge bg-light text-dark border rounded-pill px-2.5 py-1 small">
                                                    @item.BookingCode: @item.BookingStatus
                                                </span>
                                                @if (item.CanPay)
                                                {
                                                    <a href="@item.PayUrl" class="btn btn-sm btn-success rounded-pill px-3 py-1 fw-semibold">
                                                        <i class="bi bi-credit-card me-1"></i>@L["Pay Now"]
                                                    </a>
                                                }
                                                <a href="/Bookings?tab=@(isEquipment ? "equipment" : "godown")&id=@item.BookingId" class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-1">
                                                    <i class="bi bi-arrow-up-right"></i>
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Edit Item Modal -->
                        @if (Model.CanEdit)
                        {
                            <div class="modal fade" id="editItemModal-@item.Id" tabindex="-1" aria-labelledby="editItemModalLabel-@item.Id" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content border-0 shadow rounded-4">
                                        <form asp-action="UpdateItem" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="itemId" value="@item.Id" />
                                            <input type="hidden" name="planId" value="@Model.Id" />
                                            <div class="modal-header border-bottom pb-3">
                                                <h5 class="modal-title fw-bold" id="editItemModalLabel-@item.Id">
                                                    <i class="bi bi-pencil-square text-success me-2"></i>@L["Edit Plan Item"] - @item.Title
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body py-3">
                                                <div class="row g-2 mb-3">
                                                    <div class="col-6">
                                                        <label class="form-label fw-semibold small">@L["Start Date"] <span class="text-danger">*</span></label>
                                                        <input type="date" name="startDate" class="form-control rounded-3" value="@item.StartDate.ToString("yyyy-MM-dd")" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                                                    </div>
                                                    <div class="col-6">
                                                        <label class="form-label fw-semibold small">@L["End Date"] <span class="text-danger">*</span></label>
                                                        <input type="date" name="endDate" class="form-control rounded-3" value="@item.EndDate.ToString("yyyy-MM-dd")" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                                                    </div>
                                                </div>

                                                @if (isEquipment)
                                                {
                                                    <div class="mb-3">
                                                        <label class="form-label fw-semibold small">@L["Units (Max: {0})", item.MaxUnits]</label>
                                                        <input type="number" name="units" class="form-control rounded-3" value="@item.Units" min="1" max="@item.MaxUnits" required />
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="mb-3">
                                                        <label class="form-label fw-semibold small">@L["Requested Capacity (Tons)"]</label>
                                                        <input type="number" name="tons" step="0.1" class="form-control rounded-3" value="@item.Tons" min="0.1" max="@item.CapacityTons" required />
                                                    </div>
                                                }

                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold small">@L["Note / Special Instructions"]</label>
                                                    <textarea name="note" class="form-control rounded-3" rows="2" maxlength="300">@item.Note</textarea>
                                                </div>
                                            </div>
                                            <div class="modal-footer border-top pt-3">
                                                <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">@L["Cancel"]</button>
                                                <button type="submit" class="btn btn-success rounded-pill px-4 fw-semibold">
                                                    @L["Save Changes"]
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            }
        </div>

        <!-- Plan Summary & Submission (Right Sidebar) -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white sticky-top" style="top: 80px;">
                <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-receipt text-success"></i>@L["Plan Summary"]
                </h5>

                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">@L["Status"]</span>
                    <span class="badge @statusBadgeClass rounded-pill px-2.5 py-1 fw-semibold">@Model.Status</span>
                </div>

                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">@L["Total Items"]</span>
                    <span class="fw-bold text-dark">@Model.Items.Count <span class="text-muted fw-normal">/ 10</span></span>
                </div>

                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">@L["Target Window"]</span>
                    <span class="fw-semibold text-dark small text-end">@Model.TargetDateRange</span>
                </div>

                <div class="d-flex justify-content-between align-items-center py-3 border-bottom mb-3">
                    <span class="fw-bold text-dark">@L["Total Estimated Cost"]</span>
                    <span class="fw-bold fs-4 text-success">৳@Model.TotalEstimatedGross.ToString("N0")</span>
                </div>

                <!-- Terms notice -->
                <div class="alert alert-light border rounded-3 p-2.5 small text-muted mb-3">
                    <i class="bi bi-info-circle me-1 text-primary"></i>
                    @L["Submitting will simultaneously send {0} booking request(s) to owners. Standard rates apply. Batch plans cannot combine individual promo codes.", Model.Items.Count]
                </div>

                <!-- Primary Action Button -->
                @if (Model.Status == KrishiLink.Models.Entities.HarvestPlanStatus.Draft)
                {
                    @if (Model.Items.Count == 0)
                    {
                        <button type="button" class="btn btn-secondary w-100 py-2.5 rounded-pill fw-semibold shadow-sm" disabled>
                            @L["Plan is Empty"]
                        </button>
                    }
                    else if (Model.HasConflicts)
                    {
                        <button type="button" class="btn btn-warning w-100 py-2.5 rounded-pill fw-semibold shadow-sm" disabled>
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>@L["Resolve Conflicts to Submit"]
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-success w-100 py-2.5 rounded-pill fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#submitConfirmModal">
                            <i class="bi bi-send-fill me-1"></i>@L["Submit Harvest Plan ({0})", Model.Items.Count]
                        </button>
                    }
                }
                else
                {
                    <a asp-controller="Bookings" asp-action="Index" class="btn btn-outline-success w-100 py-2.5 rounded-pill fw-semibold shadow-sm">
                        <i class="bi bi-calendar2-check me-1"></i>@L["View Bookings Tracker"]
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<!-- Edit Plan Modal -->
@if (Model.CanEdit)
{
    <div class="modal fade" id="editPlanModal" tabindex="-1" aria-labelledby="editPlanModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-4">
                <form asp-action="UpdatePlan" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="planId" value="@Model.Id" />
                    <div class="modal-header border-bottom pb-3">
                        <h5 class="modal-title fw-bold" id="editPlanModalLabel">
                            <i class="bi bi-pencil-square text-success me-2"></i>@L["Edit Harvest Plan"]
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body py-3">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@L["Plan Name"] <span class="text-danger">*</span></label>
                            <input type="text" name="name" class="form-control rounded-3" value="@Model.Name" maxlength="80" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@L["Target Crop"] <span class="text-muted small fw-normal">(@L["Optional"])</span></label>
                            <input type="text" name="crop" class="form-control rounded-3" value="@Model.Crop" maxlength="60" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@L["Notes & Instructions"] <span class="text-muted small fw-normal">(@L["Optional"])</span></label>
                            <textarea name="description" class="form-control rounded-3" rows="3" maxlength="300">@Model.Note</textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-top pt-3">
                        <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">@L["Cancel"]</button>
                        <button type="submit" class="btn btn-success rounded-pill px-4 fw-semibold">
                            @L["Save Changes"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- Clone Plan Modal -->
@if (Model.CanClone)
{
    <div class="modal fade" id="clonePlanModal" tabindex="-1" aria-labelledby="clonePlanModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-4">
                <form asp-action="Clone" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="planId" value="@Model.Id" />
                    <div class="modal-header border-bottom pb-3">
                        <h5 class="modal-title fw-bold" id="clonePlanModalLabel">
                            <i class="bi bi-copy text-success me-2"></i>@L["Clone Harvest Plan for Next Season"]
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body py-4">
                        <p class="text-muted small mb-3">
                            @L["All {0} items in this plan will be duplicated into a new Draft harvest plan with dates shifted forward.", Model.Items.Count]
                        </p>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@L["Shift Dates By (Days)"]</label>
                            <input type="number" name="shiftDays" class="form-control rounded-3" value="365" min="1" max="730" required />
                            <div class="form-text">@L["Standard: 365 days for next year's season (range: 1 - 730 days)."]</div>
                        </div>
                    </div>
                    <div class="modal-footer border-top pt-3">
                        <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">@L["Cancel"]</button>
                        <button type="submit" class="btn btn-success rounded-pill px-4 fw-semibold">
                            <i class="bi bi-copy me-1"></i>@L["Duplicate Plan"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- Submit Confirmation Modal -->
@if (Model.CanSubmit)
{
    <div class="modal fade" id="submitConfirmModal" tabindex="-1" aria-labelledby="submitConfirmModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-4">
                <form asp-action="Submit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="planId" value="@Model.Id" />
                    <div class="modal-header border-bottom pb-3">
                        <h5 class="modal-title fw-bold" id="submitConfirmModalLabel">
                            <i class="bi bi-send-check text-success me-2"></i>@L["Confirm Harvest Plan Submission"]
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body py-4">
                        <p class="mb-3">
                            @L["Are you ready to submit \"{0}\"? This will create and send {1} booking request(s) to respective equipment and storage owners.", Model.Name, Model.Items.Count]
                        </p>
                        <div class="bg-light rounded-3 p-3 text-muted small">
                            <ul class="mb-0 ps-3">
                                <li>@L["Owners will receive notification of your coordinated harvest plan."]</li>
                                <li>@L["You will be notified as owners review and accept your requests."]</li>
                                <li>@L["Payments can be completed once owners accept each request."]</li>
                            </ul>
                        </div>
                    </div>
                    <div class="modal-footer border-top pt-3">
                        <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">@L["Cancel"]</button>
                        <button type="submit" class="btn btn-success rounded-pill px-4 fw-semibold">
                            <i class="bi bi-check2-circle me-1"></i>@L["Confirm & Send Requests"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
