@*
    Shared Partial: Reusable Equipment & Godown Listing Card
    Model: KrishiLink.Models.ViewModels.CardViewModel
*@
@model KrishiLink.Models.ViewModels.CardViewModel

@{
    var name = !string.IsNullOrWhiteSpace(Model?.Name) ? Model.Name : "Item Listing";
    var category = !string.IsNullOrWhiteSpace(Model?.Category) ? Model.Category : "Agriculture";
    var location = !string.IsNullOrWhiteSpace(Model?.Location) ? Model.Location : "Location Not Specified";
    var price = !string.IsNullOrWhiteSpace(Model?.Price) ? Model.Price : "Contact for Pricing";
    var status = !string.IsNullOrWhiteSpace(Model?.Status) ? Model.Status : "Available";
    var detailUrl = !string.IsNullOrWhiteSpace(Model?.DetailUrl) ? Model.DetailUrl : "#";
    var imageUrl = !string.IsNullOrWhiteSpace(Model?.ImageUrl) ? Model.ImageUrl : null;
}

<div class="card krishi-card h-100 border-0 shadow-sm overflow-hidden d-flex flex-column">
    <div class="krishi-card-img-wrapper position-relative bg-light text-center">
        @if (!string.IsNullOrEmpty(imageUrl))
        {
            <img src="@imageUrl" class="card-img-top object-fit-cover" style="height: 190px;" alt="@name" loading="lazy" />
        }
        else
        {
            <div class="d-flex flex-column align-items-center justify-content-center bg-light text-muted py-5" style="height: 190px;">
                <span class="small text-secondary fw-medium">@L["No Image Provided"]</span>
            </div>
        }
        <div class="position-absolute top-0 end-0 m-2 d-flex align-items-center gap-1.5">
            <partial name="_StatusBadge" model="status" />
            @if (Model?.Id.HasValue == true)
            {
                var favType = Model.ListingType ?? "Equipment";
                <button type="button"
                        class="btn btn-light btn-sm rounded-circle shadow-sm favorite-btn @(Model.IsFavorite ? "active text-danger" : "")"
                        style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; z-index: 2;"
                        data-type="@favType"
                        data-id="@Model.Id.Value"
                        onclick="event.stopPropagation(); KrishiFavorites.toggle(this);"
                        title="@(Model.IsFavorite ? L["Remove from favorites"] : L["Add to favorites"])">
                    <i class="bi @(Model.IsFavorite ? "bi-heart-fill text-danger" : "bi-heart")"></i>
                </button>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Model?.AvailabilityHint))
        {
            <div class="position-absolute bottom-0 start-0 m-2">
                <span class="badge bg-dark bg-opacity-75 text-white rounded-pill px-2.5 py-1 small fw-semibold">
                    <i class="bi bi-clock-history me-1"></i>@L[Model.AvailabilityHint]
                </span>
            </div>
        }
    </div>

    <div class="card-body d-flex flex-column justify-content-between p-3">
        <div>
            <div class="mb-2 d-flex justify-content-between align-items-center">
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 small fw-semibold">
                    @L[category]
                </span>
                @if (Model != null && Model.ReviewCount > 0)
                {
                    var ratingTooltip = Model.OwnerReviewCount > 0
                        ? $"{Model.Rating:0.0} ({Model.ReviewCount} reviews) · {L["Owner"]}: {Model.OwnerRating:0.0} ({Model.OwnerReviewCount})"
                        : $"{Model.Rating:0.0} ({Model.ReviewCount} reviews)";
                    <span class="text-warning small fw-bold d-inline-flex align-items-center gap-1" title="@ratingTooltip">
                        <i class="bi bi-star-fill"></i> @Model.Rating.ToString("0.0") <span class="text-muted fw-normal">(@Model.ReviewCount)</span>
                    </span>
                }
            </div>
            <h5 class="card-title fw-bold text-dark mb-2 text-truncate" title="@name">@name</h5>
            <p class="card-text text-muted small mb-3 d-flex align-items-center">
                <i class="bi bi-geo-alt text-success me-1"></i>
                <span class="text-truncate" title="@location">
                    @if (!string.IsNullOrWhiteSpace(Model?.District))
                    {
                        <strong>@L[Model.District]</strong>@(!string.IsNullOrWhiteSpace(location) && !location.Equals(Model.District, StringComparison.OrdinalIgnoreCase) ? $" · {location}" : "")
                    }
                    else
                    {
                        @L[location]
                    }
                </span>
            </p>
        </div>

        <div class="pt-3 border-top mt-auto">
            <div class="d-flex justify-content-between align-items-baseline mb-3">
                <span class="text-muted small">@L["Daily / Monthly Rate"]</span>
                <span class="fw-bold text-success fs-5">@price</span>
            </div>
            <a href="@detailUrl" class="btn btn-krishi-primary w-100 fw-semibold d-flex align-items-center justify-content-center">
                <span>@L["View Details"]</span>
            </a>
        </div>
    </div>
</div>
