@*
    Shared Partial: Reusable Equipment & Godown Listing Card
    Model: KrishiLink.Models.ViewModels.CardViewModel
*@
@model KrishiLink.Models.ViewModels.CardViewModel

@{
    var name = !string.IsNullOrWhiteSpace(Model?.Name) ? Model.Name : "Item Listing";
    var category = !string.IsNullOrWhiteSpace(Model?.Category) ? Model.Category : "Agriculture";
    var location = !string.IsNullOrWhiteSpace(Model?.Location) ? Model.Location : "Location Not Specified";
    var price = !string.IsNullOrWhiteSpace(Model?.Price) ? Model.Price : "Contact for Pricing";
    var status = !string.IsNullOrWhiteSpace(Model?.Status) ? Model.Status : "Available";
    var detailUrl = !string.IsNullOrWhiteSpace(Model?.DetailUrl) ? Model.DetailUrl : "#";
    var imageUrl = !string.IsNullOrWhiteSpace(Model?.ImageUrl) ? Model.ImageUrl : null;
}

<div class="card krishi-card h-100 border-0 shadow-sm overflow-hidden d-flex flex-column">
    <div class="krishi-card-img-wrapper position-relative bg-light text-center">
        @if (!string.IsNullOrEmpty(imageUrl))
        {
            <img src="@imageUrl" class="card-img-top object-fit-cover" style="height: 190px;" alt="@name" loading="lazy" />
        }
        else
        {
            <div class="d-flex flex-column align-items-center justify-content-center bg-light text-muted py-5" style="height: 190px;">
                <i class="bi bi-image text-success-subtle display-6 mb-2"></i>
                <span class="small text-secondary fw-medium">No Image Provided</span>
            </div>
        }
        <div class="position-absolute top-0 end-0 m-2">
            <partial name="_StatusBadge" model="status" />
        </div>
    </div>

    <div class="card-body d-flex flex-column justify-content-between p-3">
        <div>
            <div class="mb-2">
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 small fw-semibold">
                    <i class="bi bi-tag-fill me-1"></i>@category
                </span>
            </div>
            <h5 class="card-title fw-bold text-dark mb-2 text-truncate" title="@name">@name</h5>
            <p class="card-text text-muted small mb-3 d-flex align-items-center">
                <i class="bi bi-geo-alt-fill text-danger me-1 flex-shrink-0"></i>
                <span class="text-truncate">@location</span>
            </p>
        </div>

        <div class="pt-3 border-top mt-auto">
            <div class="d-flex justify-content-between align-items-baseline mb-3">
                <span class="text-muted small">Daily / Monthly Rate</span>
                <span class="fw-bold text-success fs-5">@price</span>
            </div>
            <a href="@detailUrl" class="btn btn-krishi-primary w-100 fw-semibold d-flex align-items-center justify-content-center gap-1">
                <span>View Details</span>
                <i class="bi bi-arrow-right-short fs-5"></i>
            </a>
        </div>
    </div>
</div>
