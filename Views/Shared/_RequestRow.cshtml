@model KrishiLink.Models.ViewModels.RentalRequestItem
@*
    Shared rental request row used by the Equipment Owner Dashboard widget
    (compact, ViewData["Expandable"] unset) and the full Requests page
    (ViewData["Expandable"] = true: expandable detail, status badge, conflict hint).
    Host page must define applyDecision(id, decision, btn) and promptReject(id, btn).
*@
@{
    var expandable = ViewData["Expandable"] as bool? ?? false;
    var badgeClass = Model.Status switch
    {
        "Accepted" => "krishi-badge-available",
        "Rejected" => "krishi-badge-unavailable",
        "Completed" => "krishi-badge-completed",
        _ => "krishi-badge-pending"
    };
}
<div class="request-row border-bottom pending-request-row" data-request-id="@Model.Id"
     data-farmer-name="@Model.FarmerName" data-search="@(($"{Model.FarmerName} {Model.EquipmentName}").ToLowerInvariant())">
    <div class="p-3 px-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 request-row-header"
         role="@(expandable ? "button" : null)" tabindex="@(expandable ? "0" : null)"
         data-bs-toggle="@(expandable ? "collapse" : null)" data-bs-target="@(expandable ? $"#detail-{Model.Id}" : null)"
         aria-expanded="@(expandable ? "false" : null)" aria-controls="@(expandable ? $"detail-{Model.Id}" : null)">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center fw-bold flex-shrink-0" style="width: 42px; height: 42px;">
                @Model.FarmerName[0]
            </div>
            <div>
                <span class="fw-semibold d-block" style="color: var(--krishi-text-primary);">@Model.FarmerName</span>
                <span class="small d-block" style="color: var(--krishi-text-muted);">
                    <i class="bi bi-tools me-1 text-success"></i>@Model.EquipmentName
                    <span class="mx-1">·</span>
                    <i class="bi bi-calendar-range me-1 text-success"></i>@Model.DateRange
                    @if (!string.IsNullOrEmpty(Model.TimeAgo))
                    {
                        <span class="mx-1">·</span>
                        <i class="bi bi-clock me-1 text-success"></i>@Model.TimeAgo
                    }
                </span>
                @if (!expandable && !string.IsNullOrEmpty(Model.Note))
                {
                    <span class="small fst-italic" style="color: var(--krishi-text-muted);">"@Model.Note"</span>
                }
                @if (Model.HasConflict)
                {
                    <span class="small d-block fw-semibold" style="color: var(--krishi-status-pending-text);">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>@Model.ConflictHint
                    </span>
                }
            </div>
        </div>
        <div class="d-flex align-items-center gap-3 flex-shrink-0">
            @if (expandable)
            {
                <span class="krishi-badge request-status-badge @badgeClass @(Model.Status == "Pending" ? "d-none d-md-inline-flex" : "")">@L[Model.Status]</span>
            }
            @if (Model.Status == "Pending")
            {
                <!-- stopPropagation keeps button clicks from toggling the row expansion -->
                <div class="request-actions" onclick="event.stopPropagation()">
                    <button type="button" class="btn btn-krishi-primary btn-sm rounded-pill px-3 fw-semibold btn-accept"
                            onclick="applyDecision(@Model.Id, 'accept', this)">
                        <i class="bi bi-check-lg"></i> @L["Accept"]
                    </button>
                    <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-semibold btn-reject"
                            onclick="promptReject(@Model.Id, this)">
                        <i class="bi bi-x-lg"></i> @L["Reject"]
                    </button>
                </div>
            }
            else if (expandable && Model.Status == "Accepted")
            {
                <div class="request-actions" onclick="event.stopPropagation()">
                    <button type="button" class="btn btn-krishi-outline btn-sm rounded-pill px-3 fw-semibold btn-complete"
                            onclick="markCompleted(@Model.Id, this)">
                        <i class="bi bi-check2-all"></i> @L["Mark Completed"]
                    </button>
                </div>
            }
            @if (expandable)
            {
                <i class="bi bi-chevron-down small d-none d-md-block" style="color: var(--krishi-text-muted);"></i>
            }
        </div>
    </div>

    @if (expandable)
    {
        <!-- Expanded detail: farmer's note, equipment recap, and reject reason when present -->
        <div class="collapse" id="detail-@Model.Id">
            <div class="px-4 pb-3 pt-1 ms-md-5">
                <div class="row g-3 p-3 rounded-3 border" style="background-color: var(--krishi-primary-light);">
                    <div class="col-12 col-md-6">
                        <span class="small fw-semibold text-uppercase d-block mb-1" style="color: var(--krishi-text-muted); letter-spacing: 0.04em;">@L["Farmer's Note"]</span>
                        <p class="small mb-0 fst-italic" style="color: var(--krishi-text-primary);">
                            @(string.IsNullOrEmpty(Model.Note) ? L["No note provided."].Value : $"\"{Model.Note}\"")
                        </p>
                    </div>
                    <div class="col-12 col-md-6">
                        <span class="small fw-semibold text-uppercase d-block mb-1" style="color: var(--krishi-text-muted); letter-spacing: 0.04em;">@L["Equipment Recap"]</span>
                        <ul class="list-unstyled small mb-0 d-flex flex-column gap-1" style="color: var(--krishi-text-primary);">
                            <li><i class="bi bi-tag text-success me-1"></i> @L[Model.EquipmentCategory]</li>
                            <li><i class="bi bi-cash-coin text-success me-1"></i> @Model.DailyRate</li>
                            <li><i class="bi bi-geo-alt text-success me-1"></i> @Model.Location</li>
                        </ul>
                    </div>
                    <div class="col-12 reject-reason-block @(string.IsNullOrEmpty(Model.RejectReason) ? "d-none" : "")">
                        <span class="small fw-semibold text-uppercase d-block mb-1" style="color: var(--krishi-status-rejected-text); letter-spacing: 0.04em;">@L["Rejection Reason"]</span>
                        <p class="small mb-0 reject-reason-text" style="color: var(--krishi-text-primary);">@Model.RejectReason</p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
