@model ErrorViewModel
@{
    var notFound = Model.StatusCode == 404;
    ViewData["Title"] = notFound ? L["Page not found"] : L["Error"];
}

<div class="text-center py-5" style="max-width: 560px; margin: 0 auto;">
    <i class="bi @(notFound ? "bi-signpost-split" : "bi-exclamation-octagon") text-danger" style="font-size: 3.5rem;"></i>
    @if (notFound)
    {
        <h1 class="h3 fw-bold text-dark mt-3">@L["Page not found"]</h1>
        <p class="text-secondary mb-4">@L["The page you were looking for does not exist or has moved."]</p>
    }
    else
    {
        <h1 class="h3 fw-bold text-dark mt-3">@L["Error."]</h1>
        <p class="text-secondary mb-4">@L["An error occurred while processing your request."]</p>
    }

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">
            <strong>@L["Request ID:"]</strong> <code>@Model.RequestId</code>
        </p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-krishi-primary rounded-pill px-4 py-2 fw-semibold">
        <i class="bi bi-house-door me-1"></i>@L["Back to Home"]
    </a>
</div>
