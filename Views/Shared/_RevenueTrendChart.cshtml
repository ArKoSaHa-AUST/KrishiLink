@model List<KrishiLink.Models.ViewModels.RevenueTrendPoint>
@using Microsoft.AspNetCore.Html
@*
    Shared Partial: Revenue trend bar chart rendered as inline SVG (no charting library).
    Model: ordered list of buckets. Each bar stacks earned revenue (completed bookings, by end date)
    under escrow revenue (paid but not yet completed, by payment date). Scales to its container via viewBox.
    SVG <text> clashes with Razor's reserved <text> tag, so labels are emitted via SvgText().
*@
@{
    const int W = 720, H = 260, PadL = 56, PadR = 12, PadT = 20, PadB = 40, Steps = 4;
    var plotW = W - PadL - PadR;
    var plotH = H - PadT - PadB;

    var max = Model.Count > 0 ? Model.Max(p => p.Total) : 0;
    var hasEscrow = Model.Any(p => p.EscrowAmount > 0);
    // Round the axis top up to a "nice" number so gridlines land on readable values
    decimal step = 1000;
    if (max > 0)
    {
        var magnitude = (decimal)Math.Pow(10, Math.Floor(Math.Log10((double)max / Steps)));
        step = new[] { 1m, 2m, 2.5m, 5m, 10m }.Select(m => m * magnitude).First(s => s * Steps >= max);
    }
    var yMax = step * Steps;

    string Compact(decimal v) => v >= 1000 ? $"{v / 1000:0.#}k" : v.ToString("0");
    IHtmlContent SvgText(double x, double y, string anchor, string cls, string content) =>
        new HtmlString($"<text x=\"{x:0.#}\" y=\"{y:0.#}\" text-anchor=\"{anchor}\" class=\"{cls}\">{System.Net.WebUtility.HtmlEncode(content)}</text>");

    var slot = Model.Count > 0 ? (double)plotW / Model.Count : plotW;
    var barW = Math.Max(6, slot * 0.58);
    var labelEvery = Model.Count > 12 ? 2 : 1;
}

<svg viewBox="0 0 @W @H" class="w-100 krishi-revenue-chart" role="img" aria-label="@L["Revenue trend"]" style="height: auto;">
    @for (var i = 0; i <= Steps; i++)
    {
        var y = PadT + plotH - plotH * i / Steps;
        <line x1="@PadL" x2="@(W - PadR)" y1="@y" y2="@y" class="chart-grid" />
        @SvgText(PadL - 8, y + 4, "end", "chart-axis", "৳" + Compact(step * i))
    }

    @for (var i = 0; i < Model.Count; i++)
    {
        var p = Model[i];
        var x = PadL + slot * i + (slot - barW) / 2;
        var earnedH = yMax > 0 ? (double)(p.Amount / yMax) * plotH : 0;
        var escrowH = yMax > 0 ? (double)(p.EscrowAmount / yMax) * plotH : 0;
        var earnedY = PadT + plotH - earnedH;
        var escrowY = earnedY - escrowH;
        var cx = PadL + slot * i + slot / 2;
        var isLast = i == Model.Count - 1;
        var tip = p.EscrowAmount > 0
            ? $"{p.Label}: ৳{p.Amount:N0} {L["earned"].Value} + ৳{p.EscrowAmount:N0} {L["in escrow"].Value}"
            : $"{p.Label}: ৳{p.Amount:N0}";

        <g class="chart-bar-group">
            <title>@tip</title>
            @if (earnedH > 0)
            {
                <rect x="@x.ToString("0.#")" y="@earnedY.ToString("0.#")" width="@barW.ToString("0.#")" height="@earnedH.ToString("0.#")" rx="3"
                      class="chart-bar @(isLast ? "chart-bar-current" : "")" />
            }
            @if (escrowH > 0)
            {
                <rect x="@x.ToString("0.#")" y="@escrowY.ToString("0.#")" width="@barW.ToString("0.#")" height="@escrowH.ToString("0.#")" rx="3"
                      class="chart-bar-escrow" />
            }
            @if (p.Total > 0 && slot >= 28)
            {
                @SvgText(cx, escrowY - 5, "middle", "chart-value", Compact(p.Total))
            }
            @if (i % labelEvery == 0 || isLast)
            {
                @SvgText(cx, H - PadB + 18, "middle", "chart-axis", p.Label)
            }
        </g>
    }

    @if (max == 0)
    {
        @SvgText(PadL + plotW / 2.0, PadT + plotH / 2.0, "middle", "chart-empty", L["No completed or paid bookings in this period"].Value)
    }
</svg>

@if (max > 0)
{
    <div class="d-flex flex-wrap justify-content-center gap-3 small mt-1" style="color: var(--krishi-text-muted);">
        <span class="d-inline-flex align-items-center gap-1">
            <span class="krishi-chart-key krishi-chart-key-earned"></span>@L["Earned (completed)"]
        </span>
        @if (hasEscrow)
        {
            <span class="d-inline-flex align-items-center gap-1">
                <span class="krishi-chart-key krishi-chart-key-escrow"></span>@L["In escrow (paid, awaiting completion)"]
            </span>
        }
    </div>
}
