<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KrishiLink</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex flex-column min-vh-100" style="font-family: 'Inter', sans-serif;">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-success shadow-sm py-2">
            <div class="container">
                <a class="navbar-brand fw-bold fs-4 d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-tree-fill text-warning"></i>
                    <span>KrishiLink</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 fw-medium">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-house me-1"></i> Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Equipment" asp-action="Index"><i class="bi bi-tools me-1"></i> Equipment</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Godown" asp-action="Index"><i class="bi bi-building me-1"></i> Godowns</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Advisory" asp-action="Index"><i class="bi bi-sun me-1"></i> Advisory</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Bookings" asp-action="Index"><i class="bi bi-journal-check me-1"></i> Bookings</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="roleMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Role Views
                            </a>
                            <ul class="dropdown-menu shadow border-0" aria-labelledby="roleMenu">
                                <li><a class="dropdown-item" asp-controller="Farmer" asp-action="Index"><i class="bi bi-person-fill me-2 text-success"></i>Farmer Hub</a></li>
                                <li><a class="dropdown-item" asp-controller="EquipmentOwner" asp-action="Index"><i class="bi bi-gear-fill me-2 text-primary"></i>Equipment Owner</a></li>
                                <li><a class="dropdown-item" asp-controller="GodownOwner" asp-action="Index"><i class="bi bi-house-door-fill me-2 text-warning"></i>Godown Owner</a></li>
                            </ul>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1 py-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-white-50 py-3 mt-auto border-top">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center">
            <span class="small">&copy; 2026 KrishiLink Platform. All rights reserved.</span>
            <div class="small">
                <a asp-controller="Home" asp-action="Privacy" class="text-white-50 text-decoration-none me-3">Privacy Policy</a>
                <span class="text-white-50">Role-Based Agriculture Platform</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
