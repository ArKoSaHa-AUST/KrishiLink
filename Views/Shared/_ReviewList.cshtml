@model IEnumerable<KrishiLink.Models.ViewModels.ReviewItemViewModel>

@if (Model != null && Model.Any())
{
    foreach (var review in Model)
    {
        <div class="p-3.5 rounded-3 border bg-white shadow-xs review-item" id="review_@review.Id">
            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                <div class="d-flex align-items-center gap-2.5">
                    <div class="rounded-circle bg-success-subtle text-success border border-success-subtle d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px;">
                        @review.UserInitial
                    </div>
                    <div>
                        <h6 class="fw-bold text-dark mb-0">@review.FarmerName</h6>
                        <div class="small text-muted d-flex align-items-center gap-2">
                            @if (!string.IsNullOrWhiteSpace(review.FarmerLocation))
                            {
                                <span><i class="bi bi-geo-alt text-success"></i> @review.FarmerLocation</span>
                            }
                            <span class="badge bg-light text-muted border py-0.5 px-1.5" style="font-size: 0.7rem;">@L["Verified Booking"]</span>
                        </div>
                    </div>
                </div>
                
                <div class="text-end">
                    <div class="text-warning small mb-0.5">
                        @for (int s = 1; s <= 5; s++)
                        {
                            if (s <= review.Rating)
                            {
                                <i class="bi bi-star-fill"></i>
                            }
                            else
                            {
                                <i class="bi bi-star text-muted opacity-50"></i>
                            }
                        }
                    </div>
                    <span class="text-muted small" style="font-size: 0.75rem;">@review.TimeAgo</span>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(review.Comment))
            {
                <p class="text-secondary small mb-0 mt-2 ps-1 border-start border-2 border-success-subtle ps-2.5">
                    @review.Comment
                </p>
            }

            @if (!string.IsNullOrWhiteSpace(review.OwnerReply))
            {
                <div class="mt-2.5 ms-3 p-2.5 rounded-3 bg-light border-start border-3 border-success" id="ownerReplyBox_@review.Id">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small fw-bold text-success d-flex align-items-center gap-1">
                            <i class="bi bi-reply-fill"></i> @L["Owner Response"]
                        </span>
                        @if (!string.IsNullOrWhiteSpace(review.OwnerRepliedTimeAgo))
                        {
                            <span class="text-muted small" style="font-size: 0.72rem;">@review.OwnerRepliedTimeAgo</span>
                        }
                    </div>
                    <p class="small text-secondary mb-0">@review.OwnerReply</p>
                </div>
            }
            else
            {
                <div class="d-none mt-2.5 ms-3 p-2.5 rounded-3 bg-light border-start border-3 border-success" id="ownerReplyBox_@review.Id">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small fw-bold text-success d-flex align-items-center gap-1">
                            <i class="bi bi-reply-fill"></i> @L["Owner Response"]
                        </span>
                        <span class="text-muted small" style="font-size: 0.72rem;" id="ownerReplyTime_@review.Id">@L["Just now"]</span>
                    </div>
                    <p class="small text-secondary mb-0" id="ownerReplyText_@review.Id"></p>
                </div>
            }
        </div>
    }
}
