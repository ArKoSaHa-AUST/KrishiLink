@model KrishiLink.Models.ViewModels.EquipmentOwnerDashboardViewModel
@{
    ViewData["Title"] = L["Equipment Owner Dashboard"];
    ViewData["BodyClass"] = "krishi-body-gradient";
    const int previewCap = 4;
}

<!-- Dashboard Welcome Header -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-4 pb-3 border-bottom" style="border-color: var(--krishi-border-color) !important;">
    <div>
        <h2 class="fw-bold mb-1" style="color: var(--krishi-primary);">@L["Equipment Owner Dashboard"]</h2>
        <p class="mb-0" style="color: var(--krishi-text-muted);">
            @L["Manage your listings and respond to incoming rental requests."]
        </p>
    </div>
    <a asp-controller="EquipmentOwner" asp-action="Requests" class="btn btn-krishi-outline rounded-pill px-3 py-2 fw-semibold flex-shrink-0">
        <i class="bi bi-inbox me-1"></i> @L["All Requests"]
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2">
        <i class="bi bi-check-circle-fill text-success"></i>
        <span class="small">@TempData["SuccessMessage"]</span>
    </div>
}

<!-- Summary Cards Row (horizontal scroll strip on mobile) -->
<div class="d-flex flex-nowrap overflow-x-auto flex-md-wrap gap-3 pb-2 mb-4">
    <a href="#myListings" class="text-decoration-none flex-shrink-0 flex-md-grow-1 krishi-summary-card">
        <div class="card krishi-card border-0 shadow-sm p-3 d-flex flex-row align-items-center gap-3 h-100">
            <div class="rounded-3 d-flex align-items-center justify-content-center krishi-summary-icon" style="background-color: var(--krishi-primary-light);">
                <i class="bi bi-tools fs-4" style="color: var(--krishi-primary);"></i>
            </div>
            <div>
                <span class="fs-3 fw-bold d-block lh-1 summary-count krishi-summary-value">@Model.TotalListings</span>
                <span class="small krishi-summary-label">@L["Total Listings"]</span>
            </div>
        </div>
    </a>
    <a asp-controller="EquipmentOwner" asp-action="Requests" class="text-decoration-none flex-shrink-0 flex-md-grow-1 krishi-summary-card">
        <div class="card krishi-card border-0 shadow-sm p-3 d-flex flex-row align-items-center gap-3 h-100">
            <div class="rounded-3 d-flex align-items-center justify-content-center krishi-summary-icon" style="background-color: var(--krishi-primary-subtle);">
                <i class="bi bi-arrow-repeat fs-4" style="color: var(--krishi-primary);"></i>
            </div>
            <div>
                <span class="fs-3 fw-bold d-block lh-1 summary-count krishi-summary-value" id="activeRentalsCount">@Model.ActiveRentals</span>
                <span class="small krishi-summary-label">@L["Active Rentals"]</span>
            </div>
        </div>
    </a>
    <a href="#pendingRequests" class="text-decoration-none flex-shrink-0 flex-md-grow-1 krishi-summary-card">
        <div class="card krishi-card border-0 shadow-sm p-3 d-flex flex-row align-items-center gap-3 h-100">
            <div class="rounded-3 d-flex align-items-center justify-content-center krishi-summary-icon" style="background-color: var(--krishi-status-pending-bg);">
                <i class="bi bi-hourglass-split fs-4" style="color: var(--krishi-status-pending-text);"></i>
            </div>
            <div>
                <span class="fs-3 fw-bold d-block lh-1 summary-count krishi-summary-value" id="pendingCount" aria-live="polite">@Model.PendingRequests</span>
                <span class="small krishi-summary-label">@L["Pending Requests"]</span>
            </div>
        </div>
    </a>
</div>

<!-- Pending Requests Widget (visually prioritized — the owner's main actionable task) -->
<div class="mb-5" id="pendingRequests">
    <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: var(--krishi-radius-lg); border-left: 4px solid var(--krishi-primary) !important;">
        <div class="p-3 px-4 d-flex align-items-center justify-content-between" style="background-color: var(--krishi-primary-light);">
            <h5 class="fw-bold mb-0 d-flex align-items-center gap-2" style="color: var(--krishi-primary);">
                <i class="bi bi-bell-fill"></i> @L["Pending Rental Requests"]
                <span class="badge rounded-pill bg-white shadow-sm" id="pendingBadge" style="color: var(--krishi-primary);">@Model.PendingRequests</span>
            </h5>
            <a asp-controller="EquipmentOwner" asp-action="Requests" class="small fw-semibold text-success text-decoration-none d-none d-sm-block">
                @L["View All"] <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div id="pendingRequestsList">
            @foreach (var req in Model.PendingRequestItems)
            {
                <partial name="_RequestRow" model="req" />
            }
        </div>

        <div class="p-4 text-center @(Model.PendingRequestItems.Any() ? "d-none" : "")" id="noPendingState">
            <i class="bi bi-check2-circle fs-2 text-success d-block mb-1"></i>
            <span style="color: var(--krishi-text-muted);">@L["All caught up — no pending requests right now."]</span>
        </div>
    </div>
</div>

<!-- My Listings Preview -->
<div class="mb-5" id="myListings">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h5 class="fw-bold mb-0" style="color: var(--krishi-text-primary);">
            @L["My Equipment Listings"]
            <span class="badge rounded-pill ms-1" style="background-color: var(--krishi-primary-light); color: var(--krishi-primary); font-size: 0.78rem;">@Model.TotalListings</span>
        </h5>
        <a asp-controller="EquipmentOwner" asp-action="Create" class="btn btn-krishi-primary rounded-pill px-3 py-2 fw-bold shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> @L["Add New Equipment"]
        </a>
    </div>

    @if (!Model.Listings.Any())
    {
        <!-- Empty state: first-time owner -->
        <div class="card border-0 shadow-sm text-center p-5" style="border-radius: var(--krishi-radius-lg);">
            <i class="bi bi-tools fs-1 text-success d-block mb-2"></i>
            <h5 class="fw-bold" style="color: var(--krishi-text-primary);">@L["No equipment listed yet"]</h5>
            <p class="mb-3" style="color: var(--krishi-text-muted);">@L["List your first tractor, tiller, or harvester and start earning rental income."]</p>
            <div>
                <a asp-controller="EquipmentOwner" asp-action="Create" class="btn btn-krishi-primary rounded-pill px-4 py-2 fw-bold">
                    <i class="bi bi-plus-lg me-1"></i> @L["List Your First Equipment"]
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3 g-lg-4">
            @for (int i = 0; i < Model.Listings.Count; i++)
            {
                var item = Model.Listings[i];
                <div class="col-12 col-sm-6 col-lg-3 @(i >= previewCap ? "d-none extra-listing" : "")">
                    <div class="card krishi-card border-0 shadow-sm h-100 overflow-hidden">
                        <div class="krishi-card-img-wrapper position-relative" style="height: 140px;">
                            <img src="@item.ImageUrl" class="w-100 h-100 object-fit-cover" alt="@item.Name" />
                            <span class="krishi-badge position-absolute top-0 end-0 m-2 shadow-sm @(item.Status == "Available" ? "krishi-badge-available" : item.Status == "Rented" ? "krishi-badge-pending" : "krishi-badge-unavailable")">
                                @L[item.Status]
                            </span>
                        </div>
                        <div class="card-body p-3 d-flex flex-column">
                            <span class="small text-uppercase fw-semibold" style="color: var(--krishi-text-muted); letter-spacing: 0.04em;">@L[item.Category]</span>
                            <h6 class="fw-bold mb-1" style="color: var(--krishi-text-primary);">@item.Name</h6>
                            <span class="fw-bold text-success small mb-3">@item.DailyRate</span>
                            <div class="d-flex gap-2 mt-auto">
                                <a asp-controller="EquipmentOwner" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-krishi-outline btn-sm rounded-pill px-3 flex-grow-1">
                                    <i class="bi bi-pencil"></i> @L["Edit"]
                                </a>
                                <a asp-controller="EquipmentOwner" asp-action="Availability" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm rounded-pill px-3 flex-grow-1">
                                    <i class="bi bi-calendar3"></i> @L["Availability"]
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.Listings.Count > previewCap)
        {
            <div class="text-center mt-3">
                <button type="button" class="btn btn-krishi-outline rounded-pill px-4 fw-semibold" id="showAllListingsBtn"
                        onclick="document.querySelectorAll('.extra-listing').forEach(el => el.classList.remove('d-none')); this.remove();">
                    @L["Show all {0} listings", Model.Listings.Count] <i class="bi bi-chevron-down"></i>
                </button>
            </div>
        }
    }
</div>

<form id="antiForgeryForm">@Html.AntiForgeryToken()</form>

@section Scripts {
    <script>
        const UNDO_DELAY_MS = 5000;

        function refreshPendingUI() {
            const remaining = document.querySelectorAll('.pending-request-row:not(.d-none)').length;
            KrishiCount.animate(document.getElementById('pendingCount'), remaining);
            document.getElementById('pendingBadge').textContent = remaining;
            document.getElementById('noPendingState').classList.toggle('d-none', remaining > 0);
        }

        // Track the target value in JS — reading the DOM mid-animation would
        // lose increments when two decisions happen in quick succession.
        let activeRentalsValue = @Model.ActiveRentals;
        function bumpActiveRentals(delta) {
            activeRentalsValue += delta;
            KrishiCount.animate(document.getElementById('activeRentalsCount'), activeRentalsValue);
        }

        const RESPOND_URL = '@Url.Action("RespondRequest", "EquipmentOwner")';

        // Optimistic decision with an Undo window (shared helper handles the
        // row lifecycle, toast, and deferred POST)
        function applyDecision(id, decision, btn, reason) {
            const row = btn.closest('.pending-request-row');
            const accepted = decision === 'accept';
            KrishiRequests.optimisticDecision({
                url: RESPOND_URL, id, decision, reason, row,
                acceptedMsg: '@L["Rental request accepted ✓"]',
                rejectedMsg: '@L["Rental request rejected"]',
                undoDelay: UNDO_DELAY_MS,
                onApply: () => { if (accepted) bumpActiveRentals(1); },
                onRowHidden: refreshPendingUI,
                onRevert: () => { if (accepted) bumpActiveRentals(-1); refreshPendingUI(); }
            });
        }

        // Reject flow: optional reason prompt first, then the same optimistic path
        function promptReject(id, btn) {
            const farmer = btn.closest('.request-row').dataset.farmerName;
            KrishiRequests.promptReject(farmer, reason => applyDecision(id, 'reject', btn, reason));
        }

        // Poll for newly arrived requests and animate the counts up
        KrishiRequests.watchPendingCount('@Url.Action("PendingCount", "EquipmentOwner")', @Model.PendingRequests, delta => {
            const countEl = document.getElementById('pendingCount');
            KrishiCount.animate(countEl, Number(countEl.textContent) + delta);
            const badge = document.getElementById('pendingBadge');
            badge.textContent = Number(badge.textContent) + delta;
            KrishiToast.show(delta > 1
                ? '@L["{0} new rental requests received", "__COUNT__"]'.replace('__COUNT__', delta)
                : '@L["{0} new rental request received", "__COUNT__"]'.replace('__COUNT__', delta),
                { iconClass: 'bi-bell-fill text-success' });
        });
    </script>
}
