@model KrishiLink.Models.ViewModels.EquipmentMaintenanceDashboardViewModel
@{
    ViewData["Title"] = $"{L["Health Tracker"]} — {Model.EquipmentName}";
    ViewData["BodyClass"] = "krishi-body-gradient";
}

<!-- Breadcrumb Navigation -->
<nav aria-label="@L["breadcrumb"]" class="mb-3">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-success text-decoration-none">@L["Home"]</a></li>
        <li class="breadcrumb-item"><a asp-controller="EquipmentOwner" asp-action="Index" class="text-success text-decoration-none">@L["Owner Dashboard"]</a></li>
        <li class="breadcrumb-item active text-muted" aria-current="page">@L["Equipment Health Tracker"]</li>
    </ol>
</nav>

<!-- Page Header Banner -->
<div class="card krishi-card border-0 shadow-sm rounded-4 p-4 mb-4 overflow-hidden position-relative" style="background: linear-gradient(135deg, #1b4332 0%, #2d6a4f 60%, #40916c 100%);">
    <div class="row align-items-center position-relative text-white" style="z-index: 2;">
        <div class="col-12 col-md-8">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-light text-success fw-bold px-3 py-1 rounded-pill">
                    <i class="bi bi-wrench-adjustable me-1"></i> @L["Equipment Health & Service Tracker"]
                </span>
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1">
                    @L[Model.Category]
                </span>
            </div>
            <h2 class="fw-bold text-white mb-1">@Model.EquipmentName</h2>
            <p class="text-white-50 mb-0 small d-flex align-items-center gap-3 flex-wrap">
                <span><i class="bi bi-geo-alt-fill text-warning me-1"></i>@L[Model.Location]</span>
                <span><i class="bi bi-tag-fill text-warning me-1"></i>@Model.DailyRate</span>
                <span>
                    @if (Model.IsAvailable)
                    {
                        <span class="badge bg-success text-white"><i class="bi bi-check-circle me-1"></i>@L["Available for Rent"]</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary text-white"><i class="bi bi-pause-circle me-1"></i>@L["Unavailable"]</span>
                    }
                </span>
            </p>
        </div>
        <div class="col-12 col-md-4 text-md-end mt-3 mt-md-0">
            <div class="d-flex gap-2 justify-content-md-end flex-wrap">
                <a asp-controller="EquipmentOwner" asp-action="Index" class="btn btn-outline-light btn-sm rounded-pill px-3 py-2 fw-semibold">
                    <i class="bi bi-arrow-left me-1"></i> @L["Back to Dashboard"]
                </a>
                <button type="button" class="btn btn-warning text-dark btn-sm rounded-pill px-3.5 py-2 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#addMaintenanceModal">
                    <i class="bi bi-plus-circle-fill me-1"></i> @L["Log Service Event"]
                </button>
            </div>
        </div>
    </div>
    <!-- Decorative background icon -->
    <div class="position-absolute end-0 bottom-0 opacity-10" style="transform: translate(20%, 20%); pointer-events: none;">
        <i class="bi bi-tools text-white" style="font-size: 14rem;"></i>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2">
        <i class="bi bi-check-circle-fill text-success fs-5"></i>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
        <span>@TempData["ErrorMessage"]</span>
    </div>
}

<!-- KPI Summary Cards Row -->
<div class="row g-3 mb-4">
    <!-- 1. Total Maintenance Expense -->
    <div class="col-6 col-lg-3">
        <div class="card krishi-card border-0 shadow-sm rounded-4 p-3.5 h-100 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-2.5 d-flex align-items-center justify-content-center" style="background-color: var(--krishi-primary-light); width: 48px; height: 48px;">
                    <i class="bi bi-cash-stack fs-4" style="color: var(--krishi-primary);"></i>
                </div>
                <div>
                    <span class="fs-4 fw-bold d-block text-dark lh-1">৳@Model.TotalMaintenanceCost.ToString("N0")</span>
                    <span class="small text-muted">@L["Total Maintenance Cost"]</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Total Service Logs -->
    <div class="col-6 col-lg-3">
        <div class="card krishi-card border-0 shadow-sm rounded-4 p-3.5 h-100 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-2.5 d-flex align-items-center justify-content-center" style="background-color: #e8f5e9; width: 48px; height: 48px;">
                    <i class="bi bi-journal-check fs-4 text-success"></i>
                </div>
                <div>
                    <span class="fs-4 fw-bold d-block text-dark lh-1">@Model.TotalServiceLogs</span>
                    <span class="small text-muted">@L["Recorded Service Events"]</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Last Serviced Status (Trust KPI) -->
    <div class="col-6 col-lg-3">
        <div class="card krishi-card border-0 shadow-sm rounded-4 p-3.5 h-100 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-2.5 d-flex align-items-center justify-content-center" style="background-color: #e3f2fd; width: 48px; height: 48px;">
                    <i class="bi bi-clock-history fs-4 text-primary"></i>
                </div>
                <div>
                    @if (Model.DaysSinceLastService.HasValue)
                    {
                        <span class="fs-5 fw-bold d-block text-dark lh-1">
                            @if (Model.DaysSinceLastService.Value == 0)
                            {
                                @L["Today"]
                            }
                            else if (Model.DaysSinceLastService.Value == 1)
                            {
                                @L["Yesterday"]
                            }
                            else
                            {
                                @L["{0} days ago", Model.DaysSinceLastService.Value]
                            }
                        </span>
                        <span class="small text-muted">@L["Last Serviced"] (@Model.LastServicedDate?.ToString("dd MMM yyyy"))</span>
                    }
                    else
                    {
                        <span class="fs-6 fw-bold d-block text-muted lh-1">@L["Not Logged Yet"]</span>
                        <span class="small text-muted">@L["Last Serviced"]</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Health Status Rating -->
    <div class="col-6 col-lg-3">
        <div class="card krishi-card border-0 shadow-sm rounded-4 p-3.5 h-100 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-2.5 d-flex align-items-center justify-content-center" style="background-color: #f3e5f5; width: 48px; height: 48px;">
                    <i class="bi bi-shield-check fs-4 text-purple" style="color: #7b1fa2;"></i>
                </div>
                <div>
                    @if (Model.DaysSinceLastService.HasValue && Model.DaysSinceLastService.Value <= 30)
                    {
                        <span class="badge bg-success text-white px-2.5 py-1 mb-1">@L["Prime Condition"]</span>
                        <span class="small text-muted d-block">@L["Recently Serviced"]</span>
                    }
                    else if (Model.DaysSinceLastService.HasValue && Model.DaysSinceLastService.Value <= 90)
                    {
                        <span class="badge bg-info text-dark px-2.5 py-1 mb-1">@L["Good Condition"]</span>
                        <span class="small text-muted d-block">@L["Regularly Maintained"]</span>
                    }
                    else if (Model.DaysSinceLastService.HasValue)
                    {
                        <span class="badge bg-warning text-dark px-2.5 py-1 mb-1">@L["Service Due"]</span>
                        <span class="small text-muted d-block">@L["Maintenance Recommended"]</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary text-white px-2.5 py-1 mb-1">@L["No Logs"]</span>
                        <span class="small text-muted d-block">@L["Log First Service"]</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Trust Badge Public Notice -->
<div class="alert alert-info bg-info bg-opacity-10 border border-info-subtle rounded-4 p-3 mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2 shadow-xs">
    <div class="d-flex align-items-center gap-2.5">
        <i class="bi bi-info-circle-fill text-info fs-4"></i>
        <div>
            <strong class="text-dark d-block small">@L["Public Trust Indicator Active"]</strong>
            <span class="text-secondary small">
                @if (Model.DaysSinceLastService.HasValue)
                {
                    @L["Farmers browsing equipment will see: \"Last serviced: {0} days ago\". Logging your maintenance builds strong trust and boosts your rental bookings.", Model.DaysSinceLastService.Value]
                }
                else
                {
                    @L["Logging regular maintenance displays a verified \"Last serviced: X days ago\" badge on your public listing to help farmers rent with confidence."]
                }
            </span>
        </div>
    </div>
    <a asp-controller="Equipment" asp-action="Details" asp-route-id="@Model.EquipmentId" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill px-3 py-1 fw-semibold">
        <i class="bi bi-eye me-1"></i> @L["View Public Listing"]
    </a>
</div>

<!-- Maintenance History Table Card -->
<div class="card krishi-card border-0 shadow-sm rounded-4 p-4 mb-5">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 pb-3 mb-3 border-bottom">
        <div>
            <h5 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-clock-history text-success"></i>
                <span>@L["Maintenance & Service Log History"]</span>
            </h5>
            <p class="text-muted small mb-0">@L["Complete chronological log of repairs, parts replacements, and servicing."]</p>
        </div>
        <button type="button" class="btn btn-krishi-primary btn-sm rounded-pill px-3.5 py-2 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#addMaintenanceModal">
            <i class="bi bi-plus-lg me-1"></i> @L["Log New Service Event"]
        </button>
    </div>

    @if (Model.Records.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="py-3 px-3 text-secondary small fw-bold text-uppercase" style="width: 140px;">@L["Service Date"]</th>
                        <th class="py-3 px-3 text-secondary small fw-bold text-uppercase" style="width: 180px;">@L["Service Type"]</th>
                        <th class="py-3 px-3 text-secondary small fw-bold text-uppercase">@L["Work Done / Notes"]</th>
                        <th class="py-3 px-3 text-secondary small fw-bold text-uppercase" style="width: 160px;">@L["Serviced By"]</th>
                        <th class="py-3 px-3 text-secondary small fw-bold text-uppercase text-end" style="width: 120px;">@L["Cost (৳)"]</th>
                        <th class="py-3 px-3 text-secondary small fw-bold text-uppercase text-center" style="width: 80px;">@L["Action"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in Model.Records)
                    {
                        <tr>
                            <td class="px-3">
                                <span class="fw-semibold text-dark d-block">@record.ServiceDateFormatted</span>
                                <span class="badge bg-light text-muted border py-0.5 px-1.5" style="font-size: 0.7rem;">
                                    @L[record.DaysAgoText]
                                </span>
                            </td>
                            <td class="px-3">
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 fw-semibold">
                                    @L[record.ServiceType]
                                </span>
                            </td>
                            <td class="px-3">
                                <p class="text-secondary small mb-0 lh-base">@record.Description</p>
                            </td>
                            <td class="px-3">
                                <span class="text-dark small">
                                    <i class="bi bi-tools text-muted me-1"></i>@(string.IsNullOrWhiteSpace(record.ServicedBy) ? "—" : record.ServicedBy)
                                </span>
                            </td>
                            <td class="px-3 text-end">
                                <span class="fw-bold text-success">@record.CostFormatted</span>
                            </td>
                            <td class="px-3 text-center">
                                <button type="button" class="btn btn-outline-danger btn-sm rounded-circle p-1" style="width: 32px; height: 32px;"
                                        title="@L["Delete Record"]"
                                        onclick="confirmDeleteRecord(@record.Id, '@record.ServiceType', '@record.ServiceDateFormatted')">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="text-center py-5 px-3 bg-light rounded-4 border">
            <div class="d-inline-flex p-3 rounded-circle bg-white text-muted shadow-xs mb-3">
                <i class="bi bi-wrench-adjustable text-success" style="font-size: 2.5rem;"></i>
            </div>
            <h5 class="fw-bold text-dark mb-1">@L["No Maintenance Events Logged Yet"]</h5>
            <p class="text-muted small mb-3 mx-auto" style="max-width: 440px;">
                @L["Keep a regular maintenance log of your machinery to demonstrate reliability to renting farmers and maintain equipment longevity."]
            </p>
            <button type="button" class="btn btn-krishi-primary rounded-pill px-4 py-2.5 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#addMaintenanceModal">
                <i class="bi bi-plus-circle-fill me-1"></i> @L["Log Your First Service Event"]
            </button>
        </div>
    }
</div>

<!-- =========================================================================
     MODAL: LOG NEW MAINTENANCE EVENT
     ========================================================================= -->
<div class="modal fade" id="addMaintenanceModal" tabindex="-1" aria-labelledby="addMaintenanceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header text-white p-3.5 px-4" style="background: linear-gradient(135deg, #1b4332 0%, #2d6a4f 100%);">
                <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="addMaintenanceModalLabel">
                    <i class="bi bi-wrench-adjustable"></i> @L["Log Maintenance Event"]
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="@L["Close"]"></button>
            </div>

            <form asp-controller="EquipmentOwner" asp-action="AddMaintenance" method="post" id="addMaintenanceForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="EquipmentId" value="@Model.EquipmentId" />

                <div class="modal-body p-4">
                    <!-- 1. Service Date -->
                    <div class="mb-3">
                        <label for="serviceDateInput" class="form-label small fw-bold text-dark">
                            @L["Service Date"] <span class="text-danger">*</span>
                        </label>
                        <input type="date" class="form-control form-control-lg rounded-3" id="serviceDateInput" name="ServiceDate" 
                               value="@(Model.NewRecord.ServiceDate.ToString("yyyy-MM-dd"))"
                               max="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        <span class="form-text text-muted small">@L["Date when maintenance or repair was conducted (cannot be future)."]</span>
                    </div>

                    <!-- 2. Service Category / Type -->
                    <div class="mb-3">
                        <label for="serviceTypeSelect" class="form-label small fw-bold text-dark">
                            @L["Service Type"] <span class="text-danger">*</span>
                        </label>
                        <select class="form-select form-select-lg rounded-3" id="serviceTypeSelect" name="ServiceType" required>
                            <option value="">@L["-- Select Service Category --"]</option>
                            <option value="Engine Oil & Filter Change">@L["Engine Oil & Filter Change"]</option>
                            <option value="Hydraulic System Maintenance">@L["Hydraulic System Maintenance"]</option>
                            <option value="Blade / Rotavator Replacement">@L["Blade / Rotavator Replacement"]</option>
                            <option value="Tire & Track Maintenance">@L["Tire & Track Maintenance"]</option>
                            <option value="Electrical & Battery Tune-up">@L["Electrical & Battery Tune-up"]</option>
                            <option value="General Servicing & Inspection">@L["General Servicing & Inspection"]</option>
                            <option value="Fuel System & Injector Cleaning">@L["Fuel System & Injector Cleaning"]</option>
                            <option value="Brake & Clutch Adjustment">@L["Brake & Clutch Adjustment"]</option>
                            <option value="Transmission & Gearbox Overhaul">@L["Transmission & Gearbox Overhaul"]</option>
                            <option value="Other Repairs & Maintenance">@L["Other Repairs & Maintenance"]</option>
                        </select>
                    </div>

                    <!-- 3. Cost (৳) -->
                    <div class="mb-3">
                        <label for="costInput" class="form-label small fw-bold text-dark">
                            @L["Maintenance Cost (BDT ৳)"] <span class="text-danger">*</span>
                        </label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-light text-muted fw-bold">৳</span>
                            <input type="number" class="form-control" id="costInput" name="Cost" step="10" min="0" max="5000000" 
                                   placeholder="e.g. 2500" required />
                        </div>
                        <span class="form-text text-muted small">@L["Parts cost, labor fees, fluids, or workshop invoice amount."]</span>
                    </div>

                    <!-- 4. Serviced By / Workshop -->
                    <div class="mb-3">
                        <label for="servicedByInput" class="form-label small fw-bold text-dark">
                            @L["Serviced By / Workshop"] <span class="text-muted">@L["(Optional)"]</span>
                        </label>
                        <input type="text" class="form-control rounded-3" id="servicedByInput" name="ServicedBy" 
                               placeholder="@L["e.g. Modern Auto Garage, Self, Local Mechanic..."]" maxlength="150" />
                    </div>

                    <!-- 5. Description / Notes -->
                    <div class="mb-2">
                        <label for="descriptionInput" class="form-label small fw-bold text-dark">
                            @L["Work Done / Notes"] <span class="text-danger">*</span>
                        </label>
                        <textarea class="form-control rounded-3" id="descriptionInput" name="Description" rows="3" 
                                  placeholder="@L["Describe what work was completed, oil grade used, parts replaced, or general health check remarks..."]" 
                                  required maxlength="1000"></textarea>
                    </div>
                </div>

                <div class="modal-footer bg-light p-3 px-4">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 py-2 fw-semibold" data-bs-dismiss="modal">
                        @L["Cancel"]
                    </button>
                    <button type="submit" class="btn btn-krishi-primary rounded-pill px-4 py-2 fw-bold shadow-sm">
                        <i class="bi bi-check2-circle me-1"></i> @L["Save Service Log"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- =========================================================================
     MODAL: DELETE MAINTENANCE CONFIRMATION
     ========================================================================= -->
<form id="deleteMaintenanceForm" asp-controller="EquipmentOwner" asp-action="DeleteMaintenance" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="recordId" id="deleteRecordId" value="" />
    <input type="hidden" name="equipmentId" value="@Model.EquipmentId" />
</form>

@section Scripts {
    <script>
        function confirmDeleteRecord(recordId, serviceType, serviceDate) {
            document.getElementById('deleteRecordId').value = recordId;

            window.KrishiModal.confirm({
                title: '@L["Delete Maintenance Record?"]',
                body: `@L["Are you sure you want to delete the log for"] <strong>${serviceType}</strong> @L["on"] <strong>${serviceDate}</strong>? @L["This action cannot be undone."]`,
                confirmText: '@L["Delete Record"]',
                cancelText: '@L["Cancel"]',
                confirmClass: 'btn-danger',
                onConfirm: function () {
                    document.getElementById('deleteMaintenanceForm').submit();
                }
            });
        }
    </script>
}
