@model KrishiLink.Models.ViewModels.EquipmentListingViewModel
@{
    ViewData["Title"] = L[Model.FormTitle];
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <style>
        .leaflet-popup-content-wrapper { border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.15); }
        .krishi-map-card { position: relative; border-radius: 16px; overflow: hidden; }
        .custom-map-pin {
            background-color: #198754;
            color: white;
            border-radius: 50% 50% 50% 0;
            transform: rotate(-45deg);
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid white;
            box-shadow: 0 2px 6px rgba(0,0,0,0.3);
        }
        .custom-map-pin i {
            transform: rotate(45deg);
            font-size: 14px;
        }
    </style>
}

<!-- Breadcrumb Navigation -->
<nav aria-label="@L["breadcrumb"]" class="mb-3">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-success text-decoration-none">@L["Home"]</a></li>
        <li class="breadcrumb-item"><a asp-controller="EquipmentOwner" asp-action="Index" class="text-success text-decoration-none">@L["Owner Dashboard"]</a></li>
        <li class="breadcrumb-item active text-muted" aria-current="page">@L[Model.FormTitle]</li>
    </ol>
</nav>

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-4 pb-2 border-bottom">
    <div>
        <h2 class="fw-bold mb-1" style="color: var(--krishi-primary);">
            <i class="bi bi-gear-wide-connected text-success me-2"></i>@L[Model.FormTitle]
        </h2>
        <p class="text-muted mb-0">
            @(Model.IsEditMode 
                ? L["Update your agricultural machinery details, pricing, and availability."]
                : L["List your agricultural machinery to connect with local farmers seeking rentals."])
        </p>
    </div>
    <a asp-controller="EquipmentOwner" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-1.5 fw-semibold">
        <i class="bi bi-arrow-left me-1"></i> @L["Back to Dashboard"]
    </a>
</div>

<!-- Main Form Container -->
<div class="row justify-content-center">
    <div class="col-12 col-xl-10">
        
        <form asp-controller="EquipmentOwner" asp-action="Save" method="post" id="equipmentListingForm" enctype="multipart/form-data" onsubmit="return validateListingForm(event)">
            <input type="hidden" asp-for="Id" id="equipmentId" />
            <input type="hidden" asp-for="PrimaryImageKey" id="primaryImageKeyInput" />
            <input type="hidden" asp-for="Latitude" id="equipmentLatitude" />
            <input type="hidden" asp-for="Longitude" id="equipmentLongitude" />

            <div class="card krishi-card border-0 shadow-sm rounded-4 p-4 p-md-5 mb-4">
                
                <div class="row g-4">
                    
                    <!-- Section 1: Basic Information -->
                    <div class="col-12">
                        <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                            <span class="badge bg-success-subtle text-success rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                <i class="bi bi-info-circle-fill"></i>
                            </span>
                            <h5 class="fw-bold text-dark mb-0">@L["1. Machinery Details"]</h5>
                        </div>
                    </div>

                    <!-- Equipment Name -->
                    <div class="col-12 col-md-8">
                        <label asp-for="Name" class="form-label fw-semibold text-dark small">
                            @L["Equipment / Machine Title"] <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Name" class="form-control py-2.5" id="equipmentNameInput" placeholder="@L["e.g. Mahindra 575 DI Heavy Tractor"]" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                        <div class="form-text small text-muted">@L["Include brand name, model, and horsepower for higher renter trust."]</div>
                    </div>

                    <!-- Equipment Type / Category Dropdown -->
                    <div class="col-12 col-md-4">
                        <label asp-for="Category" class="form-label fw-semibold text-dark small">
                            @L["Machinery Category"] <span class="text-danger">*</span>
                        </label>
                        <select asp-for="Category" class="form-select py-2.5" id="equipmentCategorySelect" required>
                            <option value="">@L["-- Select Category --"]</option>
                            <option value="Tractor">@L["🚜 Tractor"]</option>
                            <option value="Power Tiller">@L["⚙️ Power Tiller"]</option>
                            <option value="Combine Harvester">@L["🌾 Combine Harvester"]</option>
                            <option value="Seed Drill / Seeder">@L["🌱 Seed Drill / Seeder"]</option>
                            <option value="Power Sprayer">@L["💧 Power Sprayer"]</option>
                            <option value="Irrigation Pump">@L["⚡ Irrigation Pump"]</option>
                            <option value="Thresher">@L["🌾 Crop Thresher"]</option>
                            <option value="Other">@L["📦 Other Agricultural Tool"]</option>
                        </select>
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>

                    <!-- Description Textarea -->
                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold text-dark small">
                            @L["Description & Key Specifications"] <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="Description" class="form-control" id="equipmentDescInput" rows="4" 
                                  placeholder="@L["Detail the engine capacity (HP), compatible implements, fuel consumption, driver/operator availability, and operational condition..."]" required></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <!-- Location Input -->
                    <div class="col-12 col-md-6">
                        <label asp-for="Location" class="form-label fw-semibold text-dark small">
                            @L["Equipment Base Location / District"] <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-success border-end-0">
                                <i class="bi bi-geo-alt-fill"></i>
                            </span>
                            <input asp-for="Location" class="form-control border-start-0 py-2.5" id="equipmentLocationInput" placeholder="@L["e.g. Bogra Sadar, Bogra"]" required />
                        </div>
                        <span asp-validation-for="Location" class="text-danger small"></span>
                        <div class="form-text small text-muted">@L["District or Upazila name where the machinery is stored."]</div>
                    </div>

                    <!-- Availability Status Toggle -->
                    <div class="col-12 col-md-6 d-flex align-items-center">
                        <div class="p-3 bg-light rounded-3 border w-100 mt-md-1">
                            <div class="form-check form-switch d-flex align-items-center justify-content-between p-0 m-0">
                                <label class="form-check-label fw-semibold text-dark small mb-0" for="isAvailableSwitch">
                                    <i class="bi bi-toggle-on text-success me-1.5"></i> @L["Mark Listing as Active & Available"]
                                </label>
                                <input class="form-check-input ms-0" type="checkbox" role="switch" id="isAvailableSwitch" asp-for="IsAvailable" style="cursor: pointer;" />
                            </div>
                        </div>
                    </div>

                    <!-- Interactive Map Pin Picker -->
                    <div class="col-12">
                        <div class="p-3.5 bg-light rounded-4 border">
                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-2 pb-2 border-bottom">
                                <div>
                                    <label class="form-label fw-bold text-dark mb-0 small d-flex align-items-center gap-1.5">
                                        <i class="bi bi-pin-map-fill text-success"></i>
                                        <span>@L["Map Pin Location (Drop Pin for Exact Location)"]</span>
                                    </label>
                                    <div class="small text-muted">@L["Click anywhere on the map or drag the green marker to pinpoint your equipment base yard."]</div>
                                </div>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-semibold shadow-xs" id="btnDetectGPS" title="@L["Detect My Current GPS Location"]">
                                        <i class="bi bi-crosshair me-1"></i> @L["Use Current GPS"]
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold shadow-xs" id="btnRecenterDistrict" title="@L["Center on District"]">
                                        <i class="bi bi-arrow-clockwise me-1"></i> @L["Center on District"]
                                    </button>
                                    <span class="badge bg-success text-white px-3 py-1.5 rounded-pill font-monospace small shadow-xs" id="coordBadge">
                                        <i class="bi bi-geo-alt-fill me-1"></i> <span id="coordBadgeText">@(Model.Latitude.HasValue && Model.Longitude.HasValue ? $"{Model.Latitude.Value:F4}° N, {Model.Longitude.Value:F4}° E" : "24.8465° N, 89.3777° E")</span>
                                    </span>
                                </div>
                            </div>
                            
                            <div id="equipmentLocationPickerMap" class="rounded-3 shadow-xs border bg-white" style="height: 320px; width: 100%; z-index: 1;"></div>
                        </div>
                    </div>

                    <!-- Section 2: Pricing Configuration -->
                    <div class="col-12 pt-2">
                        <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                            <span class="badge bg-success-subtle text-success rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                <i class="bi bi-tag-fill"></i>
                            </span>
                            <h5 class="fw-bold text-dark mb-0">@L["2. Rental Rates & Pricing"]</h5>
                        </div>
                    </div>

                    <!-- Daily Rate -->
                    <div class="col-12 col-md-6">
                        <label asp-for="DailyRate" class="form-label fw-semibold text-dark small">
                            @L["Daily Rental Rate (in BDT ৳)"] <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-success fw-bold">৳</span>
                            <input type="number" asp-for="DailyRate" class="form-control py-2.5" id="dailyRateInput" min="1" step="50" placeholder="1500" required />
                            <span class="input-group-text bg-light text-muted">@L["/ Day"]</span>
                        </div>
                        <span asp-validation-for="DailyRate" class="text-danger small"></span>
                        <div class="form-text small text-muted">@L["Standard 8-hour daily operational rental rate. Must be greater than 0."]</div>
                    </div>

                    <!-- Hourly Rate -->
                    <div class="col-12 col-md-6">
                        <label asp-for="HourlyRate" class="form-label fw-semibold text-dark small">
                            @L["Hourly Rental Rate (in BDT ৳, Optional)"]
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-success fw-bold">৳</span>
                            <input type="number" asp-for="HourlyRate" class="form-control py-2.5" id="hourlyRateInput" min="0" step="10" placeholder="250" />
                            <span class="input-group-text bg-light text-muted">@L["/ Hour"]</span>
                        </div>
                        <span asp-validation-for="HourlyRate" class="text-danger small"></span>
                        <div class="form-text small text-muted">@L["Leave blank if only daily rentals are supported."]</div>
                    </div>

                    <!-- Section 3: Interactive Drag-and-Drop Image Uploader -->
                    <div class="col-12 pt-2">
                        <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-success-subtle text-success rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                    <i class="bi bi-images"></i>
                                </span>
                                <h5 class="fw-bold text-dark mb-0">@L["3. Machinery Photos"] <span class="text-danger">*</span></h5>
                            </div>
                            <span class="text-muted small">@L["At least 1 photo required (Max 5 MB each: PNG, JPG, WebP)"]</span>
                        </div>

                        <!-- Dropzone Component -->
                        <div class="krishi-upload-dropzone mb-3" id="dropzoneArea" onclick="document.getElementById('equipmentImageFileInput').click()">
                            <input type="file" id="equipmentImageFileInput" name="imageFiles" multiple accept="image/png, image/jpeg, image/webp" class="d-none" onchange="handleFileSelect(this.files)" />
                            <div class="mb-2">
                                <i class="bi bi-cloud-arrow-up text-success" style="font-size: 2.5rem;"></i>
                            </div>
                            <h6 class="fw-bold text-dark mb-1">@L["Drag & drop machinery photos here, or"] <span class="text-success text-decoration-underline">@L["browse files"]</span></h6>
                            <p class="text-muted small mb-0">@L["High-quality photos increase rental bookings. Click any photo below to set it as the Primary preview."]</p>
                        </div>

                        <!-- Server-Side & Client-Side Validation Alerts -->
                        <span asp-validation-for="ImageFiles" class="text-danger small d-block mb-2"></span>
                        <div class="alert alert-danger d-none py-2 px-3 small rounded-3 mb-3" id="imageValidationAlert">
                            <i class="bi bi-exclamation-triangle-fill me-1.5"></i> <span id="imageValidationAlertText">@L["Please upload at least one photo of the machinery before saving."]</span>
                        </div>

                        <!-- Live Preview Cards Container -->
                        <div class="d-flex flex-wrap gap-3" id="imagePreviewsContainer">
                            
                            <!-- Existing Images (if edit mode) -->
                            @for (int i = 0; i < Model.ExistingImageUrls.Count; i++)
                            {
                                var imgUrl = Model.ExistingImageUrls[i];
                                var isPrimary = (string.IsNullOrEmpty(Model.PrimaryImageKey) && i == 0) || string.Equals(Model.PrimaryImageKey, imgUrl, StringComparison.OrdinalIgnoreCase);
                                <div class="krishi-image-preview-card existing-image-card @(isPrimary ? "is-primary" : "")" id="existingCard_@i" data-key="@imgUrl" onclick="setPrimaryImage('@imgUrl', this)">
                                    <img src="@imgUrl" alt="@L["Equipment photo"]" class="w-100 h-100 object-fit-cover" />
                                    <input type="hidden" name="ExistingImageUrls" value="@imgUrl" />
                                    <span class="krishi-primary-badge @(isPrimary ? "" : "d-none")">
                                        <i class="bi bi-star-fill"></i> @L["Primary"]
                                    </span>
                                    <button type="button" class="krishi-set-primary-btn @(isPrimary ? "d-none" : "")" onclick="event.stopPropagation(); setPrimaryImage('@imgUrl', this.parentElement)">
                                        <i class="bi bi-star me-1"></i>@L["Set as Primary"]
                                    </button>
                                    <button type="button" class="krishi-preview-remove-btn" onclick="event.stopPropagation(); removeExistingImage(@i, '@imgUrl')" title="@L["Remove photo"]">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </div>
                            }

                        </div>

                    </div>

                </div>

                <!-- Form Action Buttons -->
                <div class="d-flex flex-column flex-sm-row justify-content-end align-items-center gap-3 pt-4 mt-4 border-top">
                    <a asp-controller="EquipmentOwner" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2.5 fw-semibold w-100 w-sm-auto order-2 order-sm-1">
                        @L["Cancel"]
                    </a>
                    <button type="submit" class="btn btn-krishi-primary rounded-pill px-5 py-2.5 fw-bold shadow-sm w-100 w-sm-auto order-1 order-sm-2" id="submitListingBtn">
                        <i class="bi bi-check2-circle me-1.5"></i> @L[Model.SubmitButtonText]
                    </button>
                </div>

            </div>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Track newly selected File objects in memory
        let selectedNewFiles = [];
        const maxFileSize = 5 * 1024 * 1024; // 5 MB
        const allowedExtensions = ['.jpg', '.jpeg', '.png', '.webp'];

        const dropzone = document.getElementById('dropzoneArea');

        // Drag-and-drop event listeners
        ['dragenter', 'dragover'].forEach(eventName => {
            dropzone.addEventListener(eventName, (e) => {
                e.preventDefault();
                e.stopPropagation();
                dropzone.classList.add('dragover');
            }, false);
        });

        ['dragleave', 'drop'].forEach(eventName => {
            dropzone.addEventListener(eventName, (e) => {
                e.preventDefault();
                e.stopPropagation();
                dropzone.classList.remove('dragover');
            }, false);
        });

        dropzone.addEventListener('drop', (e) => {
            const dt = e.dataTransfer;
            if (dt && dt.files && dt.files.length > 0) {
                handleFileSelect(dt.files);
            }
        }, false);

        function handleFileSelect(files) {
            const alertBox = document.getElementById('imageValidationAlert');
            if (alertBox) alertBox.classList.add('d-none');

            Array.from(files).forEach(file => {
                const ext = '.' + file.name.split('.').pop().toLowerCase();

                if (!allowedExtensions.includes(ext) || !file.type.startsWith('image/')) {
                    if (window.KrishiToast) {
                        KrishiToast.show(`File '${file.name}' is not a supported image format. Use JPG, PNG, or WebP.`, { iconClass: 'bi-exclamation-triangle-fill text-warning' });
                    }
                    return;
                }

                if (file.size > maxFileSize) {
                    const sizeMb = (file.size / (1024 * 1024)).toFixed(1);
                    if (window.KrishiToast) {
                        KrishiToast.show(`File '${file.name}' exceeds the 5 MB limit (${sizeMb} MB).`, { iconClass: 'bi-exclamation-triangle-fill text-warning' });
                    }
                    return;
                }

                selectedNewFiles.push(file);
            });

            renderNewPreviewCards();
        }

        function renderNewPreviewCards() {
            // Remove existing new-image cards
            document.querySelectorAll('.new-image-card').forEach(el => el.remove());

            const container = document.getElementById('imagePreviewsContainer');
            const primaryKeyInput = document.getElementById('primaryImageKeyInput');
            let currentPrimary = primaryKeyInput.value;

            selectedNewFiles.forEach((file, index) => {
                const key = 'new_' + index;
                const isPrimary = currentPrimary === key;

                const card = document.createElement('div');
                card.className = `krishi-image-preview-card new-image-card ${isPrimary ? 'is-primary' : ''}`;
                card.id = 'previewCard_' + index;
                card.dataset.key = key;
                card.onclick = function () { setPrimaryImage(key, card); };

                const img = document.createElement('img');
                img.className = 'w-100 h-100 object-fit-cover';
                img.alt = file.name;

                const reader = new FileReader();
                reader.onload = function (e) {
                    img.src = e.target.result;
                };
                reader.readAsDataURL(file);

                card.appendChild(img);

                const badge = document.createElement('span');
                badge.className = `krishi-primary-badge ${isPrimary ? '' : 'd-none'}`;
                badge.innerHTML = `<i class="bi bi-star-fill"></i> @L["Primary"]`;
                card.appendChild(badge);

                const setPrimaryBtn = document.createElement('button');
                setPrimaryBtn.type = 'button';
                setPrimaryBtn.className = `krishi-set-primary-btn ${isPrimary ? 'd-none' : ''}`;
                setPrimaryBtn.innerHTML = `<i class="bi bi-star me-1"></i>@L["Set as Primary"]`;
                setPrimaryBtn.onclick = function (ev) {
                    ev.stopPropagation();
                    setPrimaryImage(key, card);
                };
                card.appendChild(setPrimaryBtn);

                const removeBtn = document.createElement('button');
                removeBtn.type = 'button';
                removeBtn.className = 'krishi-preview-remove-btn';
                removeBtn.title = '@L["Remove photo"]';
                removeBtn.innerHTML = '<i class="bi bi-x"></i>';
                removeBtn.onclick = function (ev) {
                    ev.stopPropagation();
                    removeNewImage(index);
                };
                card.appendChild(removeBtn);

                container.appendChild(card);
            });

            ensurePrimarySelected();
            syncFileInput();
        }

        function setPrimaryImage(key, cardElement) {
            document.getElementById('primaryImageKeyInput').value = key;

            document.querySelectorAll('.krishi-image-preview-card').forEach(card => {
                card.classList.remove('is-primary');
                const badge = card.querySelector('.krishi-primary-badge');
                if (badge) badge.classList.add('d-none');
                const btn = card.querySelector('.krishi-set-primary-btn');
                if (btn) btn.classList.remove('d-none');
            });

            if (cardElement) {
                cardElement.classList.add('is-primary');
                const badge = cardElement.querySelector('.krishi-primary-badge');
                if (badge) badge.classList.remove('d-none');
                const btn = cardElement.querySelector('.krishi-set-primary-btn');
                if (btn) btn.classList.add('d-none');
            }
        }

        function removeNewImage(index) {
            const removedKey = 'new_' + index;
            selectedNewFiles.splice(index, 1);

            const primaryKeyInput = document.getElementById('primaryImageKeyInput');
            if (primaryKeyInput.value === removedKey) {
                primaryKeyInput.value = '';
            }

            renderNewPreviewCards();
        }

        function removeExistingImage(index, url) {
            const card = document.getElementById('existingCard_' + index);
            if (card) card.remove();

            const primaryKeyInput = document.getElementById('primaryImageKeyInput');
            if (primaryKeyInput.value === url) {
                primaryKeyInput.value = '';
            }

            ensurePrimarySelected();
        }

        function ensurePrimarySelected() {
            const primaryKeyInput = document.getElementById('primaryImageKeyInput');
            const allCards = Array.from(document.querySelectorAll('.krishi-image-preview-card'));

            if (allCards.length === 0) {
                primaryKeyInput.value = '';
                return;
            }

            const currentSelectedCard = allCards.find(c => c.dataset.key === primaryKeyInput.value);

            if (!currentSelectedCard) {
                // Default to the first available card
                const firstCard = allCards[0];
                const firstKey = firstCard.dataset.key;
                setPrimaryImage(firstKey, firstCard);
            }
        }

        function syncFileInput() {
            const fileInput = document.getElementById('equipmentImageFileInput');
            if (!fileInput) return;

            try {
                const dt = new DataTransfer();
                selectedNewFiles.forEach(file => dt.items.add(file));
                fileInput.files = dt.files;
            } catch (err) {
                console.warn('DataTransfer not fully supported on this browser', err);
            }
        }

        function validateListingForm(e) {
            syncFileInput();

            const dailyRate = Number(document.getElementById('dailyRateInput')?.value || 0);
            const existingCount = document.querySelectorAll('.existing-image-card').length;
            const newCount = selectedNewFiles.length;
            const alertBox = document.getElementById('imageValidationAlert');

            if (dailyRate <= 0) {
                if (window.KrishiToast) {
                    KrishiToast.show('@L["Daily rental rate must be greater than 0."]', { iconClass: 'bi-exclamation-triangle-fill text-warning' });
                }
                return false;
            }

            if (existingCount + newCount === 0) {
                if (alertBox) {
                    alertBox.classList.remove('d-none');
                    alertBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
                return false;
            }

            return true;
        }

        // Initialize primary selection state on page load
        document.addEventListener('DOMContentLoaded', () => {
            ensurePrimarySelected();
            initLocationPickerMap();
        });

        // -------------------------------------------------------------------------
        // LEAFLET MAP LOCATION PICKER
        // -------------------------------------------------------------------------
        const districtCentroids = {
            "Dhaka": [23.8103, 90.4125], "Gazipur": [24.0023, 90.4264], "Kishoreganj": [24.4449, 90.7766], "Manikganj": [23.8617, 90.0003],
            "Munshiganj": [23.5422, 90.5305], "Narayanganj": [23.6238, 90.5000], "Narsingdi": [23.9193, 90.7176], "Tangail": [24.2513, 89.9167],
            "Faridpur": [23.6071, 89.8429], "Gopalganj": [23.0051, 89.8266], "Madaripur": [23.1641, 90.1897], "Rajbari": [23.7574, 89.6445],
            "Shariatpur": [23.2423, 90.4348], "Bogra": [24.8465, 89.3777], "Bogura": [24.8465, 89.3777], "Joypurhat": [25.0968, 89.0227],
            "Naogaon": [24.8103, 88.9416], "Natore": [24.4206, 88.9322], "Nawabganj": [24.5965, 88.2775], "Chapai Nawabganj": [24.5965, 88.2775],
            "Pabna": [24.0064, 89.2372], "Rajshahi": [24.3636, 88.6241], "Sirajganj": [24.4534, 89.7008], "Dinajpur": [25.6279, 88.6332],
