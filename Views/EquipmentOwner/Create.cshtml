            "Jashore": [23.1664, 89.2081], "Jhenaidah": [23.5448, 89.1539], "Kushtia": [23.9013, 89.1205], "Magura": [23.4873, 89.4198],
            "Meherpur": [23.7622, 88.6318], "Narail": [23.1725, 89.5127], "Satkhira": [22.7185, 89.0705], "Barisal": [22.7010, 90.3535],
            "Barishal": [22.7010, 90.3535], "Barguna": [22.0953, 90.0768], "Bhola": [22.6859, 90.6481], "Jhalokati": [22.6406, 90.1987],
