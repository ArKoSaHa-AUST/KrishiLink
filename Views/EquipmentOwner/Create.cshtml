            "Chattogram": [22.3569, 91.7832], "Bandarban": [22.1953, 92.2184], "Brahmanbaria": [23.9571, 91.1119], "Chandpur": [23.2333, 90.6667],
            "Comilla": [23.4607, 91.1809], "Cumilla": [23.4607, 91.1809], "Cox's Bazar": [21.4272, 92.0058], "Feni": [23.0186, 91.3966],
