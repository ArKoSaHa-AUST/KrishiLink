        let pickerMap = null;
        let pickerMarker = null;

        function findDistrictCoords(locationText) {
            if (!locationText) return districtCentroids["Bogra"];
            const clean = locationText.trim();
            for (const key in districtCentroids) {
                if (clean.toLowerCase().includes(key.toLowerCase())) {
                    return districtCentroids[key];
                }
            }
            return districtCentroids["Bogra"];
        }

        function updateCoordinates(lat, lng) {
            document.getElementById('equipmentLatitude').value = lat.toFixed(6);
            document.getElementById('equipmentLongitude').value = lng.toFixed(6);
            
            const badgeText = document.getElementById('coordBadgeText');
            if (badgeText) {
                badgeText.textContent = `${Math.abs(lat).toFixed(4)}° ${lat >= 0 ? 'N' : 'S'}, ${Math.abs(lng).toFixed(4)}° ${lng >= 0 ? 'E' : 'W'}`;
            }
        }

        function initLocationPickerMap() {
            const mapEl = document.getElementById('equipmentLocationPickerMap');
            if (!mapEl) return;

            const latInput = document.getElementById('equipmentLatitude');
            const lngInput = document.getElementById('equipmentLongitude');
            const locInput = document.getElementById('equipmentLocationInput');

            let initialLat = parseFloat(latInput.value);
            let initialLng = parseFloat(lngInput.value);

            if (isNaN(initialLat) || isNaN(initialLng)) {
                const defaultCoords = findDistrictCoords(locInput?.value);
                initialLat = defaultCoords[0];
                initialLng = defaultCoords[1];
                updateCoordinates(initialLat, initialLng);
            }

            pickerMap = L.map('equipmentLocationPickerMap', {
                scrollWheelZoom: true
            }).setView([initialLat, initialLng], 12);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
            }).addTo(pickerMap);

            // Custom green tractor marker icon
            const tractorIcon = L.divIcon({
                className: 'custom-leaflet-marker',
                html: `<div class="custom-map-pin"><i class="bi bi-gear-wide-connected"></i></div>`,
                iconSize: [32, 32],
                iconAnchor: [16, 32],
                popupAnchor: [0, -32]
            });

            pickerMarker = L.marker([initialLat, initialLng], {
                draggable: true,
                icon: tractorIcon
            }).addTo(pickerMap);

            pickerMarker.bindPopup(`<strong>@L["Machinery Location"]</strong><br><small class="text-muted">@L["Drag marker or click map to adjust."]</small>`).openPopup();

            pickerMarker.on('dragend', function (e) {
                const pos = e.target.getLatLng();
                updateCoordinates(pos.lat, pos.lng);
            });

            pickerMap.on('click', function (e) {
                pickerMarker.setLatLng(e.latlng);
                updateCoordinates(e.latlng.lat, e.latlng.lng);
            });

            // "Use Current GPS" button
            document.getElementById('btnDetectGPS')?.addEventListener('click', () => {
                if ('geolocation' in navigator) {
                    if (window.KrishiToast) {
                        KrishiToast.show('@L["Detecting your current location..."]', { iconClass: 'bi-crosshair text-success' });
                    }
                    navigator.geolocation.getCurrentPosition((pos) => {
                        const lat = pos.coords.latitude;
                        const lng = pos.coords.longitude;
                        pickerMap.setView([lat, lng], 15);
                        pickerMarker.setLatLng([lat, lng]);
                        updateCoordinates(lat, lng);
                        if (window.KrishiToast) {
                            KrishiToast.show('@L["Location updated to your GPS position!"]', { iconClass: 'bi-check-circle-fill text-success' });
                        }
                    }, (err) => {
                        if (window.KrishiToast) {
                            KrishiToast.show('@L["Unable to retrieve GPS location. Please drop a pin on the map."]', { iconClass: 'bi-exclamation-triangle-fill text-warning' });
                        }
                    }, { enableHighAccuracy: true, timeout: 8000 });
                }
            });

            // "Center on District" button
            document.getElementById('btnRecenterDistrict')?.addEventListener('click', () => {
                const coords = findDistrictCoords(locInput?.value);
                pickerMap.setView(coords, 12);
                pickerMarker.setLatLng(coords);
                updateCoordinates(coords[0], coords[1]);
                if (window.KrishiToast) {
                    KrishiToast.show('@L["Map centered on district."]', { iconClass: 'bi-geo-alt-fill text-info' });
                }
            });

            // On location input change, center on district if user hasn't explicitly set pinpoint
            locInput?.addEventListener('blur', () => {
                if (locInput.value && !ModelHasCustomPin()) {
                    const coords = findDistrictCoords(locInput.value);
                    pickerMap.setView(coords, 12);
                    pickerMarker.setLatLng(coords);
                    updateCoordinates(coords[0], coords[1]);
                }
            });

            function ModelHasCustomPin() {
                const lat = parseFloat(document.getElementById('equipmentLatitude').value);
                return !isNaN(lat) && lat !== 0;
            }

            // Invalidate size in case of tab or card layout resizing
            setTimeout(() => { pickerMap.invalidateSize(); }, 300);
        }
    </script>
