@model KrishiLink.Models.ViewModels.RentalRequestsViewModel
@{
    ViewData["Title"] = "Equipment Rental Requests";
    ViewData["BodyClass"] = "krishi-body-gradient";
    ViewData["Expandable"] = true;
    var tabs = new[] { "Pending", "Accepted", "Rejected", "Completed" };
}

<!-- Page Header -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-4 pb-3 border-bottom" style="border-color: var(--krishi-border-color) !important;">
    <div>
        <h2 class="fw-bold mb-1" style="color: var(--krishi-primary);">Rental Requests</h2>
        <p class="mb-0" style="color: var(--krishi-text-muted);">
            Review incoming rental requests and accept or reject them.
        </p>
    </div>
    <a asp-controller="EquipmentOwner" asp-action="Index" class="btn btn-krishi-outline rounded-pill px-3 py-2 fw-semibold flex-shrink-0">
        <i class="bi bi-speedometer2 me-1"></i> Dashboard
    </a>
</div>

<!-- Filter Tabs + Search -->
<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
    <ul class="nav nav-pills krishi-nav-pills gap-2 flex-nowrap overflow-x-auto pb-1" id="requestTabs" role="tablist">
        @foreach (var tab in tabs)
        {
            var count = Model.Requests.Count(r => r.Status == tab);
            <li class="nav-item flex-shrink-0" role="presentation">
                <button class="nav-link rounded-pill px-3 fw-semibold @(tab == "Pending" ? "active" : "")"
                        id="tab-@tab" data-bs-toggle="pill" data-bs-target="#pane-@tab" type="button" role="tab">
                    @tab <span class="badge rounded-pill bg-white text-success shadow-sm ms-1 tab-count" id="count-@tab">@count</span>
                </button>
            </li>
        }
    </ul>
    <div class="input-group input-group-sm flex-shrink-0" style="max-width: 320px;">
        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-success"></i></span>
        <input type="search" class="form-control border-start-0" id="requestSearch"
               placeholder="Search farmer or equipment…" aria-label="Search requests" />
    </div>
</div>

<!-- Tab Panes -->
<div class="tab-content" id="requestTabPanes">
    @foreach (var tab in tabs)
    {
        var items = Model.Requests.Where(r => r.Status == tab).ToList();
        var emptyText = tab == "Pending" ? "No pending requests right now" : $"No {tab.ToLower()} requests yet";
        <div class="tab-pane fade @(tab == "Pending" ? "show active" : "")" id="pane-@tab" role="tabpanel">
            <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: var(--krishi-radius-lg);">
                <div class="request-list" id="list-@tab">
                    @foreach (var req in items)
                    {
                        <partial name="_RequestRow" model="req" />
                    }
                </div>

                <!-- Per-tab empty / no-match state -->
                <div class="p-5 text-center empty-state @(items.Any() ? "d-none" : "")" id="empty-@tab" data-default-text="@emptyText">
                    <i class="bi bi-inbox fs-2 text-success d-block mb-1"></i>
                    <span style="color: var(--krishi-text-muted);">@emptyText</span>
                </div>
            </div>
        </div>
    }
</div>

<form id="antiForgeryForm">@Html.AntiForgeryToken()</form>

@section Scripts {
    <script>
        // All list/tab/decision behavior comes from the shared KrishiRequestsPage engine
        KrishiRequestsPage.init({
            respondUrl: '@Url.Action("RespondRequest", "EquipmentOwner")',
            pendingCountUrl: '@Url.Action("PendingCount", "EquipmentOwner")',
            initialPendingCount: @Model.Requests.Count(r => r.Status == "Pending"),
            messages: {
                acceptTitle: 'Accept Rental Request',
                acceptNoun: 'rental request',
                rejectTitle: 'Reject Rental Request',
                rejectPlaceholder: 'e.g. Equipment is already booked for those dates (optional)',
                acceptedMsg: 'Request accepted — the farmer has been notified ✓',
                rejectedMsg: 'Request rejected — the farmer has been notified',
                completedMsg: 'Rental marked as completed ✓',
                completeTitle: 'Mark Rental Completed',
                newRequestMsg: 'new rental request'
            }
        });
    </script>
}
