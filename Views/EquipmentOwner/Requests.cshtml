@model KrishiLink.Models.ViewModels.RentalRequestsViewModel
@{
    ViewData["Title"] = "Equipment Rental Requests";
    ViewData["BodyClass"] = "krishi-body-gradient";
    ViewData["Expandable"] = true;
    var tabs = new[] { "Pending", "Accepted", "Rejected", "Completed" };
}

<!-- Page Header -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-4 pb-3 border-bottom" style="border-color: var(--krishi-border-color) !important;">
    <div>
        <h2 class="fw-bold mb-1" style="color: var(--krishi-primary);">Rental Requests</h2>
        <p class="mb-0" style="color: var(--krishi-text-muted);">
            Review incoming rental requests and accept or reject them.
        </p>
    </div>
    <a asp-controller="EquipmentOwner" asp-action="Index" class="btn btn-krishi-outline rounded-pill px-3 py-2 fw-semibold flex-shrink-0">
        <i class="bi bi-speedometer2 me-1"></i> Dashboard
    </a>
</div>

<!-- Filter Tabs + Search -->
<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
    <ul class="nav nav-pills krishi-nav-pills gap-2 flex-nowrap overflow-x-auto pb-1" id="requestTabs" role="tablist">
        @foreach (var tab in tabs)
        {
            var count = Model.Requests.Count(r => r.Status == tab);
            <li class="nav-item flex-shrink-0" role="presentation">
                <button class="nav-link rounded-pill px-3 fw-semibold @(tab == "Pending" ? "active" : "")"
                        id="tab-@tab" data-bs-toggle="pill" data-bs-target="#pane-@tab" type="button" role="tab">
                    @tab <span class="badge rounded-pill bg-white text-success shadow-sm ms-1 tab-count" id="count-@tab">@count</span>
                </button>
            </li>
        }
    </ul>
    <div class="input-group input-group-sm flex-shrink-0" style="max-width: 320px;">
        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-success"></i></span>
        <input type="search" class="form-control border-start-0" id="requestSearch"
               placeholder="Search farmer or equipment…" aria-label="Search requests" oninput="filterRequests(this.value)" />
    </div>
</div>

<!-- Tab Panes -->
<div class="tab-content" id="requestTabPanes">
    @foreach (var tab in tabs)
    {
        var items = Model.Requests.Where(r => r.Status == tab).ToList();
        var emptyText = tab == "Pending" ? "No pending requests right now" : $"No {tab.ToLower()} requests yet";
        <div class="tab-pane fade @(tab == "Pending" ? "show active" : "")" id="pane-@tab" role="tabpanel">
            <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: var(--krishi-radius-lg);">
                <div class="request-list" id="list-@tab">
                    @foreach (var req in items)
                    {
                        <partial name="_RequestRow" model="req" />
                    }
                </div>

                <!-- Per-tab empty / no-match state -->
                <div class="p-5 text-center empty-state @(items.Any() ? "d-none" : "")" id="empty-@tab" data-default-text="@emptyText">
                    <i class="bi bi-inbox fs-2 text-success d-block mb-1"></i>
                    <span style="color: var(--krishi-text-muted);">@emptyText</span>
                </div>
            </div>
        </div>
    }
</div>

<form id="antiForgeryForm">@Html.AntiForgeryToken()</form>

@section Scripts {
    <script>
        const RESPOND_URL = '@Url.Action("RespondRequest", "EquipmentOwner")';
        const BADGE_CLASS = {
            Pending: 'krishi-badge-pending d-none d-md-inline-flex',
            Accepted: 'krishi-badge-available',
            Rejected: 'krishi-badge-unavailable'
        };
        const UNDO_DELAY_MS = 5000;

        function updateTabCount(tab, delta) {
            const el = document.getElementById('count-' + tab);
            KrishiCount.animate(el, Number(el.textContent) + delta);
        }

        function setRowStatus(row, status) {
            const badge = row.querySelector('.request-status-badge');
            badge.textContent = status;
            badge.className = 'krishi-badge request-status-badge ' + BADGE_CLASS[status];
        }

        function refreshEmptyStates() {
            const filtering = document.getElementById('requestSearch').value.trim().length > 0;
            ['Pending', 'Accepted', 'Rejected', 'Completed'].forEach(tab => {
                const total = document.querySelectorAll('#list-' + tab + ' .request-row').length;
                const visible = document.querySelectorAll('#list-' + tab + ' .request-row:not(.d-none)').length;
                const empty = document.getElementById('empty-' + tab);
                empty.classList.toggle('d-none', visible > 0);
                empty.querySelector('span').textContent =
                    (total > 0 && filtering) ? 'No requests match your search' : empty.dataset.defaultText;
            });
        }

        // Client-side filter across all tabs by farmer or equipment name
        function filterRequests(q) {
            q = q.trim().toLowerCase();
            document.querySelectorAll('.request-row').forEach(r =>
                r.classList.toggle('d-none', q.length > 0 && !r.dataset.search.includes(q)));
            refreshEmptyStates();
        }

        // Handlers referenced by the shared _RequestRow partial
        function applyDecision(id, decision, btn) {
            const farmer = btn.closest('.request-row').dataset.farmerName;
            KrishiRequests.confirmAccept(farmer, () => submitDecision(id, 'accept', btn));
        }

        function promptReject(id, btn) {
            const farmer = btn.closest('.request-row').dataset.farmerName;
            KrishiRequests.promptReject(farmer, reason => submitDecision(id, 'reject', btn, reason));
        }

        async function submitDecision(id, decision, btn, reason) {
            const row = btn.closest('.request-row');
            if (!row) return; // stale reference (row already moved)
            const accepted = decision === 'accept';
            const actions = row.querySelector('.request-actions');
            const originalHtml = btn.innerHTML;

            // Brief loading state on the clicked button
            actions.querySelectorAll('button').forEach(b => b.disabled = true);
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Saving…';

            try {
                await KrishiRequests.post(RESPOND_URL, { id, decision, reason: reason || '' });

                // Restore buttons (hidden but intact, so Undo can bring them back)
                btn.innerHTML = originalHtml;
                actions.querySelectorAll('button').forEach(b => b.disabled = false);

                const targetTab = accepted ? 'Accepted' : 'Rejected';
                row.classList.add('row-leaving');
                setTimeout(() => {
                    row.classList.remove('row-leaving');
                    actions.classList.add('d-none');
                    setRowStatus(row, targetTab);
                    if (!accepted && reason) {
                        const block = row.querySelector('.reject-reason-block');
                        block.querySelector('.reject-reason-text').textContent = reason;
                        block.classList.remove('d-none');
                    }
                    document.getElementById('list-' + targetTab).prepend(row);
                    updateTabCount('Pending', -1);
                    updateTabCount(targetTab, +1);
                    refreshEmptyStates();
                }, 350);

                KrishiToast.show(
                    accepted ? 'Request accepted — the farmer has been notified ✓' : 'Request rejected — the farmer has been notified',
                    {
                        iconClass: accepted ? 'bi-check-circle-fill text-success' : 'bi-x-circle-fill text-danger',
                        actionText: 'Undo',
                        delay: UNDO_DELAY_MS,
                        onAction: () => undoDecision(row, targetTab)
                    });
            } catch {
                btn.innerHTML = originalHtml;
                actions.querySelectorAll('button').forEach(b => b.disabled = false);
                KrishiToast.show('Could not save the decision. Please try again.', { iconClass: 'bi-exclamation-triangle-fill text-danger' });
            }
        }

        // Reverse a decision: move the row back to Pending and notify the server
        function undoDecision(row, fromTab) {
            row.querySelector('.request-actions').classList.remove('d-none');
            row.querySelector('.reject-reason-block')?.classList.add('d-none');
            setRowStatus(row, 'Pending');
            document.getElementById('list-Pending').prepend(row);
            updateTabCount(fromTab, -1);
            updateTabCount('Pending', +1);
            refreshEmptyStates();
            KrishiRequests.post(RESPOND_URL, { id: row.dataset.requestId, decision: 'undo' })
                .catch(() => KrishiToast.show('Could not undo on the server.', { iconClass: 'bi-exclamation-triangle-fill text-danger' }));
        }

        // Deep-linking: #accepted etc. selects the tab; tab changes update the hash
        (function () {
            const map = { pending: 'Pending', accepted: 'Accepted', rejected: 'Rejected', completed: 'Completed' };
            const hash = location.hash.replace('#', '').toLowerCase();
            if (map[hash]) bootstrap.Tab.getOrCreateInstance(document.getElementById('tab-' + map[hash])).show();
            document.querySelectorAll('#requestTabs [data-bs-toggle="pill"]').forEach(t =>
                t.addEventListener('shown.bs.tab', e =>
                    history.replaceState(null, '', '#' + e.target.id.replace('tab-', '').toLowerCase())));
        })();

        // Keyboard accessibility: Enter/Space toggles row expansion
        document.getElementById('requestTabPanes').addEventListener('keydown', function (e) {
            if ((e.key === 'Enter' || e.key === ' ') && e.target.classList.contains('request-row-header')) {
                e.preventDefault();
                e.target.click();
            }
        });
    </script>
}
