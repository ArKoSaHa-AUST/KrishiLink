{
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Supabase": {
    "PublicBucket": "listing-images",
    "PrivateBucket": "verification-documents"
  },
  "DataProtection": {
    "KeyPath": "App_Data/keys"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Revenue": {
    "PlatformCommissionRate": 0.05,
    "LowUtilizationPercent": 25,
    "UnderPerformerShare": 0.33,
    "TransactionsPageSize": 25
  },
  "Pricing": {
    "WeekendDays": [ "Friday", "Saturday" ]
  },
  "Payments": {
    "Provider": "Simulated",
    "SettlementPollSeconds": 15,
    "FailAccountSuffix": "0000"
  },
  "Reminders": {
    "PollMinutes": 60,
    "StorageEndingDays": 3,
    "UnpaidNudgeHours": 48,
    "StalePendingHours": 24,
    "CompletionOverdueDays": 2
  },
  "Alerts": {
    "PollMinutes": 360
  },
  "Email": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "UseSsl": true,
    "Username": "",
    "FromAddress": "statements@krishilink.local",
    "FromName": "KrishiLink Statements"
  },
  "App": {
    "PublicBaseUrl": "https://localhost:7276"
  }
}
