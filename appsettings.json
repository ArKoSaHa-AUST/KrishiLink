{
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "ShardedWorkflowLocks": false
  },
  "Authentication": {
    "SessionStore": "Database"
  },
  "Supabase": {
    "PublicBucket": "listing-images",
    "PrivateBucket": "verification-documents"
  },
  "DataProtection": {
    "KeyPath": "App_Data/keys",
    "CertificatePath": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Diagnostics": {
    "SlowRequestMs": 2000,
    "SlowPathMs": 750
  },
  "AllowedHosts": "localhost",
  "Security": {
    "EnforceContentSecurityPolicy": true
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Revenue": {
    "PlatformCommissionRate": 0.05,
    "LowUtilizationPercent": 25,
    "UnderPerformerShare": 0.33,
    "TransactionsPageSize": 25
  },
  "Pricing": {
    "WeekendDays": [ "Friday", "Saturday" ]
  },
  "Payments": {
    "Provider": "Simulated",
    "SettlementPollSeconds": 15,
    "FailAccountSuffix": "0000"
  },
  "Reminders": {
    "PollMinutes": 60,
    "StorageEndingDays": 3,
    "UnpaidNudgeHours": 48,
    "StalePendingHours": 24,
    "CompletionOverdueDays": 2
  },
  "Alerts": {
    "PollMinutes": 360
  },
  "Groq": {
    "BaseUrl": "https://api.groq.com/openai/v1",
    "Model": "openai/gpt-oss-120b",
    "FastModel": "openai/gpt-oss-20b",
    "ReasoningEffort": "low",
    "ModelNote": "Verified against the account's live GET /openai/v1/models on 2026-09-25. Groq retires models on short notice; change the ids here, never in code. ReasoningEffort is only sent to openai/gpt-oss-* models. Keys: GROQ_API_KEY (+ standby GROQ_API_KEY_2/_3) in .env / .env.local or the host environment.",
    "FailoverAfterSeconds": 10,
    "TimeoutSeconds": 30,
    "MaxTokens": 1024,
    "Temperature": 0.2,
    "MaxToolIterations": 5,
    "MaxHistoryTurns": 12,
    "MaxHistoryTokens": 6000,
    "MaxMessageLength": 2000,
    "DailyTokenBudgetPerUser": 120000,
    "TurnTimeoutSeconds": 20,
    "ProposalLifetimeMinutes": 15
  },
  "Gemini": {
    "Enabled": true,
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
    "Model": "gemini-3.5-flash-lite",
    "FastModel": "gemini-3.5-flash-lite",
    "ReasoningEffort": "low",
    "TimeoutSeconds": 20,
    "MaxRetries": 1,
    "ModelNote": "Fallback when Groq is rate-limited, down or slow. Verified on 2026-09-25: gemini-3.5-flash-lite answers tool calls in ~1 s; gemini-2.5-* are closed to new keys, gemini-3.8-flash was overloaded and gemini-3.5-flash took 40 s. Keys: GEMINI_API_KEY (+ standby GEMINI_API_KEY_2). Set Enabled=false to send nothing to Google."
  },
  "Email": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "UseSsl": true,
    "Username": "",
    "FromAddress": "statements@krishilink.local",
    "FromName": "KrishiLink Statements"
  },
  "App": {
    "PublicBaseUrl": "https://localhost:7276",
    "ListenUrls": "http://0.0.0.0:5141;https://localhost:7276",
    "ListenUrlsNote": "Development only. 0.0.0.0 exposes the site to the local network; HTTPS stays on localhost because a dev certificate is not trusted by phones."
  }
}
