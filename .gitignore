## ASP.NET Core & .NET gitignore for KrishiLink

# Build outputs
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
[Pp]ublish/
publish/
[Ll]og/
[Ll]ogs/

# Visual Studio & IDE files
.vs/
.vscode/
.idea/
*.user
*.userosscache
*.suo
*.userhost
*.userlibraries
*.sln.docstates

# ASP.NET local / sensitive settings
appsettings.Development.json
appsettings.Local.json
*.Development.json
*.secret.json

# User-uploaded listing images
wwwroot/uploads/

# Private storage (identity documents, private files)
App_Data/
[Aa]pp_[Dd]ata/

# Database & temp files
*.mdf
*.ldf
*.db
*.sqlite
*.sqlite3

# OS files
.DS_Store
Thumbs.db
ehthumbs.db

# Ignore markdown files except README.md
*.md
!README.md
!readme.md
!README*.md

bin/
obj/

