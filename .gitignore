## ASP.NET Core & .NET gitignore for KrishiLink

# Build outputs
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
[Pp]ublish/
publish/
[Ll]og/
[Ll]ogs/

# Visual Studio & IDE files
.vs/
.vscode/
.idea/
*.user
*.userosscache
*.suo
*.userhost
*.userlibraries
*.sln.docstates

# ASP.NET local / sensitive settings
appsettings.Development.json
appsettings.Local.json
*.Development.json
*.secret.json
.env
.env.*
!.env.example

# User-uploaded listing images
wwwroot/uploads/

# Private storage (identity documents, private files, Data Protection keys) — except the reviewed seed data
App_Data/*
[Aa]pp_[Dd]ata/*
!App_Data/seed/

# Database & temp files
*.mdf
*.ldf
*.db
*.sqlite
*.sqlite3

# OS files
.DS_Store
Thumbs.db
ehthumbs.db

# Ignore markdown files except README.md and the prompt/ master prompts
*.md
!README.md
!README*.md
!prompt/
!prompt/*.md
!work/
!work/*.md
!COMMUNITY_*.md

# Agent workspace configurations & skills
.agents/
.agents

